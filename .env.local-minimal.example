# campus-agent v2 minimal local env
# 适用场景：
# - 你只有外部模型 API key
# - Qdrant 跑在本地
# - Agno 还没部署
# - MinIO 还没部署

LLM_API_KEY=
LLM_CHAT_MODEL=
EMBEDDING_MODEL=
QDRANT_URL=http://localhost:6333

# `process_raw_ingestion_job` 会对 CAMPUSRAG_RAW_ROOT 下的 PDF 调在线 OCR，
# 并同时写入 `provider-result.jsonl` 和 `structured.jsonl`
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=PaddleOCR-VL-1.5

# 历史结构化 OCR 补录入口使用
CAMPUSRAG_OCR_ROOT=
# raw-first 提交 / 处理入口使用
CAMPUSRAG_RAW_ROOT=
RAW_INGESTION_JOB_DIR=./var/ingestion-jobs
RAW_INGESTION_JOB_PATH=

# 只有当 embedding 不能复用同一个 provider key 时再填
EMBEDDING_API_KEY=
