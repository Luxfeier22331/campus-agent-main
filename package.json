{
	"name": "campus-agent-web-workspace",
	"private": true,
	"packageManager": "pnpm@10.17.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"official-web:live-seam:no-promotion": "uv run --all-packages python -m scripts.official_web_live_seam_no_promotion",
		"web:build:affected": "TURBO_SCM_BASE=origin/develop turbo run build --affected",
		"web:build": "turbo run build",
		"bundle:lint": "node scripts/check_web_client_bundle_budget.mjs",
		"web:check:affected": "TURBO_SCM_BASE=origin/develop turbo run typecheck test build --affected",
		"web:check": "turbo run typecheck test build",
		"web:dev": "turbo run dev",
		"web:dev:chat": "turbo run dev --filter=public-chat-web",
		"web:dev:docs": "turbo run dev --filter=public-docs",
		"web:lint": "uv run --all-packages python -m scripts.check_biome_tracked",
		"web:lint:fix": "pnpm exec biome check --write .",
		"web:test:affected": "TURBO_SCM_BASE=origin/develop turbo run test --affected",
		"web:test": "turbo run test",
		"web:test:worker": "turbo run test:worker",
		"web:test:integration": "turbo run test:shared-db-integration --filter=app-api",
		"web:typecheck:affected": "TURBO_SCM_BASE=origin/develop turbo run typecheck --affected",
		"web:typecheck": "turbo run typecheck",
		"contracts:generate": "uv run --all-packages python -m scripts.generate_supervisor_execution_contracts",
		"contracts:check": "uv run --all-packages python -m scripts.generate_supervisor_execution_contracts --check",
		"durable:cutover:preflight": "uv run --all-packages python -m scripts.check_run_projection_store_cutover_preflight",
		"eval:intent": "uv run --all-packages python -m scripts.intent_gate",
		"eval:intent:release": "uv run --all-packages python -m scripts.intent_release_gate",
		"eval:service-guide:release": "uv run --all-packages python -m scripts.eval_gate accept --profile service-guide-lookup --json",
		"docs:lint": "uv run --all-packages python -m scripts.check_markdown_tracked",
		"public-docs:lint": "pnpm --filter public-docs lint:generated",
		"coverage:lint": "uv run --all-packages python -m scripts.check_lint_coverage_tracked",
		"decomposition:lint": "uv run --all-packages python -m scripts.check_decomposition_tracked",
		"java:lint": "uv run --all-packages python -m scripts.check_java_tracked",
		"editorconfig:lint": "uv run --all-packages python -m scripts.check_editorconfig_tracked",
		"docker:lint": "uv run --all-packages python -m scripts.check_dockerfile_tracked",
		"env:lint": "uv run --all-packages python -m scripts.check_env_example_tracked",
		"html:lint": "uv run --all-packages python -m scripts.check_html_tracked",
		"jsonl:lint": "uv run --all-packages python -m scripts.check_jsonl_tracked",
		"lock:lint": "pnpm pnpm-lock:lint && pnpm uv-lock:lint",
		"pnpm-lock:lint": "uv run --all-packages python -m scripts.check_pnpm_lock_tracked",
		"py:lint": "uv run --all-packages ruff check .",
		"py:lint:fix": "uv run --all-packages ruff check . --fix",
		"py:format": "uv run --all-packages ruff format .",
		"py:format:check": "uv run --all-packages ruff format . --check",
		"uv-lock:lint": "uv run --all-packages python -m scripts.check_uv_lock",
		"shell:lint": "uv run --all-packages python -m scripts.check_shell_tracked",
		"sql:lint": "uv run --all-packages python -m scripts.check_sql_tracked",
		"toml:lint": "uv run --all-packages python -m scripts.check_toml_syntax",
		"xml:lint": "uv run --all-packages python -m scripts.check_xml_tracked",
		"yaml:lint": "uv run --all-packages python -m scripts.check_yaml_tracked",
		"go:fmt:check": "test -z \"$(gofmt -l apps/execution-control)\"",
		"go:vet": "cd apps/execution-control && go vet ./...",
		"go:lint": "export PATH=\"$(go env GOPATH)/bin:$PATH\"; command -v golangci-lint >/dev/null 2>&1 || { echo 'golangci-lint v2.11.4 is required. Install it from https://golangci-lint.run/welcome/install/'; exit 1; } && cd apps/execution-control && golangci-lint run ./...",
		"go:static:check": "pnpm go:fmt:check && pnpm go:vet && pnpm go:lint",
		"go:test": "cd apps/execution-control && go test ./...",
		"go:check": "pnpm go:static:check && pnpm go:test",
		"lint": "pnpm web:lint && pnpm docs:lint && pnpm public-docs:lint && pnpm coverage:lint && pnpm decomposition:lint && pnpm java:lint && pnpm editorconfig:lint && pnpm env:lint && pnpm html:lint && pnpm yaml:lint && pnpm toml:lint && pnpm shell:lint && pnpm xml:lint && pnpm jsonl:lint && pnpm sql:lint && pnpm docker:lint && pnpm lock:lint && pnpm go:static:check && pnpm py:lint && pnpm py:format:check",
		"lint:fix": "pnpm web:lint:fix && pnpm py:lint:fix && pnpm py:format"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"editorconfig-checker": "^6.1.1",
		"markdownlint-cli2": "^0.22.0",
		"turbo": "^2.8.21"
	}
}
