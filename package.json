{
	"name": "campus-agent-web-workspace",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"hooks:install": "node --experimental-strip-types scripts/hooks/install.mts",
		"prepare": "node --experimental-strip-types scripts/hooks/install.mts",
		"lint": "pnpm exec prek run --all-files --stage pre-commit --skip staged-secrets",
		"docs:check": "pnpm exec tsx scripts/docs/check-frontmatter.ts && pnpm exec tsx scripts/docs/check-adr-ids.ts && pnpm exec tsx scripts/docs/check-links.ts && pnpm exec tsx scripts/docs/check-language.ts",
		"test": "pnpm exec tsx --test scripts/ci/*.test.ts scripts/deploy/*.test.ts scripts/dev/*.test.ts scripts/docs/*.test.ts scripts/hooks/*.test.ts scripts/notices/*.test.ts scripts/release/*.test.ts scripts/release/*.test.mjs",
		"check": "pnpm lint && pnpm docs:check && pnpm test",
		"verify": "nix develop .#ci-full --command bash scripts/verify.sh",
		"notice:classify": "tsx scripts/notices/cli.ts",
		"notice:classify:job:local": "tsx jobs/notice-classifier/src/local-cli.ts",
		"notice:classify:eval": "tsx scripts/notices/eval.ts",
		"notice:classify:typecheck": "tsc --project scripts/notices/tsconfig.json",
		"internal-portal:auth:check": "pnpm --dir jobs/internal-portal-collection auth:check",
		"internal-portal:auth:pull": "pnpm --dir jobs/internal-portal-collection auth:pull",
		"internal-portal:collect": "pnpm --dir jobs/internal-portal-collection collect",
		"dev": "pnpm exec tsx scripts/dev/cli.ts doctor --target core --scope config && turbo run dev --env-mode=strict --filter=campus-web --filter=app-api --filter=model-config --filter=execution-control --filter=agent-runtime",
		"dev:init": "pnpm exec tsx scripts/dev/cli.ts init",
		"dev:doctor": "pnpm exec tsx scripts/dev/cli.ts doctor",
		"dev:instances": "pnpm exec tsx scripts/dev/cli.ts instances",
		"dev:shared-reconcile": "pnpm exec tsx scripts/dev/cli.ts shared-reconcile",
		"dev:destroy": "pnpm exec tsx scripts/dev/cli.ts destroy",
		"dev:prune": "pnpm exec tsx scripts/dev/cli.ts prune"
	},
	"devDependencies": {
		"@j178/prek": "0.5.0",
		"@aws-sdk/client-s3": "^3.1111.0",
		"@biomejs/biome": "2.5.8",
		"@campus-agent/notices": "workspace:*",
		"@types/node": "^24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"markdownlint-cli2": "^0.23.2",
		"ingestion-contracts": "workspace:*",
		"openai": "6.49.0",
		"notice-classifier-core": "workspace:*",
		"tsx": "^4.23.12",
		"turbo": "2.10.10",
		"typescript": "^7.0.2",
		"yaml": "2.9.0",
		"zod": "^4.4.3"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MUC-WIKI/campus-agent.git"
	},
	"homepage": "https://github.com/MUC-WIKI/campus-agent#readme",
	"bugs": {
		"url": "https://github.com/MUC-WIKI/campus-agent/issues"
	}
}
