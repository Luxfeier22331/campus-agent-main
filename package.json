{
	"name": "campus-agent-web-workspace",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"pnpm": {
		"overrides": {
			"adm-zip": "0.6.0",
			"body-parser@<2.3.0": "2.3.0",
			"brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
			"esbuild@<0.25.0": "0.25.12",
			"js-yaml@>=5.0.0 <5.2.1": "5.2.1",
			"protobufjs@<7.6.5": "7.6.5"
		},
		"packageExtensions": {
			"@hookform/resolvers@*": {
				"peerDependencies": {
					"zod": "^3.25 || ^4.0"
				},
				"peerDependenciesMeta": {
					"zod": {
						"optional": true
					}
				}
			}
		}
	},
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"repo:static": "pnpm exec biome check . && pnpm exec markdownlint-cli2 \"*.md\" \".github/*.md\" \".github/ISSUE_TEMPLATE/**/*.md\" \"docs/**/*.md\" \"apps/**/*.md\" \"jobs/**/*.md\" \"packages/**/*.md\" \"configs/**/*.md\" \"infra/**/*.md\" \"#docs/**/archive/**\" \"#apps/campus-web/.generated/**\" \"#**/dist/**\" \"#**/vendor/**\" \"#**/node_modules/**\" && pnpm exec editorconfig-checker -no-color -disable-indentation -disable-indent-size -exclude '(^|/)(dist|node_modules|vendor|\\.tmp|\\.worktrees|public/vendor|drizzle/meta)(/|$)'",
		"docs:check": "pnpm exec tsx scripts/docs/check-frontmatter.ts && pnpm exec tsx scripts/docs/check-adr-ids.ts && pnpm exec tsx scripts/docs/check-links.ts && pnpm exec tsx scripts/docs/check-language.ts",
		"smoke:app-api": "pnpm exec tsx scripts/smoke/app-api.ts",
		"ci:repo": "pnpm repo:static && pnpm docs:check",
		"ci:contracts": "pnpm contracts:check",
		"ci:app-api-migration": "turbo run test:migration-integration --filter=app-api --concurrency=1 --summarize",
		"ci:app-api-product-db": "turbo run test:shared-db-integration --filter=app-api --concurrency=1 --summarize",
		"ci:eval": "turbo run typecheck test --filter=eval-langfuse --concurrency=1 --summarize && turbo run test:eval --filter=ragas-runner --concurrency=1 --summarize",
		"ci:go": "scripts/ci/go-check.sh",
		"ci:execution-control-postgres": "scripts/ci/go-postgres-integration.sh",
		"ci:ingest": "turbo run typecheck test --filter=ingestion-contracts --filter=ingest-core --filter=ingestion-control --filter=source-collector --concurrency=1 --summarize",
		"ci:ingestion-control-postgres": "turbo run test:database-integration --filter=ingestion-control --concurrency=1 --summarize",
		"ci:otel": "scripts/ci/check-otel-config.sh",
		"ci:ops-web-postgres": "turbo run test:database-integration --filter=ops-web --concurrency=1 --summarize",
		"ci:postgres": "pnpm ci:app-api-migration && pnpm ci:app-api-product-db && pnpm ci:execution-control-postgres && pnpm ci:ingestion-control-postgres && pnpm ci:ops-web-postgres",
		"ci:rust": "scripts/ci/rust-check.sh",
		"ci:typescript": "turbo run typecheck test --only --concurrency=1 --summarize",
		"ci:typescript:full": "turbo run typecheck test --only --concurrency=1 --summarize && pnpm ci:worker && pnpm --dir apps/ops-web build",
		"ci:worker": "pnpm web:test:worker && pnpm exec turbo run build:worker --filter=app-api --concurrency=1 && pnpm exec turbo run build:app --filter=campus-web --concurrency=1",
		"ci:fast": "CI_AFFECTED_PROFILE=fast scripts/ci/run-affected.sh",
		"ci:pr": "CI_AFFECTED_PROFILE=fast scripts/ci/run-affected.sh",
		"ci:affected": "CI_AFFECTED_PROFILE=code scripts/ci/run-affected.sh",
		"ci:affected:docker": "CI_AFFECTED_PROFILE=docker scripts/ci/run-affected.sh",
		"ci:affected:database": "CI_AFFECTED_PROFILE=database scripts/ci/run-affected.sh",
		"ci:affected:browser": "CI_AFFECTED_PROFILE=browser scripts/ci/run-affected.sh",
		"ci:config": "pnpm ci:actions:lint && uvx zizmor==1.27.0 --min-severity=medium .github",
		"ci:actions:lint": "scripts/ci/actionlint.sh",
		"ci:deps": "scripts/ci/osv-scan.sh",
		"predev": "pnpm dev:prepare",
		"dev": "turbo run dev --filter=campus-web --filter=app-api",
		"dev:prepare": "pnpm exec tsx scripts/dev/prepare.ts",
		"web:build": "turbo run build",
		"web:check": "turbo run typecheck test build --concurrency=1",
		"web:lint": "pnpm exec biome check .",
		"web:test": "turbo run test",
		"web:test:worker": "turbo run test:worker --concurrency=1",
		"web:test:integration": "pnpm ci:app-api-product-db",
		"web:typecheck": "turbo run typecheck",
		"contracts:generate": "pnpm --dir packages/contracts generate",
		"contracts:check": "pnpm --dir packages/contracts check",
		"go:check": "scripts/ci/go-check.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@sentry/cli": "2.58.6",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"editorconfig-checker": "^6.1.1",
		"markdownlint-cli2": "^0.23.0",
		"tsx": "^4.23.0",
		"turbo": "2.10.4",
		"yaml": "2.9.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MUC-WIKI/campus-agent.git"
	},
	"homepage": "https://github.com/MUC-WIKI/campus-agent#readme",
	"bugs": {
		"url": "https://github.com/MUC-WIKI/campus-agent/issues"
	}
}
