{
	"name": "@campus-agent/dining-editor",
	"version": "0.1.0",
	"private": true,
	"description": "Local floorplan editor and deterministic asset generator for the Dining domain.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"floorplans:check": "tsx src/generate-assets.ts --check",
		"floorplans:edit": "tsx src/server.ts",
		"floorplans:generate": "tsx src/generate-assets.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@campus-agent/dining": "workspace:*",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tldraw": "5.2.4"
	},
	"devDependencies": {
		"@tldraw/tlschema": "5.2.4",
		"@types/node": "^24.13.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.10"
	}
}
