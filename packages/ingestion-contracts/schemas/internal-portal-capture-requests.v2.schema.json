{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-capture-requests.v2.schema.json",
	"title": "Internal portal capture requests",
	"oneOf": [{ "$ref": "#/$defs/notice" }, { "$ref": "#/$defs/fileRelease" }],
	"$defs": {
		"checkpoint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["notice_type", "last_released_notice_id"],
			"properties": {
				"notice_type": { "type": "string", "minLength": 1, "maxLength": 64 },
				"last_released_notice_id": { "type": "integer", "minimum": 1 }
			}
		},
		"selectedNotice": {
			"type": "object",
			"additionalProperties": false,
			"required": ["notice_id", "notice_type"],
			"properties": {
				"notice_id": { "type": "integer", "minimum": 1 },
				"notice_type": { "type": "string", "minLength": 1, "maxLength": 64 },
				"notice_type_name": { "type": "string", "minLength": 1, "maxLength": 256 },
				"notice_title": { "type": "string", "minLength": 1, "maxLength": 2048 }
			}
		},
		"notice": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "collection_mode", "checkpoints", "overlap_pages"],
			"properties": {
				"schema_version": { "const": "internal_portal_notice_capture_request.v2" },
				"collection_mode": { "enum": ["incremental", "reconcile", "selected"] },
				"checkpoints": {
					"type": "array",
					"maxItems": 64,
					"items": { "$ref": "#/$defs/checkpoint" }
				},
				"overlap_pages": { "type": "integer", "minimum": 1, "maximum": 3 },
				"max_notices": { "type": "integer", "minimum": 1, "maximum": 5000 },
				"selected_notices": {
					"type": "array",
					"minItems": 1,
					"maxItems": 200,
					"items": { "$ref": "#/$defs/selectedNotice" }
				}
			},
			"allOf": [
				{
					"if": { "properties": { "collection_mode": { "const": "selected" } } },
					"then": { "required": ["selected_notices"] },
					"else": { "not": { "required": ["selected_notices"] } }
				},
				{
					"if": { "properties": { "collection_mode": { "const": "incremental" } } },
					"else": { "not": { "required": ["max_notices"] } }
				}
			]
		},
		"fileRelease": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "file_release_id"],
			"properties": {
				"schema_version": { "const": "internal_portal_file_release_capture_request.v2" },
				"file_release_id": { "type": "integer", "minimum": 1 }
			}
		}
	}
}
