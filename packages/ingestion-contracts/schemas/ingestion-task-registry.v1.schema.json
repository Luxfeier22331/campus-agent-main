{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.local/schemas/ingestion-task-registry.v1.schema.json",
	"title": "IngestionTaskRegistry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "source_family", "corpus", "collection", "tasks"],
	"properties": {
		"schema_version": { "const": "ingestion_task_registry.v1" },
		"source_family": { "type": "string", "minLength": 1 },
		"corpus": { "type": "string", "minLength": 1 },
		"collection": { "type": "string", "minLength": 1 },
		"tasks": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"task_kind",
					"executor_kind",
					"input_contract",
					"output_contract",
					"can_publish_alias"
				],
				"properties": {
					"task_kind": {
						"enum": [
							"raw_asset_ingest",
							"source_truth_materialize",
							"canonical_document_materialize",
							"document_units_validate",
							"chunk_prepare",
							"embedding_index_build",
							"release_manifest_validate",
							"alias_publish",
							"structured_projection_publish",
							"operator_projection_snapshot"
						]
					},
					"executor_kind": { "enum": ["rust_kernel", "ts_control"] },
					"kernel_id": { "type": "string", "minLength": 1 },
					"input_contract": { "type": "string", "minLength": 1 },
					"output_contract": { "type": "string", "minLength": 1 },
					"can_publish_alias": { "type": "boolean" }
				}
			}
		}
	}
}
