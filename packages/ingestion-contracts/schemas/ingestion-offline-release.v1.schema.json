{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/ingestion-offline-release.v1.schema.json",
	"title": "Ingestion offline release",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"release_id",
		"stream_id",
		"previous_release_id",
		"created_at",
		"source",
		"target",
		"pipeline",
		"checkpoint",
		"items"
	],
	"properties": {
		"schema_version": { "const": "ingestion_offline_release.v1" },
		"release_id": { "$ref": "#/$defs/identity" },
		"stream_id": { "$ref": "#/$defs/identity" },
		"previous_release_id": { "oneOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
		"created_at": { "type": "string", "format": "date-time" },
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["channel", "surface", "site_id"],
			"properties": {
				"channel": { "const": "internal_portal" },
				"surface": { "enum": ["notice", "file_release"] },
				"site_id": { "type": "string", "minLength": 1, "maxLength": 128 }
			}
		},
		"target": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "collection"],
			"properties": {
				"corpus": { "type": "string", "minLength": 1, "maxLength": 128 },
				"collection": { "type": "string", "minLength": 1, "maxLength": 128 }
			}
		},
		"pipeline": {
			"type": "object",
			"additionalProperties": false,
			"required": ["run_id", "workflow_id", "workflow_run_id", "task_ids"],
			"properties": {
				"code_commit": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
				"worker_build_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
				"registry_digest": {
					"oneOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }]
				},
				"source_config_digest": {
					"oneOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }]
				},
				"run_id": { "$ref": "#/$defs/identity" },
				"workflow_id": { "type": "string", "minLength": 1, "maxLength": 512 },
				"workflow_run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
				"task_ids": {
					"type": "array",
					"minItems": 1,
					"maxItems": 16,
					"items": { "$ref": "#/$defs/identity" }
				}
			}
		},
		"checkpoint": { "type": "object" },
		"changes": {
			"type": "object",
			"additionalProperties": false,
			"required": ["added_item_ids", "updated_item_ids", "withdrawn_item_ids"],
			"properties": {
				"added_item_ids": { "$ref": "#/$defs/itemIds" },
				"updated_item_ids": { "$ref": "#/$defs/itemIds" },
				"withdrawn_item_ids": { "$ref": "#/$defs/itemIds" }
			}
		},
		"items": {
			"type": "array",
			"maxItems": 100000,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["item_id", "version_id", "artifacts"],
				"properties": {
					"item_id": { "$ref": "#/$defs/identity" },
					"version_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
					"artifacts": {
						"type": "array",
						"minItems": 1,
						"items": { "$ref": "#/$defs/releaseArtifact" }
					}
				}
			}
		}
	},
	"$defs": {
		"identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
		"itemIds": {
			"type": "array",
			"maxItems": 100000,
			"items": { "$ref": "#/$defs/identity" }
		},
		"releaseArtifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["role", "kind", "uri", "digest", "byte_size"],
			"properties": {
				"role": { "type": "string", "minLength": 1, "maxLength": 64 },
				"kind": { "const": "object_store" },
				"uri": { "type": "string", "maxLength": 4096, "pattern": "^s3://[^/]+/.+" },
				"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"byte_size": { "type": "integer", "minimum": 0 }
			}
		}
	}
}
