{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.local/schemas/ingestion-task-envelope.v1.schema.json",
	"title": "IngestionTaskEnvelope",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"task_id",
		"run_id",
		"source_family",
		"source_channel",
		"corpus",
		"collection",
		"task_kind",
		"input_ref",
		"output_contract",
		"idempotency_key",
		"lease_policy",
		"retry_policy",
		"created_by",
		"created_at"
	],
	"properties": {
		"schema_version": { "const": "ingestion_task_envelope.v1" },
		"task_id": { "type": "string", "minLength": 1 },
		"run_id": { "type": "string", "minLength": 1 },
		"source_family": { "type": "string", "minLength": 1 },
		"source_channel": { "type": "string", "minLength": 1 },
		"corpus": { "type": "string", "minLength": 1 },
		"collection": { "type": "string", "minLength": 1 },
		"task_kind": {
			"enum": [
				"raw_asset_ingest",
				"source_truth_materialize",
				"canonical_document_materialize",
				"document_units_validate",
				"chunk_prepare",
				"embedding_index_build",
				"release_manifest_validate",
				"alias_publish",
				"structured_projection_publish",
				"operator_projection_snapshot"
			]
		},
		"input_ref": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "uri"],
			"properties": {
				"kind": { "enum": ["object_store", "local_file", "postgres_row", "inline"] },
				"uri": { "type": "string", "minLength": 1 },
				"digest": { "type": "string", "minLength": 1 }
			}
		},
		"output_contract": { "type": "string", "minLength": 1 },
		"idempotency_key": { "type": "string", "minLength": 1 },
		"lease_policy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["lease_seconds", "heartbeat_seconds"],
			"properties": {
				"lease_seconds": { "type": "integer", "minimum": 1 },
				"heartbeat_seconds": { "type": "integer", "minimum": 1 }
			}
		},
		"retry_policy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["max_attempts"],
			"properties": {
				"max_attempts": { "type": "integer", "minimum": 1 }
			}
		},
		"created_by": { "type": "string", "minLength": 1 },
		"created_at": { "type": "string", "format": "date-time" }
	}
}
