{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-notice-checkpoint.v1.schema.json",
	"title": "Internal portal notice capture checkpoint",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "captured_at", "previous", "next"],
	"properties": {
		"schema_version": { "const": "internal_portal_notice_checkpoint.v1" },
		"captured_at": { "type": "string", "format": "date-time" },
		"previous": { "$ref": "#/$defs/checkpoints" },
		"next": { "$ref": "#/$defs/checkpoints" }
	},
	"$defs": {
		"checkpoints": {
			"type": "array",
			"maxItems": 256,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["notice_type", "last_released_notice_id"],
				"properties": {
					"notice_type": { "type": "string", "minLength": 1, "maxLength": 128 },
					"last_released_notice_id": { "type": "integer", "minimum": 1 }
				}
			}
		}
	}
}
