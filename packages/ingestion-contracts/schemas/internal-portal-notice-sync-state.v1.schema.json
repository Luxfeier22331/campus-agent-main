{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-notice-sync-state.v1.schema.json",
	"title": "Internal portal notice sync state",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"site_id",
		"incremental_head_id",
		"min_captured_id",
		"max_captured_id",
		"history_covered_from",
		"updated_at"
	],
	"properties": {
		"schema_version": { "const": "internal_portal_notice_sync_state.v1" },
		"site_id": { "$ref": "#/$defs/identity" },
		"incremental_head_id": { "$ref": "#/$defs/nullablePositiveSafeInteger" },
		"min_captured_id": { "$ref": "#/$defs/nullablePositiveSafeInteger" },
		"max_captured_id": { "$ref": "#/$defs/nullablePositiveSafeInteger" },
		"history_covered_from": {
			"oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
		},
		"updated_at": { "type": "string", "format": "date-time" }
	},
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
		},
		"positiveSafeInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"nullablePositiveSafeInteger": {
			"oneOf": [{ "$ref": "#/$defs/positiveSafeInteger" }, { "type": "null" }]
		}
	}
}
