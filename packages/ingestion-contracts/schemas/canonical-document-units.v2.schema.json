{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/canonical-document-units.v2.schema.json",
	"title": "Canonical formal document section",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"document_scope",
		"document_id",
		"version_id",
		"section_id",
		"parent_section_id",
		"ordinal",
		"anchor",
		"document_title",
		"section_title",
		"canonical_url",
		"content",
		"content_sha256",
		"metadata"
	],
	"properties": {
		"schema_version": { "const": "canonical_document_unit.v2" },
		"document_scope": { "$ref": "#/$defs/NonEmptyString" },
		"document_id": { "$ref": "#/$defs/NonEmptyString" },
		"version_id": { "$ref": "#/$defs/NonEmptyString" },
		"section_id": { "$ref": "#/$defs/NonEmptyString" },
		"parent_section_id": {
			"oneOf": [{ "$ref": "#/$defs/NonEmptyString" }, { "type": "null" }]
		},
		"ordinal": { "type": "integer", "minimum": 0 },
		"anchor": { "$ref": "#/$defs/NonEmptyString" },
		"document_title": { "type": "string", "minLength": 1, "maxLength": 300 },
		"section_title": { "type": "string", "minLength": 1, "maxLength": 300 },
		"canonical_url": { "type": "string", "format": "uri-reference", "minLength": 1 },
		"content": { "type": "string", "minLength": 1, "maxLength": 64000 },
		"content_sha256": { "$ref": "#/$defs/Sha256" },
		"metadata": { "type": "object" }
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"Sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
	}
}
