{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/ingestion-task-registry.v3.schema.json",
	"title": "Ingestion task registry v3",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "tasks"],
	"properties": {
		"schema_version": { "const": "ingestion_task_registry.v3" },
		"tasks": {
			"type": "array",
			"minItems": 1,
			"maxItems": 256,
			"items": { "$ref": "#/$defs/task" }
		}
	},
	"$defs": {
		"identity": {
			"type": "string",
			"maxLength": 128,
			"pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["family", "channel"],
			"properties": {
				"family": { "$ref": "#/$defs/identity" },
				"channel": { "$ref": "#/$defs/identity" }
			}
		},
		"target": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "collection"],
			"properties": {
				"corpus": { "$ref": "#/$defs/identity" },
				"collection": { "$ref": "#/$defs/identity" }
			}
		},
		"task": {
			"type": "object",
			"additionalProperties": false,
			"required": ["registry_task_id", "executor_kind", "input_contract", "output_contract"],
			"properties": {
				"registry_task_id": { "$ref": "#/$defs/identity" },
				"executor_kind": { "enum": ["source_collector", "typescript_kernel", "rust_kernel"] },
				"kernel_id": { "$ref": "#/$defs/identity" },
				"input_contract": { "$ref": "#/$defs/identity" },
				"output_contract": { "$ref": "#/$defs/identity" },
				"source": { "$ref": "#/$defs/source" },
				"target": { "$ref": "#/$defs/target" }
			},
			"allOf": [
				{
					"if": { "properties": { "executor_kind": { "const": "source_collector" } } },
					"then": { "required": ["source"], "not": { "required": ["kernel_id"] } }
				},
				{
					"if": { "properties": { "executor_kind": { "const": "typescript_kernel" } } },
					"then": { "required": ["kernel_id", "target"] }
				},
				{
					"if": { "properties": { "executor_kind": { "const": "rust_kernel" } } },
					"then": { "required": ["kernel_id", "target"] }
				}
			]
		}
	}
}
