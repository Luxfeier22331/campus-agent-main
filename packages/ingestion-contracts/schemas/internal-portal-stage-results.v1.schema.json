{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-stage-results.v1.schema.json",
	"title": "Internal portal ingestion stage results",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "task_id", "run_id", "registry_task_id", "artifacts", "summary"],
	"properties": {
		"schema_version": {
			"enum": [
				"internal_portal_notice_capture_result.v1",
				"internal_portal_notice_materialization_result.v1",
				"internal_portal_file_release_capture_result.v1",
				"internal_portal_file_release_materialization_result.v1"
			]
		},
		"task_id": { "$ref": "#/$defs/identity" },
		"run_id": { "$ref": "#/$defs/identity" },
		"registry_task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
		"artifacts": {
			"type": "array",
			"minItems": 1,
			"maxItems": 10000,
			"items": { "$ref": "#/$defs/roleRef" }
		},
		"items": {
			"type": "array",
			"minItems": 1,
			"maxItems": 100000,
			"items": { "$ref": "#/$defs/releaseItem" }
		},
		"summary": {
			"type": "object",
			"maxProperties": 32,
			"propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
			"additionalProperties": {
				"oneOf": [
					{ "type": "string", "maxLength": 256 },
					{ "type": "number" },
					{ "type": "boolean" },
					{ "type": "null" }
				]
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": { "schema_version": { "const": "internal_portal_notice_capture_result.v1" } }
			},
			"then": {
				"properties": {
					"artifacts": {
						"allOf": [
							{
								"type": "array",
								"contains": {
									"type": "object",
									"properties": { "role": { "const": "capture_release" } },
									"required": ["role"]
								}
							},
							{
								"type": "array",
								"contains": {
									"type": "object",
									"properties": { "role": { "const": "capture_checkpoint" } },
									"required": ["role"]
								}
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"schema_version": { "const": "internal_portal_file_release_capture_result.v1" }
				}
			},
			"then": {
				"properties": {
					"artifacts": {
						"allOf": [
							{
								"type": "array",
								"contains": {
									"type": "object",
									"properties": { "role": { "const": "source_bundle" } },
									"required": ["role"]
								}
							},
							{
								"type": "array",
								"contains": {
									"type": "object",
									"properties": { "role": { "const": "export_manifest" } },
									"required": ["role"]
								}
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"schema_version": { "const": "internal_portal_notice_materialization_result.v1" }
				}
			},
			"then": {
				"required": ["items"],
				"properties": {
					"artifacts": {
						"type": "array",
						"contains": {
							"type": "object",
							"properties": { "role": { "const": "canonical_document_units" } },
							"required": ["role"]
						}
					},
					"items": {
						"type": "array",
						"items": { "$ref": "#/$defs/noticeReleaseItem" }
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"schema_version": { "const": "internal_portal_file_release_materialization_result.v1" }
				}
			},
			"then": {
				"required": ["items"],
				"properties": {
					"artifacts": {
						"type": "array",
						"contains": {
							"type": "object",
							"properties": { "role": { "const": "released_file" } },
							"required": ["role"]
						}
					},
					"items": {
						"type": "array",
						"items": { "$ref": "#/$defs/fileReleaseItem" }
					}
				}
			}
		}
	],
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
		},
		"roleRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["role", "kind", "uri", "digest", "byte_size"],
			"properties": {
				"kind": { "const": "object_store" },
				"uri": { "type": "string", "maxLength": 4096, "pattern": "^s3://[^/]+/.+" },
				"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"byte_size": { "type": "integer", "minimum": 0 },
				"role": {
					"enum": [
						"capture_release",
						"capture_checkpoint",
						"source_bundle",
						"export_manifest",
						"source_manifest",
						"content_blocks",
						"attachment_refs",
						"canonical_markdown",
						"canonical_document_units",
						"released_file"
					]
				}
			}
		},
		"releaseItem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["item_id", "version_id", "artifacts"],
			"properties": {
				"item_id": { "$ref": "#/$defs/identity" },
				"version_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"artifacts": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/roleRef" }
				}
			}
		},
		"noticeReleaseItem": {
			"allOf": [
				{ "$ref": "#/$defs/releaseItem" },
				{
					"type": "object",
					"properties": {
						"artifacts": {
							"allOf": [
								{ "$ref": "#/$defs/containsSourceManifest" },
								{ "$ref": "#/$defs/containsContentBlocks" },
								{ "$ref": "#/$defs/containsAttachmentRefs" },
								{ "$ref": "#/$defs/containsCanonicalMarkdown" },
								{ "$ref": "#/$defs/containsCanonicalDocumentUnits" }
							]
						}
					}
				}
			]
		},
		"fileReleaseItem": {
			"allOf": [
				{ "$ref": "#/$defs/releaseItem" },
				{
					"type": "object",
					"properties": {
						"artifacts": {
							"allOf": [
								{ "$ref": "#/$defs/containsSourceManifest" },
								{ "$ref": "#/$defs/containsContentBlocks" },
								{ "$ref": "#/$defs/containsReleasedFile" }
							]
						}
					}
				}
			]
		},
		"containsSourceManifest": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "source_manifest" } },
				"required": ["role"]
			}
		},
		"containsContentBlocks": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "content_blocks" } },
				"required": ["role"]
			}
		},
		"containsAttachmentRefs": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "attachment_refs" } },
				"required": ["role"]
			}
		},
		"containsCanonicalMarkdown": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "canonical_markdown" } },
				"required": ["role"]
			}
		},
		"containsCanonicalDocumentUnits": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "canonical_document_units" } },
				"required": ["role"]
			}
		},
		"containsReleasedFile": {
			"type": "array",
			"contains": {
				"type": "object",
				"properties": { "role": { "const": "released_file" } },
				"required": ["role"]
			}
		}
	}
}
