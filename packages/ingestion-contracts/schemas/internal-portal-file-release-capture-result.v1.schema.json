{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-file-release-capture-result.v1.schema.json",
	"title": "Internal portal file release capture result",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "file_release_id", "source_ref"],
	"properties": {
		"schema_version": { "const": "internal_portal_file_release_capture_result.v1" },
		"file_release_id": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"source_ref": { "$ref": "#/$defs/object_store_ref" }
	},
	"$defs": {
		"object_store_ref": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "uri", "digest", "byte_size"],
			"properties": {
				"kind": { "const": "object_store" },
				"uri": { "type": "string", "maxLength": 4096, "pattern": "^s3://[^/]+/.+" },
				"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"byte_size": { "type": "integer", "minimum": 0 }
			}
		}
	}
}
