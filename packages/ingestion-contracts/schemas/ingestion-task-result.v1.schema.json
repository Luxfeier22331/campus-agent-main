{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/ingestion-task-result.v1.schema.json",
	"title": "Ingestion task result v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"task_id",
		"run_id",
		"registry_task_id",
		"output_contract",
		"result_ref",
		"summary"
	],
	"properties": {
		"schema_version": { "const": "ingestion_task_result.v1" },
		"task_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
		},
		"run_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
		},
		"registry_task_id": {
			"type": "string",
			"maxLength": 128,
			"pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
		},
		"output_contract": {
			"type": "string",
			"maxLength": 128,
			"pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
		},
		"result_ref": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "uri", "digest", "byte_size"],
			"properties": {
				"kind": { "const": "object_store" },
				"uri": { "type": "string", "maxLength": 4096, "pattern": "^s3://[^/]+/.+" },
				"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
				"byte_size": { "type": "integer", "minimum": 0 }
			}
		},
		"summary": {
			"type": "object",
			"maxProperties": 32,
			"propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
			"additionalProperties": {
				"oneOf": [
					{ "type": "string", "maxLength": 256 },
					{ "type": "number" },
					{ "type": "boolean" },
					{ "type": "null" }
				]
			}
		}
	}
}
