{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-notice-sync-state.v2.schema.json",
	"title": "Internal portal notice sync state",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "head_notice_id", "history_covered_from", "updated_at"],
	"properties": {
		"schema_version": { "const": "internal_portal_notice_sync_state.v2" },
		"head_notice_id": { "$ref": "#/$defs/nullablePositiveSafeInteger" },
		"history_covered_from": {
			"oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
		},
		"updated_at": { "type": "string", "format": "date-time" }
	},
	"$defs": {
		"positiveSafeInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"nullablePositiveSafeInteger": {
			"oneOf": [{ "$ref": "#/$defs/positiveSafeInteger" }, { "type": "null" }]
		}
	}
}
