{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.muc.wiki/contracts/internal-portal-notice-sync-state.v4.schema.json",
	"title": "Internal portal notice sync state",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "covered_from", "covered_until", "updated_at"],
	"properties": {
		"schema_version": { "const": "internal_portal_notice_sync_state.v4" },
		"covered_from": {
			"oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
		},
		"covered_until": {
			"oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
		},
		"updated_at": { "type": "string", "format": "date-time" },
		"recent_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
		"full_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
		"unavailable_notice_ids": {
			"type": "array",
			"items": { "type": "integer", "minimum": 1 },
			"uniqueItems": true,
			"maxItems": 500
		}
	},
	"oneOf": [
		{
			"properties": {
				"covered_from": { "type": "null" },
				"covered_until": { "type": "null" }
			}
		},
		{
			"properties": {
				"covered_from": { "$ref": "#/$defs/date" },
				"covered_until": { "$ref": "#/$defs/date" }
			}
		}
	],
	"$defs": {
		"date": { "type": "string", "format": "date" }
	}
}
