{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.local/schemas/ingestion-task-registry.v2.schema.json",
	"title": "IngestionTaskRegistry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "source_family", "corpus", "collection", "tasks"],
	"properties": {
		"schema_version": { "const": "ingestion_task_registry.v2" },
		"source_family": { "type": "string", "minLength": 1 },
		"corpus": { "type": "string", "minLength": 1 },
		"collection": { "type": "string", "minLength": 1 },
		"tasks": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"registry_task_id",
					"task_kind",
					"executor_kind",
					"input_contract",
					"output_contract"
				],
				"properties": {
					"registry_task_id": { "type": "string", "minLength": 1 },
					"task_kind": {
						"enum": [
							"source_truth_materialize",
							"document_units_validate",
							"chunk_prepare",
							"release_manifest_validate"
						]
					},
					"executor_kind": {
						"enum": ["rust_kernel", "ts_control"]
					},
					"kernel_id": { "type": "string", "minLength": 1 },
					"input_contract": { "type": "string", "minLength": 1 },
					"output_contract": { "type": "string", "minLength": 1 }
				},
				"allOf": [
					{
						"if": {
							"properties": {
								"executor_kind": { "const": "rust_kernel" }
							},
							"required": ["executor_kind"]
						},
						"then": {
							"required": ["kernel_id"]
						}
					}
				]
			}
		}
	}
}
