{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/retrieval-chunk-set.v2.schema.json",
	"title": "Deterministic retrieval chunk set",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "chunk_count", "chunks", "error_count", "errors"],
	"properties": {
		"schema_version": { "const": "retrieval_chunk_set.v2" },
		"chunk_count": { "type": "integer", "minimum": 0 },
		"chunks": {
			"type": "array",
			"items": { "$ref": "#/$defs/RetrievalChunkV2" }
		},
		"error_count": { "type": "integer", "minimum": 0 },
		"errors": { "type": "array", "items": { "type": "string" } }
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"Sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
		"RetrievalChunkV2": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema_version",
				"document_scope",
				"document_id",
				"version_id",
				"section_id",
				"chunk_id",
				"ordinal",
				"token_count",
				"text",
				"text_sha256",
				"metadata"
			],
			"properties": {
				"schema_version": { "const": "retrieval_chunk.v2" },
				"document_scope": { "$ref": "#/$defs/NonEmptyString" },
				"document_id": { "$ref": "#/$defs/NonEmptyString" },
				"version_id": { "$ref": "#/$defs/NonEmptyString" },
				"section_id": { "$ref": "#/$defs/NonEmptyString" },
				"chunk_id": { "$ref": "#/$defs/NonEmptyString" },
				"ordinal": { "type": "integer", "minimum": 0 },
				"token_count": { "type": "integer", "minimum": 1 },
				"text": { "type": "string", "minLength": 1, "maxLength": 16000 },
				"text_sha256": { "$ref": "#/$defs/Sha256" },
				"metadata": { "type": "object" }
			}
		}
	}
}
