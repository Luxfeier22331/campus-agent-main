{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://campus-agent.local/schemas/ingestion-release-manifest.v2.schema.json",
	"title": "IngestionReleaseManifest",
	"type": "object",
	"required": ["schema_version", "release_id", "corpus", "collection", "artifacts"],
	"properties": {
		"schema_version": { "const": "ingestion_release_manifest.v2" },
		"release_id": { "type": "string", "minLength": 1 },
		"corpus": { "type": "string", "minLength": 1 },
		"collection": { "type": "string", "minLength": 1 },
		"artifacts": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["kind", "uri", "digest", "byte_size"],
				"properties": {
					"kind": { "type": "string", "minLength": 1 },
					"uri": { "type": "string", "minLength": 1 },
					"digest": { "type": "string", "minLength": 1 },
					"byte_size": { "type": "integer", "minimum": 0 }
				},
				"additionalProperties": true
			}
		}
	},
	"additionalProperties": true
}
