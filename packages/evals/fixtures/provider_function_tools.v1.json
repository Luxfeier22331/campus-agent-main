      }
    },
    {
      "type": "function",
      "name": "transport_schedule_lookup",
      "description": "Lookup campus shuttle schedule snapshots, departures, and service windows.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_text": {
            "type": "string",
            "description": "Original transport schedule question."
          },
          "intent": {
            "type": "string",
            "enum": [
              "next_departure",
              "first_departure",
              "last_departure",
              "departure_list",
              "service_window",
              "timetable",
              "schedule_snapshot_metadata"
            ],
            "description": "Transport schedule lookup intent."
          },
          "route_selector": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "route_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Known route id if already resolved."
              },
              "service_family": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Service family such as intercampus or metro shuttle."
              },
              "route_variant_query": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Route variant words from the user query."
              },
              "origin_campus": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Origin campus if stated."
              },
              "destination_campus": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Destination campus if stated."
              },
              "origin_stop_query": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Origin stop if stated."
              },
              "destination_stop_query": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Destination stop if stated."
              }
            },
            "required": [
              "route_id",
              "service_family",
              "route_variant_query",
              "origin_campus",
              "destination_campus",
              "origin_stop_query",
              "destination_stop_query"
            ]
          },
          "snapshot_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "current",
                  "latest",
                  "effective",
                  "as_of",
                  "current_year",
                  null
                ],
                "description": "Temporal query mode."
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is as_of."
              },
              "year_hint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is current_year."
              }
            },
            "required": [
              "mode",
              "as_of",
              "year_hint"
            ]
          },
          "service_time_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "date_mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "today",
                  "tomorrow",
                  "date",
                  null
                ],
                "description": "Service date interpretation."
              },
              "service_date": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISO date when date_mode is date."
              },
              "daypart": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "morning",
                  "afternoon",
                  "evening",
                  "all_day",
                  null
                ],
                "description": "Requested daypart."
              },
              "departure_not_before": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Lower bound departure time in HH:MM if stated."
              },
              "departure_not_after": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Upper bound departure time in HH:MM if stated."
              }
            },
            "required": [
              "date_mode",
              "service_date",
              "daypart",
              "departure_not_before",
              "departure_not_after"
            ]
          },
          "result_limit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Optional positive maximum result count.",
            "minimum": 1
          }
        },
        "required": [
          "query_text",
          "intent",
          "route_selector",
          "snapshot_query",
          "service_time_query",
          "result_limit"
        ]
      }
    },
