            "type": "string",
            "enum": [
              "overview",
              "procedure",
              "required_materials",
              "entry",
              "office_hours",
              "contact",
              "eligibility",
              "full_guide"
            ],
            "description": "Requested service guide section."
          },
          "temporal_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "current",
                  "latest",
                  "effective",
                  "as_of",
                  "current_year",
                  null
                ],
                "description": "Temporal query mode."
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is as_of."
              },
              "year_hint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is current_year."
              }
            },
            "required": [
              "mode",
              "as_of",
              "year_hint"
            ]
          },
          "campus_scope": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional campus scope such as haidian or fengtai."
          },
          "audience": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "student",
              "faculty",
              "visitor",
              "unknown",
              null
