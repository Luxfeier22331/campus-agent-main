{
  "schema_version": "provider-function-tools-v1",
  "tools": [
    {
      "type": "function",
      "name": "service_status_lookup",
      "description": "Lookup current or temporally qualified campus service status.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject_query": {
            "type": "string",
            "description": "Campus service, facility, or operation to check."
          },
          "temporal_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "current",
                  "latest",
                  "effective",
                  "as_of",
                  "current_year",
                  null
                ],
                "description": "Temporal query mode."
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is as_of."
              },
              "year_hint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is current_year."
              }
            },
            "required": [
              "mode",
              "as_of",
              "year_hint"
            ]
          },
          "campus_scope": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional campus scope such as haidian or fengtai."
          }
        },
        "required": [
          "subject_query",
          "temporal_query",
          "campus_scope"
        ]
      }
    },
    {
      "type": "function",
