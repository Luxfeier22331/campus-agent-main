    {
      "type": "function",
      "name": "academic_calendar_lookup",
      "description": "Lookup governed academic calendar facts such as teaching week, holiday and makeup-class arrangement.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_text": {
            "type": "string",
            "description": "Original academic calendar fact question."
          },
          "temporal_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "current",
                  "latest",
                  "effective",
                  "as_of",
                  "current_year",
                  null
                ],
                "description": "Temporal query mode."
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is as_of."
              },
              "year_hint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is current_year."
              }
            },
            "required": [
              "mode",
              "as_of",
              "year_hint"
            ]
          },
          "academic_year_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional explicit academic year label such as 2026-2027学年."
          },
          "date_hint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional ISO date to resolve week, holiday, or makeup-class arrangement."
          },
          "query_kind": {
            "type": "string",
            "enum": [
              "date_week",
              "named_event_range",
              "day_status",
              "class_day_pattern",
              "term_window"
            ],
            "description": "Deterministic academic calendar fact query kind."
          },
          "event_query": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional named event query such as 春假 or 劳动节."
          },
          "target_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional ISO date being queried."
          },
          "audience": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional audience such as student or faculty."
          },
          "term_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional term label such as 春季学期."
          }
        },
        "required": [
          "query_text",
          "temporal_query",
          "academic_year_label",
          "date_hint",
          "query_kind",
          "event_query",
          "target_date",
          "audience",
          "term_label"
        ]
      }
    },
    {
      "type": "function",
      "name": "campus_notice_discover",
      "description": "Discover governed campus notices by topic, family, and target surface.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_text": {
            "type": "string",
            "description": "Original notice discovery question."
          },
          "temporal_query": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "current",
                  "latest",
                  "effective",
                  "as_of",
                  "current_year",
                  null
                ],
                "description": "Temporal query mode."
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is as_of."
              },
              "year_hint": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Required only when mode is current_year."
              }
            },
            "required": [
              "mode",
              "as_of",
              "year_hint"
            ]
          },
          "source_families": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "enum": [
                "official_web_public_notice",
                "internal_notice_restricted",
                "wechat_public_notice"
              ],
              "description": "Allowed notice source families."
            },
            "description": "Allowed notice source families."
          },
          "target_surfaces": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "enum": [
                "notice_level_query",
                "campus_services/service_status_candidate",
                "campus_services/special_service_candidate",
                "campus_services/stable_contact_candidate"
              ],
              "description": "Allowed notice target surfaces."
            },
            "description": "Allowed notice target surfaces."
          },
          "max_results": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Positive maximum number of notice cards.",
            "minimum": 1
          }
        },
        "required": [
          "query_text",
          "temporal_query",
          "source_families",
          "target_surfaces",
          "max_results"
        ]
      }
    }
  ]
}
