{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/campus-services-tool-result.v1.schema.json",
	"title": "campus-agent campus services tool result envelope",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"capability",
		"tool_name",
		"query_kind",
		"outcome",
		"facts",
		"source_refs",
		"projection_ref",
		"content_hash",
		"clarification_options"
	],
	"properties": {
		"schema_version": {
			"const": "campus_services_tool_result.v1"
		},
		"capability": {
			"const": "campus_services"
		},
		"tool_name": {
			"enum": ["transport_schedule_lookup"]
		},
		"query_kind": {
			"enum": ["transport_schedule"]
		},
		"outcome": {
			"enum": [
				"resolved_current",
				"resolved_historical_reference",
				"not_found",
				"temporarily_unverifiable",
				"clarification_required"
			]
		},
		"facts": {
			"$ref": "#/$defs/Facts"
		},
		"source_refs": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/SanitizedRef"
			}
		},
		"projection_ref": {
			"$ref": "#/$defs/SanitizedRef"
		},
		"content_hash": {
			"type": "string",
			"pattern": "^sha256:[0-9A-Za-z._:-]+$"
		},
		"clarification_options": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"fail_close_reason": {
			"type": "string",
			"enum": [
				"",
				"current_state_unverifiable",
				"source_truth_unavailable",
				"temporal_scope_ambiguous",
				"source_family_unavailable",
				"source_conflict"
			]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"outcome": {
						"enum": ["resolved_current", "resolved_historical_reference", "not_found"]
					}
				},
				"required": ["outcome"]
			},
			"then": {
				"properties": {
					"source_refs": {
						"minItems": 1
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"outcome": {
						"const": "temporarily_unverifiable"
					}
				},
				"required": ["outcome"]
			},
			"then": {
				"required": ["fail_close_reason"],
				"properties": {
					"fail_close_reason": {
						"not": {
							"const": ""
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": {
						"const": "transport_schedule_lookup"
					}
				},
				"required": ["tool_name"]
			},
			"then": {
				"properties": {
					"query_kind": {
						"const": "transport_schedule"
					},
					"facts": {
						"properties": {
							"kind": {
								"const": "schedule_facts"
							}
						}
					}
				}
			}
		}
	],
	"$defs": {
		"Facts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "result"],
			"properties": {
				"kind": {
					"enum": ["schedule_facts"]
				},
				"result": {
					"type": "object",
					"additionalProperties": true,
					"not": {
						"required": ["result_envelope"]
					}
				}
			}
		},
		"SanitizedRef": {
			"type": "string",
			"minLength": 1,
			"allOf": [
				{
					"not": {
						"pattern": "(?i)(raw_sql|raw_source|raw_html|source_html|object_locator|object_store_key|provider_raw_response|raw_provider|s3://|r2://|minio://)"
					}
				}
			]
		}
	}
}
