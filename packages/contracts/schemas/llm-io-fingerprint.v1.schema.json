{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/llm-io-fingerprint.v1.schema.json",
	"title": "campus-agent LLM IO fingerprint",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"run_id",
		"request_id",
		"trace_id",
		"runtime_release",
		"llm_call_site",
		"provider_profile_revision",
		"provider",
		"model",
		"model_params_hash",
		"model_params_projection",
		"prompt_id",
		"prompt_registry_attestation",
		"prompt_template_sha256",
		"prompt_variables_schema_version",
		"rendered_prompt_sha256",
		"provider_request_safe_hash",
		"tool_catalog_sha256",
		"tool_schema_sha256",
		"tool_runtime_fingerprint",
		"tool_runtime_attestation",
		"workflow_artifact_sha256",
		"context_envelope_sha256",
		"memory_selection_sha256",
		"evidence_packet_sha256",
		"output_schema_id",
		"primary_attestation"
	],
	"properties": {
		"schema_version": {
			"const": "llm_io_fingerprint.v1"
		},
		"run_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"request_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"trace_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"runtime_release": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"llm_call_site": {
			"const": "agent.primary"
		},
		"provider_profile_revision": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"provider": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"model": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"model_params_hash": {
			"$ref": "#/$defs/Sha256"
		},
		"model_params_projection": {
			"$ref": "#/$defs/ModelParamsProjection"
		},
		"prompt_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"prompt_registry_attestation": {
			"$ref": "#/$defs/PromptRegistryAttestation"
		},
		"prompt_template_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"prompt_variables_schema_version": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"rendered_prompt_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"provider_request_safe_hash": {
			"$ref": "#/$defs/ProviderRequestSafeHash"
		},
		"tool_catalog_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"tool_schema_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"tool_runtime_fingerprint": {
			"$ref": "#/$defs/ToolRuntimeFingerprint"
		},
		"tool_runtime_attestation": {
			"$ref": "#/$defs/ToolRuntimeAttestation"
		},
		"workflow_artifact_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"context_envelope_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"memory_selection_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"evidence_packet_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"output_schema_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"primary_attestation": {
			"$ref": "#/$defs/PrimaryAttestation"
		}
	},
	"$defs": {
		"NonEmptyString": {
			"type": "string",
			"minLength": 1
		},
		"Sha256": {
			"type": "string",
			"pattern": "^(sha256:)?[a-f0-9]{64}$"
		},
		"PromptRegistryAttestation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema_version",
				"prompt_registry_version",
				"prompt_id",
				"prompt_template_sha256",
				"prompt_variables_schema_version",
				"output_schema_id",
				"attestation_sha256"
			],
			"properties": {
				"schema_version": {
					"const": "prompt_registry_attestation.v1"
				},
				"prompt_registry_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"prompt_id": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"prompt_template_sha256": {
					"$ref": "#/$defs/Sha256"
				},
				"prompt_variables_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"output_schema_id": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"attestation_sha256": {
					"$ref": "#/$defs/Sha256"
				}
			}
		},
		"PrimaryAttestation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "attestation_kind", "attested_by", "attestation_sha256"],
			"properties": {
				"schema_version": {
					"const": "primary_attestation.v1"
				},
				"attestation_kind": {
					"const": "primary_agent_call"
				},
				"attested_by": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"attestation_sha256": {
					"$ref": "#/$defs/Sha256"
				}
			}
		},
		"ProviderRequestSafeHash": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "canonicalization", "redaction_policy", "request_sha256"],
			"properties": {
				"schema_version": {
					"const": "provider_request_safe_hash.v1"
				},
				"canonicalization": {
					"const": "canonical_json_redacted_v1"
				},
				"redaction_policy": {
					"const": "llm_provider_request_safe_projection.v1"
				},
				"request_sha256": {
					"$ref": "#/$defs/Sha256"
				}
			}
		},
		"ModelParamsProjection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "params_schema_version", "params_sha256", "projected_params"],
			"properties": {
				"schema_version": {
					"const": "model_params_projection.v1"
				},
				"params_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"params_sha256": {
					"$ref": "#/$defs/Sha256"
				},
				"projected_params": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"max_output_tokens": {
							"type": ["integer", "null"],
							"minimum": 1
						},
						"temperature": {
							"type": ["number", "null"],
							"minimum": 0,
							"maximum": 2
						},
						"top_p": {
							"type": ["number", "null"],
							"minimum": 0,
							"maximum": 1
						},
						"reasoning_effort": {
							"type": ["string", "null"],
							"enum": ["none", "minimal", "low", "medium", "high", "xhigh", null]
						},
						"response_format": {
							"type": ["string", "null"],
							"enum": ["text", "json_schema", "json_object", null]
						},
						"store": {
							"type": ["boolean", "null"]
						},
						"text_verbosity": {
							"type": ["string", "null"],
							"enum": ["low", "medium", "high", null]
						},
						"tool_choice": {
							"type": ["string", "null"],
							"enum": ["auto", "none", "required", "tool_name", null]
						}
					}
				}
			}
		},
		"ToolRuntimeFingerprint": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema_version",
				"tools_schema_version",
				"tools_registry_version",
				"tools_sha256",
				"function_schema_version",
				"function_schema_sha256",
				"workflow_artifact_schema_version",
				"workflow_artifact_registry_version",
				"workflow_artifact_sha256",
				"combined_sha256"
			],
			"properties": {
				"schema_version": {
					"const": "tool_runtime_fingerprint.v1"
				},
				"tools_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"tools_registry_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"tools_sha256": {
					"$ref": "#/$defs/Sha256"
				},
				"function_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"function_schema_sha256": {
					"$ref": "#/$defs/Sha256"
				},
				"workflow_artifact_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"workflow_artifact_registry_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"workflow_artifact_sha256": {
					"$ref": "#/$defs/Sha256"
				},
				"combined_sha256": {
					"$ref": "#/$defs/Sha256"
				}
			}
		},
		"ToolRuntimeAttestation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"schema_version",
				"attested_by",
				"config_refs",
				"tools_registry_version",
				"function_schema_version",
				"workflow_artifact_registry_version",
				"combined_sha256"
			],
			"properties": {
				"schema_version": {
					"const": "tool_runtime_attestation.v1"
				},
				"attested_by": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"config_refs": {
					"type": "array",
					"minItems": 3,
					"maxItems": 3,
					"uniqueItems": true,
					"items": {
						"enum": [
							"configs/runtime/tools.v4.json",
							"configs/runtime/tool-function-schemas.v1.json",
							"configs/runtime/workflow-artifacts.v2.json"
						]
					},
					"allOf": [
						{
							"contains": {
								"const": "configs/runtime/tools.v4.json"
							}
						},
						{
							"contains": {
								"const": "configs/runtime/tool-function-schemas.v1.json"
							}
						},
						{
							"contains": {
								"const": "configs/runtime/workflow-artifacts.v2.json"
							}
						}
					]
				},
				"tools_registry_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"function_schema_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"workflow_artifact_registry_version": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"combined_sha256": {
					"$ref": "#/$defs/Sha256"
				}
			}
		}
	}
}
