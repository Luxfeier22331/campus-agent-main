{
	"$id": "https://muc.wiki/campus-agent/schemas/public-web-tool-contracts.v1.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "campus-agent public web search tool contracts",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"payload": {
			"$ref": "#/$defs/PublicWebSearchPayload"
		},
		"result": {
			"$ref": "#/$defs/PublicWebSearchResult"
		}
	},
	"$defs": {
		"PublicWebSearchPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query_text", "max_results"],
			"properties": {
				"query_text": {
					"type": "string",
					"minLength": 1
				},
				"max_results": {
					"type": ["integer", "null"],
					"minimum": 1,
					"maximum": 5
				}
			}
		},
		"PublicWebSearchResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["result_kind", "query_text", "provider", "model", "sources"],
			"properties": {
				"result_kind": {
					"const": "public_web_evidence"
				},
				"query_text": {
					"type": "string",
					"minLength": 1
				},
				"provider": {
					"type": "string",
					"minLength": 1
				},
				"model": {
					"type": "string",
					"minLength": 1
				},
				"sources": {
					"type": "array",
					"minItems": 1,
					"maxItems": 5,
					"items": {
						"$ref": "#/$defs/PublicWebSource"
					}
				}
			}
		},
		"PublicWebSource": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"source_kind",
				"target_kind",
				"title",
				"url",
				"snippet",
				"publisher_label",
				"evidence_id",
				"content_hash"
			],
			"properties": {
				"source_kind": {
					"const": "public_web"
				},
				"target_kind": {
					"const": "public_web_url"
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"url": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://(?!(?:my\\.muc\\.edu\\.cn)(?:[/?#]|$))(?:[a-z0-9-]+\\.)*muc\\.edu\\.cn(?:[/?#].*)?$"
				},
				"snippet": {
					"type": "string",
					"minLength": 1
				},
				"publisher_label": {
					"type": ["string", "null"]
				},
				"evidence_id": {
					"type": "string",
					"minLength": 1
				},
				"content_hash": {
					"type": ["string", "null"]
				}
			}
		}
	}
}
