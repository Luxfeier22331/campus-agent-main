{
  "$id": "https://muc.wiki/campus-agent/schemas/agent-handoff.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campus-agent agent handoff schemas",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_request": {
      "$ref": "#/$defs/AgentRequest"
    },
    "agent_response": {
      "$ref": "#/$defs/AgentResponse"
    }
  },
  "$defs": {
    "AgentTarget": {
      "type": "string",
      "enum": [
        "rag-agent",
        "navigation-agent",
        "campus-services-agent",
        "notice-agent"
      ]
    },
    "DelegateStatus": {
      "type": "string",
      "enum": [
        "completed",
        "needs_clarification",
        "no_answer",
        "error"
      ]
    },
    "ConfidenceLevel": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "SafeObject": {
      "type": "object",
      "additionalProperties": true
    },
    "TraceContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        }
      }
    },
    "ActorContext": {
      "type": "object",
      "additionalProperties": true
    },
    "ErrorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "AgentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "user_goal",
        "payload",
        "allowed_tools"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/AgentTarget"
        },
        "user_goal": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "safety_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        },
        "actor": {
          "$ref": "#/$defs/ActorContext"
        },
        "context": {
          "$ref": "#/$defs/SafeObject"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "payload"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/SafeObject"
            }
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "AgentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "status"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/AgentTarget"
        },
        "status": {
          "$ref": "#/$defs/DelegateStatus"
        },
        "answer_text": {
          "type": "string"
        },
        "follow_up_question": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_observability": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
