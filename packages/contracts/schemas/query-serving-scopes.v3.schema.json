{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/query-serving-scopes.v3.schema.json",
	"title": "campus-agent query-serving scope registry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "scopes"],
	"properties": {
		"schema_version": {
			"const": "query-serving-scopes-v3"
		},
		"scopes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/scope"
			}
		}
	},
	"$defs": {
		"scope": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scope", "description", "corpus", "collection", "allowed_version_modes"],
			"properties": {
				"scope": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"minLength": 1
				},
				"corpus": {
					"type": "string",
					"minLength": 1
				},
				"collection": {
					"type": "string",
					"minLength": 1
				},
				"allowed_version_modes": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": ["current", "historical", "as_of", "compare"]
					}
				}
			}
		}
	}
}
