{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/raw-capture-policy.v1.schema.json",
	"title": "campus-agent raw capture policy",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"mode",
		"capture_reason",
		"ttl_days",
		"allowed_sinks",
		"allowed_raw_fields",
		"audit_required",
		"dsar_delete_linkage_required"
	],
	"properties": {
		"schema_version": {
			"const": "raw_capture_policy.v1"
		},
		"mode": {
			"enum": [
				"off",
				"sampled",
				"failure_triggered",
				"operator_window",
				"eval_case",
				"manual_run_capture"
			]
		},
		"capture_reason": {
			"type": "string",
			"minLength": 1
		},
		"ttl_days": {
			"type": "integer",
			"minimum": 0
		},
		"allowed_sinks": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"enum": ["s3_replay_packet", "langfuse_otlp", "openai_agents_trace"]
			}
		},
		"allowed_raw_fields": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/AllowedRawField"
			}
		},
		"operator_principal": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"approval_ref": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"request_id": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"run_id": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"trace_id": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"audit_required": {
			"type": "boolean"
		},
		"dsar_delete_linkage_required": {
			"type": "boolean"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"mode": {
						"const": "off"
					}
				},
				"required": ["mode"]
			},
			"then": {
				"properties": {
					"ttl_days": {
						"const": 0
					},
					"allowed_sinks": {
						"maxItems": 0
					},
					"allowed_raw_fields": {
						"maxItems": 0
					},
					"operator_principal": {
						"type": "null"
					},
					"approval_ref": {
						"type": "null"
					},
					"request_id": {
						"type": "null"
					},
					"run_id": {
						"type": "null"
					},
					"trace_id": {
						"type": "null"
					},
					"audit_required": {
						"const": false
					},
					"dsar_delete_linkage_required": {
						"const": false
					}
				}
			},
			"else": {
				"required": ["operator_principal", "approval_ref", "request_id", "run_id", "trace_id"],
				"properties": {
					"ttl_days": {
						"type": "integer",
						"minimum": 1
					},
					"allowed_sinks": {
						"minItems": 1
					},
					"allowed_raw_fields": {
						"minItems": 1
					},
					"operator_principal": {
						"type": "string",
						"minLength": 1
					},
					"approval_ref": {
						"type": "string",
						"minLength": 1
					},
					"request_id": {
						"type": "string",
						"minLength": 1
					},
					"run_id": {
						"type": "string",
						"minLength": 1
					},
					"trace_id": {
						"type": "string",
						"minLength": 1
					},
					"audit_required": {
						"const": true
					},
					"dsar_delete_linkage_required": {
						"const": true
					}
				}
			}
		}
	],
	"$defs": {
		"AllowedRawField": {
			"enum": [
				"rendered_messages",
				"provider_request_body",
				"provider_response_body",
				"provider_stream_deltas",
				"tool_calls",
				"tool_results",
				"selected_evidence_packet",
				"selected_memory_context",
				"output_schema"
			]
		}
	}
}
