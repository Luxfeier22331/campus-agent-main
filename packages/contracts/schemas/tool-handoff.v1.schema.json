{
	"$id": "https://muc.wiki/campus-agent/schemas/tool-handoff.v1.schema.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "campus-agent tool handoff schemas",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"tool_request": {
			"$ref": "#/$defs/ToolRequest"
		},
		"tool_response": {
			"$ref": "#/$defs/ToolResponse"
		}
	},
	"$defs": {
		"ToolID": {
			"type": "string",
			"enum": [
				"knowledge_query",
				"place_lookup",
				"transport_schedule_lookup",
				"campus_notice_discover",
				"campus_notice_change_set_lookup",
				"campus_notice_period_summary",
				"campus_notice_get"
			]
		},
		"ModelVisibleToolName": {
			"type": "string",
			"enum": ["knowledge_query", "transport_schedule_lookup", "campus_notice_discover"]
		},
		"DelegateStatus": {
			"type": "string",
			"enum": ["completed", "needs_clarification", "no_answer", "error"]
		},
		"ConfidenceLevel": {
			"type": "string",
			"enum": ["high", "medium", "low"]
		},
		"SafeObject": {
			"type": "object",
			"additionalProperties": true
		},
		"TraceContext": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"trace_id": {
					"type": "string"
				}
			}
		},
		"ActorContext": {
			"type": "object",
			"additionalProperties": true
		},
		"ErrorInfo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["code", "message"],
			"properties": {
				"code": {
					"type": "string"
				},
				"message": {
					"type": "string"
				},
				"retryable": {
					"type": "boolean"
				}
			}
		},
		"ToolRequest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tool", "user_goal", "payload", "allowed_tools"],
			"properties": {
				"tool": {
					"$ref": "#/$defs/ToolID"
				},
				"user_goal": {
					"type": "string"
				},
				"conversation_id": {
					"type": "string"
				},
				"request_id": {
					"type": "string"
				},
				"safety_identifier": {
					"type": ["string", "null"]
				},
				"trace": {
					"$ref": "#/$defs/TraceContext"
				},
				"actor": {
					"$ref": "#/$defs/ActorContext"
				},
				"context": {
					"$ref": "#/$defs/SafeObject"
				},
				"payload": {
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "payload"],
					"properties": {
						"kind": {
							"type": "string"
						},
						"payload": {
							"$ref": "#/$defs/SafeObject"
						}
					}
				},
				"allowed_tools": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ModelVisibleToolName"
					}
				}
			}
		},
		"ToolResponse": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tool", "status"],
			"properties": {
				"tool": {
					"$ref": "#/$defs/ToolID"
				},
				"status": {
					"$ref": "#/$defs/DelegateStatus"
				},
				"answer_text": {
					"type": "string"
				},
				"follow_up_question": {
					"type": "string"
				},
				"confidence": {
					"$ref": "#/$defs/ConfidenceLevel"
				},
				"result": {
					"type": ["object", "null"],
					"additionalProperties": true
				},
				"error": {
					"oneOf": [
						{
							"$ref": "#/$defs/ErrorInfo"
						},
						{
							"type": "null"
						}
					]
				},
				"tool_observability": {
					"type": ["object", "null"],
					"additionalProperties": true
				}
			}
		}
	}
}
