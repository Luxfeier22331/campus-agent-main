{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/execution-control-runtime-config.v1.schema.json",
	"title": "campus-agent execution-control runtime config",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"max_concurrent_answers",
		"queue_capacity",
		"queue_timeout_ms",
		"request_timeout_ms",
		"request_body_limit_bytes",
		"shutdown_grace_ms",
		"query_serving_scopes_path",
		"tool_read_model_timeout_ms",
		"otel",
		"knowledge_search",
		"personal_memory"
	],
	"properties": {
		"schema_version": {
			"const": "campus_execution_control_runtime_config.v1"
		},
		"max_concurrent_answers": {
			"type": "integer",
			"minimum": 1
		},
		"queue_capacity": {
			"type": "integer",
			"minimum": 0
		},
		"queue_timeout_ms": {
			"type": "integer",
			"minimum": 1
		},
		"request_timeout_ms": {
			"type": "integer",
			"minimum": 1
		},
		"request_body_limit_bytes": {
			"type": "integer",
			"minimum": 1
		},
		"shutdown_grace_ms": {
			"type": "integer",
			"minimum": 1
		},
		"query_serving_scopes_path": {
			"type": "string",
			"minLength": 1
		},
		"tool_read_model_timeout_ms": {
			"type": "integer",
			"minimum": 1
		},
		"otel": {
			"$ref": "#/$defs/OTel"
		},
		"knowledge_search": {
			"$ref": "#/$defs/KnowledgeSearch"
		},
		"personal_memory": {
			"$ref": "#/$defs/PersonalMemory"
		},
		"worker_profiles": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"workflow": {
					"$ref": "#/$defs/WorkerProfile"
				},
				"activity-core": {
					"$ref": "#/$defs/WorkerProfile"
				},
				"activity-agent": {
					"$ref": "#/$defs/WorkerProfile"
				}
			}
		}
	},
	"$defs": {
		"OTel": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"endpoint",
				"metrics_enabled",
				"metrics_endpoint",
				"service_name",
				"export_timeout_ms",
				"export_interval_ms",
				"sample_ratio",
				"allowed_attributes_version",
				"temporal_tracing_enabled"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"endpoint": {
					"type": "string",
					"minLength": 1
				},
				"metrics_enabled": {
					"type": "boolean"
				},
				"metrics_endpoint": {
					"type": "string",
					"minLength": 1
				},
				"headers": {
					"type": "string"
				},
				"service_name": {
					"type": "string",
					"minLength": 1
				},
				"export_timeout_ms": {
					"type": "integer",
					"minimum": 1
				},
				"export_interval_ms": {
					"type": "integer",
					"minimum": 1
				},
				"sample_ratio": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"allowed_attributes_version": {
					"type": "string",
					"minLength": 1
				},
				"temporal_tracing_enabled": {
					"type": "boolean"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"temporal_tracing_enabled": {
								"const": true
							}
						},
						"required": ["temporal_tracing_enabled"]
					},
					"then": {
						"properties": {
							"enabled": {
								"const": true
							}
						}
					}
				}
			]
		},
		"KnowledgeSearch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["top_k_max", "embedding_timeout_ms", "qdrant_timeout_ms"],
			"properties": {
				"top_k_max": {
					"type": "integer",
					"minimum": 1
				},
				"embedding_timeout_ms": {
					"type": "integer",
					"minimum": 1
				},
				"qdrant_timeout_ms": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"PersonalMemory": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"runtime",
				"timeout_seconds",
				"recall_limit",
				"recall_max_tokens",
				"context_char_budget"
			],
			"properties": {
				"runtime": {
					"const": "hindsight"
				},
				"timeout_seconds": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"recall_limit": {
					"type": "integer",
					"minimum": 1
				},
				"recall_max_tokens": {
					"type": "integer",
					"minimum": 1
				},
				"context_char_budget": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"WorkerProfile": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"activity_slots": {
					"type": "integer",
					"minimum": 1
				},
				"activity_task_pollers": {
					"type": "integer",
					"minimum": 0
				},
				"task_queue_activities_per_second": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"worker_activities_per_second": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"workflow_task_slots": {
					"type": "integer",
					"minimum": 1
				},
				"workflow_task_pollers": {
					"type": "integer",
					"minimum": 0
				}
			}
		}
	}
}
