{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/query-serving-scopes.v1.schema.json",
	"title": "campus-agent query serving scope policy",
	"type": "object",
	"additionalProperties": false,
	"required": ["policy_version", "scopes"],
	"properties": {
		"policy_version": {
			"const": "query-serving-scopes-v1"
		},
		"scopes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["corpus", "collection"],
				"properties": {
					"corpus": {
						"type": "string",
						"minLength": 1
					},
					"collection": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		}
	}
}
