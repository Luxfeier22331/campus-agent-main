{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/env-surface-policy.v1.schema.json",
	"title": "campus-agent environment surface policy",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"allowed_templates",
		"template_key_limits",
		"keys",
		"allowed_prefixes",
		"retired_scan_paths"
	],
	"properties": {
		"schema_version": {
			"const": "campus_env_surface_policy.v1"
		},
		"allowed_templates": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"template_key_limits": {
			"type": "object",
			"additionalProperties": {
				"type": "integer",
				"minimum": 1
			}
		},
		"keys": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/EnvKey"
			}
		},
		"allowed_prefixes": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/StringList"
			}
		},
		"retired_scan_paths": {
			"$ref": "#/$defs/StringList"
		}
	},
	"$defs": {
		"StringList": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"EnvKey": {
			"type": "object",
			"additionalProperties": false,
			"required": ["owner", "scopes", "secret"],
			"properties": {
				"owner": {
					"type": "string",
					"minLength": 1
				},
				"scopes": {
					"$ref": "#/$defs/StringList"
				},
				"secret": {
					"type": "boolean"
				},
				"retired": {
					"type": "boolean"
				}
			}
		}
	}
}
