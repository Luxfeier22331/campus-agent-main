{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/runtime-workflow-artifacts.v2.schema.json",
	"title": "campus-agent runtime workflow artifact registry",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"registry_version",
		"visibility_values",
		"support_status_values",
		"forbidden_raw_key_tokens",
		"artifacts",
		"bindings"
	],
	"properties": {
		"schema_version": {
			"const": "workflow-artifact-registry-v2"
		},
		"registry_version": {
			"type": "string",
			"minLength": 1
		},
		"visibility_values": {
			"type": "array",
			"minItems": 1,
			"items": {
				"enum": ["tool_private", "operator_safe_summary", "finalizer_input"]
			}
		},
		"support_status_values": {
			"type": "array",
			"minItems": 1,
			"items": {
				"enum": ["supported_go_runtime", "contract_only", "planned_contract_gap"]
			}
		},
		"forbidden_raw_key_tokens": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"artifacts": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/Artifact"
			}
		},
		"bindings": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/Binding"
			}
		}
	},
	"$defs": {
		"Artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"display_name",
				"owner_tool_boundary",
				"producer_tools",
				"source_truth_owner",
				"visibility",
				"current_projection_support",
				"answer_eligible",
				"freshness_policy",
				"allowed_consumers",
				"forbidden_raw_payload_keys",
				"notes"
			],
			"properties": {
				"kind": {
					"type": "string",
					"minLength": 1
				},
				"display_name": {
					"type": "string",
					"minLength": 1
				},
				"owner_tool_boundary": {
					"enum": [
						"knowledge_query",
						"place_lookup",
						"transport_schedule_lookup",
						"campus_notice_discover",
						"campus_notice_change_set_lookup",
						"campus_notice_period_summary",
						"campus_notice_get",
						"public_web_search",
						"execution-control"
					]
				},
				"producer_tools": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"source_truth_owner": {
					"type": "string",
					"minLength": 1
				},
				"visibility": {
					"enum": ["tool_private", "operator_safe_summary", "finalizer_input"]
				},
				"current_projection_support": {
					"enum": ["supported_go_runtime", "contract_only", "planned_contract_gap"]
				},
				"answer_eligible": {
					"type": "boolean"
				},
				"requires_grounding": {
					"type": "boolean"
				},
				"freshness_policy": {
					"type": "string",
					"minLength": 1
				},
				"allowed_consumers": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"known_aliases": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"forbidden_raw_payload_keys": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"notes": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"Binding": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"binding_id",
				"owner_tool_boundary",
				"tool_name",
				"produces",
				"consumes",
				"required_inputs",
				"state_changing",
				"opening_gate",
				"eval_denominator",
				"priority",
				"notes"
			],
			"properties": {
				"binding_id": {
					"type": "string",
					"minLength": 1
				},
				"owner_tool_boundary": {
					"enum": [
						"knowledge_query",
						"place_lookup",
						"transport_schedule_lookup",
						"campus_notice_discover",
						"campus_notice_change_set_lookup",
						"campus_notice_period_summary",
						"campus_notice_get",
						"public_web_search"
					]
				},
				"tool_name": {
					"type": "string"
				},
				"produces": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"consumes": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"required_inputs": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"pattern": "^(request|artifact):"
					}
				},
				"state_changing": {
					"type": "boolean"
				},
				"opening_gate": {
					"enum": ["open", "closed"]
				},
				"eval_denominator": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"priority": {
					"type": "integer",
					"minimum": 1
				},
				"notes": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	}
}
