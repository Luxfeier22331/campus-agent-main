{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/runtime-tools.v3.schema.json",
	"title": "campus-agent execution-control tool spec registry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "registry_version", "tools"],
	"properties": {
		"schema_version": {
			"const": "tool-spec-registry-v3"
		},
		"registry_version": {
			"type": "string",
			"minLength": 1
		},
		"tools": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/Tool"
			}
		}
	},
	"$defs": {
		"Tool": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name",
				"owner_capability",
				"capability",
				"payload_kind",
				"payload_schema_ref",
				"result_schema_ref",
				"backend",
				"surface",
				"read_only",
				"active",
				"function_schema",
				"runtime_posture",
				"description"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"owner_capability": {
					"enum": ["knowledge", "navigation", "campus_services", "notice"]
				},
				"capability": {
					"enum": ["knowledge", "navigation", "campus_services", "notice"]
				},
				"payload_kind": {
					"type": "string",
					"minLength": 1
				},
				"payload_schema_ref": {
					"type": "string",
					"pattern": "^https://muc\\.wiki/campus-agent/schemas/[A-Za-z0-9.-]+\\.schema\\.json#/\\$defs/[A-Za-z0-9_]+$"
				},
				"result_schema_ref": {
					"type": "string",
					"pattern": "^https://muc\\.wiki/campus-agent/schemas/[A-Za-z0-9.-]+\\.schema\\.json#/\\$defs/[A-Za-z0-9_]+$"
				},
				"backend": {
					"enum": [
						"internal_structured_query_service",
						"execution_control_rag_runtime",
						"retrieval_core"
					]
				},
				"surface": {
					"enum": ["structured_handoff", "capability_internal"]
				},
				"read_only": {
					"type": "boolean"
				},
				"active": {
					"type": "boolean"
				},
				"function_schema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["available", "strict"],
					"properties": {
						"available": {
							"type": "boolean"
						},
						"strict": {
							"type": "boolean"
						}
					}
				},
				"runtime_posture": {
					"enum": [
						"closed",
						"typed_handoff_only",
						"typed_activity_admitted",
						"capability_internal_admitted",
						"internal_function"
					]
				},
				"description": {
					"type": "string",
					"minLength": 1
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"active": {
								"const": true
							}
						},
						"required": ["active"]
					},
					"then": {
						"properties": {
							"read_only": {
								"const": true
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"surface": {
								"const": "structured_handoff"
							}
						},
						"required": ["surface"]
					},
					"then": {
						"properties": {
							"backend": {
								"const": "internal_structured_query_service"
							},
							"function_schema": {
								"properties": {
									"available": {
										"const": true
									},
									"strict": {
										"const": true
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"runtime_posture": {
								"const": "typed_activity_admitted"
							}
						},
						"required": ["runtime_posture"]
					},
					"then": {
						"properties": {
							"function_schema": {
								"properties": {
									"available": {
										"const": true
									},
									"strict": {
										"const": true
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"runtime_posture": {
								"const": "internal_function"
							}
						},
						"required": ["runtime_posture"]
					},
					"then": {
						"properties": {
							"surface": {
								"const": "capability_internal"
							},
							"function_schema": {
								"properties": {
									"available": {
										"const": false
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"runtime_posture": {
								"const": "capability_internal_admitted"
							}
						},
						"required": ["runtime_posture"]
					},
					"then": {
						"properties": {
							"surface": {
								"const": "capability_internal"
							},
							"function_schema": {
								"properties": {
									"available": {
										"const": true
									},
									"strict": {
										"const": true
									}
								}
							}
						}
					}
				}
			]
		}
	}
}
