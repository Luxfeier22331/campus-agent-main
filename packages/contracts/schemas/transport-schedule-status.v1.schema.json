{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/transport-schedule-status.v1.schema.json",
	"title": "campus-agent transport schedule status projection",
	"type": "object",
	"additionalProperties": false,
	"required": ["release", "groups"],
	"properties": {
		"release": {
			"type": "object",
			"additionalProperties": false,
			"required": ["releaseId", "publishedAt", "sourceRefs"],
			"properties": {
				"releaseId": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"publishedAt": {
					"type": "string",
					"format": "date-time"
				},
				"sourceRefs": {
					"$ref": "#/$defs/SourceRefs"
				}
			}
		},
		"groups": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/Group"
			}
		}
	},
	"$defs": {
		"NonEmptyString": {
			"type": "string",
			"minLength": 1,
			"pattern": "\\S"
		},
		"SourceRefs": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/HttpUrl"
			}
		},
		"HttpUrl": {
			"type": "string",
			"format": "uri",
			"pattern": "^https?://"
		},
		"Group": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "routes"],
			"properties": {
				"kind": {
					"enum": ["daily", "weekday", "weekend_holiday", "temporary"]
				},
				"routes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Route"
					}
				}
			}
		},
		"Route": {
			"type": "object",
			"additionalProperties": false,
			"required": ["routeId", "displayName", "departures"],
			"properties": {
				"routeId": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"displayName": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"departures": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Departure"
					}
				}
			}
		},
		"Departure": {
			"type": "object",
			"additionalProperties": false,
			"required": ["departureTime", "kind", "status", "sourceRefs"],
			"properties": {
				"serviceDate": {
					"type": "string",
					"format": "date"
				},
				"departureTime": {
					"type": "string",
					"pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
				},
				"kind": {
					"enum": ["student", "teacher", "other"]
				},
				"status": {
					"enum": ["normal", "added", "cancelled", "changed", "delayed"]
				},
				"note": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"sourceRefs": {
					"$ref": "#/$defs/SourceRefs"
				}
			}
		}
	}
}
