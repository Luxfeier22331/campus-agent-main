{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/query-serving-scopes.v2.schema.json",
	"title": "campus-agent query serving scope policy",
	"type": "object",
	"additionalProperties": false,
	"required": ["policy_version", "default_open", "intent_scoped"],
	"properties": {
		"policy_version": {
			"const": "query-serving-scopes-v2"
		},
		"default_open": {
			"$ref": "#/$defs/scope_policy_array"
		},
		"intent_scoped": {
			"$ref": "#/$defs/scope_policy_array"
		}
	},
	"$defs": {
		"query_mode": {
			"type": "string",
			"enum": ["current", "historical", "as_of", "compare", "freshness_sensitive", "live_assisted"]
		},
		"scope_policy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "collection", "allowed_query_modes"],
			"properties": {
				"corpus": {
					"type": "string",
					"minLength": 1
				},
				"collection": {
					"type": "string",
					"minLength": 1
				},
				"allowed_query_modes": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/query_mode"
					},
					"uniqueItems": true
				},
				"admission_intents": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"freshness_intents": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			}
		},
		"scope_policy_array": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/scope_policy"
			}
		}
	}
}
