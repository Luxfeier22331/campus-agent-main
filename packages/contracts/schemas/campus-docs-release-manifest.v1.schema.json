{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/campus-docs-release-manifest.v1.schema.json",
	"title": "campus docs release manifest",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"surface",
		"projection",
		"entries",
		"searchUnits",
		"sourceReleaseRefs"
	],
	"properties": {
		"schemaVersion": { "const": "campus_docs_release_manifest.v1" },
		"surface": { "const": "campus_docs" },
		"projection": { "$ref": "#/$defs/ObjectRef" },
		"entries": { "type": "array", "items": { "$ref": "#/$defs/Entry" } },
		"searchUnits": { "type": "array", "items": { "$ref": "#/$defs/SearchUnit" } },
		"sourceReleaseRefs": { "type": "array", "items": { "$ref": "#/$defs/ObjectRef" } }
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"Sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
		"StringMap": {
			"type": "object",
			"required": ["reader", "outline", "meta", "asset-manifest"],
			"properties": {
				"reader": { "$ref": "#/$defs/NonEmptyString" },
				"outline": { "$ref": "#/$defs/NonEmptyString" },
				"meta": { "$ref": "#/$defs/NonEmptyString" },
				"asset-manifest": { "$ref": "#/$defs/NonEmptyString" }
			},
			"additionalProperties": { "$ref": "#/$defs/NonEmptyString" }
		},
		"ObjectRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["key", "sha256", "byteSize"],
			"properties": {
				"key": { "$ref": "#/$defs/NonEmptyString" },
				"sha256": { "$ref": "#/$defs/Sha256" },
				"byteSize": { "type": "integer", "minimum": 1 }
			}
		},
		"Entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"corpus",
				"collection",
				"deliveryMode",
				"docId",
				"documentSlug",
				"sourceObjects",
				"targetObjects",
				"title",
				"isCurrent",
				"versionLabel",
				"versionId",
				"versionSlug"
			],
			"properties": {
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"collection": { "$ref": "#/$defs/NonEmptyString" },
				"deliveryMode": { "enum": ["public_static_asset", "gated_asset"] },
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"documentSlug": { "$ref": "#/$defs/NonEmptyString" },
				"sourceObjects": { "$ref": "#/$defs/StringMap" },
				"targetObjects": { "$ref": "#/$defs/StringMap" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"isCurrent": { "type": "boolean" },
				"versionLabel": { "$ref": "#/$defs/NonEmptyString" },
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"versionSlug": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"SearchUnit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"anchor",
				"canonicalUrl",
				"collection",
				"corpus",
				"docId",
				"documentSlug",
				"documentTitle",
				"highlightRootUnitIds",
				"searchUnitId",
				"snippet",
				"title",
				"versionId",
				"versionSlug"
			],
			"properties": {
				"anchor": { "$ref": "#/$defs/NonEmptyString" },
				"canonicalUrl": { "$ref": "#/$defs/NonEmptyString" },
				"collection": { "$ref": "#/$defs/NonEmptyString" },
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"documentSlug": { "$ref": "#/$defs/NonEmptyString" },
				"documentTitle": { "$ref": "#/$defs/NonEmptyString" },
				"highlightRootUnitIds": {
					"type": "array",
					"items": { "$ref": "#/$defs/NonEmptyString" },
					"uniqueItems": true
				},
				"searchUnitId": { "$ref": "#/$defs/NonEmptyString" },
				"snippet": { "type": "string" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"versionSlug": { "$ref": "#/$defs/NonEmptyString" }
			}
		}
	}
}
