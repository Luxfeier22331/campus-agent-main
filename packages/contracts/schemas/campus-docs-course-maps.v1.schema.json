{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/campus-docs-course-maps.v1.schema.json",
	"title": "校园文档课程地图",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "docId", "versionId", "maps"],
	"properties": {
		"schemaVersion": { "const": "campus_docs_course_maps.v1" },
		"docId": { "$ref": "#/$defs/NonEmptyString" },
		"versionId": { "$ref": "#/$defs/NonEmptyString" },
		"maps": {
			"type": "array",
			"items": { "$ref": "#/$defs/CourseMap" }
		}
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"RelativePath": {
			"type": "string",
			"minLength": 1,
			"pattern": "^(?!/)(?!.*\\\\)(?!.*[?#])(?!.*(?:^|/)\\.\\.(?:/|$)).+"
		},
		"CourseMap": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mapId", "targetRootUnitId", "title", "parts"],
			"properties": {
				"mapId": { "$ref": "#/$defs/NonEmptyString" },
				"targetRootUnitId": { "$ref": "#/$defs/NonEmptyString" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"parts": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/CourseMapPart" }
				}
			}
		},
		"CourseMapPart": {
			"type": "object",
			"additionalProperties": false,
			"required": ["partId", "imagePath", "width", "height"],
			"properties": {
				"partId": { "$ref": "#/$defs/NonEmptyString" },
				"imagePath": { "$ref": "#/$defs/RelativePath" },
				"width": { "type": "integer", "minimum": 1 },
				"height": { "type": "integer", "minimum": 1 }
			}
		}
	}
}
