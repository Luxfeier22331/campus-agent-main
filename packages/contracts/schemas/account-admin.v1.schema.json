{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"anyOf": [
		{
			"$ref": "#/$defs/userPage"
		},
		{
			"$ref": "#/$defs/userDetail"
		},
		{
			"$ref": "#/$defs/eventPage"
		},
		{
			"$ref": "#/$defs/temporaryPassword"
		},
		{
			"$ref": "#/$defs/reasonCommand"
		},
		{
			"$ref": "#/$defs/emptyCommand"
		},
		{
			"$ref": "#/$defs/userQuery"
		},
		{
			"$ref": "#/$defs/eventQuery"
		}
	],
	"$defs": {
		"userPage": {
			"type": "object",
			"properties": {
				"items": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/userSummary"
					}
				},
				"nextCursor": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["items", "nextCursor"],
			"additionalProperties": false
		},
		"userSummary": {
			"type": "object",
			"properties": {
				"accessSource": {
					"anyOf": [
						{
							"type": "string",
							"enum": ["campus_email", "email_grant"]
						},
						{
							"type": "null"
						}
					]
				},
				"accessState": {
					"type": "string",
					"enum": ["allowed", "denied"]
				},
				"activeSessionCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"createdAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
				},
				"email": {
					"type": "string",
					"format": "email",
					"pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
				},
				"emailVerified": {
					"type": "boolean"
				},
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string"
				},
				"state": {
					"$ref": "#/$defs/state"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
				}
			},
			"required": [
				"accessSource",
				"accessState",
				"activeSessionCount",
				"createdAt",
				"email",
				"emailVerified",
				"id",
				"name",
				"state",
				"updatedAt"
			],
			"additionalProperties": false
		},
		"state": {
			"type": "string",
			"enum": ["active", "unverified", "banned", "password_change_required", "deleting"]
		},
		"userDetail": {
