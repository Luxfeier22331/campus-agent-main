				},
				"emailVerified": {
					"type": "boolean"
				},
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string"
				},
				"state": {
					"$ref": "#/$defs/state"
				},
				"updatedAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
				},
				"banReason": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"credentialAccount": {
					"type": "boolean"
				},
				"deletion": {
					"anyOf": [
						{
							"$ref": "#/$defs/deletion"
						},
						{
							"type": "null"
						}
					]
				},
				"events": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/event"
					}
				},
				"passwordChangeRequired": {
					"type": "boolean"
				},
				"sessions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/session"
					}
				},
				"temporaryPasswordExpiresAt": {
					"anyOf": [
						{
							"type": "string",
							"format": "date-time",
							"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"accessSource",
				"accessState",
				"activeSessionCount",
				"createdAt",
				"email",
				"emailVerified",
				"id",
				"name",
				"state",
				"updatedAt",
				"banReason",
				"credentialAccount",
				"deletion",
				"events",
				"passwordChangeRequired",
				"sessions",
				"temporaryPasswordExpiresAt"
			],
			"additionalProperties": false
		},
		"deletion": {
			"type": "object",
			"properties": {
				"attemptCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
