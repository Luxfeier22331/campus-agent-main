{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/query-serving-targets.v1.schema.json",
	"title": "campus-agent query-serving target registry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "targets"],
	"properties": {
		"schema_version": { "const": "query-serving-targets-v1" },
		"targets": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/Target" }
		}
	},
	"$defs": {
		"Target": {
			"type": "object",
			"additionalProperties": false,
			"required": ["target", "collection", "description", "serving_config_path", "retrieval_top_k"],
			"properties": {
				"target": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
				"collection": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[a-z][a-z0-9_]*$"
				},
				"description": { "type": "string", "minLength": 1 },
				"serving_config_path": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[a-z0-9_/-]+/serving-config\\.json$"
				},
				"retrieval_top_k": { "type": "integer", "minimum": 1, "maximum": 20 }
			}
		}
	}
}
