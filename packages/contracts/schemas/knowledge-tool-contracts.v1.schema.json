{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v1.schema.json",
	"title": "campus-agent knowledge agent tool contracts",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "tool_name", "packet_kind"],
	"properties": {
		"schema_version": {
			"const": "knowledge_tool_contracts.v1"
		},
		"tool_name": {
			"enum": ["knowledge_query", "knowledge_search"]
		},
		"packet_kind": {
			"enum": ["payload", "result"]
		},
		"payload": {
			"type": "object"
		},
		"result": {
			"type": "object"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"packet_kind": {
						"const": "payload"
					}
				},
				"required": ["packet_kind"]
			},
			"then": {
				"required": ["payload"],
				"not": {
					"required": ["result"]
				}
			}
		},
		{
			"if": {
				"properties": {
					"packet_kind": {
						"const": "result"
					}
				},
				"required": ["packet_kind"]
			},
			"then": {
				"required": ["result"],
				"not": {
					"required": ["payload"]
				}
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": {
						"const": "knowledge_query"
					},
					"packet_kind": {
						"const": "payload"
					}
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": {
				"properties": {
					"payload": {
						"$ref": "#/$defs/KnowledgeQueryPayload"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": {
						"const": "knowledge_query"
					},
					"packet_kind": {
						"const": "result"
					}
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": {
				"properties": {
					"result": {
						"$ref": "#/$defs/KnowledgeAgentTerminalResult"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": {
						"const": "knowledge_search"
					},
					"packet_kind": {
						"const": "payload"
					}
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": {
				"properties": {
					"payload": {
						"$ref": "#/$defs/KnowledgeSearchPayload"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": {
						"const": "knowledge_search"
					},
					"packet_kind": {
						"const": "result"
					}
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": {
				"properties": {
					"result": {
						"$ref": "#/$defs/KnowledgeSearchResult"
					}
				}
			}
		}
	],
	"$defs": {
		"NonEmptyString": {
			"type": "string",
			"minLength": 1,
			"pattern": "\\S"
		},
		"NullableString": {
			"type": ["string", "null"]
		},
		"VersionQuery": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "as_of", "version_id", "compare_to_version_id"],
			"properties": {
				"mode": {
					"enum": ["current", "historical", "as_of", "compare"]
				},
				"as_of": {
					"$ref": "#/$defs/NullableString"
				},
				"version_id": {
					"$ref": "#/$defs/NullableString"
				},
				"compare_to_version_id": {
					"$ref": "#/$defs/NullableString"
				}
			}
		},
		"KnowledgeQueryPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query_text", "scope", "version_query"],
			"properties": {
				"query_text": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"scope": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"version_query": {
					"anyOf": [
						{
							"$ref": "#/$defs/VersionQuery"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"KnowledgeSearchPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query_text"],
			"properties": {
				"query_text": {
					"$ref": "#/$defs/NonEmptyString"
				}
			}
		},
		"KnowledgeEvidence": {
			"type": "object",
			"additionalProperties": false,
			"required": ["evidence_ref", "title", "snippet", "canonical_url", "version_id"],
			"properties": {
				"evidence_ref": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 300
				},
				"snippet": {
					"type": "string",
					"minLength": 1,
					"maxLength": 1200
				},
				"canonical_url": {
					"type": "string",
					"format": "uri"
				},
				"version_id": {
					"$ref": "#/$defs/NullableString"
				}
			}
		},
		"KnowledgeSearchResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome", "search_ref", "resolved_scope", "resolved_version", "evidence"],
			"properties": {
				"outcome": {
					"enum": ["found", "no_evidence"]
				},
				"search_ref": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"resolved_scope": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"resolved_version": {
					"$ref": "#/$defs/VersionQuery"
				},
				"evidence": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"$ref": "#/$defs/KnowledgeEvidence"
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"outcome": {
								"const": "found"
							}
						}
					},
					"then": {
						"properties": {
							"evidence": {
								"minItems": 1
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"outcome": {
								"const": "no_evidence"
							}
						}
					},
					"then": {
						"properties": {
							"evidence": {
								"maxItems": 0
							}
						}
					}
				}
			]
		},
		"SessionUpdateSlot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["confirmed", "name", "value"],
			"properties": {
				"confirmed": {
					"const": true
				},
				"name": {
					"enum": ["curriculum_program", "curriculum_program_family", "curriculum_semester"]
				},
				"value": {
					"$ref": "#/$defs/NonEmptyString"
				}
			}
		},
		"SessionUpdate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["upsert_slots"],
			"properties": {
				"upsert_slots": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/SessionUpdateSlot"
					}
				}
			}
		},
		"KnowledgeAgentTerminalResult": {
			"oneOf": [
				{
					"$ref": "#/$defs/KnowledgeAnswerResult"
				},
				{
					"$ref": "#/$defs/KnowledgeClarificationResult"
				},
				{
					"$ref": "#/$defs/KnowledgeUnsupportedResult"
				}
			]
		},
		"KnowledgeAnswerResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"resolved_scope",
				"session_update"
			],
			"properties": {
				"kind": {
					"const": "answer"
				},
				"answer_text": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"follow_up_question": {
					"type": "null"
				},
				"reason": {
					"$ref": "#/$defs/NullableString"
				},
				"evidence_refs": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/NonEmptyString"
					}
				},
				"resolved_scope": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"session_update": {
					"anyOf": [
						{
							"$ref": "#/$defs/SessionUpdate"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"KnowledgeClarificationResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"resolved_scope",
				"session_update"
			],
			"properties": {
				"kind": {
					"const": "clarification_required"
				},
				"answer_text": {
					"type": "null"
				},
				"follow_up_question": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"reason": {
					"$ref": "#/$defs/NullableString"
				},
				"evidence_refs": {
					"type": "array",
					"maxItems": 0
				},
				"resolved_scope": {
					"$ref": "#/$defs/NullableString"
				},
				"session_update": {
					"type": "null"
				}
			}
		},
		"KnowledgeUnsupportedResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"resolved_scope",
				"session_update"
			],
			"properties": {
				"kind": {
					"const": "unsupported_by_evidence"
				},
				"answer_text": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"follow_up_question": {
					"type": "null"
				},
				"reason": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"evidence_refs": {
					"type": "array",
					"maxItems": 0
				},
				"resolved_scope": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"session_update": {
					"type": "null"
				}
			}
		}
	}
}
