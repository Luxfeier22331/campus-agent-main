{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/runtime-tool-function-schemas.v4.schema.json",
	"title": "campus-agent runtime tool function schemas",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "tools"],
	"properties": {
		"schema_version": { "const": "tool-function-schemas-v4" },
		"tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/FunctionTool" } }
	},
	"$defs": {
		"FunctionTool": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "name", "description", "strict", "parameters"],
			"properties": {
				"type": { "const": "function" },
				"name": { "type": "string", "minLength": 1 },
				"description": { "type": "string", "minLength": 1 },
				"strict": { "const": true },
				"parameters": { "$ref": "#/$defs/StrictObjectSchema" }
			}
		},
		"StrictObjectSchema": {
			"type": "object",
			"additionalProperties": true,
			"required": ["type", "additionalProperties", "properties", "required"],
			"properties": {
				"type": { "const": "object" },
				"additionalProperties": { "const": false },
				"properties": { "type": "object" },
				"required": { "type": "array", "items": { "type": "string" } }
			}
		}
	}
}
