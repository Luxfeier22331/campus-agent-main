{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/provider-config-projection.v1.schema.json",
	"title": "评测 Provider Config 本地投影",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "profiles"],
	"properties": {
		"schema_version": { "const": "provider_config_projection.v1" },
		"profiles": {
			"type": "object",
			"additionalProperties": false,
			"required": ["eval_ragas_llm", "eval_ragas_embedding", "eval_judge_llm"],
			"properties": {
				"eval_ragas_llm": { "$ref": "#/$defs/Profile" },
				"eval_ragas_embedding": { "$ref": "#/$defs/Profile" },
				"eval_judge_llm": { "$ref": "#/$defs/Profile" }
			}
		}
	},
	"$defs": {
		"Profile": {
			"type": "object",
			"additionalProperties": false,
			"required": ["api_key", "base_url", "model", "provider", "timeout_ms", "transport"],
			"properties": {
				"api_key": { "type": "string", "minLength": 1 },
				"base_url": { "type": "string", "pattern": "^https?://" },
				"dimensions": { "type": "integer", "minimum": 1 },
				"model": { "type": "string", "minLength": 1 },
				"provider": { "type": "string", "minLength": 1 },
				"timeout_ms": { "type": "integer", "minimum": 1 },
				"transport": { "type": "string", "minLength": 1 }
			}
		}
	}
}
