{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/campus-docs-app-projection.v1.schema.json",
	"title": "campus docs app-api release projection",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"collections",
		"documents",
		"documentVersions",
		"readerAssets",
		"searchUnits"
	],
	"properties": {
		"schemaVersion": { "const": "campus_docs_app_projection.v1" },
		"collections": {
			"type": "array",
			"items": { "$ref": "#/$defs/Collection" }
		},
		"documents": {
			"type": "array",
			"items": { "$ref": "#/$defs/Document" }
		},
		"documentVersions": {
			"type": "array",
			"items": { "$ref": "#/$defs/DocumentVersion" }
		},
		"readerAssets": {
			"type": "array",
			"items": { "$ref": "#/$defs/ReaderAsset" }
		},
		"searchUnits": {
			"type": "array",
			"items": { "$ref": "#/$defs/SearchUnit" }
		}
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"StringMap": {
			"type": "object",
			"required": ["reader", "outline", "meta", "asset-manifest"],
			"properties": {
				"reader": { "$ref": "#/$defs/NonEmptyString" },
				"outline": { "$ref": "#/$defs/NonEmptyString" },
				"meta": { "$ref": "#/$defs/NonEmptyString" },
				"asset-manifest": { "$ref": "#/$defs/NonEmptyString" }
			},
			"additionalProperties": { "$ref": "#/$defs/NonEmptyString" }
		},
		"Collection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "collection", "displayName", "updatedAt"],
			"properties": {
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"collection": { "$ref": "#/$defs/NonEmptyString" },
				"displayName": { "$ref": "#/$defs/NonEmptyString" },
				"description": { "type": ["string", "null"] },
				"updatedAt": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"Document": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"docId",
				"corpus",
				"collection",
				"documentSlug",
				"title",
				"canonicalUrl",
				"currentVersionId",
				"currentVersionSlug",
				"updatedAt"
			],
			"properties": {
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"collection": { "$ref": "#/$defs/NonEmptyString" },
				"documentSlug": { "$ref": "#/$defs/NonEmptyString" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"canonicalUrl": { "$ref": "#/$defs/NonEmptyString" },
				"currentVersionId": { "$ref": "#/$defs/NonEmptyString" },
				"currentVersionSlug": { "$ref": "#/$defs/NonEmptyString" },
				"updatedAt": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"DocumentVersion": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"versionId",
				"docId",
				"versionSlug",
				"label",
				"isCurrent",
				"visibilityLevel",
				"entitlementGroups",
				"deliveryMode",
				"updatedAt"
			],
			"properties": {
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"versionSlug": { "$ref": "#/$defs/NonEmptyString" },
				"label": { "$ref": "#/$defs/NonEmptyString" },
				"effectiveFrom": { "type": ["string", "null"] },
				"isCurrent": { "type": "boolean" },
				"visibilityLevel": { "$ref": "#/$defs/NonEmptyString" },
				"entitlementGroups": {
					"type": "array",
					"items": { "$ref": "#/$defs/NonEmptyString" },
					"uniqueItems": true
				},
				"deliveryMode": { "enum": ["public_static_asset", "gated_asset"] },
				"updatedAt": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"ReaderAsset": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"versionId",
				"staticPrefix",
				"contentUrl",
				"outlineUrl",
				"sourceObjects",
				"targetObjects",
				"updatedAt"
			],
			"properties": {
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"staticPrefix": { "$ref": "#/$defs/NonEmptyString" },
				"contentUrl": { "$ref": "#/$defs/NonEmptyString" },
				"outlineUrl": { "$ref": "#/$defs/NonEmptyString" },
				"manifestUrl": { "type": ["string", "null"] },
				"sourceObjects": { "$ref": "#/$defs/StringMap" },
				"targetObjects": { "$ref": "#/$defs/StringMap" },
				"updatedAt": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"SearchUnit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"searchUnitId",
				"docId",
				"versionId",
				"title",
				"anchor",
				"canonicalUrl",
				"highlightRootUnitIds",
				"snippet",
				"searchText",
				"unitOrder"
			],
			"properties": {
				"searchUnitId": { "$ref": "#/$defs/NonEmptyString" },
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"anchor": { "$ref": "#/$defs/NonEmptyString" },
				"canonicalUrl": { "$ref": "#/$defs/NonEmptyString" },
				"highlightRootUnitIds": {
					"type": "array",
					"items": { "$ref": "#/$defs/NonEmptyString" },
					"uniqueItems": true
				},
				"snippet": { "type": "string" },
				"searchText": { "type": "string" },
				"unitOrder": { "type": "integer", "minimum": 0 }
			}
		}
	}
}
