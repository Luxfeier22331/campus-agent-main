{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/query-serving-targets.v3.schema.json",
	"title": "campus-agent document evidence scope registry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "scopes"],
	"properties": {
		"schema_version": { "const": "query-serving-targets-v3" },
		"scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Scope" } }
	},
	"$defs": {
		"Scope": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"scope",
				"corpus",
				"collection",
				"description",
				"routing_terms",
				"serving_config_path",
				"candidate_top_k",
				"max_evidence_sections"
			],
			"properties": {
				"scope": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
				"corpus": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
				"collection": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
				"description": { "type": "string", "minLength": 1 },
				"routing_terms": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "type": "string", "minLength": 1, "maxLength": 64 }
				},
				"serving_config_path": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[a-z0-9_/-]+/serving-config\\.json$"
				},
				"candidate_top_k": { "type": "integer", "minimum": 1, "maximum": 20 },
				"max_evidence_sections": { "type": "integer", "minimum": 1, "maximum": 6 }
			}
		}
	}
}
