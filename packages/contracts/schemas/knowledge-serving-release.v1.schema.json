{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/knowledge-serving-release.v1.schema.json",
	"title": "Published knowledge serving release",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"release_id",
		"source_release_id",
		"document_scope",
		"corpus",
		"collection",
		"published_at",
		"content_sha256",
		"section_count",
		"retrieval_chunk_count",
		"qdrant_collection",
		"embedding_model",
		"embedding_dimensions"
	],
	"properties": {
		"schema_version": { "const": "knowledge_serving_release.v1" },
		"release_id": { "$ref": "#/$defs/Identifier" },
		"source_release_id": { "$ref": "#/$defs/Identifier" },
		"document_scope": { "$ref": "#/$defs/Identifier" },
		"corpus": { "$ref": "#/$defs/Identifier" },
		"collection": { "$ref": "#/$defs/Identifier" },
		"published_at": { "type": "string", "format": "date-time" },
		"content_sha256": { "$ref": "#/$defs/Sha256" },
		"section_count": { "type": "integer", "minimum": 1 },
		"retrieval_chunk_count": { "type": "integer", "minimum": 1 },
		"qdrant_collection": { "$ref": "#/$defs/Identifier" },
		"embedding_model": { "type": "string", "minLength": 1 },
		"embedding_dimensions": { "type": "integer", "minimum": 1 }
	},
	"$defs": {
		"Identifier": {
			"type": "string",
			"minLength": 1,
			"maxLength": 200,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
		},
		"Sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
	}
}
