{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/campus-docs-site-index.v5.schema.json",
	"title": "校园文档公开目录索引",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "searchIndexUrl", "collections", "topics", "redirects"],
	"properties": {
		"schemaVersion": { "const": "campus_docs_site_index.v5" },
		"searchIndexUrl": { "$ref": "#/$defs/LocalPath" },
		"collections": { "type": "array", "items": { "$ref": "#/$defs/Collection" } },
		"topics": { "type": "array", "items": { "$ref": "#/$defs/Topic" } },
		"redirects": { "type": "array", "items": { "$ref": "#/$defs/Redirect" } }
	},
	"$defs": {
		"NonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
		"VersionSlug": { "type": "string", "pattern": "^[1-9][0-9]*$" },
		"LocalPath": { "type": "string", "pattern": "^/(?!/)" },
		"Collection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "corpusLabel", "collection", "label", "description", "documents"],
			"properties": {
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"corpusLabel": { "$ref": "#/$defs/NonEmptyString" },
				"collection": { "$ref": "#/$defs/NonEmptyString" },
				"label": { "$ref": "#/$defs/NonEmptyString" },
				"description": { "type": ["string", "null"] },
				"documents": { "type": "array", "items": { "$ref": "#/$defs/Document" } }
			}
		},
		"Topic": {
			"type": "object",
			"additionalProperties": false,
			"required": ["corpus", "topicId", "displayName", "description", "order"],
			"properties": {
				"corpus": { "$ref": "#/$defs/NonEmptyString" },
				"topicId": { "$ref": "#/$defs/NonEmptyString" },
				"displayName": { "$ref": "#/$defs/NonEmptyString" },
				"description": { "type": ["string", "null"] },
				"order": { "type": "integer", "minimum": 1 }
			}
		},
		"Document": {
			"type": "object",
			"additionalProperties": false,
			"required": ["docId", "documentSlug", "title", "topicId", "canonicalUrl", "versions"],
			"properties": {
				"docId": { "$ref": "#/$defs/NonEmptyString" },
				"documentSlug": { "$ref": "#/$defs/NonEmptyString" },
				"title": { "$ref": "#/$defs/NonEmptyString" },
				"topicId": { "type": ["string", "null"], "minLength": 1 },
				"canonicalUrl": { "$ref": "#/$defs/LocalPath" },
				"versions": {
					"type": "array",
					"minItems": 1,
					"items": { "$ref": "#/$defs/Version" }
				}
			}
		},
		"Version": {
			"type": "object",
			"additionalProperties": false,
			"required": ["versionId", "versionSlug", "canonicalUrl", "readerUrl"],
			"properties": {
				"versionId": { "$ref": "#/$defs/NonEmptyString" },
				"versionSlug": { "$ref": "#/$defs/VersionSlug" },
				"canonicalUrl": { "$ref": "#/$defs/LocalPath" },
				"readerUrl": { "$ref": "#/$defs/LocalPath" },
				"details": { "$ref": "#/$defs/VersionDetails" }
			}
		},
		"VersionDetails": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"documentNumber": { "$ref": "#/$defs/NonEmptyString" },
				"effectiveDate": {
					"type": "string",
					"pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
				},
				"source": {
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "url"],
					"properties": {
						"name": { "$ref": "#/$defs/NonEmptyString" },
						"url": { "type": "string", "pattern": "^https://[^\\s/?#]+(?:/[^\\s]*)?$" }
					}
				}
			}
		},
		"Redirect": {
			"type": "object",
			"additionalProperties": false,
			"required": ["fromPath", "toPath", "statusCode"],
			"properties": {
				"fromPath": { "$ref": "#/$defs/LocalPath" },
				"toPath": { "$ref": "#/$defs/LocalPath" },
				"statusCode": { "const": 308 }
			}
		}
	}
}
