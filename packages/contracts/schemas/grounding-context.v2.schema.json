{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/grounding-context.v2.schema.json",
	"title": "Grounding context",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"run_id",
		"admission_sha256",
		"plan_sha256",
		"query_sha256",
		"prepared_at",
		"mode",
		"selected_scopes",
		"covered_scopes",
		"status",
		"token_count",
		"model_context_chars",
		"evidence"
	],
	"properties": {
		"schema_version": { "const": "grounding_context.v2" },
		"run_id": { "type": "string", "minLength": 1 },
		"admission_sha256": { "$ref": "#/$defs/Sha256Ref" },
		"plan_sha256": { "$ref": "#/$defs/Sha256" },
		"query_sha256": { "$ref": "#/$defs/Sha256Ref" },
		"prepared_at": { "type": "string", "format": "date-time" },
		"mode": { "enum": ["none", "single_scope", "multi_scope"] },
		"selected_scopes": { "$ref": "#/$defs/Scopes" },
		"covered_scopes": { "$ref": "#/$defs/Scopes" },
		"status": { "enum": ["not_required", "empty", "partial", "ready"] },
		"token_count": { "type": "integer", "minimum": 0, "maximum": 4096 },
		"model_context_chars": { "type": "integer", "minimum": 0 },
		"evidence": {
			"type": "array",
			"maxItems": 8,
			"items": { "$ref": "#/$defs/Evidence" }
		}
	},
	"$defs": {
		"Sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"Sha256Ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
		"Scopes": {
			"type": "array",
			"maxItems": 32,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"Evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"evidence_ref",
				"document_scope",
				"release_id",
				"chunk_id",
				"section_ref",
				"document_id",
				"section_id",
				"document_title",
				"section_title",
				"canonical_url",
				"text",
				"text_sha256",
				"token_count",
				"rerank_score"
			],
			"properties": {
				"evidence_ref": { "type": "string", "pattern": "^evidence://[a-f0-9]{64}$" },
				"document_scope": { "type": "string", "minLength": 1 },
				"release_id": { "type": "string", "minLength": 1 },
				"chunk_id": { "type": "string", "minLength": 1 },
				"section_ref": { "type": "string", "minLength": 1 },
				"document_id": { "type": "string", "minLength": 1 },
				"section_id": { "type": "string", "minLength": 1 },
				"document_title": { "type": "string", "minLength": 1 },
				"section_title": { "type": "string", "minLength": 1 },
				"canonical_url": { "type": "string", "minLength": 1 },
				"text": { "type": "string", "minLength": 1 },
				"text_sha256": { "$ref": "#/$defs/Sha256Ref" },
				"token_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"rerank_score": { "type": "number", "minimum": 0, "maximum": 1 }
			}
		}
	}
}
