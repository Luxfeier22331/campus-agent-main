{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v2.schema.json",
	"title": "campus-agent knowledge agent tool contracts",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "tool_name", "packet_kind"],
	"properties": {
		"schema_version": {
			"const": "knowledge_tool_contracts.v2"
		},
		"tool_name": {
			"enum": ["knowledge_query", "knowledge_search"]
		},
		"packet_kind": {
			"enum": ["payload", "result"]
		},
		"payload": {
			"type": "object"
		},
		"result": {
			"type": "object"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": { "packet_kind": { "const": "payload" } },
				"required": ["packet_kind"]
			},
			"then": {
				"required": ["payload"],
				"not": { "required": ["result"] }
			}
		},
		{
			"if": {
				"properties": { "packet_kind": { "const": "result" } },
				"required": ["packet_kind"]
			},
			"then": {
				"required": ["result"],
				"not": { "required": ["payload"] }
			}
		},
		{
			"if": {
				"properties": {
					"tool_name": { "const": "knowledge_query" },
					"packet_kind": { "const": "payload" }
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": { "properties": { "payload": { "$ref": "#/$defs/KnowledgeQueryPayload" } } }
		},
		{
			"if": {
				"properties": {
					"tool_name": { "const": "knowledge_query" },
					"packet_kind": { "const": "result" }
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": { "properties": { "result": { "$ref": "#/$defs/KnowledgeAgentTerminalResult" } } }
		},
		{
			"if": {
				"properties": {
					"tool_name": { "const": "knowledge_search" },
					"packet_kind": { "const": "payload" }
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": { "properties": { "payload": { "$ref": "#/$defs/KnowledgeSearchPayload" } } }
		},
		{
			"if": {
				"properties": {
					"tool_name": { "const": "knowledge_search" },
					"packet_kind": { "const": "result" }
				},
				"required": ["tool_name", "packet_kind"]
			},
			"then": { "properties": { "result": { "$ref": "#/$defs/KnowledgeSearchResult" } } }
		}
	],
	"$defs": {
		"NonEmptyString": {
			"type": "string",
			"minLength": 1,
			"pattern": "\\S"
		},
		"NullableString": {
			"type": ["string", "null"]
		},
		"KnowledgeQueryPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query_text"],
			"properties": {
				"query_text": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"KnowledgeSearchPayload": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query_text", "target", "include_history"],
			"properties": {
				"query_text": { "$ref": "#/$defs/NonEmptyString" },
				"target": { "$ref": "#/$defs/NonEmptyString" },
				"include_history": { "type": "boolean" }
			}
		},
		"KnowledgeEvidence": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"evidence_ref",
				"retrieval_target",
				"document_id",
				"chunk_id",
				"title",
				"snippet",
				"canonical_url",
				"version_id",
				"rank",
				"fusion_score"
			],
			"properties": {
				"evidence_ref": { "$ref": "#/$defs/NonEmptyString" },
				"retrieval_target": { "$ref": "#/$defs/NonEmptyString" },
				"document_id": { "$ref": "#/$defs/NonEmptyString" },
				"chunk_id": { "$ref": "#/$defs/NonEmptyString" },
				"title": { "type": "string", "minLength": 1, "maxLength": 300 },
				"snippet": { "type": "string", "minLength": 1, "maxLength": 1200 },
				"canonical_url": { "type": "string", "format": "uri" },
				"version_id": { "$ref": "#/$defs/NullableString" },
				"rank": { "type": "integer", "minimum": 1 },
				"fusion_score": { "type": "number" }
			}
		},
		"KnowledgeSearchResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"outcome",
				"search_ref",
				"retrieval_target",
				"include_history",
				"candidate_count",
				"discarded_count",
				"retriever_modes",
				"evidence"
			],
			"properties": {
				"outcome": {
					"enum": ["found", "no_evidence", "duplicate_query", "search_budget_exhausted"]
				},
				"search_ref": { "$ref": "#/$defs/NonEmptyString" },
				"retrieval_target": { "$ref": "#/$defs/NonEmptyString" },
				"include_history": { "type": "boolean" },
				"candidate_count": { "type": "integer", "minimum": 0 },
				"discarded_count": { "type": "integer", "minimum": 0 },
				"retriever_modes": {
					"type": "array",
					"uniqueItems": true,
					"items": { "enum": ["dense", "sparse"] }
				},
				"evidence": {
					"type": "array",
					"maxItems": 20,
					"items": { "$ref": "#/$defs/KnowledgeEvidence" }
				}
			},
			"allOf": [
				{
					"if": { "properties": { "outcome": { "const": "found" } } },
					"then": { "properties": { "evidence": { "minItems": 1 } } }
				},
				{
					"if": {
						"properties": {
							"outcome": {
								"enum": ["no_evidence", "duplicate_query", "search_budget_exhausted"]
							}
						}
					},
					"then": { "properties": { "evidence": { "maxItems": 0 } } }
				}
			]
		},
		"SessionUpdateSlot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["confirmed", "name", "value"],
			"properties": {
				"confirmed": { "const": true },
				"name": {
					"enum": ["curriculum_program", "curriculum_program_family", "curriculum_semester"]
				},
				"value": { "$ref": "#/$defs/NonEmptyString" }
			}
		},
		"SessionUpdate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["upsert_slots"],
			"properties": {
				"upsert_slots": {
					"type": "array",
					"items": { "$ref": "#/$defs/SessionUpdateSlot" }
				}
			}
		},
		"KnowledgeAgentTerminalResult": {
			"oneOf": [
				{ "$ref": "#/$defs/KnowledgeAnswerResult" },
				{ "$ref": "#/$defs/KnowledgeClarificationResult" },
				{ "$ref": "#/$defs/KnowledgeUnsupportedResult" }
			]
		},
		"KnowledgeAnswerResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"session_update"
			],
			"properties": {
				"kind": { "const": "answer" },
				"answer_text": { "$ref": "#/$defs/NonEmptyString" },
				"follow_up_question": { "type": "null" },
				"reason": { "$ref": "#/$defs/NullableString" },
				"evidence_refs": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/NonEmptyString" }
				},
				"session_update": {
					"anyOf": [{ "$ref": "#/$defs/SessionUpdate" }, { "type": "null" }]
				}
			}
		},
		"KnowledgeClarificationResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"session_update"
			],
			"properties": {
				"kind": { "const": "clarification_required" },
				"answer_text": { "type": "null" },
				"follow_up_question": { "$ref": "#/$defs/NonEmptyString" },
				"reason": { "$ref": "#/$defs/NullableString" },
				"evidence_refs": { "type": "array", "maxItems": 0 },
				"session_update": { "type": "null" }
			}
		},
		"KnowledgeUnsupportedResult": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"answer_text",
				"follow_up_question",
				"reason",
				"evidence_refs",
				"session_update"
			],
			"properties": {
				"kind": { "const": "unsupported_by_evidence" },
				"answer_text": { "$ref": "#/$defs/NonEmptyString" },
				"follow_up_question": { "type": "null" },
				"reason": { "$ref": "#/$defs/NonEmptyString" },
				"evidence_refs": {
					"type": "array",
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/NonEmptyString" }
				},
				"session_update": { "type": "null" }
			}
		}
	}
}
