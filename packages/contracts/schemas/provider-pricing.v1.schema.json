{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/provider-pricing.v1.schema.json",
	"title": "campus-agent provider pricing catalog",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "currency", "models"],
	"properties": {
		"schema_version": {
			"const": "provider-pricing-v1"
		},
		"currency": {
			"const": "USD"
		},
		"models": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"provider",
					"model",
					"input_microusd_per_1k_tokens",
					"cached_input_microusd_per_1k_tokens",
					"output_microusd_per_1k_tokens"
				],
				"properties": {
					"provider": {
						"type": "string",
						"minLength": 1
					},
					"model": {
						"type": "string",
						"minLength": 1
					},
					"input_microusd_per_1k_tokens": {
						"type": "integer",
						"minimum": 0
					},
					"cached_input_microusd_per_1k_tokens": {
						"type": "integer",
						"minimum": 0
					},
					"output_microusd_per_1k_tokens": {
						"type": "integer",
						"minimum": 0
					}
				}
			}
		}
	}
}
