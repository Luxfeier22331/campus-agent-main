{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://muc.wiki/campus-agent/schemas/answer-eval-fingerprint.v1.schema.json",
	"title": "campus-agent answer eval fingerprint",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"answer_fingerprint_sha256",
		"run_id",
		"request_id",
		"trace_id",
		"runtime_release",
		"llm_call_site",
		"llm_io_fingerprint_sha256",
		"provider_profile_revision",
		"output_schema_id",
		"branch_identity",
		"terminal_outcome",
		"selected_tool",
		"selected_tools",
		"stage_timing_profile_sha256",
		"tool_runtime_combined_sha256"
	],
	"properties": {
		"schema_version": {
			"const": "answer_eval_fingerprint.v1"
		},
		"answer_fingerprint_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"run_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"request_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"trace_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"runtime_release": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"llm_call_site": {
			"enum": ["agent.primary", "rag.synthesis"]
		},
		"llm_io_fingerprint_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"provider_profile_revision": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"output_schema_id": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"branch_identity": {
			"$ref": "#/$defs/BranchIdentity"
		},
		"terminal_outcome": {
			"$ref": "#/$defs/NonEmptyString"
		},
		"selected_tool": {
			"type": ["string", "null"],
			"minLength": 1
		},
		"selected_tools": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/NonEmptyString"
			},
			"uniqueItems": true
		},
		"stage_timing_profile_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"tool_runtime_combined_sha256": {
			"$ref": "#/$defs/Sha256"
		},
		"evidence_replay_index_sha256": {
			"type": ["string", "null"],
			"pattern": "^(sha256:)?[a-f0-9]{64}$"
		}
	},
	"$defs": {
		"NonEmptyString": {
			"type": "string",
			"minLength": 1
		},
		"Sha256": {
			"type": "string",
			"pattern": "^(sha256:)?[a-f0-9]{64}$"
		},
		"BranchIdentity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "prompt_id", "branch_kind", "workflow_mode"],
			"properties": {
				"schema_version": {
					"const": "answer_branch_identity.v1"
				},
				"prompt_id": {
					"$ref": "#/$defs/NonEmptyString"
				},
				"branch_kind": {
					"enum": [
						"direct_no_tool",
						"tool_routed",
						"rag_synthesis",
						"clarification",
						"policy_refusal",
						"runtime_error"
					]
				},
				"workflow_mode": {
					"$ref": "#/$defs/NonEmptyString"
				}
			}
		}
	}
}
