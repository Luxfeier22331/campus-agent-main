{
	"name": "campus-contracts",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./account-admin": "./src/account-admin.ts",
		"./campus-groups": "./src/campus-groups.ts",
		"./email-access": "./src/email-access.ts",
		"./product-availability": "./src/product-availability.ts"
	},
	"scripts": {
		"check": "pnpm exec tsx ./scripts/generate_contracts.ts --check && pnpm exec tsx ./scripts/check_contract_schemas.ts",
		"generate": "pnpm exec tsx ./scripts/generate_contracts.ts",
		"test": "vitest run && pnpm run test:generators",
		"test:generators": "pnpm exec tsx ./scripts/check_contract_schemas.ts --self-test && pnpm exec tsx ./scripts/generate_contracts.ts --self-test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"ajv": "^8.20.0",
		"smol-toml": "1.7.0",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.9",
		"yaml": "^2.9.0"
	}
}
