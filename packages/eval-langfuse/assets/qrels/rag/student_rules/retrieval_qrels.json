{
	"schema_version": 1,
	"corpus": "regulations",
	"collection": "student_rules",
	"baseline": {
		"dense_model": "Qwen3-Embedding-4B",
		"dense_dimensions": 2560,
		"sparse_model": "qdrant/bm25",
		"sparse_tokenizer": "multilingual",
		"sparse_language": "none",
		"fusion": "rrf"
	},
	"coverage_scenarios": {
		"policy_title_exact_match": [
			"synthetic-policy-title-scholarship",
			"synthetic-policy-title-medical"
		],
		"article_number_exact_match": ["synthetic-article-number-degree"],
		"semantic_service_process": ["synthetic-service-card-reissue"],
		"hard_negative": ["synthetic-hard-negative-grant-vs-scholarship"],
		"no_hit": ["synthetic-no-hit-fictional-office"],
		"version_locked": ["synthetic-policy-title-medical"]
	},
	"cases": [
		{
			"case_id": "synthetic-policy-title-scholarship",
			"split": "smoke",
			"query": "示例学生奖学金评定办法",
			"expected_sources": [
				{
					"doc_id": "handbook:synthetic-scholarship-policy",
					"grade": 2,
					"rationale": "合成制度标题 exact-match。"
				}
			],
			"notes": "公开仓库只保留合成 qrels 形状样例。"
		},
		{
			"case_id": "synthetic-policy-title-medical",
			"split": "regression",
			"query": "示例学生医疗报销管理办法",
			"expected_sources": [
				{
					"doc_id": "handbook:synthetic-medical-policy",
					"version_id": "v1:synthetic-medical-policy",
					"grade": 2,
					"rationale": "合成版本锁定样例。"
				}
			],
			"notes": "用于验证 qrels-only dataset item 投影。"
		},
		{
			"case_id": "synthetic-article-number-degree",
			"split": "smoke",
			"query": "示例学位授予规定 第十条",
			"expected_sources": [
				{
					"doc_id": "handbook:synthetic-degree-policy",
					"grade": 2,
					"rationale": "合成条款号 exact-match。"
				}
			]
		},
		{
			"case_id": "synthetic-service-card-reissue",
			"split": "curated",
			"query": "学生证补办需要看哪份合成流程",
			"expected_sources": [
				{
					"doc_id": "handbook:synthetic-student-card-process",
					"grade": 2,
					"rationale": "合成语义流程问法。"
				}
			]
		},
		{
			"case_id": "synthetic-hard-negative-grant-vs-scholarship",
			"split": "regression",
			"query": "示例助学金认定办法",
			"expected_sources": [
				{
					"doc_id": "handbook:synthetic-grant-policy",
					"grade": 2,
					"rationale": "合成资助制度标题。"
				}
			],
			"forbidden_sources": [
				{
					"doc_id": "handbook:synthetic-scholarship-policy",
					"grade": 1,
					"rationale": "奖学金合成制度不应压过助学金合成制度。"
				}
			]
		},
		{
			"case_id": "synthetic-no-hit-fictional-office",
			"split": "regression",
			"query": "示例校园月球办公室办理处",
			"expected_sources": [],
			"notes": "不存在事项应 no-hit。"
		}
	]
}
