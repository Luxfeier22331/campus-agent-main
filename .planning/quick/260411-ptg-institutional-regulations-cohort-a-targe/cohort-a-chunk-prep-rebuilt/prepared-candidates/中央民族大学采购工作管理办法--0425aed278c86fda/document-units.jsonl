{"doc_id": "institutional_regulation:muc:中央民族大学采购工作管理办法:a2f1da036a48", "version_id": "sha256:77dc1a8d41d6a6e8d137d7e1f68608ab8b2009f059e69852adae6acd99d03e09:effective-2021年3月1日:revision-修订", "chunk_id": "institutional_regulation:muc:中央民族大学采购工作管理办法:a2f1da036a48:row-0015", "row_id": "institutional_regulation:muc:中央民族大学采购工作管理办法:a2f1da036a48:row-0015", "row_type": "paragraph", "clean_text": "校内分散采购指校内集中采购限额标准以下及范围以外的项目。校内分散采购，在资产管理处（招标采购中心）的指导下，工程类由归口管理部门采购，货物、服务类由采购需求单位组织实施。各单位可以根据项目的具体情况，自行确定采购方式，依规实施，择优确定成交商。各单位应做好供应商报价材料、第三方采购平台采购清单截图、采购合同、发票等与采购项目相关资料的收集和归档工作，以备核查。", "source_pdf": "canonical.md", "source_url": "campusrag://promotion/internal_notice/0425aed278c86fda", "source": {"id": "campusrag://promotion/internal_notice/0425aed278c86fda"}, "page_start": null, "page_end": null, "entitlement_groups": ["campus_members"], "visibility_scope": "campus", "visibility_level": "restricted", "policy_projection_version": "phase1-authorization-projection-v1", "unit_type": "institutional_regulation_block", "root_unit_id": "institutional_regulation:muc:中央民族大学采购工作管理办法:a2f1da036a48:root", "metadata": {"title": "中央民族大学采购工作管理办法", "semantic_content_hash": "77dc1a8d41d6a6e8d137d7e1f68608ab8b2009f059e69852adae6acd99d03e09", "content_kind": "institutional_regulation", "content_role": "regulation_body", "is_answer_bearing": true, "projection_name": "internal_notice_regulation_promotion", "derived_from": "internal_notice_canonical_document", "derived_from_document_id": "notice:muc_internal_portal:187233", "derived_from_document_ids": ["notice:muc_internal_portal:187233"], "parent_document_id": "notice:muc_internal_portal:187233", "promotion_class": "formal_regulation", "promotion_source_collection": "campus_notices/internal_notice", "source_notice_ids": ["187233"], "source_document_ids": ["notice:muc_internal_portal:187233"], "source_parent_document_id": "notice:muc_internal_portal:187233", "source_parent_document_ids": ["notice:muc_internal_portal:187233"], "source_attachment_ref_ids":