{"schema_version": "authenticated_notice_block_v1", "raw_asset_id": "asset:authenticated-notice:muc_internal_portal:177880", "raw_version_id": "sha256:e1cfbdb56b34f883d58476b71c965e467651925fb640013078990c21d90bf6d3", "row_id": "block-0003", "row_index": 2, "block_order": 3, "block_role": "paragraph", "heading_level": null, "parent_heading_path": [], "list_level": null, "table_id": null, "table_row_index": null, "table_col_index": null, "text_raw": "《中央民族大学学生申诉管理办法》（民大校发〔2019〕153号）已经于2019年12月25日经学校校长办公会议审议通过，自2020年1月1日起施行。本办法调整了学校学生申诉处理委员会成员构成，学生申诉处理委员会办公室设在校长办公室。", "text_normalized": "《中央民族大学学生申诉管理办法》（民大校发〔2019〕153号）已经于2019年12月25日经学校校长办公会议审议通过，自2020年1月1日起施行。本办法调整了学校学生申诉处理委员会成员构成，学生申诉处理委员会办公室设在校长办公室。", "html_fragment": null, "link_target": null, "link_text": null, "table_html": null, "table_cells": null}
