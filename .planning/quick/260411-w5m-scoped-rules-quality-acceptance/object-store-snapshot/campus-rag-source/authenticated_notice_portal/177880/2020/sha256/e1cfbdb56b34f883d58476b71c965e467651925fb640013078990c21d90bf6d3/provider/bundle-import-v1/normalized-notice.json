  "notice_content_html": "<p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">各学院：</span></p><p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp; &nbsp;</span><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">《中央民族大学学生申诉管理办法》（民大校发〔2019〕153号）已经于2019年12月25日经学校校长办公会议审议通过，自2020年1月1日起施行。本办法调整了学校学生申诉处理委员会成员构成，学生申诉处理委员会办公室设在校长办公室。</span></p><p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;&nbsp;</span><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">特此通知，请遵照执行。</span></p><p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></p><p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">党委学生工作部、学生处</span></p><p><span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp;</span> <span style=\"font-size: 21px;font-family: Arial, sans-serif\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span><span style=\"font-size: 21px;font-family: 仿宋_GB2312\"> 2020</span><span style=\"font-size: 21px;font-family: 仿宋_GB2312\">年1月7日</span></p><p style=\"margin-top:5px;margin-right:0;margin-bottom:5px;margin-left: 0\"><span style=\"font-family: Arial, sans-serif\">&nbsp;</span></p><p><br/></p>"
