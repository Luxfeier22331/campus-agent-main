  "notice_content_html": "<p><span style=\";font-family:仿宋;font-size:21px\"><span style=\"font-family:仿宋\">各单位、各部门：</span></span></p><p style=\"text-indent:43px\"><span style=\";font-family:仿宋;font-size:21px;background:rgb(255,255,255)\"><span style=\"font-family:仿宋\">为加强学校国内差旅费管理</span></span><span style=\";font-family:仿宋;font-size:21px;background:rgb(255,255,255)\"><span style=\"font-family:仿宋\">，进一步规范各类人员出差标准、审批流程等，提升学校财务管理水平和效率，</span></span><span style=\";font-family:仿宋;font-size:21px;background:rgb(255,255,255)\"><span style=\"font-family:仿宋\">学校</span></span><span style=\";font-family:仿宋;font-size:21px;background:rgb(255,255,255)\"><span style=\"font-family:仿宋\">对</span></span><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">《中央民族大学差旅费管理办法》</span></span><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">进行了修订</span></span><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">，</span></span><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">现已经过</span><span style=\"font-family:仿宋\">2025年第13次校长办公会审议通过，自2025年7月1日起实施。</span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">使用学校各类经费在</span><span style=\"font-family:仿宋\">2025年7月1日前发生的出差事项适用原文件，7月1日之后申请出差的事项，适用修订后的文件（见信息门户-文件发布），请各单位自行下载参照执行</span></span><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">。</span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\">&nbsp;<span style=\"font-family:仿宋\"><br/></span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\"><br/></span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\"><br/></span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\"><span style=\"font-family:仿宋\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;财务处</span></span></p><p style=\"text-indent:41px\"><span style=\";font-family:仿宋;color:rgb(0,0,0);font-size:21px\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<span style=\"font-family:仿宋\">2025年7月9日</span></span></p><p><span style=\";font-family:仿宋;font-size:21px\">&nbsp;</span></p><p><br/></p>"
}
