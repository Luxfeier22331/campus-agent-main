  "notice_title": "中央民族大学民族学与社会学学院2022年硕博连读博士研究生招生实施细则",
  "organization_name": "民族学与社会学学院",
  "organization_id": "11026",
  "notice_release_time": "2022-03-01 15:35",
  "notice_create_time": "2022-03-01 14:45",
  "notice_first_time": "2022-03-01 14:51",
