  "notice_type_names": [
    "教学通知"
  ],
  "notice_content_html": "<p style=\";text-align: center;font-family: Calibri;font-size: 14px;white-space: normal\"><br/></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">根据教育部关于深化研究生教育改革的相关意见</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">以及</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">《中央民族大学</span><span style=\"font-family:仿宋\">202</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">6</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">年博士研究生招生简章》</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">和《关于开展</span><span style=\"font-family:仿宋\">2026年“英才计划”硕博连读研究生招生工作的通知》</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">等文件要求，立足培养高层次创新人才，为积极探索和构建符合博士研究生培养规律的招生机制，提高博士研究生招生选拔质量、规范招生工作，特制定本实施细则。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">一、招生专业</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">新闻传播学</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">二、选拔对象</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">我校全日制非定向的学术学位、专业学位（三年制）二年级硕士研究生</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">三、申请条件</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">一</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">基本条件</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">坚定对伟大祖国、中华民族、中华文化、中国共产党、中国特色社会主义的高度认同，维护祖国统一和民族团结，遵纪守法，品行端正，无任何违法违纪受处分记录，诚实守信，学风端正。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">已完成的专业必修课和专业选修课成绩均不低于</span><span style=\"font-family:仿宋\">80分，其他课程成绩均不低于70分。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">遵守学术道德，具备创新精神和培养潜质。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">4.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">至少有</span><span style=\"font-family:仿宋\">2名所报考学科专业领域的</span></span><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">教授或相当专业技术职称</span></span></strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">的专家（非申请人的硕士培养导师）做出书面推荐。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">5.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">硕博连读申报的博士专业一般应与硕士就读专业属于同一个一级学科。对于跨学位类型、跨一级学科的申请人，要具备跨学科的潜力和科研能力。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">6.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">身心健康，身体健康状况符合《普通高等学校招生体检工作指导意见》的相关要求。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">学术科研条件</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请人须至少应具备如下学术科研经历之一：</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在相关学科参加国内外重要学术会议并宣讲论文；</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在国内外相关学科学术期刊发表论文或者国内</span><span style=\"font-family:仿宋\">“三报一刊”发表理论文章；</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在所申报专业方向相关领域获得授权专利或者软件著作权；</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">4.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在相关学科领域撰写咨政报告、内参并获重要批示；</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">5.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在讲好中华民族共同体故事、中华民族共同体战略传播等相关领域作出突出贡献或取得突出成绩。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">四、</span></span></strong><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请程序</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">一</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">网上报名</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1．报名时间：</span></span><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">即日起</span></span></strong><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">—2026年1月10日</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2．网上报名网址：https://yjszs.muc.edu.cn/（中央民族大学研究生招生平台）</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3．网上报名程序</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">①</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">考生登录我校博士报名平台，进行注册。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">②</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">在网上填报报考信息、上传本人近期正面</span><span style=\"font-family:仿宋\">2寸免冠证件照和相关电子材料。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">③</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">网上支付</span><span style=\"font-family:仿宋\">200元报名费。网上支付报名费后，无论考生是否参加考试，一律不退还报名费。我校报名费只采取网上支付方式，不接收现场缴费和邮政汇款。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">二</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">提交</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">电子</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">材料</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">网上报名系统中的博士报名表（从网上报名系统直接下载打印）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.《中央民族大学2026年“英才计划”硕博连读申请表》扫描版。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">①“申请人自述”须</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">包括</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">以下内容：</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">学习及学术研究经历、对铸牢中华民族共同体意识的认识、对报考专业及研究方向的认识、个人优势与不足，字数为</span><span style=\"font-family:仿宋\">1500-2000字。跨学位类型、跨一级学科的申报人须</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">同时陈述</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">跨学位类型、跨一级学科申报的缘由及攻读博士学位的基础与潜力说明</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">，</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">并在第（八）项材料中提交相关证明</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">②</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">“攻读博士期间的学习和研究计划”</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">须包括</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请人拟在攻读博士学位期间将要开展的研究问题、研究意义、文献综述、研究方法、研究内容框架、研究创新性、研究日程安排、主要参考文献等内容，须使用国家通用语言文字写作，字数为</span><span style=\"font-family:仿宋\">6000-8000字。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">③所有签名均须为本人手写签名，否则材料审核不合格。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.专家推荐信2份。推荐信签字部分务必由专家本人签字，务必为正高级（或相当职称）专业技术职称的专家，否则材料审核不合格。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">4.硕士阶段的成绩单（加盖学校研究生院公章，可使用新研究生系统成绩单彩打）。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">5.外语水平证明。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">6.有效身份证，须正反清晰扫描为一张图。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">7.在学术期刊上发表的学术论文、重要的获奖证书、课题结项证书扫描件以及其他可以体现申请人科研能力的材料。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">8.跨学位类型、跨一级学科的申请人须提供具备跨学科的潜力和科研能力的相关证明材料。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">三</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">注意事项</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请材料需将原件清晰扫描为电子版，并按上述顺序进行阿拉伯数字编号排序合并为一个</span><span style=\"font-family:仿宋\">PDF电子文件，加上封面和目录通过报名系统提交。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">报名结束后不再接收材料，所提交材料不予退还。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请人应确认本人是否符合</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">条件。须如实、准确提交报名信息和报名材料，不得弄虚作假。在任何阶段一旦发现</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请人</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">不符合</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">条件或提交的报考信息不真实，将取消其</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">申请</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">资格和录取资格，相关后果由考生本人承担。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">五、材料</span></span></strong><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">审核</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（一）学院研究生招生工作小组安排专人对申请材料进行形式审查，确保与本细则要求一致。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）对不符合申请条件、未按时提交材料、材料不全、未按时缴纳报名费的申请人及材料，视为审查不合格，已缴纳的报名费不予退回。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（三）材料审核合格可进入综合考核环节。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\">&nbsp;</span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">六、综合考核</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（一）学院预计在</span><span style=\"font-family:仿宋\">2026年1月21日前完成综合考核，具体考场和时间另行通知。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）综合考核程序包含材料评议、专业面试两个环节。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.材料评议：专家组根据材料对申请人进行科研能力评价，从教育背景、学术经历、外语水平、前期科研成果、研究计划、专家推荐意见等方面进行匿名评分，以百分制计。专家组成员独立打分，取平均成绩作为材料评议成绩。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.专业面试：专家组对申请人的政治思想表现、专业知识、学术素养、创新精神和科研能力进行考核，重点考查申请人是否具备博士生培养潜力和从事科学研究的能力。面试成绩以百分制计，专家组成员独立打分，取平均成绩作为专业面试成绩。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.对跨学位类型、跨一级学科的申请人须适当强化材料审核和专业面试考察，一般综合考核时间应不少于40分钟。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">4.最终成绩计算：考生最终成绩为百分制，材料评议成绩和专业面试成绩分别占最终成绩的50%。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（三）最终成绩公示：考核工作结束后，在学院网站上公示考生的最终成绩，公示期为</span><span style=\"font-family:仿宋\">5天。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">七、录取管理</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（一）学院研究生招生工作领导小组对申请人的考核成绩进行审查。审查无误后，按照考生最终成绩及招生计划，从高分到低分排序确定拟录取人选。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）存在以下任何一种情况的申请人不予录取：</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">1.材料评议成绩、专业面试成绩中有一项低于60分。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2.政审不合格。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">3.体检不合格。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（三）</span><span style=\"font-family:仿宋\">“英才计划”硕博连读招生报考阶段只报专业（研究方向），报名时填报的导师仅为意向导师，不按照意向导师进行排名和拟录取。后续由招生单位根据申请人导师志愿和学科需要，确定导师。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（四）拟录取结果上报研究生院审核批准，最终录取结果由研究生院进行公示。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">八、学制及培养</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（一）基本学制为</span><span style=\"font-family:仿宋\">6年（从硕士研究生阶段开始计算），最长学习年限按照《中央民族大学研究生学籍管理办法》执行。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）硕士研究生阶段的第</span><span style=\"font-family:仿宋\">5学期进行资格考核，资格考核“合格”者进入博士研究生阶段的学习，享受博士研究生待遇，达到博士研究生毕业要求和博士学位授予标准后，方可毕业，授予博士学位。若资格考核“不合格”，考核小组认为可完成硕士研究生学位学习者，经本人申请，导师同意，由培养单位签署意见后报研究生院审核，审核通过后继续按照原硕士阶段专业进行培养，达到硕士研究生毕业要求和硕士学位授予标准后，方可毕业，授予硕士学位。&nbsp;</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">九、</span></span></strong><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">其他事项</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（一）学制学费、奖助学金、毕业就业等根据学校博士招生简章执行。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（二）咨询电话：</span><span style=\"font-family:仿宋\">010-6893</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">4746</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">；邮箱：</span><span style=\"font-family:仿宋\">mucxwycb@163.com。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">（三）</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">办公地址</span><span style=\"font-family:仿宋\">: 中央民族大学文华楼1335D办公室。</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">十、</span></span></strong><strong><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">本实施办法由新闻与传播学院负责解释。</span></span></strong></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 37px\"><span style=\"font-family: 仿宋;font-size: 19px\">&nbsp;</span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal\"><span style=\"font-family: 仿宋;font-size: 19px\">&nbsp;</span></p><p style=\";text-align: right;font-family: Calibri;font-size: 14px;white-space: normal\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">中央民族大学新闻与传播学院</span></span></p><p style=\";text-align: right;font-family: Calibri;font-size: 14px;white-space: normal\"><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">2025年</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">12</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">月</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">14</span></span><span style=\"font-family: 仿宋;font-size: 19px\"><span style=\"font-family:仿宋\">日</span></span></p><p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal\"><span style=\"font-family: 仿宋;font-size: 19px\">&nbsp;</span></p><p><br/></p>"
}
