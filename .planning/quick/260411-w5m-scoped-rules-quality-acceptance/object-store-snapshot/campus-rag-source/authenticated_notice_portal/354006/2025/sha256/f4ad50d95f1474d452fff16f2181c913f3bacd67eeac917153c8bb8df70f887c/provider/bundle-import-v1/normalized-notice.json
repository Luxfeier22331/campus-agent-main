  ],
  "notice_content_html": "<p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">根据《关于开展</span><span style=\"font-family:宋体\">2026年“英才计划”硕博连读研究生招生工作的通知》，</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">本</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">院在</span><span style=\"font-family:宋体\">2026年博士研究生招生中招收硕博连读博士研究生。为规范此项工作，特制定本实施细则。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">一、招生专业</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">我院</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">中华民族共同体学专业</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">招收</span><span style=\"font-family:宋体\">“英才计划”硕博连读研究生。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">二、选拔对象</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">我校全日制非定向的学术学位、专业学位（三年制）二年级硕士研究生均可申请。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">三、申请条件</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（一）坚定对伟大祖国、中华民族、中华文化、中国共产党、中国特色社会主义的高度认同，维护祖国统一和民族团结，遵纪守法，品行端正，无任何违法违纪受处分记录，诚实守信，学风端正。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（二）已完成的专业必修课和专业选修课成绩均不低于</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">85</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">分，其他课程成绩均不低于</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">70</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">分。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（三）遵守学术道德，具备创新精神和培养潜质。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（四）至少有</span><span style=\"font-family:宋体\">2名所报考学科专业领域的教授或相当专业技术职称的专家（非申请人的硕士培养导师）做出书面推荐。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（五）硕博连读申报的博士专业一般应与硕士就读专业属于同一个一级学科。对于跨学位类型、跨一级学科的申请人，要具备跨学科的潜力和科研能力。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（六）身心健康，身体健康状况符合《普通高等学校招生体检工作指导意见》的相关要求。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（七）硕士研究生培养阶段发表高质量论文或参与省部级及以上课题者优先考虑。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">四、招生程序和时间安排</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（一）网上报名</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">1．报名时间：2025年12月10日—2026年1月10日</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">2．网上报名网址：https://yjszs.muc.edu.cn/（中央民族大学研究生招生平台）</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">3．网上报名程序</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">1）考生登录我校博士报名平台，进行注册。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">2）在网上填报报考信息、上传本人近期正面2寸免冠证件照和相关电子材料。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">3）网上支付200元报名费。网上支付报名费后，无论考生是否参加考试，一律不退还报名费。我校报名费只采取网上支付方式，不接收现场缴费和邮政汇款。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">4）网上报名须提交的电子材料</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">①网上报名系统中的博士报名表（从网上报名系统直接下载打印）；</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">②《中央民族大学2026年“英才计划”硕博连读申请表》（模板见附件1）；</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">③至少有2名所报考学科专业领域的教授或相当专业技术职称的专家（非申请人的硕士培养导师）做出书面推荐。</span></span><strong><span style=\"font-family: Arial;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">注意</span></span></strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">：签字部分务必由专家本人签字，务必为正高级（或相当职称）专业技术职称的专家，否则材料审核不合格；</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">④硕士阶段的成绩单（加盖学校研究生院公章，可使用新研究生系统成绩单彩打）；</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">⑤在学术期刊上发表的学术论文、重要的获奖证书、课题结项证书扫描件以及其他可以体现申请人科研能力的材料；</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">⑥个人陈述</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">个人陈述要使用国家通用语言文字，内容包括学习及学术研究经历、对报考专业及研究方向的认识及个人优势，字数不超过</span><span style=\"font-family:宋体\">2000字；跨学位类型、跨一级学科的申报人须提供跨学位类型、跨一级学科申报的缘由及攻读博士学位的基础与潜力说明。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\";font-family:宋体;font-size:16px\">⑦</span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">研究计划书</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">研究计划书包括申请人拟在攻读博士学位期间将要开展的研究问题、研究思路、文献综述、理论基础、已有的研究成果、研究内容设计、研究方法及研究创新性等内容，须使用国家通用语言文字写作</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">注：</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">材料需由原件清晰扫描为电子版，且按照以下编号排序合并为一个</span><span style=\"font-family:宋体\">PDF电子文件，加上封面和目录通过报名系统提交</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（二）网上报名注意事项</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">1）申请人按照招生专业（研究方向）进行报名，考试类别填写：硕博连读，报考类别：非定向。报名时可填报2位本专业（</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">中华民族共同体学</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">）的意向导师，但不按照意向导师进行排名和拟录取。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">2）申请人报名前务必仔细阅读学校公布的招生简章和学院公布的硕博连读招生通知，确认本人是否符合报考条件。须如实、准确提交报名信息和相关材料，不得弄虚作假。在任何阶段一旦发现不符合报考条件或提交的报考信息不真实，我校将取消其报考资格和录取资格，相关后果由申请人本人承担。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（</span><span style=\"font-family:宋体\">3）申请人报名时填报的姓名、身份证号必须与身份证件及学历、学位证书上的信息一致，如不一致，须提供相关部门的证明材料，因信息不一致引起的一切后果由考生自行承担。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（三）综合考核。</span><span style=\"font-family:宋体\">1月底前学院对申请硕博连读的考生进行资格审核，并组织符合条件的申请者进行综合考核。具体综合考核时间、地点安排将另行通知。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（四）学院审核公示。学院研究生招生委员会对符合录取条件的申请人依据最终成绩、思想政治表现、健康状况等</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">按照专业</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">择优确定拟录取名单，并进行公示，公示期为</span><span style=\"font-family:宋体\">5天。综合考核分数低于60分的考生不予录取</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">五、报考说明</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（一）</span><span style=\"font-family:宋体\">“英才计划”硕博连读招生报考阶段只报专业（</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">中华民族共同体学</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">），报名时填报的导师仅为意向导师，不按照意向导师进行排名和拟录取。后续由学院根据申请人导师志愿和学科需要，确定导师。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（二）</span><span style=\"font-family:宋体\">“英才计划”硕博连读研究生录取类别为非定向。定向就业的硕士研究生不能申请。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（三）</span><span style=\"font-family:宋体\">“英才计划”硕博连读招生人数占用学院普通招生计划，原则上不超过本专业（研究方向）普通计划招生总数的50%。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">六、学制及培养</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（一）基本学制为</span><span style=\"font-family:宋体\">6年（从硕士研究生阶段开始计算），最长学习年限按照《中央民族大学研究生学籍管理办法》执行。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">（二）硕士研究生阶段的第</span><span style=\"font-family:宋体\">5学期进行资格考核，资格考核“合格”者进入博士研究生阶段的学习，享受博士研究生待遇，达到博士研究生毕业要求和博士学位授予标准后，方可毕业，授予博士学位。若资格考核“不合格”，考核小组认为可完成硕士研究生学位学习者，经本人申请，导师同意，由培养单位签署意见后报研究生院审核，审核通过后继续按照原硕士阶段专业进行培养，达到硕士研究生毕业要求和硕士学位授予标准后，方可毕业，授予硕士学位。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">七、其他事项</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:26px;padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">咨询邮箱：</span></span><a href=\"mailto:zhmzgtt11@126.com\"><span style=\"text-decoration:underline;\"><span style=\"font-family: 宋体;color: rgb(0, 0, 255);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">zhmzgtt11@126.com</span></span></span></a></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:26px;padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">咨询电话：</span><span style=\"font-family:宋体\">83875355</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:26px;padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">办公地址</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">：</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\">&nbsp;<span style=\"font-family:宋体\">中央民族大学</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">海淀校区北智楼</span><span style=\"font-family:宋体\">226室</span></span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">。</span></span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\">&nbsp;</span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">八、本实施细则由</span></span></strong><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">中华民族共同体</span></span></strong><strong><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\"><span style=\"font-family:宋体\">学院负责解释。</span></span></strong></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph;line-height:24px\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px;background: rgb(255, 255, 255)\">&nbsp;</span></p><p style=\"margin-top:0;margin-right:0;margin-bottom:0;margin-left:0;text-indent:40px;padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:center;line-height:24px\"><span style=\"font-family: Arial;color: rgb(50, 50, 50);font-size: 20px\">&nbsp;</span></p><p style=\"margin: 0px; text-indent: 0px; padding: 0px; text-align: center; line-height: 24px;\"><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;中</span><span style=\"font-family: 宋体;color: rgb(50, 50, 50);letter-spacing: 0;font-size: 20px\">华民族共同体学院</span></p><p style=\"margin: 0px; text-indent: 0px; padding: 0px; text-align: center; line-height: 24px;\"><span style=\"color: rgb(50, 50, 50); font-family: 宋体; font-size: 20px; letter-spacing: 0px;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; 2025年12月16日</span></p><p><br/></p>"
