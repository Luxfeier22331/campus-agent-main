{
	"name": "dining-sync",
	"version": "0.1.0",
	"private": true,
	"description": "Dining Feishu/Lark source sync runtime for campus-agent.",
	"type": "module",
	"scripts": {
		"build:runtime": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outfile=dist/cli.mjs --external:pg --external:@aws-sdk/*",
		"test": "vitest run",
		"test:database-integration": "vitest run -c vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1081.0",
		"@aws-sdk/s3-request-presigner": "^3.1081.0",
		"@campus-agent/dining": "workspace:*",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.0.4",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.15.6",
		"esbuild": "0.28.1",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	}
}
