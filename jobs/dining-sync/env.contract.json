{
	"schema_version": "campus_env_contract.v1",
	"owner": "jobs/dining-sync",
	"consumers": [
		{
			"id": "config-loaders",
			"sources": [{ "kind": "typescript", "path": "jobs/dining-sync/src/config.ts" }]
		},
		{
			"id": "sync-runtime",
			"sources": [
				{
					"kind": "kubernetes",
					"path": "infra/k8s/dining-sync/runtime/configmap.yaml",
					"resources": ["dining-sync-config"]
				},
				{
					"kind": "kubernetes",
					"path": "infra/k8s/dining-sync/runtime/cronjob.yaml",
					"resources": ["dining-sync"]
				}
			]
		},
		{
			"id": "migration-command",
			"sources": [
				{
					"kind": "kubernetes",
					"path": "infra/k8s/dining-sync/migration/job.yaml",
					"resources": ["dining-migrate"]
				}
			]
		}
	],
	"keys": [
		{ "name": "DATABASE_URL", "class": "secret", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MIGRATION_DATABASE_URL", "class": "secret", "required_by": ["config-loaders", "migration-command"] },
		{ "name": "APP_API_ENVIRONMENT", "class": "config", "required_by": ["config-loaders"] },
		{ "name": "DINING_LARK_APP_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_APP_SECRET", "class": "secret", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_BASE_TOKEN", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_CAMPUS_TABLE_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_DISH_TABLE_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_HALL_TABLE_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_REVIEW_TABLE_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_REVIEW_VIEW_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_LARK_STALL_TABLE_ID", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MODERATION_API_KEY", "class": "secret", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MODERATION_BASE_URL", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MODERATION_IMAGE_MODEL", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MODERATION_TEXT_MODEL", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_MODERATION_TIMEOUT_MS", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "OBJECT_STORE_ENDPOINT", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "OBJECT_STORE_REGION", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "OBJECT_STORE_DERIVED_ACCESS_KEY", "class": "secret", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "OBJECT_STORE_DERIVED_SECRET_KEY", "class": "secret", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_OBJECT_STORE_BUCKET", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_OBJECT_STORE_PUBLIC_BASE_URL", "class": "config", "required_by": ["config-loaders", "sync-runtime"] },
		{ "name": "DINING_OBJECT_STORE_REVIEW_PREFIX", "class": "config", "required_by": ["config-loaders", "sync-runtime"] }
	],
	"retired_names": ["DINING_LARK_BASE_ID", "OBJECT_STORE_ACCESS_KEY", "OBJECT_STORE_SECRET_KEY"]
}
