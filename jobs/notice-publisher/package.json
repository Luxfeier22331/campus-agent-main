{
	"name": "notice-publisher",
	"version": "0.1.0",
	"private": true,
	"description": "Explicit internal portal notice normalization publisher.",
	"type": "module",
	"scripts": {
		"backfill-attachment-links": "tsx src/cli.ts backfill-attachment-links",
		"migrate": "tsx src/cli.ts migrate",
		"publish": "tsx src/cli.ts publish",
		"test": "vitest run --exclude 'test/**/*.integration.test.ts'",
		"test:migration-integration": "vitest run -c vitest.migration-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1081.0",
		"@campus-agent/notices": "workspace:*",
		"ingestion-contracts": "workspace:*",
		"pg": "^8.22.0",
		"tsx": "^4.23.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.0.4",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.15.6",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
}
