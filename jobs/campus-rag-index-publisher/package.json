{
	"name": "campus-rag-index-publisher",
	"version": "0.1.0",
	"private": true,
	"description": "Unified immutable Campus Docs and Notices Qdrant serving index publisher.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "bash scripts/build.sh",
		"publish-index": "tsx src/cli.ts publish-index",
		"publish-index-local": "node --env-file=.env.local --import=tsx src/local-cli.ts",
		"import-artifacts-local": "node --env-file=.env.local --import=tsx src/import-local-cli.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@campus-agent/embedding-runtime": "workspace:*",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"exports": {
		"./catalog": "./src/catalog.ts",
		"./publisher": "./src/publisher.ts",
		"./run": "./src/run.ts",
		"./types": "./src/types.ts",
		"./artifacts": "./src/artifacts.ts",
		"./artifact-import": "./src/artifact-import.ts",
		"./object-store": "./src/object-store.ts",
		"./qdrant": "./src/qdrant.ts"
	}
}
