{
	"name": "document-ocr",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"ocr": "tsx src/local-cli.ts",
		"build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js --external:pg --external:@aws-sdk/client-s3 --external:jsdom",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@campus-agent/document-ocr": "workspace:*",
		"@campus-agent/notice-database": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"jsdom": "^30.0.1",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@types/jsdom": "^30.0.0",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
