{
	"name": "notice-classifier",
	"version": "0.1.0",
	"private": true,
	"description": "Title-only notice classification job and shared classification core.",
	"type": "module",
	"scripts": {
		"build": "esbuild ./src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js --external:pg",
		"classify": "tsx src/cli.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@campus-agent/notice-database": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"campus-contracts": "workspace:*",
		"ingestion-contracts": "workspace:*",
		"notice-classifier-core": "workspace:*",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"license": "Apache-2.0",
	"exports": { "./job": "./src/job.ts", "./model": "./src/model.ts" }
}
