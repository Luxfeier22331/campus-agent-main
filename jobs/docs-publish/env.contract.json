{
	"schema_version": "campus_env_contract.v1",
	"owner": "jobs/docs-publish",
	"consumers": [
		{
			"id": "release-command",
			"sources": [
				{ "kind": "typescript", "path": "jobs/docs-publish/src" },
				{
					"kind": "kubernetes",
					"path": "infra/k8s/docs-publish/base/job.yaml",
					"resources": ["docs-publish"]
				}
			]
		}
	],
	"keys": [
		{ "name": "OBJECT_STORE_ENDPOINT", "class": "config", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "OBJECT_STORE_REGION", "class": "config", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "OBJECT_STORE_BUCKET_DERIVED", "class": "config", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "OBJECT_STORE_DERIVED_ACCESS_KEY", "class": "secret", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "OBJECT_STORE_DERIVED_SECRET_KEY", "class": "secret", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "DOCS_PUBLISH_DATABASE_URL", "class": "secret", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "DOCS_PUBLISH_DATABASE_SSLMODE", "class": "config", "required_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] },
		{ "name": "DOCS_PUBLISH_DATABASE_CA_CERT_PATH", "class": "config", "required_by": [], "optional_by": ["release-command"], "templates": ["env/commands/campus-docs-release.env.example"] }
	],
	"retired_names": ["DOCS_PUBLISH_OBJECT_STORE_ACCESS_KEY", "DOCS_PUBLISH_OBJECT_STORE_SECRET_KEY"]
}
