{
	"name": "internal-portal-collection",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "One-shot internal portal notice and file collection job.",
	"scripts": {
		"build": "esbuild adapters/internal-portal/src/collection-job.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/collection-job.js --external:@aws-sdk/client-s3 --external:content-disposition --external:dotenv --external:jsdom --external:mime-types --external:pg --external:tldts --external:undici && node ./dist/collection-job.js --help",
		"auth:check": "tsx adapters/internal-portal/src/auth-cli.ts check",
		"auth:pull": "tsx adapters/internal-portal/src/auth-cli.ts pull",
		"collect": "tsx adapters/internal-portal/src/collection-cli.ts",
		"state-versions": "tsx adapters/internal-portal/src/state-version-maintenance-cli.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run -c vitest.fast.config.mts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@campus-agent/internal-portal-client": "workspace:*",
		"@campus-agent/notice-database": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"campus-contracts": "workspace:*",
		"content-disposition": "^3.0.0",
		"dotenv": "^17.4.2",
		"ingestion-contracts": "workspace:*",
		"jsdom": "^30.0.1",
		"mime-types": "^3.0.2",
		"pg": "^8.22.0",
		"tldts": "^7.4.13",
		"undici": "^8.10.2"
	},
	"devDependencies": {
		"@types/content-disposition": "^0.5.9",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"license": "Apache-2.0",
	"exports": {
		"./collection-command": "./adapters/internal-portal/src/collection-command.ts",
		"./config": "./adapters/internal-portal/src/config.ts",
		"./ops-web-credential-resolver": "./adapters/internal-portal/src/ops-web-credential-resolver.ts"
	}
}
