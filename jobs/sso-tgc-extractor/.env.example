# SSO_TGC 提取器运行环境
# 复制到 .env 并填入实际值。不要将真实凭据提交到仓库。

SSO_TGC_EXTRACTOR_USERNAME=
SSO_TGC_EXTRACTOR_PASSWORD=

SSO_TGC_EXTRACTOR_LOGIN_URL=https://ca.muc.edu.cn/zfca/login?service=http%3A%2F%2Fmy.muc.edu.cn%2Fuser%2FsimpleSSOLogin
SSO_TGC_EXTRACTOR_PORTAL_URL=https://my.muc.edu.cn/
SSO_TGC_EXTRACTOR_COOKIE_NAME=SSO_TGC

# 同步模式所需的 Ops Web 自动化 API 配置。
# GitHub Actions 运行仓库和本地运行都从 Ops Web 页面取得 endpoint 和 token。
# --dry-run 不需要以下两个变量。
SSO_TGC_EXTRACTOR_AUTOMATION_URL=
SSO_TGC_EXTRACTOR_AUTOMATION_TOKEN=

# 要同步的 Ops Web 凭据名称。首次运行自动创建，后续运行复用该名称对应的记录。
SSO_TGC_EXTRACTOR_CREDENTIAL_NAME=

# 提取行为
SSO_TGC_EXTRACTOR_HEADED=false
SSO_TGC_EXTRACTOR_RETRY_TIMES=3
SSO_TGC_EXTRACTOR_RETRY_DELAY=5000

# 浏览器状态持久化目录（留空则每次全新登录）
SSO_TGC_EXTRACTOR_STORAGE_STATE_DIR=
