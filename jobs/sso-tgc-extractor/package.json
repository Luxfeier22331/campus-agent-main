{
	"name": "sso-tgc-extractor",
	"version": "0.2.0",
	"private": true,
	"description": "通过 Playwright 自动提取中央民族大学统一身份认证 SSO_TGC 凭据，并通过 Ops Web 自动化 API 轮换。",
	"type": "module",
	"scripts": {
		"extract": "tsx src/cli.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"playwright": "^1.61.1"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	}
}
