{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/campus-docs/**",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-course-maps.v1.schema.json",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-reader.v3.schema.json",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-source.v4.schema.json",
				"$TURBO_ROOT$/packages/embedding-runtime/package.json",
				"$TURBO_ROOT$/packages/embedding-runtime/src/**"
			],
			"outputs": ["dist/**"]
		},
		"test": { "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"] },
		"test:database-integration": {
			"inputs": [
				"package.json",
				"src/catalog.ts",
				"src/types.ts",
				"test/catalog.database.integration.test.ts",
				"vitest.database-integration.config.mts"
			]
		},
		"typecheck": { "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"] }
	}
}
