		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1109.0",
		"ajv": "^8.20.0",
		"pg": "^8.23.0",
		"tsx": "^4.23.12"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.1.0",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.21.0",
		"testcontainers": "12.1.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
