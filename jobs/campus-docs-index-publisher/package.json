{
	"name": "campus-docs-index-publisher",
	"version": "0.1.0",
	"private": true,
	"description": "Campus Web 文档当前版本的不可变 Qdrant 索引发布任务。",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { force: true, recursive: true })\" && esbuild ./src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js --external:@aws-sdk/client-s3 --external:pg && node --input-type=module -e \"import('./dist/cli.js')\"",
		"build-chunks": "node --env-file=.env.local --import=tsx src/local-chunk-cli.ts",
		"build-embeddings": "node --env-file=../../.env --import=tsx src/local-embedding-cli.ts",
		"publish-index-local": "node --env-file=.env.local --import=tsx src/local-publish-cli.ts",
		"review-chunks-local": "node --env-file=.env.local --import=tsx src/local-chunk-governance-cli.ts",
		"summarize-chunk-review-labels-local": "tsx src/local-chunk-review-labels-cli.ts",
		"compare-chunks-local": "tsx src/local-chunk-comparison-cli.ts",
		"evaluate-chunks-local": "node --env-file=../../.env --import=tsx src/local-chunk-embedding-evaluation-cli.ts",
		"test": "vitest run --exclude 'test/**/*.database.integration.test.ts'",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@campus-agent/embedding-runtime": "workspace:*",
		"@aws-sdk/client-s3": "^3.1109.0",
		"campus-contracts": "workspace:*",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.1.0",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.21.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12",
		"testcontainers": "12.1.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
