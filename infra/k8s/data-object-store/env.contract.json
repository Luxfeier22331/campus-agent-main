{
	"schema_version": "campus_env_contract.v1",
	"owner": "infra/k8s/data-object-store",
	"consumers": [
		{
			"id": "local-compose",
			"sources": [
				{
					"kind": "compose",
					"path": "infra/local/docker-compose.object-store.yml",
					"services": ["minio"]
				}
			]
		},
		{
			"id": "server",
			"sources": [
				{
					"kind": "kubernetes",
					"path": "infra/k8s/data-object-store/base/workload.yaml",
					"resources": ["object-store"]
				}
			]
		},
		{
			"id": "bootstrap",
			"sources": [
				{
					"kind": "kubernetes",
					"path": "infra/k8s/data-object-store/base/bootstrap.yaml",
					"resources": ["object-store-bootstrap"]
				}
			]
		}
	],
	"keys": [
		{ "name": "MINIO_BROWSER", "class": "config", "required_by": ["server"] },
		{ "name": "MINIO_ROOT_USER", "class": "secret", "required_by": ["local-compose", "server", "bootstrap"] },
		{ "name": "MINIO_ROOT_PASSWORD", "class": "secret", "required_by": ["local-compose", "server", "bootstrap"] },
		{ "name": "OBJECT_STORE_SOURCE_ACCESS_KEY", "class": "secret", "required_by": ["bootstrap"] },
		{ "name": "OBJECT_STORE_SOURCE_SECRET_KEY", "class": "secret", "required_by": ["bootstrap"] },
		{ "name": "OBJECT_STORE_DERIVED_ACCESS_KEY", "class": "secret", "required_by": ["bootstrap"] },
		{ "name": "OBJECT_STORE_DERIVED_SECRET_KEY", "class": "secret", "required_by": ["bootstrap"] },
		{ "name": "MC_CONFIG_DIR", "class": "config", "required_by": ["bootstrap"] }
	],
	"retired_names": ["OBJECT_STORE_ACCESS_KEY", "OBJECT_STORE_SECRET_KEY"]
}
