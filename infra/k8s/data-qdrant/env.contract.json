{
	"schema_version": "campus_env_contract.v1",
	"owner": "infra/k8s/data-qdrant",
	"consumers": [
		{
			"id": "local-compose",
			"sources": [
				{
					"kind": "compose",
					"path": "infra/local/docker-compose.qdrant.yml",
					"services": ["qdrant"]
				},
				{
					"kind": "compose",
					"path": "infra/local/docker-compose.qdrant-tls.yml",
					"services": ["qdrant"]
				}
			]
		}
	],
	"keys": [
		{ "name": "QDRANT_API_KEY", "class": "secret", "required_by": ["local-compose"] },
		{ "name": "QDRANT_READ_ONLY_API_KEY", "class": "secret", "required_by": ["local-compose"] },
		{ "name": "QDRANT_HOST", "class": "config", "required_by": [], "optional_by": ["local-compose"] },
		{ "name": "QDRANT_HTTP_PORT", "class": "config", "required_by": [], "optional_by": ["local-compose"] },
		{ "name": "QDRANT_GRPC_PORT", "class": "config", "required_by": [], "optional_by": ["local-compose"] },
		{ "name": "QDRANT_STORAGE_DIR", "class": "config", "required_by": [], "optional_by": ["local-compose"] },
		{ "name": "QDRANT_SNAPSHOTS_DIR", "class": "config", "required_by": [], "optional_by": ["local-compose"] },
		{ "name": "QDRANT_TLS_DIR", "class": "config", "required_by": ["local-compose"], "delivery": "file" }
	]
}
