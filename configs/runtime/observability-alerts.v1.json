{
	"schema_version": "runtime-observability-alerts-v1",
	"alert_version": "observability-alerts-v1",
	"rules": [
		{
			"id": "stage.stream_ttft.p95.warn",
			"signal": "stage_latency_p95",
			"severity": "ticket",
			"window": "15m",
			"stage_field": "stream.browser_ttft_ms",
			"threshold": {
				"operator": "gte",
				"value": 2500,
				"unit": "ms"
			},
			"runbook_anchor": "#stage-latency",
			"enabled": true
		},
		{
			"id": "stage.agent_runtime.p95.warn",
			"signal": "stage_latency_p95",
			"severity": "ticket",
			"window": "15m",
			"stage_field": "agent.runtime_ms",
			"threshold": {
				"operator": "gte",
				"value": 6000,
				"unit": "ms"
			},
			"runbook_anchor": "#stage-latency",
			"enabled": true
		},
		{
			"id": "requests.error_rate.page",
			"signal": "request_error_rate",
			"severity": "page",
			"window": "15m",
			"threshold": {
				"operator": "gte",
				"value": 0.02,
				"unit": "ratio"
			},
			"runbook_anchor": "#request-errors",
			"enabled": true
		},
		{
			"id": "projection.outbox_stale.ticket",
			"signal": "projection_outbox_stale",
			"severity": "ticket",
			"window": "15m",
			"threshold": {
				"operator": "gte",
				"value": 1,
				"unit": "count"
			},
			"runbook_anchor": "#projection-outbox",
			"enabled": true
		},
		{
			"id": "telemetry.export_failure.ticket",
			"signal": "telemetry_export_failure",
			"severity": "ticket",
			"window": "15m",
			"threshold": {
				"operator": "gte",
				"value": 1,
				"unit": "count"
			},
			"runbook_anchor": "#telemetry-export",
			"enabled": true
		},
		{
			"id": "trace.missing_rate.ticket",
			"signal": "missing_trace_rate",
			"severity": "ticket",
			"window": "1h",
			"threshold": {
				"operator": "gte",
				"value": 0.05,
				"unit": "ratio"
			},
			"runbook_anchor": "#trace-correlation",
			"enabled": true
		}
	]
}
