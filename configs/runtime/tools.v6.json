{
	"schema_version": "tool-registry-v6",
	"registry_version": "2026-08-22",
	"tools": [
		{
			"name": "campus_search",
			"description": "检索中央民族大学当前 Campus Web 文档中的校内事实、政策和办事流程。",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-search-tool-contracts.v1.schema.json#/$defs/CampusSearchPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-search-tool-contracts.v1.schema.json#/$defs/CampusSearchResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/campus/search"
			},
			"timeout_ms": 12000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "personal_memory_recall",
			"description": "仅在有助于回答或消除当前问题歧义时，检索用户的私有个人记忆。",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/personal-memory-tool-contracts.v1.schema.json#/$defs/PersonalMemoryRecallPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/personal-memory-tool-contracts.v1.schema.json#/$defs/PersonalMemoryRecallResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/memory/personal/recall"
			},
			"timeout_ms": 12000,
			"result_projection_policy": "bounded_json"
		}
	]
}
