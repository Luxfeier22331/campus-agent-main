{
	"schema_version": "tool-registry-v5",
	"registry_version": "2026-07-13",
	"tools": [
		{
			"name": "transport_schedule_lookup",
			"description": "Use only for official campus shuttle routes, departures, timetables, and service windows.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-services-tool-contracts.v1.schema.json#/$defs/TransportScheduleLookupPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-services-tool-contracts.v1.schema.json#/$defs/TransportScheduleLookupResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/campus-services/transport-schedule"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "knowledge_query",
			"description": "Use for institution-specific claims that require published campus evidence, such as policies, regulations, or curricula. Do not use for shuttle schedules, general conversation, or unopened sources.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v2.schema.json#/$defs/KnowledgeQueryPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v2.schema.json#/$defs/KnowledgeAgentTerminalResult",
			"handler": {
				"type": "agent_handoff",
				"target": "knowledge_agent"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "knowledge_search",
			"description": "Search one runtime-provided published knowledge target with a focused query. Search history only for explicit prior-version, as-of-date, or comparison questions.",
			"exposure": "internal_only",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v2.schema.json#/$defs/KnowledgeSearchPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v2.schema.json#/$defs/KnowledgeSearchResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/knowledge/search"
			},
			"timeout_ms": 12000,
			"result_projection_policy": "bounded_json"
		}
	]
}
