{
	"schema_version": "tool-registry-v4",
	"registry_version": "2026-06-26",
	"tools": [
		{
			"name": "knowledge_query",
			"description": "Route this turn to the governed knowledge retrieval and grounded answer workflow when campus regulations, curriculum, official-web facts, or institutional account/network/auth/portal policy facts are needed.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v1.schema.json#/$defs/KnowledgeQuerySignalPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/knowledge-tool-contracts.v1.schema.json#/$defs/KnowledgeQuerySignalResult",
			"handler": {
				"type": "workflow_signal"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "public_web_search",
			"description": "Search current public MUC official-web pages for evidence when governed RAG is missing or likely stale. Use only for public official website facts, guides, and notices.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/public-web-tool-contracts.v1.schema.json#/$defs/PublicWebSearchPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/public-web-tool-contracts.v1.schema.json#/$defs/PublicWebSearchResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/public-web/search"
			},
			"timeout_ms": 12000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "transport_schedule_lookup",
			"description": "Lookup campus shuttle schedule snapshots, departures, and service windows.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-services-tool-contracts.v1.schema.json#/$defs/TransportScheduleLookupPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/campus-services-tool-contracts.v1.schema.json#/$defs/TransportScheduleLookupResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/campus-services/transport-schedule"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "campus_notice_discover",
			"description": "Discover governed campus notices by topic, family, and target surface.",
			"exposure": "model_visible",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeDiscoverPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeDiscoverResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/notices/discover"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "campus_notice_get",
			"description": "Internal selected notice resolution function; not exposed as a model-facing tool.",
			"exposure": "internal_only",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeGetPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeGetResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/notices/get"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "campus_notice_period_summary",
			"description": "Summarize governed campus notices over a bounded date range from the notice read model.",
			"exposure": "closed",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticePeriodSummaryPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticePeriodSummaryResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/notices/period-summary"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		},
		{
			"name": "campus_notice_change_set_lookup",
			"description": "Lookup admitted transport notice change-set overrides from bounded notice/runtime truth.",
			"exposure": "closed",
			"read_only": true,
			"requires_approval": false,
			"payload_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeChangeSetLookupPayload",
			"result_schema_ref": "https://muc.wiki/campus-agent/schemas/notice-tool-contracts.v1.schema.json#/$defs/CampusNoticeChangeSetLookupResult",
			"handler": {
				"type": "execution_control_internal_query",
				"endpoint": "/internal/query/notices/change-set"
			},
			"timeout_ms": 1000,
			"result_projection_policy": "bounded_json"
		}
	]
}
