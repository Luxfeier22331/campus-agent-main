{
	"schema_version": "campus_execution_control_runtime_config.v1",
	"max_concurrent_answers": 8,
	"queue_capacity": 24,
	"queue_timeout_ms": 3000,
	"request_timeout_ms": 180000,
	"request_body_limit_bytes": 1048576,
	"shutdown_grace_ms": 180000,
	"query_serving_scopes_path": "/etc/campus-agent/query-serving-scopes.v3.json",
	"tool_read_model_timeout_ms": 1000,
	"otel": {
		"enabled": true,
		"endpoint": "http://otel-collector:4318/v1/traces",
		"metrics_enabled": true,
		"metrics_endpoint": "http://otel-collector:4318/v1/metrics",
		"service_name": "campus-execution-control",
		"export_timeout_ms": 1000,
		"export_interval_ms": 15000,
		"sample_ratio": 1,
		"allowed_attributes_version": "execution-control-otel-attrs-v1",
		"temporal_tracing_enabled": true
	},
	"knowledge_search": {
		"top_k_max": 8,
		"embedding_timeout_ms": 10000,
		"qdrant_timeout_ms": 60000
	},
	"personal_memory": {
		"runtime": "hindsight",
		"timeout_seconds": 90,
		"recall_limit": 8,
		"recall_max_tokens": 2500,
		"context_char_budget": 2500
	}
}
