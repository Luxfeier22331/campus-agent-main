{
	"schema_version": "tool-function-schemas-v3",
	"tools": [
		{
			"type": "function",
			"name": "personal_memory_recall",
			"description": "Recall private user memory only when it can help answer or disambiguate the current request.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query": {
						"type": "string",
						"description": "A focused memory query derived from the current user request.",
						"minLength": 1,
						"maxLength": 400
					}
				},
				"required": ["query"]
			}
		},
		{
			"type": "function",
			"name": "transport_schedule_lookup",
			"description": "Use only for official campus shuttle routes, departures, timetables, and service windows.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original transport schedule question."
					},
					"intent": {
						"type": "string",
						"description": "Transport schedule lookup intent.",
						"enum": [
							"next_departure",
							"first_departure",
							"last_departure",
							"departure_list",
							"service_window",
							"timetable",
							"schedule_snapshot_metadata"
						]
					},
					"route_selector": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"route_id": {
								"type": ["string", "null"],
								"description": "Known route id if already resolved."
							},
							"service_family": {
								"type": ["string", "null"],
								"description": "Service family such as intercampus or metro shuttle."
							},
							"route_variant_query": {
								"type": ["string", "null"],
								"description": "Route variant words from the user query."
							},
							"origin_campus": {
								"type": ["string", "null"],
								"description": "Origin campus if stated."
							},
							"destination_campus": {
								"type": ["string", "null"],
								"description": "Destination campus if stated."
							},
							"origin_stop_query": {
								"type": ["string", "null"],
								"description": "Origin stop if stated."
							},
							"destination_stop_query": {
								"type": ["string", "null"],
								"description": "Destination stop if stated."
							}
						},
						"required": [
							"route_id",
							"service_family",
							"route_variant_query",
							"origin_campus",
							"destination_campus",
							"origin_stop_query",
							"destination_stop_query"
						],
						"description": "Optional route selection hints."
					},
					"snapshot_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"service_time_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"date_mode": {
								"type": ["string", "null"],
								"description": "Service date interpretation.",
								"enum": ["today", "tomorrow", "date", null]
							},
							"service_date": {
								"type": ["string", "null"],
								"description": "ISO date when date_mode is date."
							},
							"daypart": {
								"type": ["string", "null"],
								"description": "Requested daypart.",
								"enum": ["morning", "afternoon", "evening", "all_day", null]
							},
							"departure_not_before": {
								"type": ["string", "null"],
								"description": "Lower bound departure time in HH:MM if stated."
							},
							"departure_not_after": {
								"type": ["string", "null"],
								"description": "Upper bound departure time in HH:MM if stated."
							}
						},
						"required": [
							"date_mode",
							"service_date",
							"daypart",
							"departure_not_before",
							"departure_not_after"
						],
						"description": "Optional service time constraints."
					},
					"result_limit": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum result count.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"intent",
					"route_selector",
					"snapshot_query",
					"service_time_query",
					"result_limit"
				]
			}
		}
	]
}
