{
	"schema_version": "tool-function-schemas-v1",
	"tools": [
		{
			"type": "function",
			"name": "knowledge_query",
			"description": "Route this turn to the governed knowledge retrieval and grounded answer workflow when campus regulations, curriculum, or official-web facts are needed.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original knowledge question to answer with governed retrieval."
					},
					"intent": {
						"type": ["string", "null"],
						"description": "Knowledge workflow intent.",
						"enum": ["answer_question", "compare_rules", "clarify_scope", null]
					}
				},
				"required": ["query_text", "intent"]
			}
		},
		{
			"type": "function",
			"name": "service_status_lookup",
			"description": "Lookup current or temporally qualified campus service status.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"subject_query": {
						"type": "string",
						"description": "Campus service, facility, or operation to check."
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"campus_scope": {
						"type": ["string", "null"],
						"description": "Optional campus scope such as haidian or fengtai."
					}
				},
				"required": ["subject_query", "temporal_query", "campus_scope"]
			}
		},
		{
			"type": "function",
			"name": "service_guide_lookup",
			"description": "Lookup stable campus service guide entries and current release material.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"service_query": {
						"type": "string",
						"description": "Campus service or process to explain."
					},
					"guide_focus": {
						"type": "string",
						"description": "Requested service guide section.",
						"enum": [
							"overview",
							"procedure",
							"required_materials",
							"entry",
							"office_hours",
							"contact",
							"eligibility",
							"full_guide"
						]
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"campus_scope": {
						"type": ["string", "null"],
						"description": "Optional campus scope such as haidian or fengtai."
					},
					"audience": {
						"type": ["string", "null"],
						"description": "Audience for the guide.",
						"enum": ["student", "faculty", "visitor", "unknown", null]
					},
					"result_limit": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum result count.",
						"minimum": 1
					}
				},
				"required": [
					"service_query",
					"guide_focus",
					"temporal_query",
					"campus_scope",
					"audience",
					"result_limit"
				]
			}
		},
		{
			"type": "function",
			"name": "transport_schedule_lookup",
			"description": "Lookup campus shuttle schedule snapshots, departures, and service windows.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original transport schedule question."
					},
					"intent": {
						"type": "string",
						"description": "Transport schedule lookup intent.",
						"enum": [
							"next_departure",
							"first_departure",
							"last_departure",
							"departure_list",
							"service_window",
							"timetable",
							"schedule_snapshot_metadata"
						]
					},
					"route_selector": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"route_id": {
								"type": ["string", "null"],
								"description": "Known route id if already resolved."
							},
							"service_family": {
								"type": ["string", "null"],
								"description": "Service family such as intercampus or metro shuttle."
							},
							"route_variant_query": {
								"type": ["string", "null"],
								"description": "Route variant words from the user query."
							},
							"origin_campus": {
								"type": ["string", "null"],
								"description": "Origin campus if stated."
							},
							"destination_campus": {
								"type": ["string", "null"],
								"description": "Destination campus if stated."
							},
							"origin_stop_query": {
								"type": ["string", "null"],
								"description": "Origin stop if stated."
							},
							"destination_stop_query": {
								"type": ["string", "null"],
								"description": "Destination stop if stated."
							}
						},
						"required": [
							"route_id",
							"service_family",
							"route_variant_query",
							"origin_campus",
							"destination_campus",
							"origin_stop_query",
							"destination_stop_query"
						],
						"description": "Optional route selection hints."
					},
					"snapshot_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"service_time_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"date_mode": {
								"type": ["string", "null"],
								"description": "Service date interpretation.",
								"enum": ["today", "tomorrow", "date", null]
							},
							"service_date": {
								"type": ["string", "null"],
								"description": "ISO date when date_mode is date."
							},
							"daypart": {
								"type": ["string", "null"],
								"description": "Requested daypart.",
								"enum": ["morning", "afternoon", "evening", "all_day", null]
							},
							"departure_not_before": {
								"type": ["string", "null"],
								"description": "Lower bound departure time in HH:MM if stated."
							},
							"departure_not_after": {
								"type": ["string", "null"],
								"description": "Upper bound departure time in HH:MM if stated."
							}
						},
						"required": [
							"date_mode",
							"service_date",
							"daypart",
							"departure_not_before",
							"departure_not_after"
						],
						"description": "Optional service time constraints."
					},
					"result_limit": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum result count.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"intent",
					"route_selector",
					"snapshot_query",
					"service_time_query",
					"result_limit"
				]
			}
		},
		{
			"type": "function",
			"name": "contact_directory_lookup",
			"description": "Lookup governed campus contact directory records.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original contact directory question."
					},
					"contact_focus": {
						"type": "string",
						"description": "Requested contact information focus.",
						"enum": ["phone", "email", "location", "office_hours", "contact_person", "all_contacts"]
					},
					"entity_selector": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"contact_id": {
								"type": ["string", "null"],
								"description": "Known contact id if already resolved."
							},
							"department_query": {
								"type": ["string", "null"],
								"description": "Department name fragment."
							},
							"office_query": {
								"type": ["string", "null"],
								"description": "Office name fragment."
							},
							"service_query": {
								"type": ["string", "null"],
								"description": "Service or task the contact should support."
							},
							"person_query": {
								"type": ["string", "null"],
								"description": "Person name fragment."
							},
							"role_query": {
								"type": ["string", "null"],
								"description": "Role name fragment."
							},
							"purpose_query": {
								"type": ["string", "null"],
								"description": "Reason for contacting."
							},
							"contact_group_query": {
								"type": ["string", "null"],
								"description": "Contact group fragment."
							},
							"location_query": {
								"type": ["string", "null"],
								"description": "Location fragment."
							}
						},
						"required": [
							"contact_id",
							"department_query",
							"office_query",
							"service_query",
							"person_query",
							"role_query",
							"purpose_query",
							"contact_group_query",
							"location_query"
						],
						"description": "Optional selector for the contact entity to resolve."
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"campus_scope": {
						"type": ["string", "null"],
						"description": "Optional campus scope such as haidian or fengtai."
					},
					"audience": {
						"type": ["string", "null"],
						"description": "Audience for the contact.",
						"enum": ["student", "faculty", "visitor", "unknown", null]
					},
					"result_limit": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum result count.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"contact_focus",
					"entity_selector",
					"temporal_query",
					"campus_scope",
					"audience",
					"result_limit"
				]
			}
		},
		{
			"type": "function",
			"name": "academic_calendar_lookup",
			"description": "Lookup governed academic calendar facts such as teaching week, holiday and makeup-class arrangement.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original academic calendar fact question."
					},
					"query_kind": {
						"type": "string",
						"description": "Deterministic academic calendar fact query kind.",
						"enum": [
							"date_week",
							"named_event_range",
							"day_status",
							"class_day_pattern",
							"term_window"
						]
					},
					"answer_focus": {
						"type": ["string", "null"],
						"description": "Optional answer focus for the academic calendar query.",
						"enum": [
							"teaching_week",
							"holiday_duration",
							"campus_break_window",
							"course_adjustment",
							"day_status",
							"term_window",
							"official_notice_reference",
							null
						]
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"academic_year_label": {
						"type": ["string", "null"],
						"description": "Optional explicit academic year label such as 2026-2027学年."
					},
					"date_hint": {
						"type": ["string", "null"],
						"description": "Optional ISO date to resolve week, holiday, or makeup-class arrangement."
					},
					"event_query": {
						"type": ["string", "null"],
						"description": "Optional named event query such as 春假 or 劳动节."
					},
					"target_date": {
						"type": ["string", "null"],
						"description": "Optional ISO date being queried."
					},
					"audience": {
						"type": ["string", "null"],
						"description": "Optional audience such as student or faculty."
					},
					"term_label": {
						"type": ["string", "null"],
						"description": "Optional term label such as 春季学期."
					}
				},
				"required": [
					"query_text",
					"query_kind",
					"answer_focus",
					"temporal_query",
					"academic_year_label",
					"date_hint",
					"event_query",
					"target_date",
					"audience",
					"term_label"
				]
			}
		},
		{
			"type": "function",
			"name": "campus_notice_change_set_lookup",
			"description": "Lookup admitted transport notice change-set overrides from bounded notice/runtime truth.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original transport notice override question."
					},
					"route_labels": {
						"type": ["array", "null"],
						"description": "Optional admitted route labels.",
						"items": {
							"type": "string",
							"description": "Optional admitted route labels."
						}
					},
					"direction_labels": {
						"type": ["array", "null"],
						"description": "Optional admitted direction labels.",
						"items": {
							"type": "string",
							"description": "Optional admitted direction labels."
						}
					},
					"stop_labels": {
						"type": ["array", "null"],
						"description": "Optional admitted stop labels.",
						"items": {
							"type": "string",
							"description": "Optional admitted stop labels."
						}
					},
					"service_date": {
						"type": ["string", "null"],
						"description": "Optional ISO local service date."
					},
					"query_time_anchor": {
						"type": ["string", "null"],
						"description": "Optional RFC3339 query time anchor."
					}
				},
				"required": [
					"query_text",
					"route_labels",
					"direction_labels",
					"stop_labels",
					"service_date",
					"query_time_anchor"
				]
			}
		},
		{
			"type": "function",
			"name": "campus_notice_discover",
			"description": "Discover governed campus notices by topic, family, and target surface.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original notice discovery question."
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal constraint for notice discovery."
					},
					"source_families": {
						"type": ["array", "null"],
						"description": "Allowed notice source families.",
						"items": {
							"type": "string",
							"description": "Allowed notice source families.",
							"enum": [
								"official_web_public_notice",
								"internal_notice_restricted",
								"wechat_public_notice"
							]
						}
					},
					"target_surfaces": {
						"type": ["array", "null"],
						"description": "Allowed notice target surfaces.",
						"items": {
							"type": "string",
							"description": "Allowed notice target surfaces.",
							"enum": [
								"notice_level_query",
								"procurement_notice_history",
								"regulations/*",
								"regulations/student_rules",
								"regulations/institutional_rules",
								"regulations/scoped_rules",
								"campus_services/service_status_candidate",
								"campus_services/special_service_candidate",
								"campus_services/stable_contact_candidate",
								"publication_surface_candidate",
								"multimodal_processing_candidate",
								"unsupported"
							]
						}
					},
					"max_results": {
						"type": ["integer", "null"],
						"description": "Positive maximum number of notice cards.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"temporal_query",
					"source_families",
					"target_surfaces",
					"max_results"
				]
			}
		},
		{
			"type": "function",
			"name": "campus_notice_period_summary",
			"description": "Summarize governed campus notices over a bounded date range from the notice read model.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original notice period summary question."
					},
					"date_range": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"start_date": {
								"type": "string",
								"description": "Inclusive start date in YYYY-MM-DD."
							},
							"end_date": {
								"type": "string",
								"description": "Inclusive end date in YYYY-MM-DD."
							},
							"timezone": {
								"type": ["string", "null"],
								"description": "IANA timezone for date interpretation."
							}
						},
						"required": ["start_date", "end_date", "timezone"],
						"description": "Bounded notice publication date range."
					},
					"source_families": {
						"type": ["array", "null"],
						"description": "Allowed notice source families.",
						"items": {
							"type": "string",
							"description": "Allowed notice source families.",
							"enum": [
								"official_web_public_notice",
								"internal_notice_restricted",
								"wechat_public_notice"
							]
						}
					},
					"target_surfaces": {
						"type": ["array", "null"],
						"description": "Allowed notice target surfaces.",
						"items": {
							"type": "string",
							"description": "Allowed notice target surfaces.",
							"enum": [
								"notice_level_query",
								"procurement_notice_history",
								"regulations/*",
								"regulations/student_rules",
								"regulations/institutional_rules",
								"regulations/scoped_rules",
								"campus_services/service_status_candidate",
								"campus_services/special_service_candidate",
								"campus_services/stable_contact_candidate",
								"publication_surface_candidate",
								"multimodal_processing_candidate",
								"unsupported"
							]
						}
					},
					"group_by": {
						"type": ["string", "null"],
						"description": "Summary grouping mode.",
						"enum": ["topic", "day", "source_family", null]
					},
					"max_items": {
						"type": ["integer", "null"],
						"description": "Positive maximum number of notice cards.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"date_range",
					"source_families",
					"target_surfaces",
					"group_by",
					"max_items"
				]
			}
		},
		{
			"type": "function",
			"name": "retrieve_evidence",
			"description": "Return bounded evidence anchors for an admitted deterministic RAG query slot.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_slot_id": {
						"type": ["string", "null"],
						"description": "One of the admitted deterministic query slot ids."
					},
					"retrieval_intent": {
						"type": "string",
						"description": "Short semantic label for the requested evidence."
					}
				},
				"required": ["query_slot_id", "retrieval_intent"]
			}
		}
	]
}
