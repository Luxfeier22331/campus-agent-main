{
	"schema_version": "tool-function-schemas-v1",
	"tools": [
		{
			"type": "function",
			"name": "knowledge_query",
			"description": "Route this turn to the governed knowledge retrieval and grounded answer workflow when campus regulations, curriculum, official-web facts, or institutional account/network/auth/portal policy facts are needed.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original knowledge question to answer with governed retrieval, including campus network, unified authentication, portal, and account/password policy questions."
					},
					"intent": {
						"type": ["string", "null"],
						"description": "Knowledge workflow intent.",
						"enum": ["answer_question", "compare_rules", "clarify_scope", null]
					},
					"requested_scope": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"corpus": {
								"type": "string",
								"description": "Knowledge corpus such as regulations, curriculum, or official_web."
							},
							"collection": {
								"type": "string",
								"description": "Knowledge collection within the corpus."
							}
						},
						"required": ["corpus", "collection"],
						"description": "Optional explicit knowledge retrieval scope when the user intent clearly identifies it."
					},
					"query_mode": {
						"type": ["string", "null"],
						"description": "Knowledge retrieval query mode.",
						"enum": [
							"current",
							"historical",
							"as_of",
							"compare",
							"freshness_sensitive",
							"live_assisted",
							null
						]
					},
					"version_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Version query mode.",
								"enum": [
									"current",
									"historical",
									"as_of",
									"compare",
									"freshness_sensitive",
									"live_assisted",
									null
								]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "ISO timestamp/date for as_of lookup."
							},
							"version_id": {
								"type": ["string", "null"],
								"description": "Version id for historical or compare lookup."
							},
							"compare_to_version_id": {
								"type": ["string", "null"],
								"description": "Second version id for compare lookup."
							}
						},
						"required": ["mode", "as_of", "version_id", "compare_to_version_id"],
						"description": "Optional version or freshness query constraints."
					},
					"freshness_intent": {
						"type": ["string", "null"],
						"description": "Explicit freshness intent; required for fresh_news/latest style lookups.",
						"enum": ["latest", "recent", "fresh", null]
					},
					"constraints": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"max_age_hours": {
								"type": ["integer", "null"],
								"description": "Optional freshness age bound.",
								"minimum": 1
							},
							"official_sources_only": {
								"type": ["boolean", "null"],
								"description": "Whether evidence must remain inside governed official sources."
							}
						},
						"required": ["max_age_hours", "official_sources_only"],
						"description": "Optional structured retrieval constraints."
					}
				},
				"required": [
					"query_text",
					"intent",
					"requested_scope",
					"query_mode",
					"version_query",
					"freshness_intent",
					"constraints"
				]
			}
		},
		{
			"type": "function",
			"name": "public_web_search",
			"description": "Search current public MUC official-web pages for evidence when governed RAG is missing or likely stale.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original public official-web question to search for evidence."
					},
					"max_results": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum source count. Runtime caps this at 5.",
						"minimum": 1,
						"maximum": 5
					}
				},
				"required": ["query_text", "max_results"]
			}
		},
		{
			"type": "function",
			"name": "transport_schedule_lookup",
			"description": "Lookup campus shuttle schedule snapshots, departures, and service windows.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original transport schedule question."
					},
					"intent": {
						"type": "string",
						"description": "Transport schedule lookup intent.",
						"enum": [
							"next_departure",
							"first_departure",
							"last_departure",
							"departure_list",
							"service_window",
							"timetable",
							"schedule_snapshot_metadata"
						]
					},
					"route_selector": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"route_id": {
								"type": ["string", "null"],
								"description": "Known route id if already resolved."
							},
							"service_family": {
								"type": ["string", "null"],
								"description": "Service family such as intercampus or metro shuttle."
							},
							"route_variant_query": {
								"type": ["string", "null"],
								"description": "Route variant words from the user query."
							},
							"origin_campus": {
								"type": ["string", "null"],
								"description": "Origin campus if stated."
							},
							"destination_campus": {
								"type": ["string", "null"],
								"description": "Destination campus if stated."
							},
							"origin_stop_query": {
								"type": ["string", "null"],
								"description": "Origin stop if stated."
							},
							"destination_stop_query": {
								"type": ["string", "null"],
								"description": "Destination stop if stated."
							}
						},
						"required": [
							"route_id",
							"service_family",
							"route_variant_query",
							"origin_campus",
							"destination_campus",
							"origin_stop_query",
							"destination_stop_query"
						],
						"description": "Optional route selection hints."
					},
					"snapshot_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal query constraint."
					},
					"service_time_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"date_mode": {
								"type": ["string", "null"],
								"description": "Service date interpretation.",
								"enum": ["today", "tomorrow", "date", null]
							},
							"service_date": {
								"type": ["string", "null"],
								"description": "ISO date when date_mode is date."
							},
							"daypart": {
								"type": ["string", "null"],
								"description": "Requested daypart.",
								"enum": ["morning", "afternoon", "evening", "all_day", null]
							},
							"departure_not_before": {
								"type": ["string", "null"],
								"description": "Lower bound departure time in HH:MM if stated."
							},
							"departure_not_after": {
								"type": ["string", "null"],
								"description": "Upper bound departure time in HH:MM if stated."
							}
						},
						"required": [
							"date_mode",
							"service_date",
							"daypart",
							"departure_not_before",
							"departure_not_after"
						],
						"description": "Optional service time constraints."
					},
					"result_limit": {
						"type": ["integer", "null"],
						"description": "Optional positive maximum result count.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"intent",
					"route_selector",
					"snapshot_query",
					"service_time_query",
					"result_limit"
				]
			}
		},
		{
			"type": "function",
			"name": "campus_notice_discover",
			"description": "Discover governed campus notices by topic, family, and target surface.",
			"strict": true,
			"parameters": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"query_text": {
						"type": "string",
						"description": "Original notice discovery question."
					},
					"temporal_query": {
						"type": ["object", "null"],
						"additionalProperties": false,
						"properties": {
							"mode": {
								"type": ["string", "null"],
								"description": "Temporal query mode.",
								"enum": ["current", "latest", "effective", "as_of", "current_year", null]
							},
							"as_of": {
								"type": ["string", "null"],
								"description": "Required only when mode is as_of."
							},
							"year_hint": {
								"type": ["string", "null"],
								"description": "Required only when mode is current_year."
							}
						},
						"required": ["mode", "as_of", "year_hint"],
						"description": "Optional temporal constraint for notice discovery."
					},
					"source_families": {
						"type": ["array", "null"],
						"description": "Allowed notice source families.",
						"items": {
							"type": "string",
							"description": "Allowed notice source families.",
							"enum": [
								"official_web_public_notice",
								"internal_notice_restricted",
								"wechat_public_notice"
							]
						}
					},
					"target_surfaces": {
						"type": ["array", "null"],
						"description": "Allowed notice target surfaces.",
						"items": {
							"type": "string",
							"description": "Allowed notice target surfaces.",
							"enum": [
								"notice_level_query",
								"procurement_notice_history",
								"regulations/*",
								"regulations/student_rules",
								"regulations/institutional_rules",
								"regulations/scoped_rules",
								"campus_services/service_status_candidate",
								"campus_services/special_service_candidate",
								"campus_services/stable_contact_candidate",
								"publication_surface_candidate",
								"multimodal_processing_candidate",
								"unsupported"
							]
						}
					},
					"max_results": {
						"type": ["integer", "null"],
						"description": "Positive maximum number of notice cards.",
						"minimum": 1
					}
				},
				"required": [
					"query_text",
					"temporal_query",
					"source_families",
					"target_surfaces",
					"max_results"
				]
			}
		}
	]
}
