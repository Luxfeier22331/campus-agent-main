		{
			"host": "lib.muc.edu.cn",
			"public_kind": "directory_site",
			"enabled": true,
			"seed_urls": ["https://lib.muc.edu.cn/"],
			"allowed_path_prefixes": ["/"],
			"denied_path_patterns": ["^/search", "^/login", "^/logout"],
			"query_param_allowlist": [
				"appId",
				"currentBranch",
				"dataId",
				"dataTypeId",
				"domain",
				"engineInstanceId",
				"id",
				"p",
