{
	"schema_version": "official_web_host_policy.v1",
	"site_id": "muc_public",
	"host_policy_version": "muc_public_synthetic_hosts_v1",
	"hosts": [
		{
			"host": "www.example.edu",
			"public_kind": "directory_site",
			"host_group": "university_core",
			"owner_label": "Synthetic campus homepage",
			"rollout_order": 10,
			"enabled": true,
			"seed_urls": ["https://www.example.edu/"],
			"allowed_path_prefixes": ["/"],
			"denied_path_patterns": ["^/search", "^/login", "^/logout"],
			"query_param_allowlist": ["id", "p", "pageId", "websiteId", "wfwfid"],
			"max_depth": 2,
			"max_pages_per_run": 20,
			"max_concurrency": 1,
			"min_delay_ms": 1000,
			"respect_robots": true,
			"explicit_sitemaps": [],
			"dynamic_shell_discovery": {
				"enabled": true,
				"engine": "playwright",
				"wait_after_load_ms": 1500,
				"network_observation_timeout_ms": 1500,
				"max_promoted_urls": 10,
				"allowed_request_url_patterns": [
					"^https://www\\.example\\.edu/page/\\d+/all-request",
					"^https://www\\.example\\.edu/webjson/",
					"^https://www\\.example\\.edu/engine2/api/data/general/"
				],
				"ignored_request_url_patterns": [
					"^https://www\\.example\\.edu/(?:assets|upload|pv/|cookie/|cx-domain/)",
					"^https://www\\.example\\.edu/engine2/file/download/",
					"\\.(?:css|js|png|jpe?g|gif|svg|woff2?)(?:\\?|$)"
				],
				"promoted_url_patterns": [
					"^https://www\\.example\\.edu/engine2/general-rest/\\d+/proxy-detail-url",
					"^https://www\\.example\\.edu/engine2/d/",
					"^https://www\\.example\\.edu/db/detail"
				],
				"wait_for_response_url_patterns": [
					"^https://www\\.example\\.edu/page/\\d+/all-request",
					"^https://www\\.example\\.edu/webjson/",
					"^https://www\\.example\\.edu/engine2/api/data/general/"
				],
				"wait_for_selector_patterns": []
			}
		}
	]
}
