			"max_concurrency": 1,
			"min_delay_ms": 1200,
			"respect_robots": true,
			"explicit_sitemaps": [],
			"dynamic_shell_discovery": {
				"enabled": true,
				"engine": "playwright",
				"wait_after_load_ms": 5000,
				"network_observation_timeout_ms": 5000,
				"max_promoted_urls": 30,
				"allowed_request_url_patterns": [
					"^https://lib\\.muc\\.edu\\.cn/page/ck/",
					"^https://lib\\.muc\\.edu\\.cn/page/\\d+/all-request",
					"^https://lib\\.muc\\.edu\\.cn/webjson/",
					"^https://lib\\.muc\\.edu\\.cn/engine2/api/data/general/"
				],
				"ignored_request_url_patterns": [
					"^https://lib\\.muc\\.edu\\.cn/(?:assets|upload|pv/|cookie/|cx-domain/)",
					"^https://lib\\.muc\\.edu\\.cn/engine2/file/download/",
					"^https://robot\\.chaoxing\\.com/",
					"^https://p\\.ananas\\.chaoxing\\.com/",
					"\\.(?:css|js|png|jpe?g|gif|svg|woff2?)(?:\\?|$)"
				],
				"promoted_url_patterns": [
					"^https://lib\\.muc\\.edu\\.cn/engine2/general-rest/\\d+/proxy-detail-url",
					"^https://lib\\.muc\\.edu\\.cn/engine2/d/",
					"^https://lib\\.muc\\.edu\\.cn/db/detail",
					"^https://lib\\.muc\\.edu\\.cn/engine2/general/m/"
				],
				"wait_for_response_url_patterns": [
					"^https://lib\\.muc\\.edu\\.cn/page/\\d+/all-request",
					"^https://lib\\.muc\\.edu\\.cn/webjson/",
					"^https://lib\\.muc\\.edu\\.cn/engine2/api/data/general/"
				],
				"wait_for_selector_patterns": []
			}
