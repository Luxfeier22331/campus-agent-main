{
	"schema_version": "official_web_scheduler_policy.v1",
	"site_id": "muc_public",
	"scheduler_policy_version": "muc_public_scheduler_v1",
	"timezone": "Asia/Shanghai",
	"lanes": [
		{
			"lane_id": "consumer-candidate-hot",
			"enabled": true,
			"run_intent": "hot",
			"cadence_minutes": 30,
			"host_filter": ["www.muc.edu.cn", "xxgk.muc.edu.cn"],
			"max_pages_per_host": 20,
			"max_total_pages": 40,
			"notes": "Bounded consumer-candidate refresh for contact, service guide, and stable reference surfaces; news pages remain inventory-only until notice/news runtime admission."
		},
		{
			"lane_id": "consumer-stable-baseline",
			"enabled": true,
			"run_intent": "baseline",
			"cadence_minutes": 1440,
			"host_filter": ["www.muc.edu.cn", "xxgk.muc.edu.cn", "lib.muc.edu.cn", "xiaoyou.muc.edu.cn"],
			"max_pages_per_host": 40,
			"max_total_pages": 160,
			"notes": "Daily bounded baseline for university-level consumer candidates; broad news crawl is not part of default recovery."
		},
		{
			"lane_id": "college-single-host-baseline",
			"enabled": false,
			"run_intent": "baseline",
			"cadence_minutes": 1440,
			"host_filter": [],
			"max_pages_per_host": 40,
			"max_total_pages": 40,
			"notes": "Operator-triggered single-college crawl; pass one explicit --host value."
		},
		{
			"lane_id": "topic-single-host-baseline",
			"enabled": false,
			"run_intent": "baseline",
			"cadence_minutes": 1440,
			"host_filter": [],
			"max_pages_per_host": 40,
			"max_total_pages": 40,
			"notes": "Operator-triggered single-topic crawl; pass one explicit --host value."
		},
		{
			"lane_id": "repair",
			"enabled": true,
			"run_intent": "repair",
			"cadence_minutes": 120,
			"host_filter": [],
			"max_pages_per_host": 15,
			"max_total_pages": 150,
			"notes": "Retry pages whose latest observation is fetch_failed without widening coverage."
		}
	]
}
