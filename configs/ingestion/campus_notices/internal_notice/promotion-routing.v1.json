{
  "schema_version": "internal_notice_promotion_routing_v1",
  "source_corpus": "campus_notices",
  "source_collection": "internal_notice",
  "target_corpus": "regulations",
  "target_collection": "institutional_regulations",
  "default_action": "hold_in_internal_notice",
  "accepted_input_lanes": [
    "notice_body",
    "attachment_text_extractable",
    "attachment_ocr_required"
  ],
  "terminal_outcomes_excluded_from_promotion": [
    "reference_only",
    "manual_review_required",
    "no_extractable_text",
    "unsupported_binary"
  ],
  "promotion_classes": {
    "formal_regulation": {
      "admission_goal": "Promote stable formal regulation text such as 办法, 规定, 细则, 条例, 章程, 准则, 指导意见.",
      "accepted_revision_tracks": ["source-faithful", "current-effective"],
      "required_quality_gates": [
        "canonical_text_available",
        "wrapper_semantics_removed",
        "provenance_complete",
        "duplicate_check_passed"
      ]
    },
    "normative_handbook": {
      "admission_goal": "Promote stable normative handbook text that can be consumed as a standalone institutional document.",
      "accepted_revision_tracks": ["source-faithful", "current-effective"],
      "required_quality_gates": [
        "canonical_text_available",
        "standalone_body_quality_passed",
        "provenance_complete",
        "duplicate_check_passed"
      ]
    },
    "wrapper_notice_only": {
      "default_action": "retain_in_internal_notice",
      "reason": "The notice itself is only the publication wrapper and must not become a regulation document."
    },
    "manual_promotion_review": {
      "default_action": "manual_review_required",
      "reason": "Use when the document may be regulation-like but title/body/provenance/version signals are still ambiguous."
    }
  },
  "required_promotion_metadata": [
    "promotion_class",
    "promotion_source_collection",
    "source_notice_ids",
    "source_parent_document_id",
    "source_attachment_ref_id",
    "source_attachment_sha256",
    "source_notice_release_time",
    "regulation_title_normalized",
    "issuing_org",
    "effective_date",
    "revision_signal",
    "supersedes_candidate_keys"
  ],
  "identity_rules": {
    "document_id_strategy": "regulation_title_issuing_org_semantic_scope_hash",
    "version_id_strategy": "content_hash_effective_date_revision_signal",
    "forbidden_identity_inputs": ["notice_id"]
  },
  "notes": [
    "This file is a repo-tracked scaffold for the regulation-promotion boundary only; it is not yet consumed by execution code.",
    "Promotion never deletes or rewrites the source-triage notice row in campus_notices/internal_notice.",
    "Only canonical regulation text may cross into regulations/institutional_regulations."
  ]
}
