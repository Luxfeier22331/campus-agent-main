				"guideSections": [
					{
						"sectionId": "service:handbook:student-public-medical-exclusions:section:overview",
						"sectionType": "overview",
						"title": "不属于享受公费医疗范围的项目",
						"content": "不属于享受公费医疗范围的项目包括：镶牙、矫形、美容术、配眼镜、假肢、拐杖、畸形鞋垫、钢背心、钢围腰、助听器、健脑器、药瓶、药锅等器具以及煎药费和药引子；急救车费、住院期间特护费、护理费、陪住费、会诊费、赔偿费、取暖费及代付病员配置用品的代垫费等；交通事故、斗殴、酗酒、自杀、违法乱纪产生且应由本人及肇事者自负的费用；出国、归国、入学、游泳、婚前检查、小孩入托前身体检查等费用；出国和到港澳台地区探亲、考察、进修、讲学期间发生的医药费；各种预测费、预防服药、接种、不育症检查治疗费及各类会议医疗费；各种出诊费、检查治疗加急费、点名手术附加费、手术加台费、优质优价费、自请特别护士、护工等特需医疗服务费用；各种预防、保健性及非治疗必需的诊疗项目费用；各种自用保健、按摩、检查和治疗器械费用；气功疗法、保健性营养疗法、磁疗等辅助性治疗费用；不可单独收费的一次性医疗材料费用和各种生活性材料费用；微量元素检查、SW 系列反射治疗仪、骨质疏松治疗仪等费用。",
						"order": 1,
						"sourceRefs": ["handbook:student_rules:pages:259-260#page=260"]
					},
					{
						"sectionId": "service:handbook:student-public-medical-exclusions:section:eligibility",
						"sectionType": "eligibility",
						"title": "费用范围限制",
						"content": "上述项目不属于享受公费医疗范围，即使学生具有公费医疗资格，也不能按公费医疗范围报销这些项目。",
						"order": 2,
						"sourceRefs": ["handbook:student_rules:pages:259-260#page=260"]
					}
