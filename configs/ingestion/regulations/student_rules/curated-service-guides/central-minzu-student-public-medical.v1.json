						"sectionType": "eligibility",
						"title": "享受公费医疗人员范围",
						"content": "国家计划内招生的本科生、硕士生、博士生、预科部学生享受公费医疗。",
						"order": 2,
						"sourceRefs": ["handbook:student_rules:pages:259-260#page=259"]
					},
					{
						"sectionId": "service:handbook:student-public-medical-eligibility-care:section:procedure",
						"sectionType": "procedure",
						"title": "校医院首诊与转诊规则",
						"content": "学生患病（包括普通急诊）第一时间到校医院就诊，并持《公费医疗证》挂号看病。有困难需外诊转合同医院时，须由校医院医生开具《转诊单》后方可到合同医院就医；没有《转诊单》发生的就医费用由个人负责。危及生命的紧急情况需呼 120 或 999 时可不经转诊。慢性病不能利用假期在外地治疗，只能在京治疗并需经过校医院转诊、转院。",
						"order": 3,
						"sourceRefs": ["handbook:student_rules:pages:259-260#page=259"]
					},
					{
						"sectionId": "service:handbook:student-public-medical-eligibility-care:section:entry",
						"sectionType": "entry",
						"title": "就医入口",
						"content": "首诊入口为校医院；学校合同医院为北京大学人民医院。",
						"order": 4,
						"sourceRefs": ["handbook:student_rules:pages:259-260#page=259"]
					}
