				"guideSections": [
					{
						"sectionId": "service:handbook:student-appeal:section:overview",
						"sectionType": "overview",
						"title": "申诉范围与期限",
						"content": "学生对学校作出涉及本人权益的相关处理或者处分决定有异议时，可以提请学校重新处理。学生对学校的同一处理或者处分决定只能提出一次申诉；对处理或者处分决定有异议的，可以在接到决定书之日起10日内提出书面申诉。",
						"order": 1,
						"sourceRefs": ["handbook:student_rules:pages:133-137#page=134"]
					},
					{
						"sectionId": "service:handbook:student-appeal:section:procedure",
						"sectionType": "procedure",
						"title": "申诉受理流程",
						"content": "1. 在接到学校处理或者处分决定书之日起10日内，向学校学生申诉处理委员会提出书面申诉。\n2. 向学校学生申诉处理委员会办公室递交书面申诉申请书，并附学校作出的相关处理或者处分决定通知书复印件。\n3. 学生申诉处理委员会办公室接到申请书后，应在5日内作出予以受理、退回重新提交申请或不予受理的处理。\n4. 予以受理后5日内，申诉材料提交学生申诉处理委员会复查；学生申诉处理委员会在接到书面申诉之日起15日内作出复查决定并告知申诉人，情况复杂时经批准可延长15日。",
						"order": 2,
						"sourceRefs": [
							"handbook:student_rules:pages:133-137#page=134",
							"handbook:student_rules:pages:133-137#page=135"
						]
					},
					{
						"sectionId": "service:handbook:student-appeal:section:required-materials",
						"sectionType": "required_materials",
						"title": "申诉材料",
						"content": "申诉须递交书面申诉申请书，并附学校作出的相关处理或者处分决定通知书复印件。申诉申请书应写明申诉人的基本情况、申诉事项、理由及请求、申诉人本人签名和递交申诉申请的日期。",
						"order": 3,
						"sourceRefs": ["handbook:student_rules:pages:133-137#page=134"]
					},
					{
						"sectionId": "service:handbook:student-appeal:section:entry",
						"sectionType": "entry",
						"title": "受理入口",
						"content": "学生申诉由中央民族大学学生申诉处理委员会负责受理，学生申诉处理委员会办公室设在学生处。",
						"order": 4,
						"sourceRefs": ["handbook:student_rules:pages:133-137#page=134"]
					}
