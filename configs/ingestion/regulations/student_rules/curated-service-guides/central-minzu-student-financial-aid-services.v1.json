				],
				"guideSections": [
					{
						"sectionId": "service:handbook:work-study-position:section:overview",
						"sectionType": "overview",
						"title": "勤工助学活动范围",
						"content": "勤工助学活动是指学生在学校统一组织和安排下，利用课余时间自愿参加的助管、助教、助研等校内岗位见习实践活动。学生个人自行联系和参加的校外兼职活动不在该办法规定之列。",
						"order": 1,
						"sourceRefs": ["handbook:student_rules:pages:220-225#page=220"]
					},
					{
						"sectionId": "service:handbook:work-study-position:section:eligibility",
						"sectionType": "eligibility",
						"title": "申请基本条件",
						"content": "学生申请勤工助学岗位的基本条件包括：自觉遵守国家法律法规和校规校纪、无违纪受处分记录；学习成绩良好、无不及格课程；身体健康、工作责任心强，能够胜任并顺利完成岗位工作任务。同等条件下，优先聘用家庭经济困难学生和有岗位专长学生。",
						"order": 2,
						"sourceRefs": ["handbook:student_rules:pages:220-225#page=222"]
					},
					{
						"sectionId": "service:handbook:work-study-position:section:procedure",
						"sectionType": "procedure",
						"title": "岗位聘用流程",
						"content": "1. 岗位需求单位在规定时间内通过学校学生工作管理系统向学校助学服务中心提出岗位需求申请。\n2. 学校助学服务中心核定各单位可聘用的勤工助学岗位职数，并在全校范围内进行公示。\n3. 各单位根据核定岗位职数公开发布选聘信息，自行组织面试并公示拟录用学生名单。\n4. 各单位在学校学生工作管理系统内填报最终录用勤工助学岗位学生基本信息，并经岗前培训和签订协议书后安排学生正式上岗。",
						"order": 3,
						"sourceRefs": ["handbook:student_rules:pages:220-225#page=223"]
					},
					{
						"sectionId": "service:handbook:work-study-position:section:office-hours",
						"sectionType": "office_hours",
						"title": "工作时间限制",
						"content": "学生参加勤工助学的工作时间原则上每周不超过10小时、每月不超过40小时，寒暑假可适当延长。",
						"order": 4,
						"sourceRefs": ["handbook:student_rules:pages:220-225#page=221"]
					},
					{
						"sectionId": "service:handbook:work-study-position:section:entry",
						"sectionType": "entry",
						"title": "岗位入口",
						"content": "岗位需求单位通过学校学生工作管理系统向学校助学服务中心提出岗位需求申请；各单位公开发布选聘信息并组织面试，最终录用信息在学校学生工作管理系统内填报。",
						"order": 5,
						"sourceRefs": ["handbook:student_rules:pages:220-225#page=223"]
					}
				],
