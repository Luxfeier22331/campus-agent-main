# campus-agent staging local data-plane template
# Copy values from the staging operator secret store before running
# `scripts/run-with-staging-ingestion-env.mjs`.

# Shared ingestion databases
STAGING_INGESTION_SHARED_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
STAGING_INGESTION_DOCUMENT_REGISTRY_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
STAGING_INGESTION_RAW_ASSET_REGISTRY_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
STAGING_INGESTION_SHARED_POSTGRES_OPERATOR_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
STAGING_INGESTION_DOCUMENT_REGISTRY_OPERATOR_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
STAGING_INGESTION_RAW_ASSET_REGISTRY_OPERATOR_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Shared object store endpoint and default credentials
STAGING_INGESTION_OBJECT_STORE_ENDPOINT=
STAGING_INGESTION_OBJECT_STORE_ACCESS_KEY=
STAGING_INGESTION_OBJECT_STORE_SECRET_KEY=

# Bucket-scoped source credentials
STAGING_INGESTION_OBJECT_STORE_SOURCE_ACCESS_KEY=
STAGING_INGESTION_OBJECT_STORE_SOURCE_SECRET_KEY=

# Bucket-scoped derived credentials
STAGING_INGESTION_OBJECT_STORE_DERIVED_ACCESS_KEY=
STAGING_INGESTION_OBJECT_STORE_DERIVED_SECRET_KEY=
STAGING_INGESTION_OBJECT_STORE_BUCKET_DERIVED=campus-rag-derived-staging
STAGING_INGESTION_OBJECT_STORE_REGION=auto

# Staging vector index
STAGING_INGESTION_QDRANT_URL=http://127.0.0.1:6333
STAGING_INGESTION_QDRANT_API_KEY=
STAGING_INGESTION_QDRANT_READ_ONLY_API_KEY=
STAGING_INGESTION_QDRANT_TIMEOUT_SECONDS=

# Retrieval embedding/sparse settings used by supervisor-agent-worker.
STAGING_INGESTION_EMBEDDING_PROVIDER=
STAGING_INGESTION_EMBEDDING_BASE_URL=
STAGING_INGESTION_EMBEDDING_API_KEY=
STAGING_INGESTION_EMBEDDING_MODEL=
STAGING_INGESTION_EMBEDDING_DIMENSIONS=
STAGING_INGESTION_SPARSE_PROVIDER=
STAGING_INGESTION_SPARSE_MODEL=
STAGING_INGESTION_SPARSE_TOKENIZER=
STAGING_INGESTION_SPARSE_LANGUAGE=

# Supervisor staging execution origin
STAGING_SUPERVISOR_API_BASE_URL=https://exec-staging.mucwiki-edge.link
SUPERVISOR_API_METRICS_BEARER_TOKEN=
SUPERVISOR_API_STAGING_UV_BIN=/home/deploy/.local/bin/uv
SUPERVISOR_API_STAGING_TUNNEL_TOKEN=
SUPERVISOR_AGENT_WORKER_SHARED_SECRET=
SUPERVISOR_INTERNAL_QUERY_SHARED_SECRET=
