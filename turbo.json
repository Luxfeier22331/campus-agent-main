{
	"$schema": "https://turborepo.com/schema.json",
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"tasks": {
		"//#ci:config": {
			"inputs": [
				".github/**",
				"flake.lock",
				"flake.nix",
				"nix/**",
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"//#ci:contracts": {
			"inputs": [
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"apps/agent-runtime/src/tool-catalog.ts",
				"apps/app-api/src/modules/integration/generated/tool-execution-contract.ts",
				"apps/execution-control/internal/contracts/tool_execution_contract.go",
				"configs/runtime/**",
				"docs/contracts/schemas/**",
				"packages/contracts/**",
				"packages/ingestion-contracts/assertions/**",
				"packages/ingestion-contracts/schemas/**"
			]
		},
		"//#ci:deps": {
			"cache": false,
			"inputs": [
				"Cargo.lock",
				"Cargo.toml",
				"apps/**/go.mod",
				"apps/**/go.sum",
				"flake.lock",
				"flake.nix",
				"osv-scanner.toml",
				"package.json",
				"packages/**/package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"pyproject.toml",
				"uv.lock"
			]
		},
		"//#ci:infra": {
			"inputs": ["infra/k8s/**", "infra/policies/**", "scripts/ci/infra-check.sh"]
		},
		"//#ci:otel": {
			"cache": false,
			"inputs": ["infra/otel/**", "infra/policies/**", "scripts/ci/check-otel-config.sh"]
		},
		"//#ci:release": {
			"inputs": [
				".github/workflows/execution-runtime-publish.yml",
				"docker-bake.hcl",
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"scripts/ci/check-ops-web-artifact.*",
				"scripts/ci/evidence.*",
				"scripts/ci/scope.*",
				"scripts/ci/validation.*",
				"scripts/release/**"
			]
		},
		"//#ci:repo": {
			"inputs": [
				".editorconfig",
				".github/**",
				"AGENTS.md",
				"CONTRIBUTING.md",
				"README.md",
				"apps/**/*.md",
				"configs/**/*.md",
				"docs/**",
				"jobs/**/*.md",
				"packages/**/*.md",
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				"scripts/docs/**"
			]
		},
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputs": ["dist/**", ".tanstack/**"]
		},
		"agent-runtime#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/runtime/tool-function-schemas.v3.json",
				"$TURBO_ROOT$/configs/runtime/tools.v6.json"
			]
		},
		"app-api-schema#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/apps/app-api/db/shared-product-schema/**",
				"$TURBO_ROOT$/apps/app-api/drizzle/**",
				"$TURBO_ROOT$/apps/app-api/ops/db/**",
				"$TURBO_ROOT$/apps/app-api/src/script-support/shared-db/**"
			]
		},
		"execution-control#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/ingestion/**",
				"$TURBO_ROOT$/configs/runtime/query-serving-targets.v3.json",
				"$TURBO_ROOT$/configs/runtime/tool-function-schemas.v3.json",
				"$TURBO_ROOT$/configs/runtime/tools.v6.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/tool_execution_contract/**"
			]
		},
		"ops-web#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/langfuse-identity/package.json",
				"$TURBO_ROOT$/packages/langfuse-identity/src/**",
				"$TURBO_ROOT$/packages/internal-portal-client/package.json",
				"$TURBO_ROOT$/packages/internal-portal-client/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/ci/check-ops-web-artifact.mjs"
			],
			"outputs": ["dist/**", "dist-ops/**", "dist-server/**", ".tanstack/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:format": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:lint": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:test": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:typecheck": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"ingest-core#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/ingestion/**"
			],
			"outputLogs": "new-only"
		},
		"ingestion-control#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/ingestion/**"
			],
			"outputLogs": "new-only"
		},
		"source-collector#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/**"
			],
			"outputLogs": "new-only"
		},
		"test:eval": {
			"dependsOn": ["^test:eval"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/pyproject.toml",
				"$TURBO_ROOT$/uv.lock"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:ingest": {
			"dependsOn": ["^test:ingest"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:migration-integration": {
			"cache": false
		},
		"test:database-integration": {
			"cache": false
		},
		"test:browser": {
			"cache": false
		},
		"test:e2e:full": {
			"cache": false
		},
		"test:e2e:smoke": {
			"cache": false
		},
		"test:worker": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"campus-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["package.json", "scripts/**/*.ts", "test/**/*.ts", "tsconfig.json"],
			"outputLogs": "new-only"
		},
		"ingest-core#test:ingest": {
			"dependsOn": ["^test:ingest"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/ingestion/**"
			],
			"outputLogs": "new-only"
		},
		"ingestion-control#test:ingest": {
			"dependsOn": ["^test:ingest"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/ingestion/**"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#test:eval": {
			"dependsOn": ["^test:eval"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["package.json", "schemas/**", "src/**/*.ts", "test/**/*.ts", "tsconfig.json"],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"assertions/**",
				"package.json",
				"schemas/**",
				"src/**/*.ts",
				"test/**/*.ts",
				"tsconfig.json"
			],
			"outputLogs": "new-only"
		},
		"ops-web#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"ops-web#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"source-collector#test:ingest": {
			"dependsOn": ["^test:ingest"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/**"
			],
			"outputLogs": "new-only"
		},
		"test:integration": {
			"cache": false
		},
		"test:shared-db-integration": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "XDG_STATE_HOME"]
		},
		"deploy": {
			"cache": false
		}
	}
}
