{
	"$schema": "https://turborepo.com/schema.json",
	"globalPassThroughEnv": ["STAGING_EXECUTION_CONTROL_BASE_URL", "STAGING_SENTRY_RELEASE"],
	"tasks": {
		"build": {
			"env": [
				"CAMPUS_DOCS_SYNC_MANIFEST_KEY",
				"CAMPUS_DOCS_SYNC_MANIFEST_PATH",
				"OBJECT_STORE_ACCESS_KEY",
				"OBJECT_STORE_BUCKET_DERIVED",
				"OBJECT_STORE_ENDPOINT",
				"OBJECT_STORE_REGION",
				"OBJECT_STORE_SECRET_KEY"
			],
			"outputs": ["dist/**", ".tanstack/**"]
		},
		"typecheck": {
			"outputs": []
		},
		"test": {
			"outputs": []
		},
		"test:worker": {
			"outputs": []
		},
		"test:integration": {
			"cache": false
		},
		"test:shared-db-integration": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"cache": false
		}
	}
}
