{
	"$schema": "https://turborepo.com/schema.json",
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"globalPassThroughEnv": ["WORKERS"],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputs": ["dist/**", ".tanstack/**"]
		},
		"agent-runtime#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/runtime/tool-function-schemas.v4.json",
				"$TURBO_ROOT$/configs/runtime/tools.v7.json"
			]
		},
		"ops-web#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/internal-portal-client/package.json",
				"$TURBO_ROOT$/packages/internal-portal-client/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/release/check-ops-web-artifact.mjs",
				"$TURBO_ROOT$/packages/document-ocr/package.json",
				"$TURBO_ROOT$/packages/document-ocr/src/**",
				"$TURBO_ROOT$/packages/domains/notices/package.json",
				"$TURBO_ROOT$/packages/domains/notices/src/**"
			],
			"outputs": ["dist/**", "dist-ops/**", "dist-server/**", ".tanstack/**"]
		},
		"campus-web#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/campus-docs/**",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-course-maps.v1.schema.json",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-reader.v3.schema.json",
				"$TURBO_ROOT$/packages/contracts/schemas/campus-docs-source.v4.schema.json"
			],
			"outputs": ["dist/**", ".tanstack/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:format": {
			"outputLogs": "new-only",
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/go.work",
				"$TURBO_ROOT$/go.work.sum",
				"$TURBO_ROOT$/apps/*/go.mod",
				"$TURBO_ROOT$/apps/*/go.sum",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			],
			"env": ["GOTOOLCHAIN", "CAMPUS_NATIVE_PLATFORM"],
			"passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOLANGCI_LINT_CACHE", "LD_LIBRARY_PATH"]
		},
		"native:lint": {
			"outputLogs": "new-only",
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/go.work",
				"$TURBO_ROOT$/go.work.sum",
				"$TURBO_ROOT$/apps/*/go.mod",
				"$TURBO_ROOT$/apps/*/go.sum",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			],
			"env": ["GOTOOLCHAIN", "CAMPUS_NATIVE_PLATFORM"],
			"passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOLANGCI_LINT_CACHE", "LD_LIBRARY_PATH"]
		},
		"native:test": {
			"outputLogs": "new-only",
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/go.work",
				"$TURBO_ROOT$/go.work.sum",
				"$TURBO_ROOT$/apps/*/go.mod",
				"$TURBO_ROOT$/apps/*/go.sum",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			],
			"env": ["GOTOOLCHAIN", "CAMPUS_NATIVE_PLATFORM"],
			"passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOLANGCI_LINT_CACHE", "LD_LIBRARY_PATH"]
		},
		"native:typecheck": {
			"outputLogs": "new-only",
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/go.work",
				"$TURBO_ROOT$/go.work.sum",
				"$TURBO_ROOT$/apps/*/go.mod",
				"$TURBO_ROOT$/apps/*/go.sum",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			],
			"env": ["GOTOOLCHAIN", "CAMPUS_NATIVE_PLATFORM"],
			"passThroughEnv": ["GOCACHE", "GOMODCACHE", "GOLANGCI_LINT_CACHE", "LD_LIBRARY_PATH"]
		},
		"internal-portal-collection#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/**"
			],
			"outputLogs": "new-only"
		},
		"test:eval": {
			"dependsOn": ["^test:eval"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/pyproject.toml",
				"$TURBO_ROOT$/uv.lock"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:migration-integration": {
			"cache": false
		},
		"test:database-integration": {
			"cache": false
		},
		"test:browser": {
			"cache": false
		},
		"test:e2e:full": {
			"cache": false
		},
		"test:worker": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"campus-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"package.json",
				"schemas/**",
				"scripts/**/*.ts",
				"src/**/*.ts",
				"test/**/*.ts",
				"tsconfig.json"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["package.json", "schemas/**", "src/**/*.ts", "test/**/*.ts", "tsconfig.json"],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"assertions/**",
				"package.json",
				"schemas/**",
				"src/**/*.ts",
				"test/**/*.ts",
				"tsconfig.json"
			],
			"outputLogs": "new-only"
		},
		"ops-web#test": {
			"dependsOn": [
				"@campus-agent/dining#test",
				"@campus-agent/document-ocr#test",
				"@campus-agent/internal-portal-client#test",
				"@campus-agent/notices#test",
				"@campus-agent/transport#test",
				"@campus-agent/ui#test",
				"campus-contracts#test",
				"notice-publisher#test"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/.dockerignore",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"ops-web#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:shared-db-integration": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"HTTP_PROXY",
				"HTTPS_PROXY",
				"NO_PROXY",
				"QDRANT_READ_ONLY_API_KEY",
				"QDRANT_TLS_CA_CERT_PATH",
				"QDRANT_URL",
				"XDG_STATE_HOME",
				"HINDSIGHT_*",
				"OTEL_*"
			]
		},
		"document-ocr#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/notice-database/package.json",
				"$TURBO_ROOT$/packages/notice-database/src/**",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/notices.ts",
				"$TURBO_ROOT$/packages/document-ocr/package.json",
				"$TURBO_ROOT$/packages/document-ocr/src/**",
				"$TURBO_ROOT$/packages/domains/notices/package.json",
				"$TURBO_ROOT$/packages/domains/notices/src/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json"
			],
			"outputs": ["dist/**"]
		},
		"ocr": {
			"cache": false
		},
		"//#test:scripts": {
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": [],
			"outputLogs": "new-only",
			"env": ["CAMPUS_REPO_TEST_INDEX_TREE", "CAMPUS_REPO_TEST_RUNTIME"]
		}
	}
}
