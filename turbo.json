{
	"$schema": "https://turborepo.com/schema.json",
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputs": ["dist/**", ".tanstack/**"]
		},
		"agent-runtime#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/runtime/tool-function-schemas.v3.json",
				"$TURBO_ROOT$/configs/runtime/tools.v6.json"
			]
		},
		"ops-web#build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/langfuse-identity/package.json",
				"$TURBO_ROOT$/packages/langfuse-identity/src/**",
				"$TURBO_ROOT$/packages/internal-portal-client/package.json",
				"$TURBO_ROOT$/packages/internal-portal-client/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/release/check-ops-web-artifact.mjs"
			],
			"outputs": ["dist/**", "dist-ops/**", "dist-server/**", ".tanstack/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:format": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:lint": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:test": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"native:typecheck": {
			"outputLogs": "new-only",
			"outputs": []
		},
		"internal-portal-collection#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/**"
			],
			"outputLogs": "new-only"
		},
		"test:eval": {
			"dependsOn": ["^test:eval"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/pyproject.toml",
				"$TURBO_ROOT$/uv.lock"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:migration-integration": {
			"cache": false
		},
		"test:database-integration": {
			"cache": false
		},
		"test:browser": {
			"cache": false
		},
		"test:e2e:full": {
			"cache": false
		},
		"test:e2e:smoke": {
			"cache": false
		},
		"test:worker": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/README.md"],
			"outputLogs": "new-only",
			"outputs": []
		},
		"campus-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["package.json", "scripts/**/*.ts", "test/**/*.ts", "tsconfig.json"],
			"outputLogs": "new-only"
		},
		"eval-langfuse#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"eval-langfuse#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/scripts/deploy/**"
			],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["package.json", "schemas/**", "src/**/*.ts", "test/**/*.ts", "tsconfig.json"],
			"outputLogs": "new-only"
		},
		"ingestion-contracts#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"assertions/**",
				"package.json",
				"schemas/**",
				"src/**/*.ts",
				"test/**/*.ts",
				"tsconfig.json"
			],
			"outputLogs": "new-only"
		},
		"ops-web#test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"ops-web#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"outputLogs": "new-only",
			"outputs": []
		},
		"test:shared-db-integration": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"HTTP_PROXY",
				"HTTPS_PROXY",
				"NO_PROXY",
				"QDRANT_READ_ONLY_API_KEY",
				"QDRANT_TLS_CA_CERT_PATH",
				"QDRANT_URL",
				"XDG_STATE_HOME",
				"HINDSIGHT_*",
				"OTEL_*"
			]
		}
	}
}
