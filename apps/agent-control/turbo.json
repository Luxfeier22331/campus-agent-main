{
	"extends": ["//"],
	"tasks": {
		"native:test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/go.work",
				"$TURBO_ROOT$/go.work.sum",
				"$TURBO_ROOT$/apps/*/go.mod",
				"$TURBO_ROOT$/apps/*/go.sum",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**",
				"$TURBO_ROOT$/configs/runtime/**",
				"$TURBO_ROOT$/packages/contracts/fixtures/tool_execution_contract/**",
				"$TURBO_ROOT$/packages/contracts/fixtures/agent-runtime-control.v1.json",
				"$TURBO_ROOT$/packages/contracts/schemas/agent-runtime-control.v1.schema.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/citation-diagnostic.v1.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/citation-markers.v1.json",
				"$TURBO_ROOT$/packages/search-api-go/**",
				"$TURBO_ROOT$/packages/memory-api-go/**"
			]
		},
		"test:database-integration": {
			"inputs": [
				"go.mod",
				"go.sum",
				"integration/postgres/**",
				"internal/execution/**",
				"scripts/test-postgres-integration.sh"
			]
		},
		"native:vet": {
			"inputs": [
				"$TURBO_EXTENDS$",
				"$TURBO_ROOT$/packages/memory-api-go/**",
				"$TURBO_ROOT$/packages/search-api-go/**"
			]
		},
		"native:lint": {
			"inputs": [
				"$TURBO_EXTENDS$",
				"$TURBO_ROOT$/packages/memory-api-go/**",
				"$TURBO_ROOT$/packages/search-api-go/**"
			]
		}
	}
}
