{
	"name": "execution-control",
	"private": true,
	"scripts": {
		"dev": "set -a && . ./.env.local && set +a && exec go run ./cmd/execution-control",
		"native:format": "golangci-lint fmt --diff",
		"native:lint": "golangci-lint run --verbose ./...",
		"native:test": "go test ./...",
		"native:typecheck": "go vet ./...",
		"test:database-integration": "./scripts/test-postgres-integration.sh",
		"test:temporal-integration": "go test -v -tags=temporal_integration ./integration/temporal ./integration/execution_http -count=1 -timeout=2m",
		"test:temporal-replay": "go test -v -tags=temporal_replay ./integration/temporal -count=1 -timeout=30s",
		"test:stream-integration": "go test -v -tags=stream_integration ./integration/stream -count=1 -timeout=2m"
	}
}
