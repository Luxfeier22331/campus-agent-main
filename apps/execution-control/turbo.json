{
	"extends": ["//"],
	"tasks": {
		"native:format": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			]
		},
		"native:lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			]
		},
		"native:test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/ingestion/**",
				"$TURBO_ROOT$/configs/runtime/**",
				"$TURBO_ROOT$/packages/contracts/fixtures/tool_execution_contract/**"
			]
		},
		"test:database-integration": {
			"inputs": [
				"go.mod",
				"go.sum",
				"integration/postgres/**",
				"internal/execution/**",
				"internal/providerconfig/**",
				"internal/schemamigrations/**",
				"$TURBO_ROOT$/scripts/ci/go-postgres-integration.sh"
			]
		}
	}
}
