{
	"name": "public-docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rspress build",
		"dev": "rspress dev --host 127.0.0.1 --port 5177",
		"preview": "rspress preview --host 127.0.0.1 --port 4177",
		"sync:real-docs": "tsx scripts/sync-real-docs.ts",
