		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.913.0",
		"@rspress/core": "^2.0.9",
		"@xyflow/react": "^12.10.2",
		"dagre": "^0.8.5"
	},
	"devDependencies": {
		"@types/node": "^22.8.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"typescript": "^5.9.3",
		"tsx": "^4.20.5",
		"vitest": "^4.1.0"
	}
