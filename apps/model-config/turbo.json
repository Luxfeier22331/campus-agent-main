{
	"extends": ["//"],
	"tasks": {
		"native:format": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			]
		},
		"native:lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/flake.lock",
				"$TURBO_ROOT$/flake.nix",
				"$TURBO_ROOT$/nix/**"
			]
		},
		"native:test": { "inputs": ["$TURBO_DEFAULT$"] },
		"native:typecheck": { "inputs": ["$TURBO_DEFAULT$"] },
		"test:database-integration": {
			"inputs": [
				"go.mod",
				"go.sum",
				"internal/modelconfig/**",
				"internal/httpapi/**",
				"scripts/test-postgres-integration.sh"
			]
		}
	}
