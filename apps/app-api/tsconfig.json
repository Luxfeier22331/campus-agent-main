{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"strict": true,
		"types": ["node", "@cloudflare/workers-types", "vite/client", "vitest/globals"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"e2e/**/*.ts",
		"ops/**/*.ts",
		"vitest*.config.mts",
		"drizzle.config.ts"
	]
}
