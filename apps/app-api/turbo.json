{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:shared-db-integration": {
			"inputs": [
				"$TURBO_ROOT$/jobs/campus-agent-schema/**",
				"package.json",
				"src/**",
				"test/*postgres.integration.test.ts",
				"test/app-api-product-db.global-setup.ts",
				"test/shared-db-integration-helpers.ts",
				"test/shared-product-db.integration.test.ts",
				"vitest.shared-db.config.mts",
				"$TURBO_ROOT$/apps/campus-web/src/**",
				"$TURBO_ROOT$/apps/campus-web/test-support/**"
			]
		},
		"test:worker": {
			"inputs": [
				"package.json",
				"scripts/**",
				"src/**",
				"test/worker.test.ts",
				"tsconfig.json",
				"vitest.worker.config.mts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json"
			],
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/transport#source",
				"campus-contracts#source"
			]
		},
		"typecheck": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"test:node:fast": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/transport#source",
				"campus-contracts#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.test.ts",
				"!test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/**",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/**",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/turbo.json",
				"$TURBO_ROOT$/packages/domains/transport/test/fixtures/**",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:node:isolated": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/transport#source",
				"campus-contracts#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/**",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/**",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/turbo.json",
				"$TURBO_ROOT$/packages/domains/transport/test/fixtures/**",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"build": {
			"inputs": [
				"package.json",
				"scripts/**",
				"src/**",
				"tsconfig.json",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**"
			],
			"outputLogs": "new-only",
			"outputs": ["dist/worker/**"],
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/transport#source",
				"campus-contracts#source"
			],
			"env": ["CAMPUS_NODE_RUNTIME"]
		}
	}
}
