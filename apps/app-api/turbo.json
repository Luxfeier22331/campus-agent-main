{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build:worker": {
			"inputs": [
				"package.json",
				"scripts/**",
				"src/**",
				"tsconfig.json",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-wrangler-command.ts",
				"$TURBO_ROOT$/scripts/deploy/staging-release.mts",
				"$TURBO_ROOT$/scripts/deploy/worker-version.ts"
			],
			"outputLogs": "new-only",
			"outputs": ["dist/worker/**"]
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/**",
				"$TURBO_ROOT$/package.json",
				"$TURBO_ROOT$/packages/contracts/fixtures/**",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/turbo.json"
			]
		},
		"test:migration-integration": {
			"inputs": [
				"package.json",
				"drizzle/**",
				"ops/db/**",
				"src/db/**",
				"src/modules/profile-memory/**",
				"test/app-api-migration-upgrade.integration.test.ts",
				"vitest.migration-integration.config.mts"
			]
		},
		"test:shared-db-integration": {
			"inputs": [
				"package.json",
				"src/**",
				"test/*postgres.integration.test.ts",
				"test/app-api-product-db.global-setup.ts",
				"test/shared-db-integration-helpers.ts",
				"test/shared-product-db.integration.test.ts",
				"vitest.shared-db.config.mts",
				"$TURBO_ROOT$/apps/campus-web/src/**"
			]
		},
		"test:worker": {
			"inputs": [
				"package.json",
				"scripts/**",
				"src/**",
				"test/federation-runtime-readiness.test.ts",
				"test/worker-scheduled-sweepers.test.ts",
				"test/worker.test.ts",
				"tsconfig.json",
				"vitest.worker.config.mts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"typecheck": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		}
	}
}
