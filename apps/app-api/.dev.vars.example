APP_API_NAME=campus-agent-app-api
APP_API_ENVIRONMENT=development
# Generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-dev-secret
AUTH_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
RESEND_API_KEY=replace-with-resend-api-key
AUTH_RESET_EMAIL_FROM=Campus Agent <auth@example.com>
# Optional. Keep empty unless your transactional mail setup needs a distinct reply-to.
AUTH_RESET_EMAIL_REPLY_TO=
# Generate a different high-entropy secret for anonymous safety identifier derivation.
APP_API_SAFETY_IDENTIFIER_HMAC_SECRET=replace-with-safety-identifier-secret
# Browser account shell origin. This is required.
AUTH_SHELL_ORIGIN=https://campus.example.com
# Comma-separated campus email domain suffixes allowed for end-user sign-up/sign-in.
# Matches exact domains and subdomains, case-insensitively.
APP_API_END_USER_EMAIL_DOMAIN_ALLOWLIST=muc.edu.cn
# Optional exact email exceptions for end-user sign-up/sign-in.
APP_API_END_USER_EMAIL_ALLOWLIST=help_bot@outlook.com
EXECUTION_CONTROL_BASE_URL=https://execution-control.internal
EXECUTION_CONTROL_SHARED_SECRET=replace-with-execution-control-shared-secret
EXECUTION_CONTROL_TIMEOUT_MS=8000
EXECUTION_CONTROL_EVAL_TIMEOUT_MS=30000
# Optional. Required only when EXECUTION_CONTROL_BASE_URL is protected by
# Cloudflare Access service-token authentication.
EXECUTION_CONTROL_ACCESS_CLIENT_ID=
EXECUTION_CONTROL_ACCESS_CLIENT_SECRET=
# Comma-separated exact operator emails allowed through the operator surface.
APP_API_OPERATOR_EMAIL_ALLOWLIST=ops@example.com
APP_API_OPERATOR_SERVICE_ID_ALLOWLIST=
# Local scripts auto-generate APP_API_INTERNAL_SHARED_SECRET in
# `infra/local/.generated/runtime.env`; set this only when you intentionally
# override the generated internal shared secret.
APP_API_INTERNAL_SHARED_SECRET=
APP_API_DATABASE_SSLMODE=prefer
# Required for live `official_web` control-plane smoke. This must match
# `apps/official-web-collector/.env` `OFFICIAL_WEB_SERVICE_TOKEN`.
APP_API_OFFICIAL_WEB_COLLECTOR_TOKEN=
# Required for live `wechat_official_account` capture control-plane smoke. This
# must match `apps/wechat-official-account-collector/.env`
# `WECHAT_OFFICIAL_ACCOUNT_SERVICE_TOKEN`.
APP_API_WECHAT_OFFICIAL_ACCOUNT_COLLECTOR_TOKEN=
# Optional. Enables official_web terminal projection to admit tasks into
# ingestion-control. Set OBJECT_STORE_BUCKET_SOURCE to the same source bucket
# used by the collector when this is enabled.
INGESTION_CONTROL_BASE_URL=
OBJECT_STORE_BUCKET_SOURCE=campus-rag-source
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=app-api@dev-local
APP_API_OTEL_INGEST_ENDPOINT=http://127.0.0.1:4318
APP_API_OTEL_INGEST_SHARED_SECRET=
# Optional panel deep-link templates. Placeholders are URL-encoded before use.
# Supported placeholders: {requestId}, {traceId}, {errorCode}, {selectedTool}, {surface}, {status}.
APP_API_OPERATOR_TRACE_LINK_TEMPLATE=
APP_API_OPERATOR_ISSUE_LINK_TEMPLATE=

# APP_API_DB is a Worker binding and is not configured in .dev.vars.
# For local Wrangler / Drizzle commands, place the process-level database URLs in
# `apps/app-api/.env` instead. `pnpm dev` and direct
# `node ./scripts/run-with-local-env.mjs ...` commands load that file before
# invoking the underlying tool.
# APP_API_OPERATOR_DATABASE_URL lives in `apps/app-api/.env` for schema generation,
# drift reconciliation, and repo-owned operator scripts.
