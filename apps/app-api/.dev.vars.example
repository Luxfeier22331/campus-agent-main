APP_API_ENVIRONMENT=development
# Generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-dev-secret
AUTH_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
RESEND_API_KEY=replace-with-resend-api-key
OPS_WEB_INTERNAL_TOKEN=replace-with-ops-web-internal-token
AUTH_EMAIL_FROM=Campus Agent <auth@example.com>
# Optional reply address for all authentication email.
AUTH_EMAIL_REPLY_TO=
# Generate a different high-entropy secret for anonymous safety identifier derivation.
APP_API_SAFETY_IDENTIFIER_HMAC_SECRET=replace-with-safety-identifier-secret
# Browser account shell origin. This is required.
AUTH_SHELL_ORIGIN=https://campus.example.com
# Local read base for immutable derived assets. This base includes the bucket path.
OBJECT_STORE_LOCAL_BASE_URL=http://127.0.0.1:9000/campus-agent-derived/
EXECUTION_CONTROL_BASE_URL=https://execution-control.internal
APP_API_EXECUTION_SHARED_SECRET=replace-with-execution-control-shared-secret
# Use a distinct high-entropy secret for execution-control input reads and releases.
APP_API_EXECUTION_INPUT_SHARED_SECRET=replace-with-execution-input-shared-secret
# Comma-separated exact public notice hosts admitted into browser-facing source links.
APP_API_PUBLIC_NOTICE_URL_ALLOWLIST=www.example.edu
APP_API_DATABASE_SSLMODE=prefer
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=app-api@dev-local
# APP_API_DB is a Worker binding and is not configured in .dev.vars.
# For local Wrangler / Drizzle commands, place the process-level database URLs in
# `apps/app-api/.env` instead. `pnpm dev` and direct
# `pnpm exec tsx ./scripts/run-with-local-env.ts ...` commands load that file before
# invoking the underlying tool.
# APP_API_SCHEMA_DATABASE_URL lives in `apps/app-api/.env` for schema generation
# and repo-owned schema administration scripts.
