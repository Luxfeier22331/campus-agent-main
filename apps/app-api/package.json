{
	"name": "app-api",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Worker-native application backend for campus-agent v2.",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"dev": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=../../.wrangler-home pnpm exec tsx ./scripts/run-with-local-env.ts wrangler dev -e local --name app-api-local --ip 127.0.0.1 --port 27031",
		"deploy": "pnpm exec tsx ../../scripts/deploy/run-wrangler-command.ts deploy",
		"deploy:staging": "pnpm exec tsx ./scripts/deploy-staging.ts",
		"test": "vitest run -c vitest.node.config.mts",
		"test:node": "vitest run -c vitest.node.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"test:shared-db-integration": "RUN_APP_API_SHARED_DB_INTEGRATION=1 pnpm exec tsx ./scripts/run-with-local-env.ts vitest run -c vitest.shared-db.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/core": "1.6.23",
		"@better-auth/oauth-provider": "1.6.23",
		"@campus-agent/dining": "file:../../packages/domains/dining",
		"@hono/zod-openapi": "^1.4.0",
		"@sentry/cloudflare": "^10.64.0",
		"better-auth": "^1.6.23",
		"better-call": "1.3.7",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.9.3",
		"hono": "^4.12.28",
		"ingestion-contracts": "file:../../packages/ingestion-contracts",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.18.1",
		"@cloudflare/workers-types": "4.20260702.1",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.15.6",
		"drizzle-kit": "^0.31.5",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"wrangler": "4.107.1"
	},
	"license": "Apache-2.0"
}
