{
	"name": "app-api",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Worker-native application backend for campus-agent v2.",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"chat:e2e": "pnpm exec tsx ./scripts/chat-e2e.ts",
		"chat:e2e:dev": "pnpm exec tsx ./scripts/chat-e2e-local-dev.ts",
		"chat:e2e:local-real-provider": "pnpm exec tsx ./scripts/chat-e2e-local-real-provider.ts",
		"chat:e2e:staging": "node ./scripts/run-with-staging-smoke-env.mjs pnpm exec tsx ./scripts/chat-durable-e2e-staging.ts --chat-base-url https://api-staging.mucwiki-edge.link",
		"chat:durable:e2e:staging": "node ./scripts/run-with-staging-smoke-env.mjs pnpm exec tsx ./scripts/chat-durable-e2e-staging.ts --chat-base-url https://api-staging.mucwiki-edge.link",
		"chat:memory:e2e:staging": "node ./scripts/run-with-staging-smoke-env.mjs pnpm exec tsx ./scripts/chat-memory-e2e-staging.ts",
		"hindsight:memory:e2e:staging": "node ./scripts/run-with-staging-smoke-env.mjs pnpm exec tsx ./scripts/hindsight-memory-e2e-staging.ts",
		"dev": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=../../.wrangler-home node ./scripts/run-with-local-env.mjs wrangler dev -e local --name app-api-local --ip 127.0.0.1 --port 27031",
		"deploy": "node ../../scripts/run-wrangler-command.mjs deploy",
		"deploy:staging": "node ./scripts/deploy-staging.mjs",
		"runtime-db:proof:staging": "node ./scripts/run-with-staging-proof-env.mjs pnpm exec tsx ./scripts/staging-runtime-db-proof.ts --chat-base-url https://api-staging.mucwiki-edge.link",
		"test": "node ./scripts/run-node-tests.mjs",
		"test:all": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.config.mts",
		"test:node": "vitest run -c vitest.node.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"test:shared-db-integration": "RUN_APP_API_SHARED_DB_INTEGRATION=1 node ./scripts/run-with-local-env.mjs vitest run -c vitest.shared-db.config.mts",
		"test:official-web-shared-db-integration": "RUN_APP_API_OFFICIAL_WEB_SHARED_DB_INTEGRATION=1 node ./scripts/run-with-local-env.mjs vitest run -c vitest.official-web-shared-db.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "1.6.23",
		"@hono/zod-openapi": "^1.4.0",
		"@sentry/cloudflare": "^10.63.0",
		"better-auth": "^1.6.23",
		"@campus-agent/dining": "file:../../packages/domains/dining",
		"better-call": "1.3.7",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.9.3",
		"hono": "^4.12.27",
		"ingestion-contracts": "file:../../packages/ingestion-contracts",
		"official-web-core": "file:../../packages/official-web-core",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.0",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@types/node": "^24.12.0",
		"@types/pg": "^8.15.6",
		"drizzle-kit": "^0.31.5",
		"tsx": "^4.22.5",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.9",
		"wrangler": "^4.107.0"
	},
	"license": "Apache-2.0"
}
