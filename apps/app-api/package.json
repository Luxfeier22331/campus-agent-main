{
	"name": "app-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Shared Worker-native application backend for campus-agent v2.",
	"scripts": {
		"build:worker": "rm -rf dist/worker && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home pnpm exec wrangler deploy --dry-run --outdir dist/worker --env local",
		"dev": "set -a && . ./.env.local && . ./.dev.vars.local && set +a && export WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 && export XDG_CONFIG_HOME=\"${XDG_CONFIG_HOME:-../../.wrangler-home}\" && exec wrangler dev -e local --name app-api-local --ip 127.0.0.1 --port \"$PORT\" --env-file .dev.vars.local --var \"EXECUTION_CONTROL_BASE_URL:$EXECUTION_CONTROL_BASE_URL\"",
		"db:seed-local-campus-groups": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types ops/db/seed-local-campus-groups.ts",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"test": "pnpm run test:node:fast && pnpm run test:node:isolated",
		"test:node:fast": "vitest run -c vitest.node-fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.node-isolated.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"test:shared-db-integration": "vitest run -c vitest.shared-db.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/core": "1.7.4",
		"@better-auth/oauth-provider": "1.7.4",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"@hono/zod-openapi": "^1.6.3",
		"aws4fetch": "1.0.20",
		"better-auth": "1.7.4",
		"better-call": "1.4.0",
		"campus-contracts": "workspace:*",
		"drizzle-orm": "1.0.0-rc.4",
		"fast-xml-parser": "^5.11.1",
		"hono": "4.13.7",
		"html-escaper": "^3.0.3",
		"pg": "^8.23.0",
		"resend": "^6.28.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260914.1",
		"@testcontainers/postgresql": "12.1.0",
		"@types/html-escaper": "^3.0.4",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"campus-web": "workspace:*",
		"smol-toml": "1.8.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "4.131.1"
	},
	"license": "Apache-2.0"
}
