{
	"name": "app-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Shared Worker-native application backend for campus-agent v2.",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build:worker": "rm -rf dist/worker && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home pnpm exec wrangler deploy --dry-run --outdir dist/worker --env local",
		"dev": "pnpm --dir ../.. exec tsx scripts/dev/service.ts app-api",
		"deploy": "pnpm exec tsx ../../scripts/deploy/run-wrangler-command.ts deploy",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"test": "pnpm run test:node",
		"test:node": "pnpm run test:node:fast && pnpm run test:node:isolated",
		"test:node:fast": "vitest run -c vitest.node-fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.node-isolated.config.mts",
		"test:migration-integration": "vitest run -c vitest.migration-integration.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"test:shared-db-integration": "vitest run -c vitest.shared-db.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/core": "1.6.25",
		"@better-auth/oauth-provider": "1.6.25",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/langfuse-identity": "workspace:*",
		"@hono/zod-openapi": "^1.4.0",
		"@sentry/cloudflare": "10.68.0",
		"better-auth": "^1.6.25",
		"better-call": "1.3.7",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.10.1",
		"hono": "^4.12.28",
		"pg": "^8.22.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.18.8",
		"@cloudflare/workers-types": "5.20260724.1",
		"@testcontainers/postgresql": "12.0.4",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.15.6",
		"drizzle-kit": "^0.31.5",
		"smol-toml": "1.7.0",
		"tsx": "^4.23.0",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"wrangler": "4.114.0"
	},
	"license": "Apache-2.0"
}
