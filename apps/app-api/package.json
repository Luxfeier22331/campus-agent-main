{
  "name": "app-api",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Worker-native application backend for campus-agent v2.",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "db:bootstrap": "node ./scripts/run-with-local-env.mjs node ./scripts/bootstrap-shared-product-database.mjs",
    "db:bootstrap:staging": "node ./scripts/run-with-staging-db-env.mjs node ./scripts/bootstrap-shared-product-database.mjs",
    "db:generate": "node ./scripts/run-with-local-env.mjs drizzle-kit generate",
    "db:ensure-app-auth-role-search-path": "node ./scripts/run-with-local-env.mjs node ./scripts/ensure-app-auth-role-search-path.mjs",
    "db:migrate": "node ./scripts/run-with-local-env.mjs drizzle-kit migrate",
    "db:migrate:staging": "node ./scripts/run-with-staging-db-env.mjs drizzle-kit migrate",
    "db:print-auth-migration": "node ./scripts/run-with-local-env.mjs node ./scripts/print-shared-product-auth-migration.mjs",
    "db:reconcile-shared-drift": "node ./scripts/run-with-local-env.mjs node ./scripts/reconcile-shared-db-drift.mjs",
    "db:reconcile-shared-drift:staging": "node ./scripts/run-with-staging-db-env.mjs node ./scripts/reconcile-shared-db-drift.mjs",
    "smoke-identity:provision": "node ./scripts/run-with-local-env.mjs pnpm exec tsx ./scripts/provision-smoke-identity.ts",
    "smoke-identity:provision:staging": "node ./scripts/run-with-staging-db-env.mjs pnpm exec tsx ./scripts/provision-smoke-identity.ts",
    "official-web:drain-projection": "node ./scripts/run-with-local-env.mjs pnpm exec tsx ./scripts/drain-official-web-projection.ts",
    "official-web:seed-smoke": "node ./scripts/run-with-local-env.mjs pnpm exec tsx ./scripts/seed-official-web-smoke.ts",
    "requests:seed-smoke": "node ./scripts/run-with-local-env.mjs pnpm exec tsx ./scripts/seed-request-smoke.ts",
    "db:adopt-shared": "node ./scripts/run-with-local-env.mjs node ./scripts/adopt-shared-database.mjs",
    "projection:drain": "node ./scripts/run-with-local-env.mjs node ./scripts/trigger-local-scheduled-drain.mjs",
    "dev": "XDG_CONFIG_HOME=./.wrangler-home node ./scripts/run-with-local-env.mjs wrangler dev -e local",
    "deploy": "node ../../scripts/run-wrangler-command.mjs deploy",
    "deploy:check-secrets:staging": "uv run --all-packages python ../../scripts/check_worker_secret_presence.py --app apps/app-api --env staging",
    "deploy:preflight:staging": "node ../../scripts/run-worker-staging-preflight.mjs --app apps/app-api",
    "deploy:verify-config:staging": "node ./scripts/verify-staging-config.mjs",
    "deploy:staging": "pnpm deploy:preflight:staging && node ./scripts/deploy-staging.mjs",
    "test": "pnpm run test:node",
    "test:all": "XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.config.mts",
    "test:node": "vitest run -c vitest.node.config.mts",
    "test:worker": "XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
    "test:shared-db-integration": "RUN_APP_API_SHARED_DB_INTEGRATION=1 node ./scripts/run-with-local-env.mjs vitest run -c vitest.shared-db.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.10",
    "@sentry/cloudflare": "^10.46.0",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.8.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.77.0"
  }
}
