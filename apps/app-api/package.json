{
	"name": "app-api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Shared Worker-native application backend for campus-agent v2.",
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"test:node:fast": "vitest run -c vitest.node-fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.node-isolated.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"test:shared-db-integration": "vitest run -c vitest.shared-db.config.mts",
		"typecheck": "tsc --noEmit",
		"build": "bash scripts/build.sh"
	},
	"dependencies": {
		"@better-auth/core": "1.7.11",
		"@better-auth/oauth-provider": "1.7.11",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"aws4fetch": "1.0.20",
		"better-auth": "1.7.11",
		"better-call": "1.4.2",
		"campus-contracts": "workspace:*",
		"drizzle-orm": "1.0.0-rc.4",
		"fast-xml-parser": "^5.11.2",
		"hono": "4.13.13",
		"html-escaper": "^3.0.3",
		"pg": "^8.23.1",
		"resend": "^6.34.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.5",
		"@cloudflare/workers-types": "5.20261019.1",
		"@testcontainers/postgresql": "12.2.1",
		"@types/html-escaper": "^3.0.4",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"campus-web": "workspace:*",
		"smol-toml": "1.9.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "4.151.2"
	},
	"license": "Apache-2.0"
}
