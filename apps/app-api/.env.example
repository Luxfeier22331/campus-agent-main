# app-api local process environment for Wrangler / Drizzle commands.
# Copy to `apps/app-api/.env` and fill real values.
# You can also fan out `CAMPUS_SHARED_POSTGRES_URL` and
# `CAMPUS_SHARED_POSTGRES_MANAGEMENT_URL` from the root-worktree `.env`
# into this file with:
# `uv run --all-packages python -m scripts.sync_app_api_local_db_env`

# Wrangler local Hyperdrive override for the `APP_API_DB` binding in `wrangler.toml`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_APP_API_DB=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Optional dedicated local fresh-read connection for the `APP_API_DB_FRESH` binding.
# If omitted, local runtime falls back to `APP_API_DB`, but local sync now writes the same
# DSN here so auth-sensitive local flows stay explicit.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_APP_API_DB_FRESH=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Direct management connection used by Drizzle schema generation / migrations.
# Do not reuse the session pooler here.
APP_API_MANAGEMENT_DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
