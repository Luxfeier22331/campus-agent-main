# app-api local process environment for Wrangler / Drizzle commands.
# Copy to `apps/app-api/.env` and fill real values.

# Wrangler local Hyperdrive override for the `APP_API_DB` binding in `wrangler.toml`.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_APP_API_DB=postgresql://app_api:<url-encoded-password>@postgres.example.internal:5432/campus_agent?sslmode=verify-full

# Dedicated local fresh-read connection for the `APP_API_DB_FRESH` binding.
# Local sync writes the same DSN here so auth-sensitive local flows stay explicit.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_APP_API_DB_FRESH=postgresql://app_api:<url-encoded-password>@postgres.example.internal:5432/campus_agent?sslmode=verify-full

# Owner connection used only by schema installation and schema-admin commands.
APP_API_SCHEMA_DATABASE_URL=postgresql://schema-owner:<url-encoded-password>@postgres.example.internal:5432/campus_agent?sslmode=verify-full
APP_API_DATABASE_SSLMODE=verify-full
APP_API_DATABASE_CA_CERT_PATH=/path/to/postgres-ca.crt

# Command-scoped federation client provision inputs. These are consumed by
# `pnpm federation:provision-muc-wiki*`; the client secret is not a Worker
# runtime var and must not be committed with a real value.
APP_API_FEDERATION_MUC_WIKI_CLIENT_SECRET=
APP_API_FEDERATION_MUC_WIKI_REDIRECT_URI=https://muc.wiki/wiki/Special:PluggableAuthLogin
APP_API_FEDERATION_MUC_WIKI_POST_LOGOUT_REDIRECT_URI=https://muc.wiki/wiki/Special:UserLogout
