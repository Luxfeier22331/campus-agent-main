{
	"schema_version": "campus_env_contract.v1",
	"owner": "apps/app-api",
	"consumers": [
		{
			"id": "worker-runtime-code",
			"sources": [{ "kind": "typescript", "path": "apps/app-api/src/config.ts" }]
		},
		{
			"id": "worker-local",
			"doctor_surfaces": ["query"],
			"sources": [
				{
					"kind": "wrangler",
					"path": "apps/app-api/wrangler.toml",
					"environment": "local"
				}
			]
		},
		{
			"id": "worker-staging",
			"sources": [
				{
					"kind": "wrangler",
					"path": "apps/app-api/wrangler.toml",
					"environment": "staging"
				}
			]
		},
		{ "id": "worker-observability-local", "doctor_surfaces": ["worker-observability-local"] },
		{
			"id": "schema-command",
			"sources": [
				{ "kind": "typescript", "path": "apps/app-api/drizzle.config.ts" },
				{ "kind": "typescript", "path": "apps/app-api/scripts/run-with-local-env.ts" },
				{ "kind": "typescript", "path": "apps/app-api/ops/db" },
				{
					"kind": "typescript",
					"path": "apps/app-api/src/script-support/shared-db/shared-product-database-bootstrap.ts"
				},
				{
					"kind": "kubernetes",
					"path": "infra/k8s/execution-runtime/base/app-api-schema-job.yaml",
					"resources": ["app-api-schema"]
				}
			]
		},
		{
			"id": "federation-command",
			"sources": [
				{
					"kind": "typescript",
					"path": "apps/app-api/ops/identity/provision-muc-wiki-federation-client.ts"
				},
				{
					"kind": "typescript",
					"path": "apps/app-api/src/script-support/provisioning/provision-muc-wiki-federation-client-lib.ts"
				}
			]
		},
		{
			"id": "worker-release",
			"doctor_surfaces": ["worker-staging-app-api"],
			"sources": [
				{ "kind": "typescript", "path": "apps/app-api/scripts/upload-staging-version.ts" },
				{
					"kind": "typescript",
					"path": "scripts/deploy/worker-version.ts",
					"ignore": ["WORKER_VERSION_OUTPUT"]
				}
			]
		},
		{
			"id": "smoke-command",
			"sources": [
				{ "kind": "typescript", "path": "apps/app-api/e2e/support/chat-e2e.args.ts" },
				{ "kind": "typescript", "path": "apps/app-api/e2e/chat-durable-staging.ts" },
				{ "kind": "typescript", "path": "apps/app-api/e2e/chat-memory-staging.ts" },
				{
					"kind": "typescript",
					"path": "apps/app-api/e2e/support/staging-docs-gated-smoke.args.ts"
				}
			]
		}
	],
	"keys": [
		{
			"name": "APP_API_NAME",
			"class": "config",
			"required_by": [],
			"optional_by": ["worker-runtime-code", "worker-local"],
			"templates": ["apps/app-api/.dev.vars.example"]
		},
		{ "name": "PGHOST", "class": "config", "required_by": ["schema-command"] },
		{ "name": "PGPORT", "class": "config", "required_by": ["schema-command"] },
		{ "name": "PGDATABASE", "class": "config", "required_by": ["schema-command"] },
		{ "name": "PGUSER", "class": "secret", "required_by": ["schema-command"] },
		{ "name": "PGPASSWORD", "class": "secret", "required_by": ["schema-command"] },
		{ "name": "HOME", "class": "config", "required_by": ["schema-command"] },
