		"@campus-agent/notice-database": "workspace:*",
		"internal-portal-collection": "workspace:*",
		"notice-classifier": "workspace:*",
		"notice-publisher": "workspace:*",
		"tsx": "^4.23.13"
	},
	"devDependencies": {
		"@types/node": "^24.13.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"esbuild": "^0.28.2"
