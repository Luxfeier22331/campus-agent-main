{
	"name": "notice-pipeline-worker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"scripts": {
		"dev": "node --env-file-if-exists=.env.local --import=tsx src/worker.ts",
