		"internal-portal-collection": "workspace:*",
		"jsdom": "^30.1.1",
		"mime-types": "^3.0.2",
		"notice-classifier": "workspace:*",
		"notice-publisher": "workspace:*",
		"pg": "^8.23.1",
		"tldts": "^7.4.16",
		"tsx": "^4.23.15",
		"undici": "^8.11.2"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "^7.0.2",
