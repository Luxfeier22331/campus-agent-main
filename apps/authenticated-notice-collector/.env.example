# authenticated-notice-collector runtime env
# Copy to this app's untracked `.env` or inject through the scheduler/deploy
# secret store. Do not put real portal cookies in repo-root templates.

# Entrypoint mode: auth-check, notice-export, file-release-export, visual-ref-audit.
AUTHENTICATED_NOTICE_COLLECTOR_MODE=auth-check

# Portal auth. Use the explicit three-cookie set.
AUTHENTICATED_NOTICE_SSO_TGC=
AUTHENTICATED_NOTICE_JSESSIONID=
AUTHENTICATED_NOTICE_NGINX=
AUTHENTICATED_NOTICE_AUTH_TIMEOUT_MS=30000

# Portal source and runtime paths.
AUTHENTICATED_NOTICE_RUNTIME_DIR=
AUTHENTICATED_NOTICE_BASE_URL=https://portal.example.edu
AUTHENTICATED_NOTICE_PAGE_URL=https://portal.example.edu/page/11#/
AUTHENTICATED_NOTICE_SOURCE_HOME_URL=https://portal.example.edu
AUTHENTICATED_NOTICE_SITE_ID=example_internal_portal
AUTHENTICATED_NOTICE_NOTICE_TYPES_PATH=
AUTHENTICATED_NOTICE_BYPASS_PROXY=true
AUTHENTICATED_NOTICE_PROXY_SERVER=

# Collection scope and auth-check defaults.
AUTHENTICATED_NOTICE_AUTH_CHECK_NOTICE_TYPE=5
AUTHENTICATED_NOTICE_AUTH_CHECK_PAGE_SIZE=3
AUTHENTICATED_NOTICE_COLLECTION_MODE=incremental
AUTHENTICATED_NOTICE_HISTORICAL_BACKFILL_MAX_PAGES_PER_TYPE=
AUTHENTICATED_NOTICE_NOTICE_TYPE_ALLOWLIST=
AUTHENTICATED_NOTICE_SELECTED_NOTICES=
AUTHENTICATED_NOTICE_REQUEST_MAX_RETRIES=3
AUTHENTICATED_NOTICE_REQUEST_BACKOFF_BASE_MS=1200

# Attachment and media capture controls.
AUTHENTICATED_NOTICE_ATTACHMENT_FETCH_REQUEST_MANIFEST_PATH=
AUTHENTICATED_NOTICE_ATTACHMENT_FETCH_STATUS_DATABASE_URL=
AUTHENTICATED_NOTICE_ATTACHMENT_FETCH_STATUS_DISABLE=false
AUTHENTICATED_NOTICE_DEFAULT_INLINE_VISUAL_CAPTURE=false

# Run ledger and lease.
AUTHENTICATED_NOTICE_COLLECTOR_RUN_LEDGER_DATABASE_URL=
AUTHENTICATED_NOTICE_COLLECTOR_RUN_LEDGER_DISABLE=false
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_DATABASE_URL=
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_DISABLE=false
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_TTL_SECONDS=3600
AUTHENTICATED_NOTICE_WRITE_LOCAL_EXPORTS=false

# File-release and visual-reference bounded operator modes.
AUTHENTICATED_NOTICE_FILE_RELEASE_PAGE_SIZE=100
AUTHENTICATED_NOTICE_FILE_RELEASE_MAX_PAGES=
AUTHENTICATED_NOTICE_FILE_RELEASE_MAX_ITEMS=
AUTHENTICATED_NOTICE_FILE_RELEASE_TARGET_ID=
AUTHENTICATED_NOTICE_VISUAL_AUDIT_MAX_NOTICES=
AUTHENTICATED_NOTICE_VISUAL_AUDIT_OUTPUT_DIR=

# Existing MinIO-backed source bucket / S3-compatible source-bucket interface.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
OBJECT_STORE_BUCKET_SOURCE=campus-agent-source
