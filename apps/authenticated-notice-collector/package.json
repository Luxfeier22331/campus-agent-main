{
	"name": "authenticated-notice-collector",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Node runtime shell for authenticated_notice_portal collection with typed reference-only bootstrap export.",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"auth:save": "tsx src/auth-save.ts",
		"auth:check": "tsx src/auth-check.ts",
		"bootstrap:export": "tsx src/bootstrap-export.ts",
		"file-release:export": "tsx src/file-release-export.ts",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run -c vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.913.0",
		"dotenv": "^16.6.1",
		"pg": "^8.20.0",
		"playwright": "^1.59.1"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"@types/pg": "^8.20.0",
		"tsx": "^4.20.5",
		"typescript": "^5.8.2",
		"vitest": "^4.1.0"
	}
}
