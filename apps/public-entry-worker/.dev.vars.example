# Local Cloudflare Worker bindings for `wrangler dev`.
# Copy to `.dev.vars` in this directory and fill real local values.

ORIGIN_BASE_URL=http://127.0.0.1:8000
# This must match `API_WORKER_SHARED_SECRET` in the repo root `.env`.
ORIGIN_SHARED_SECRET=local-dev-origin-secret
ENTRY_MODE=authenticated-only
WORKER_ALLOW_ANONYMOUS=false
ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
ACCESS_POLICY_AUD=<cloudflare-access-audience>
