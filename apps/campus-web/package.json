{
	"name": "campus-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the student-facing campus experience surface.",
	"scripts": {
		"build": "pnpm exec tsx ./scripts/build-campus-web.ts",
		"build:test": "pnpm exec tsx ./test/build-browser-test-content.ts",
		"build:worker": "CLOUDFLARE_ENV=local pnpm run build:test",
		"build:staging": "pnpm exec tsx ./scripts/build-campus-web.ts --staging",
		"dev": "CLOUDFLARE_ENV=local WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=\"${XDG_CONFIG_HOME:-../../.wrangler-home}\" vite",
		"docs:seed-local": "pnpm exec tsx ./scripts/seed-local-docs-source.ts",
		"docs:source:update": "pnpm exec tsx ./scripts/update-docs-source.ts",
		"map:normalize": "pnpm exec tsx ./scripts/campus-map/generate.ts --normalize",
		"map:snapshot:update": "pnpm exec tsx ./scripts/campus-map/generate.ts --snapshot-update",
		"map:validate": "pnpm exec tsx ./scripts/campus-map/generate.ts --validate",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "pnpm run test:node:fast && pnpm run test:node:isolated",
		"test:e2e": "playwright test -c e2e.config.ts",
		"test:e2e:full": "pnpm run build:worker && CAMPUS_WEB_E2E_PREBUILT=1 pnpm run test:e2e && CAMPUS_WEB_E2E_PREBUILT=1 pnpm run test:e2e:worker && CAMPUS_WEB_E2E_PREBUILT=1 pnpm run test:e2e:ui-baseline",
		"pretest:e2e:dev:chat": "pnpm run build:worker",
		"test:e2e:dev:chat": "playwright test -c e2e.dev-chat.config.ts",
		"test:e2e:ui-baseline": "playwright test -c e2e.ui-baseline.config.ts",
		"test:e2e:worker": "playwright test -c e2e.worker.config.ts",
		"test:node:fast": "vitest run -c vitest.fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.isolated.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.19",
		"@assistant-ui/react-markdown": "0.14.15",
		"@better-auth-ui/core": "^1.7.23",
		"@better-auth-ui/react": "^1.7.23",
		"@better-auth/api-key": "1.7.5",
		"@better-auth/core": "1.7.5",
		"@better-auth/oauth-provider": "1.7.5",
		"@better-auth/passkey": "1.7.5",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@gravity-ui/icons": "2.22.0",
		"@hookform/resolvers": "^5.9.1",
		"@internationalized/date": "^3.12.4",
		"@marsidev/react-turnstile": "^1.6.1",
		"@mikkelscheike/email-provider-links": "^6.0.0",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toggle": "^1.1.18",
		"@radix-ui/react-toggle-group": "^1.1.19",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@tanstack/history": "1.162.4",
		"@tanstack/react-pacer": "^0.23.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.36",
		"assistant-stream": "0.3.42",
		"better-auth": "1.7.5",
		"better-call": "1.4.0",
		"bowser": "^2.14.1",
		"campus-contracts": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"flexsearch": "0.8.212",
		"lucide-react": "^1.45.0",
		"maplibre-gl": "^6.9.1",
		"motion": "^13.2.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-aria-components": "1.21.1",
		"react-dom": "^19.3.0",
		"react-email": "6.9.5",
		"react-hook-form": "^7.88.0",
		"react-zoom-pan-pinch": "^4.2.0",
		"remark-gfm": "^4.0.1",
		"tw-shimmer": "^0.4.13",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/vite-plugin": "1.54.9",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260915.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.0.1",
		"osmtogeojson": "3.0.0-beta.5",
		"smol-toml": "1.8.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "4.131.2"
	},
	"license": "Apache-2.0"
}
