{
	"name": "campus-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the student-facing campus experience surface.",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"build": "pnpm run build:docs && pnpm run build:app",
		"build:app": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite build && pnpm exec tsx ./scripts/check-client-bundle-budget.ts",
		"build:docs": "pnpm exec tsx ./scripts/build-published-reader-docs.ts",
		"build:staging": "pnpm exec tsx ./scripts/build-published-reader-docs.ts --staging && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 CLOUDFLARE_ENV=staging XDG_CONFIG_HOME=./.wrangler-home pnpm exec tsx ../../scripts/deploy/run-worker-staging-build.ts -- vite build && pnpm exec tsx ./scripts/check-client-bundle-budget.ts",
		"dev": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 CLOUDFLARE_ENV=local XDG_CONFIG_HOME=../../.wrangler-home vite --host 127.0.0.1 --port 27014 --strictPort",
		"deploy": "pnpm build && pnpm exec tsx ../../scripts/deploy/verify-worker-deploy-config.ts dist/campus_web/wrangler.json APP_API=app-api && pnpm exec tsx ../../scripts/deploy/run-wrangler-command.ts deploy --config dist/campus_web/wrangler.json",
		"deploy:staging": "pnpm exec tsx ./scripts/deploy-staging.ts",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "pnpm run test:node:fast && pnpm run test:node:isolated",
		"test:e2e": "playwright test -c e2e.config.ts",
		"test:e2e:worker": "playwright test -c e2e.worker.config.ts",
		"test:node": "vitest run -c vitest.config.mts",
		"test:node:fast": "vitest run -c vitest.fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.isolated.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@assistant-ui/react": "0.14.26",
		"@assistant-ui/react-markdown": "^0.14.5",
		"@better-auth-ui/core": "^1.6.27",
		"@better-auth-ui/heroui": "^1.6.27",
		"@better-auth-ui/react": "^1.6.27",
		"@better-auth/api-key": "1.6.23",
		"@better-auth/core": "1.6.23",
		"@better-auth/oauth-provider": "^1.6.23",
		"@better-auth/passkey": "1.6.23",
		"@campus-agent/dining": "workspace:*",
		"@gravity-ui/icons": "2.18.0",
		"@heroui/react": "^3.2.2",
		"@heroui/styles": "^3.2.2",
		"@hookform/resolvers": "^5.4.0",
		"@internationalized/date": "^3.12.2",
		"@marsidev/react-turnstile": "^1.5.3",
		"@mikkelscheike/email-provider-links": "^5.1.8",
		"@radix-ui/react-avatar": "^1.2.2",
		"@radix-ui/react-checkbox": "^1.3.7",
		"@radix-ui/react-collapsible": "^1.1.16",
		"@radix-ui/react-dialog": "^1.1.19",
		"@radix-ui/react-dropdown-menu": "^2.1.20",
		"@radix-ui/react-label": "^2.1.11",
		"@radix-ui/react-popover": "^1.1.19",
		"@radix-ui/react-select": "^2.3.3",
		"@radix-ui/react-separator": "^1.1.11",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-toggle": "^1.1.14",
		"@radix-ui/react-toggle-group": "^1.1.15",
		"@radix-ui/react-tooltip": "^1.2.12",
		"@react-email/components": "^1.0.12",
		"@rspress/core": "^2.0.16",
		"@sentry/cloudflare": "^10.64.0",
		"@tanstack/react-pacer": "^0.22.1",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.17",
		"assistant-stream": "0.3.25",
		"better-auth": "^1.6.23",
		"better-call": "1.3.7",
		"bowser": "^2.14.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.23.0",
		"maplibre-gl": "^5.14.0",
		"motion": "^12.42.2",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.81.0",
		"react-zoom-pan-pinch": "^4.0.3",
		"remark-gfm": "^4.0.1",
		"sonner": "^1.7.4",
		"tailwind-merge": "^3.6.0",
		"tw-shimmer": "^0.4.11",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1081.0",
		"@cloudflare/vite-plugin": "1.43.1",
		"@cloudflare/vitest-pool-workers": "0.18.1",
		"@cloudflare/workers-types": "4.20260702.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"jsdom": "^27.4.0",
		"playwright": "^1.61.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"wrangler": "4.107.1"
	},
	"license": "Apache-2.0"
}
