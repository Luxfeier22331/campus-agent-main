{
	"name": "campus-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the student-facing campus experience surface.",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "pnpm exec tsx ./scripts/build-campus-web.ts",
		"build:test": "pnpm exec tsx ./test/build-browser-test-content.ts",
		"build:worker": "CLOUDFLARE_ENV=local pnpm run build:test",
		"build:staging": "pnpm exec tsx ./scripts/build-campus-web.ts --staging",
		"dev": "pnpm --dir ../.. exec tsx scripts/dev/service.ts campus-web",
		"deploy": "pnpm exec tsx ./scripts/deploy-campus-web.ts",
		"docs:seed-local": "pnpm exec tsx ./scripts/seed-local-docs-source.ts",
		"docs:source:clean-segmentation": "pnpm exec tsx ./scripts/hotfix-docs-reader-segmentation.ts",
		"docs:source:update": "pnpm exec tsx ./scripts/update-docs-source.ts",
		"map:normalize": "pnpm exec tsx ./scripts/campus-map/generate.ts --normalize",
		"map:snapshot:update": "pnpm exec tsx ./scripts/campus-map/generate.ts --snapshot-update",
		"map:validate": "pnpm exec tsx ./scripts/campus-map/generate.ts --validate",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "pnpm run test:node:fast && pnpm run test:node:isolated",
		"test:e2e": "playwright test -c e2e.config.ts",
		"test:e2e:full": "pnpm run test:e2e && pnpm run test:e2e:worker",
		"test:e2e:smoke": "pnpm run test:e2e:smoke:app && pnpm run test:e2e:smoke:worker",
		"test:e2e:smoke:app": "playwright test -c e2e.config.ts --grep @smoke",
		"test:e2e:ui-baseline": "playwright test -c e2e.ui-baseline.config.ts",
		"test:e2e:smoke:worker": "playwright test -c e2e.worker.config.ts --grep @smoke",
		"test:e2e:worker": "playwright test -c e2e.worker.config.ts",
		"test:node:fast": "vitest run -c vitest.fast.config.mts",
		"test:node:isolated": "vitest run -c vitest.isolated.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.14",
		"@assistant-ui/react-markdown": "0.14.10",
		"@better-auth-ui/core": "^1.6.45",
		"@better-auth-ui/heroui": "^1.6.45",
		"@better-auth-ui/react": "^1.6.45",
		"@better-auth/api-key": "1.6.27",
		"@better-auth/core": "1.6.27",
		"@better-auth/oauth-provider": "^1.6.27",
		"@better-auth/passkey": "1.6.27",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@gravity-ui/icons": "2.21.0",
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "^3.2.4",
		"@hookform/resolvers": "^5.7.1",
		"@internationalized/date": "^3.12.3",
		"@marsidev/react-turnstile": "^1.6.0",
		"@mikkelscheike/email-provider-links": "^5.2.2",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-toggle": "^1.1.18",
		"@radix-ui/react-toggle-group": "^1.1.19",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@sentry/cloudflare": "10.70.0",
		"@sentry/react": "10.70.0",
		"@tanstack/history": "1.162.1",
		"@tanstack/react-pacer": "^0.23.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.27",
		"assistant-stream": "0.3.37",
		"better-auth": "^1.6.27",
		"better-call": "1.4.0",
		"bowser": "^2.14.1",
		"campus-contracts": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"flexsearch": "0.8.212",
		"lucide-react": "^1.31.0",
		"maplibre-gl": "^6.3.0",
		"motion": "^13.1.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "6.9.2",
		"react-hook-form": "^7.85.0",
		"react-zoom-pan-pinch": "^4.0.4",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-shimmer": "^0.4.12",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1109.0",
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/vite-plugin": "1.52.0",
		"@cloudflare/vitest-pool-workers": "0.21.2",
		"@cloudflare/workers-types": "5.20260813.1",
		"@playwright/test": "^1.62.1",
		"@sentry/vite-plugin": "5.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"ajv": "^8.20.0",
		"image-size": "2.0.2",
		"jsdom": "^30.0.1",
		"osmtogeojson": "3.0.0-beta.5",
		"playwright": "^1.62.1",
		"smol-toml": "1.8.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "4.122.0"
	},
	"license": "Apache-2.0"
}
