{
	"name": "campus-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the student-facing campus experience surface.",
	"scripts": {
		"build": "pnpm exec tsx ./scripts/build-campus-web.ts",
		"build:staging": "pnpm exec tsx ./scripts/build-campus-web.ts --staging",
		"dev": "CLOUDFLARE_ENV=local WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=\"${XDG_CONFIG_HOME:-../../.wrangler-home}\" vite",
		"docs:source:check": "pnpm exec tsx ./scripts/check-docs-source.ts",
		"docs:source:publish": "pnpm exec tsx ./scripts/publish-docs-source.ts",
		"map:normalize": "pnpm exec tsx ./scripts/campus-map/generate.ts --normalize",
		"map:snapshot:update": "pnpm exec tsx ./scripts/campus-map/generate.ts --snapshot-update",
		"map:validate": "pnpm exec tsx ./scripts/campus-map/generate.ts --validate",
		"static:prepare": "pnpm exec tsx ./scripts/prepare-static-site.ts",
		"static:publish": "pnpm exec tsx ./scripts/publish-static-site.ts --repo Luxfeier22331/Luxfeier22331.github.io",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test:e2e": "playwright test -c e2e.config.ts",
		"test:e2e:full": "bash scripts/test-e2e-full.sh",
		"test:e2e:dev:chat": "pnpm run build:fixture && playwright test -c e2e.dev-chat.config.ts",
		"test:e2e:ui-baseline": "playwright test -c e2e.ui-baseline.config.ts",
		"test:e2e:worker": "playwright test -c e2e.worker.config.ts",
		"test:node:fast": "vitest run -c vitest.config.mts --project=campus-node-fast",
		"test:node:isolated": "vitest run -c vitest.config.mts --project=campus-node-isolated",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit --checkers 1",
		"test:dom:fast": "vitest run -c vitest.config.mts --project=campus-dom-fast",
		"test:dom:isolated": "vitest run -c vitest.config.mts --project=campus-dom-isolated",
		"test:browser": "vitest run -c vitest.browser.config.mts",
		"build:fixture": "CLOUDFLARE_ENV=local pnpm exec tsx ./test/build-browser-test-content.ts",
		"test:e2e:answer-transport": "playwright test -c e2e.answer-transport.config.ts"
	},
	"dependencies": {
		"@assistant-ui/react": "0.15.29",
		"@assistant-ui/react-markdown": "0.14.23",
		"@better-auth-ui/core": "^1.7.30",
		"@better-auth-ui/react": "^1.7.30",
		"@better-auth/oauth-provider": "1.7.11",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@hookform/resolvers": "^6.0.0",
		"@internationalized/date": "^3.12.4",
		"@marsidev/react-turnstile": "^1.6.2",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-toggle": "^1.2.1",
		"@radix-ui/react-toggle-group": "^1.2.1",
		"@tanstack/history": "1.162.5",
		"@tanstack/react-pacer": "^0.24.1",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.45",
		"assistant-stream": "0.3.52",
		"better-auth": "1.7.11",
		"bowser": "^2.14.1",
		"campus-contracts": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"flexsearch": "0.8.212",
		"lucide-react": "^1.59.0",
		"maplibre-gl": "^6.15.0",
		"motion": "^14.4.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-aria-components": "1.22.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
		"react-zoom-pan-pinch": "^4.2.0",
		"remark-gfm": "^4.0.1",
		"tw-shimmer": "^0.4.14",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1153.0",
		"@axe-core/playwright": "4.14.0",
		"@cloudflare/vite-plugin": "1.64.0",
		"@cloudflare/vitest-plugin": "1.4.5",
		"@cloudflare/workers-types": "5.20261019.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser": "5.0.5",
		"@vitest/browser-playwright": "5.0.5",
		"jsdom": "^30.1.3",
		"smol-toml": "1.9.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "4.151.2",
		"yaml": "2.9.1"
	},
	"license": "Apache-2.0"
}
