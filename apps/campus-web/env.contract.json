{
	"schema_version": "campus_env_contract.v1",
	"owner": "apps/campus-web",
	"consumers": [
		{
			"id": "worker-runtime-code",
			"sources": [{ "kind": "typescript", "path": "apps/campus-web/src/index.ts" }]
		},
		{
			"id": "worker-local",
			"sources": [
				{
					"kind": "wrangler",
					"path": "apps/campus-web/wrangler.toml",
					"environment": "local"
				}
			]
		},
		{
			"id": "worker-staging",
			"sources": [
				{
					"kind": "wrangler",
					"path": "apps/campus-web/wrangler.toml",
					"environment": "staging"
				}
			]
		},
		{ "id": "worker-observability-local", "doctor_surfaces": ["worker-observability-local"] },
		{
			"id": "worker-release",
			"doctor_surfaces": ["worker-staging-campus-web"],
			"sources": [
				{ "kind": "typescript", "path": "apps/campus-web/scripts/upload-staging-version.ts" },
				{
					"kind": "typescript",
					"path": "scripts/deploy/worker-version.ts",
					"ignore": ["WORKER_VERSION_OUTPUT"]
				}
			]
		},
		{
			"id": "reader-build",
			"sources": [
				{
					"kind": "typescript",
					"path": "apps/campus-web/src/docs-reader-build/published-reader-object-store.ts"
				}
			]
		},
		{
			"id": "staging-e2e",
			"sources": [{ "kind": "typescript", "path": "apps/campus-web/e2e/staging-browser.ts" }]
		},
		{
			"id": "browser-test",
			"sources": [
				{ "kind": "typescript", "path": "apps/campus-web/e2e.config.ts" },
				{ "kind": "typescript", "path": "apps/campus-web/e2e.worker.config.ts" }
			]
		}
	],
	"keys": [
		{
			"name": "APP_API",
			"class": "config",
			"required_by": ["worker-local", "worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"delivery": "binding"
		},
		{
			"name": "APP_API_BASE_URL",
			"class": "config",
			"required_by": ["worker-local", "worker-staging"],
			"optional_by": ["worker-runtime-code", "staging-e2e"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "ASSETS",
			"class": "config",
			"required_by": [],
			"optional_by": ["worker-runtime-code"],
			"delivery": "binding"
		},
		{
			"name": "MAP_DATA",
			"class": "config",
			"required_by": ["worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"delivery": "binding"
		},
		{
			"name": "CAMPUS_WEB_BASE_URL",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		},
		{
			"name": "CAMPUS_WEB_E2E_PORT",
			"class": "config",
			"required_by": [],
			"optional_by": ["browser-test"]
		},
		{
			"name": "CAMPUS_WEB_E2E_PREBUILT",
			"class": "config",
			"required_by": [],
			"optional_by": ["browser-test"]
		},
		{
			"name": "CAMPUS_WEB_E2E_WORKER_PORT",
			"class": "config",
			"required_by": [],
			"optional_by": ["browser-test"]
		},
		{
			"name": "CI",
			"class": "config",
			"required_by": [],
			"optional_by": ["browser-test"]
		},
		{
			"name": "CAMPUS_WEB_HOSTNAME",
			"class": "config",
			"required_by": ["worker-local", "worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "AUTH_TURNSTILE_SITE_KEY",
			"class": "config",
			"required_by": [],
			"optional_by": ["worker-runtime-code", "worker-local", "worker-staging"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "AUTH_TURNSTILE_APPEARANCE",
			"class": "config",
			"required_by": ["worker-local", "worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "AUTH_TURNSTILE_EXECUTION",
			"class": "config",
			"required_by": ["worker-local", "worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "DOCS_RELEASE_ID",
			"class": "config",
			"required_by": ["worker-local", "worker-release"],
			"optional_by": ["worker-runtime-code"]
		},
		{
			"name": "SENTRY_DSN",
			"class": "config",
			"required_by": ["worker-observability-local"],
			"optional_by": ["worker-runtime-code", "worker-staging"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "SENTRY_BROWSER_DSN",
			"class": "config",
			"required_by": ["worker-observability-local"],
			"optional_by": ["worker-runtime-code", "worker-staging"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "SENTRY_ENVIRONMENT",
			"class": "config",
			"required_by": ["worker-observability-local", "worker-staging"],
			"optional_by": ["worker-runtime-code"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{
			"name": "SENTRY_RELEASE",
			"class": "config",
			"required_by": ["worker-observability-local"],
			"optional_by": ["worker-runtime-code", "worker-staging"],
			"templates": ["apps/campus-web/.dev.vars.example"]
		},
		{ "name": "CLOUDFLARE_ACCOUNT_ID", "class": "config", "required_by": ["worker-release"] },
		{ "name": "CLOUDFLARE_AUTOMATION_TOKEN", "class": "secret", "required_by": ["worker-release"] },
		{
			"name": "CAMPUS_AUTH_TURNSTILE_SITE_KEY",
			"class": "config",
			"required_by": ["worker-release"]
		},
		{ "name": "MAP_DATA_BUCKET_NAME", "class": "config", "required_by": ["worker-release"] },
		{ "name": "SENTRY_CAMPUS_WEB_DSN", "class": "config", "required_by": ["worker-release"] },
		{ "name": "SENTRY_ORG_SLUG", "class": "config", "required_by": ["worker-release"] },
		{
			"name": "SENTRY_CAMPUS_WEB_PROJECT_SLUG",
			"class": "config",
			"required_by": ["worker-release"]
		},
		{ "name": "SENTRY_AUTH_TOKEN", "class": "secret", "required_by": ["worker-release"] },
		{
			"name": "OBJECT_STORE_ENDPOINT",
			"class": "config",
			"required_by": ["worker-release", "reader-build"]
		},
		{
			"name": "OBJECT_STORE_REGION",
			"class": "config",
			"required_by": ["worker-release", "reader-build"]
		},
		{
			"name": "OBJECT_STORE_BUCKET_DERIVED",
			"class": "config",
			"required_by": ["worker-release", "reader-build"]
		},
		{
			"name": "OBJECT_STORE_DERIVED_ACCESS_KEY",
			"class": "secret",
			"required_by": ["worker-release", "reader-build"]
		},
		{
			"name": "OBJECT_STORE_DERIVED_SECRET_KEY",
			"class": "secret",
			"required_by": ["worker-release", "reader-build"]
		},
		{
			"name": "APP_API_STAGING_SMOKE_AUTH_SECRET",
			"class": "secret",
			"required_by": ["staging-e2e"]
		},
		{
			"name": "APP_API_SMOKE_IDENTITY_EMAIL",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		},
		{
			"name": "APP_API_SMOKE_IDENTITY_NAME",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		},
		{
			"name": "E2E_QA_EVIDENCE_DIR",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		},
		{
			"name": "CAMPUS_BROWSER_E2E_PROMPT",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		},
		{
			"name": "CAMPUS_BROWSER_E2E_TIMEOUT_MS",
			"class": "config",
			"required_by": [],
			"optional_by": ["staging-e2e"]
		}
	],
	"retired_names": [
		"OBJECT_STORE_ACCESS_KEY",
		"OBJECT_STORE_SECRET_KEY",
		"STAGING_APP_API_BASE_URL",
		"APP_API_STAGING_BASE_URL",
		"STAGING_CAMPUS_BASE_URL",
		"CAMPUS_WEB_STAGING_BASE_URL",
		"STAGING_APP_API_SMOKE_AUTH_SECRET",
		"STAGING_CAMPUS_AUTH_TURNSTILE_SITE_KEY",
		"STAGING_CAMPUS_WEB_BROWSER_SENTRY_DSN",
		"STAGING_CAMPUS_WEB_EDGE_SENTRY_DSN",
		"STAGING_MAP_DATA_BUCKET_NAME"
	]
}
