{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"types": [
			"node",
			"@cloudflare/workers-types",
			"vite/client",
			"vitest/globals",
			"@testing-library/jest-dom"
		],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/**/*.test.ts",
		"test/**/*.test.tsx",
		"vite.config.ts",
		"vitest.fast.config.mts",
		"vitest.isolated.config.mts",
		"vitest.worker.config.mts"
	],
	"exclude": ["test/**/*.worker.test.ts"]
}
