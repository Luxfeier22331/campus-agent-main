{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"cache": false
		},
		"build:app": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/branding/**"]
		},
		"build:worker": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/branding/**"]
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/branding/**",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"test:worker": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/configs/branding/**",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"typecheck": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/deploy/**"]
		}
	}
}
