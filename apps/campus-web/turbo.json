{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"cache": false,
			"inputs": [
				"docs-source/**",
				"index.html",
				"package.json",
				"scripts/build-campus-web.ts",
				"scripts/check-client-bundle-budget.ts",
				"scripts/campus-map/**",
				"scripts/prepare-docs-content.ts",
				"src/**",
				"assets/campus-map/**",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"assets/favicon.ico",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/schemas/**",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-worker-staging-build.ts",
				"config/**",
				"scripts/build-process-env.ts"
			],
			"outputLogs": "new-only",
			"outputs": [
				".generated/bundle-graph.json",
				".generated/docs-content/sources/**",
				"dist/**",
				".tanstack/**"
			],
			"dependsOn": ["^source"],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"passThroughEnv": [
				"OBJECT_STORE_*",
				"CLOUDFLARE_ENV",
				"CAMPUS_WEB_DOCS_SHARD_TOTAL",
				"VITE_*",
				"XDG_CONFIG_HOME"
			]
		},
		"test:e2e:full": {
			"inputs": [
				"e2e/**",
				"e2e.config.ts",
				"e2e.worker.config.ts",
				"e2e.ui-baseline.config.ts",
				"fixtures/**",
				"index.html",
				"package.json",
				"scripts/**",
				"src/**",
				"test/build-browser-test-content.ts",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"assets/favicon.ico",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/domains/dining/**",
				"$TURBO_ROOT$/packages/ui/**"
			]
		},
		"test:worker": {
			"inputs": [
				"package.json",
				"src/**",
				"test/assets/**",
				"test/**/*.worker.test.ts",
				"tsconfig.json",
				"vitest.worker.config.mts",
				"wrangler.test.toml",
				"assets/favicon.ico",
				"$TURBO_ROOT$/configs/sources/internal-portal.json"
			]
		},
		"typecheck": {
			"inputs": [
				"package.json",
				"tsconfig*.json",
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.json",
				"test/**/*.ts",
				"test/**/*.tsx",
				"test/**/*.json",
				"test-support/**/*.ts",
				"scripts/**/*.ts",
				"scripts/**/*.json",
				"*.config.ts",
				"*.config.mts",
				"fixtures/**/*.json",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/packages/contracts/fixtures/citation-markers.v1.json",
				"config/**/*.ts"
			]
		},
		"test:node:fast": {
			"dependsOn": ["^source"],
			"inputs": [
				"docs-source/**",
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.test.ts",
				"!test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/scripts/ci/evidence.mts",
				"!test/runtime-config.test.ts",
				"!test/maplibre-boundary.test.ts",
				"!test/browser-answer-timing.test.ts",
				"!test/docs-data-source.test.ts",
				"!test/docs-router.test.ts",
				"!test/notices-content-html.test.ts",
				"!test/dining-floorplan-asset-loader.test.ts",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:node:isolated": {
			"dependsOn": ["^source"],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/scripts/ci/evidence.mts",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:dom:fast": {
			"dependsOn": ["^source"],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.test.tsx",
				"!test/**/*.isolated.test.tsx",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/packages/contracts/fixtures/citation-markers.v1.json",
				"$TURBO_ROOT$/scripts/ci/evidence.mts",
				"test/runtime-config.test.ts",
				"test/maplibre-boundary.test.ts",
				"test/browser-answer-timing.test.ts",
				"test/docs-data-source.test.ts",
				"test/docs-router.test.ts",
				"test/notices-content-html.test.ts",
				"test/dining-floorplan-asset-loader.test.ts",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:dom:isolated": {
			"dependsOn": ["^source"],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.isolated.test.tsx",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**",
				"$TURBO_ROOT$/scripts/ci/evidence.mts",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"build:fixture": {
			"inputs": [
				"docs-source/**",
				"fixtures/**",
				"index.html",
				"package.json",
				"scripts/build-campus-web.ts",
				"scripts/check-client-bundle-budget.ts",
				"scripts/campus-map/**",
				"scripts/prepare-docs-content.ts",
				"src/**",
				"assets/campus-map/**",
				"test/build-browser-test-content.ts",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"assets/favicon.ico",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/schemas/**",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-worker-staging-build.ts",
				"config/**",
				"scripts/build-process-env.ts"
			],
			"outputLogs": "new-only",
			"outputs": [
				".generated/bundle-graph.json",
				".generated/docs-content/sources/**",
				".wrangler/deploy/**",
				"dist/**",
				".tanstack/**"
			],
			"dependsOn": ["^source"],
			"env": ["CAMPUS_NODE_RUNTIME"]
		},
		"build:check": {
			"dependsOn": ["build:fixture"],
			"inputs": [],
			"outputs": []
		}
	}
}
