{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"cache": false,
			"inputs": [
				"index.html",
				"package.json",
				"scripts/build-campus-web.ts",
				"scripts/check-client-bundle-budget.ts",
				"scripts/prepare-docs-content.ts",
				"src/**",
				"assets/campus-map/**",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/branding/web-public/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/schemas/**",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-worker-staging-build.ts"
			],
			"outputLogs": "new-only",
			"outputs": [
				".generated/bundle-graph.json",
				".generated/docs-content/sources/**",
				"dist/**",
				".tanstack/**"
			]
		},
		"build:test": {
			"inputs": [
				"fixtures/**",
				"index.html",
				"package.json",
				"scripts/build-campus-web.ts",
				"scripts/check-client-bundle-budget.ts",
				"scripts/prepare-docs-content.ts",
				"src/**",
				"assets/campus-map/**",
				"test/build-browser-test-content.ts",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/branding/web-public/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/schemas/**",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-worker-staging-build.ts"
			],
			"outputLogs": "new-only",
			"outputs": [
				".generated/bundle-graph.json",
				".generated/docs-content/sources/**",
				"dist/**",
				".tanstack/**"
			]
		},
		"build:worker": {
			"inputs": [
				"fixtures/**",
				"index.html",
				"package.json",
				"scripts/build-campus-web.ts",
				"scripts/check-client-bundle-budget.ts",
				"scripts/prepare-docs-content.ts",
				"src/**",
				"assets/campus-map/**",
				"test/build-browser-test-content.ts",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/branding/web-public/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/contracts/package.json",
				"$TURBO_ROOT$/packages/contracts/schemas/**",
				"$TURBO_ROOT$/packages/contracts/src/**",
				"$TURBO_ROOT$/packages/domains/dining/package.json",
				"$TURBO_ROOT$/packages/domains/dining/src/**",
				"$TURBO_ROOT$/packages/ui/package.json",
				"$TURBO_ROOT$/packages/ui/src/**",
				"$TURBO_ROOT$/scripts/deploy/run-worker-staging-build.ts"
			],
			"outputLogs": "new-only",
			"outputs": [
				".generated/bundle-graph.json",
				".generated/docs-content/sources/**",
				".wrangler/deploy/**",
				"dist/**",
				".tanstack/**"
			]
		},
		"test": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/branding/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"test:e2e:full": {
			"inputs": ["e2e/**", "e2e.config.ts", "e2e.worker.config.ts", "package.json"]
		},
		"test:e2e:smoke": {
			"inputs": [
				"e2e/**",
				"e2e.config.ts",
				"e2e.worker.config.ts",
				"fixtures/**",
				"index.html",
				"package.json",
				"scripts/**",
				"src/**",
				"test/build-browser-test-content.ts",
				"tsconfig.json",
				"vite.config.ts",
				"wrangler*.toml",
				"$TURBO_ROOT$/configs/branding/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/domains/dining/**",
				"$TURBO_ROOT$/packages/ui/**"
			]
		},
		"test:worker": {
			"inputs": [
				"package.json",
				"src/**",
				"test/assets/**",
				"test/**/*.worker.test.ts",
				"tsconfig.json",
				"vitest.worker.config.mts",
				"wrangler.test.toml",
				"$TURBO_ROOT$/configs/branding/**",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		},
		"typecheck": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"!README.md",
				"!**/README.md",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/scripts/deploy/**"
			]
		}
	}
}
