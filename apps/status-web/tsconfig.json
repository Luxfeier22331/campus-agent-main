{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"types": ["node", "@cloudflare/workers-types", "vitest/globals"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "vite.config.ts"],
	"exclude": ["test/**/*.worker.test.ts"]
}
