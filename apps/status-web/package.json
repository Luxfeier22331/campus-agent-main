{
	"name": "status-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Public product availability status page for campus-agent.",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "pnpm run build:worker",
		"build:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home pnpm exec wrangler deploy --dry-run --outdir dist/worker --env local",
		"dev": "pnpm exec wrangler dev --local --env local",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"test": "pnpm run test:node",
		"test:browser": "playwright test --config browser.config.ts",
		"test:node": "vitest run -c vitest.node.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"campus-contracts": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@cloudflare/vitest-pool-workers": "0.21.2",
		"@cloudflare/workers-types": "5.20260813.1",
		"@playwright/test": "^1.62.1",
		"@types/node": "^24.13.3",
		"jsdom": "^30.0.1",
		"smol-toml": "1.8.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"wrangler": "4.122.0"
	},
	"license": "Apache-2.0"
}
