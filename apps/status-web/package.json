{
	"name": "status-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Public product availability status page for campus-agent.",
	"scripts": {
		"build": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home pnpm exec wrangler deploy --dry-run --outdir dist/worker --env local",
		"dev": "pnpm exec wrangler dev --local --env local",
		"test:browser": "playwright test --config browser.config.ts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run -c vitest.node.config.mts"
	},
	"dependencies": {
		"campus-contracts": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@cloudflare/vitest-plugin": "1.4.5",
		"@cloudflare/workers-types": "5.20261019.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"jsdom": "^30.1.3",
		"smol-toml": "1.9.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "4.151.2"
	},
	"license": "Apache-2.0"
}
