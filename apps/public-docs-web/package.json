{
	"name": "public-docs-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"description": "Cloudflare Worker runtime shell for the public docs web surface.",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"build": "XDG_CONFIG_HOME=./.wrangler-home vite build",
		"cf-typegen": "XDG_CONFIG_HOME=./.wrangler-home wrangler types --env-interface CloudflareEnv",
		"deploy": "pnpm build && node ../../scripts/run-wrangler-command.mjs deploy --config wrangler.toml",
		"dev": "XDG_CONFIG_HOME=./.wrangler-home vite",
		"postinstall": "fumadocs-mdx",
		"preview": "XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "vitest run -c vitest.config.mts",
		"typecheck": "pnpm cf-typegen && fumadocs-mdx && tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/react-router": "1.168.23",
		"@tanstack/react-start": "1.167.42",
		"fumadocs-core": "16.8.1",
		"fumadocs-mdx": "14.3.1",
		"fumadocs-ui": "16.8.1",
		"lucide-react": "^1.8.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.15.3",
		"@tailwindcss/vite": "^4.2.2",
		"@types/mdx": "^2.0.13",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.8.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.1",
		"wrangler": "^4.78.0"
	}
}
