{
	"name": "operator-console-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the Operator Console web surface.",
	"packageManager": "pnpm@10.34.5",
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-slot": "^1.3.0",
		"@sentry/cloudflare": "^10.64.0",
		"@tanstack/react-query": "^5.101.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jose": "^6.2.3",
		"lucide-react": "^1.23.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.81.0",
		"react-router-dom": "^7.18.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"scripts": {
		"build": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite build",
		"build:staging": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 CLOUDFLARE_ENV=staging XDG_CONFIG_HOME=./.wrangler-home pnpm exec tsx ../../scripts/deploy/run-worker-staging-build.ts OPERATOR_CONSOLE_APP_API_SHARED_SECRET SENTRY_DSN -- vite build",
		"build:worker": "pnpm run build",
		"dev": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 CLOUDFLARE_ENV=local XDG_CONFIG_HOME=./.wrangler-home vite --host 127.0.0.1 --port 27021 --strictPort",
		"deploy": "pnpm build && pnpm exec tsx ../../scripts/deploy/verify-worker-deploy-config.ts dist/operator_console_web/wrangler.json APP_API=app-api && pnpm exec tsx ../../scripts/deploy/run-wrangler-command.ts deploy --config dist/operator_console_web/wrangler.json",
		"upload:staging": "pnpm exec tsx ./scripts/upload-staging-version.ts",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "pnpm run test:node",
		"test:node": "vitest run -c vitest.node.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.43.1",
		"@cloudflare/vitest-pool-workers": "0.18.1",
		"@cloudflare/workers-types": "4.20260702.1",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.13.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"jsdom": "^27.4.0",
		"playwright": "^1.61.1",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.10",
		"wrangler": "4.107.1"
	},
	"license": "Apache-2.0"
}
