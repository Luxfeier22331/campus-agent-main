{
	"name": "agent-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Provider-neutral model operation runtime for campus-agent.",
	"type": "module",
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "node --env-file-if-exists=.env.local --experimental-strip-types --network-family-autoselection-attempt-timeout=2000 src/server.ts",
		"test": "vitest run -c vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@google/genai": "2.21.0",
		"@arizeai/openinference-instrumentation-openai-agents": "^0.2.7",
		"@langfuse/otel": "^5.10.1",
		"@langfuse/tracing": "^5.10.1",
		"@openai/agents": "0.17.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.10.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"openai": "7.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"license": "Apache-2.0"
}
