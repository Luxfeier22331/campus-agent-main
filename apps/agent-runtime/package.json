{
	"name": "agent-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Provider-neutral model operation runtime for campus-agent.",
	"type": "module",
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "node --env-file-if-exists=.env.local --experimental-strip-types --network-family-autoselection-attempt-timeout=2000 src/server.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "vitest run -c vitest.config.mts"
	},
	"dependencies": {
		"@arizeai/openinference-instrumentation-openai-agents": "^0.3.2",
		"@google/genai": "2.26.0",
		"@langfuse/otel": "^5.11.1",
		"@langfuse/tracing": "^5.11.1",
		"@openai/agents": "0.18.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.11.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"htmlparser2": "12.0.0",
		"ipaddr.js": "2.5.0",
		"openai": "7.27.0",
		"undici": "8.11.2",
		"zod": "^4.6.5",
		"campus-contracts": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "Apache-2.0"
}
