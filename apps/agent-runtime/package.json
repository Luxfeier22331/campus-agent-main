{
	"name": "agent-runtime",
	"version": "0.1.0",
	"private": true,
	"description": "Internal OpenAI Agents SDK runtime for campus-agent primary assistant turns.",
	"type": "module",
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsx src/server.ts",
		"test": "vitest run -c vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@arizeai/openinference-instrumentation-openai-agents": "^0.2.6",
		"@langfuse/otel": "^5.10.0",
		"@langfuse/tracing": "^5.10.0",
		"@openai/agents": "0.15.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.10.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-node": "^2.10.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"openai": "7.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
