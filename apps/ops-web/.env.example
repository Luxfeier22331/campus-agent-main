# Ops Web local provider-config development
#
# Copy values into an untracked apps/ops-web/.env. Production receives the
# equivalent values from Kubernetes-owned Secrets and workload configuration.
OPS_WEB_PROVIDER_CONFIG_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/campus_agent
OPS_WEB_PROVIDER_CONFIG_DATABASE_SSLMODE=disable
OPS_WEB_PROVIDER_CONFIG_ENCRYPTION_KEY=replace-with-high-entropy-local-key
OPS_WEB_PROVIDER_CONFIG_PUBLISH_TARGET=file
OPS_WEB_PROVIDER_CONFIG_PROJECTION_PATH=.tmp/provider-config/provider-config-projection.json
OPS_WEB_PROTECTION_ENVELOPE=cloudflare-access
ACCESS_TEAM_DOMAIN=https://team-your-org.cloudflareaccess.com
ACCESS_POLICY_AUD=replace-with-ops-web-access-audience
