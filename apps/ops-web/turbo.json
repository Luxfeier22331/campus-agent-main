{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:browser": {
			"inputs": [
				"browser.config.ts",
				"package.json",
				"src/**",
				"test/browser/**",
				"test/browser-server.ts",
				"vite.config.ts",
				"vite.ops.config.ts",
