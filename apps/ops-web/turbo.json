{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"test:browser": {
			"inputs": [
				"browser.config.ts",
				"package.json",
				"src/**",
				"test/browser/**",
				"test/browser-server.ts",
				"vite.config.ts",
				"vite.ops.config.ts",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/packages/internal-portal-client/**",
				"$TURBO_ROOT$/packages/ui/**"
			]
		},
		"test:database-integration": {
			"inputs": [
				"ops/db/**",
				"package.json",
				"src/server/database.ts",
				"src/server/dining*.ts",
				"src/server/internal-portal-automation-token-store.ts",
				"src/server/internal-portal-automation-token-service.ts",
				"src/server/internal-portal-credential-store.ts",
				"src/server/ops-status/**",
				"src/server/postgres-tls.ts",
				"src/server/transport*.ts",
				"src/shared/dining-contract.ts",
				"test/dining-bootstrap.integration.test.ts",
				"test/dining-content-store.integration.test.ts",
				"test/dining-submission-store.integration.test.ts",
				"test/transport-store.integration.test.ts",
				"test/ops-web-database.integration.test.ts",
				"test/ops-status-store-test-helpers.ts",
				"test/ops-web-postgres-topology.test.ts",
				"test/ops-web-postgres.global-setup.ts",
				"vitest.database-integration.config.mts",
				"$TURBO_ROOT$/jobs/campus-agent-schema/**",
				"$TURBO_ROOT$/packages/domains/dining/**",
				"$TURBO_ROOT$/packages/domains/transport/**",
				"$TURBO_ROOT$/apps/app-api/package.json",
				"$TURBO_ROOT$/apps/app-api/src/**",
				"$TURBO_ROOT$/apps/app-api/test-support/**"
			]
		},
		"test:node:fast": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/document-ocr#source",
				"@campus-agent/internal-portal-client#source",
				"@campus-agent/notices#source",
				"@campus-agent/transport#source",
				"@campus-agent/ui#source",
				"campus-contracts#source",
				"ingestion-contracts#source",
				"notice-publisher#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.test.ts",
				"!test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/.dockerignore",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:node:isolated": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/document-ocr#source",
				"@campus-agent/internal-portal-client#source",
				"@campus-agent/notices#source",
				"@campus-agent/transport#source",
				"@campus-agent/ui#source",
				"campus-contracts#source",
				"ingestion-contracts#source",
				"notice-publisher#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.isolated.test.ts",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/.dockerignore",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:dom:fast": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/document-ocr#source",
				"@campus-agent/internal-portal-client#source",
				"@campus-agent/notices#source",
				"@campus-agent/transport#source",
				"@campus-agent/ui#source",
				"campus-contracts#source",
				"ingestion-contracts#source",
				"notice-publisher#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.test.tsx",
				"!test/**/*.isolated.test.tsx",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/.dockerignore",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		},
		"test:dom:isolated": {
			"dependsOn": [
				"@campus-agent/dining#source",
				"@campus-agent/document-ocr#source",
				"@campus-agent/internal-portal-client#source",
				"@campus-agent/notices#source",
				"@campus-agent/transport#source",
				"@campus-agent/ui#source",
				"campus-contracts#source",
				"ingestion-contracts#source",
				"notice-publisher#source"
			],
			"inputs": [
				"package.json",
				"src/**",
				"scripts/**",
				"tsconfig*.json",
				"vitest*.config.mts",
				"wrangler*.toml",
				"assets/**",
				"fixtures/**",
				"test/fixtures/**",
				"test/helpers/**",
				"test/*setup*.ts",
				"test/**/*.suite.ts",
				"test/**/*.isolated.test.tsx",
				"!test/**/*.integration.test.*",
				"!test/**/*.worker.test.ts",
				"!test/worker.test.ts",
				"$TURBO_ROOT$/.dockerignore",
				"$TURBO_ROOT$/configs/sources/internal-portal.json",
				"$TURBO_ROOT$/configs/runtime/latency-budgets.v1.json",
				"test/**/*support*",
				"test/**/*helpers*",
				"test/**/*test-utils*",
				"test/support/**"
			],
			"env": ["CAMPUS_NODE_RUNTIME"],
			"outputs": [],
			"outputLogs": "new-only"
		}
	}
}
