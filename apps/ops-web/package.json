{
	"name": "ops-web",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist",
		"dist-server",
		"ops"
	],
	"scripts": {
		"build": "vite build && vite build --ssr src/server/node.ts --outDir dist-server",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"dev": "pnpm --dir ../.. exec tsx scripts/dev/service.ts ops-web",
		"start": "node --env-file-if-exists=.env dist-server/node.js",
		"db:apply": "node --experimental-strip-types ops/db/ops-web-database.ts apply",
		"db:apply-dining": "node --experimental-strip-types ops/db/ops-web-database.ts apply-dining",
		"db:bootstrap-dining": "node --experimental-strip-types ops/db/bootstrap-dining.ts",
		"db:verify": "node --experimental-strip-types ops/db/ops-web-database.ts verify",
		"test": "vitest run --config vitest.config.mts",
		"test:browser": "playwright test --config browser.config.ts",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1081.0",
		"@axiomhq/js": "1.8.0",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/langfuse-identity": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@hono/node-server": "^2.0.11",
		"@kubernetes/client-node": "1.4.0",
		"@radix-ui/react-accordion": "^1.2.17",
		"@radix-ui/react-alert-dialog": "^1.1.19",
		"@radix-ui/react-dialog": "^1.1.19",
		"@radix-ui/react-dropdown-menu": "^2.1.20",
		"@radix-ui/react-slot": "^1.3.0",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/react-virtual": "^3.14.5",
		"@tldraw/assets": "5.2.4",
		"@tldraw/editor": "5.2.4",
		"@tldraw/tlschema": "5.2.4",
		"clsx": "^2.1.1",
		"hono": "^4.12.27",
		"jose": "^6.2.3",
		"lucide-react": "^1.23.0",
		"pg": "^8.22.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-markdown": "^10.1.0",
		"recharts": "^3.9.2",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tldraw": "5.2.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@testcontainers/postgresql": "12.0.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.12.0",
		"@types/pg": "^8.15.6",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"jsdom": "^27.4.0",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.22.5",
		"typescript": "^5.8.2",
		"vite": "^8.1.3",
		"vitest": "^4.1.9"
	}
}
