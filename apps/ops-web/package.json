{
	"name": "ops-web",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist",
		"dist-ops",
		"dist-server",
		"drizzle"
	],
	"scripts": {
		"build": "vite build && vite build --ssr src/server/node.ts --outDir dist-server && vite build --config vite.ops.config.ts",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"dev:api": "node --env-file-if-exists=.env.local --experimental-strip-types src/server/node.ts",
		"dev:fixture": "set -a && . ./.env.local && set +a && exec node --experimental-strip-types test/fixtures/internal-portal-automation-server.ts --port \"$PORT\"",
		"dev:init": "pnpm --dir ../.. exec tsx scripts/dev/cli.ts init --target ops-web",
		"dev:web": "set -a && . ./.env.local && set +a && exec vite --host 127.0.0.1 --port \"$OPS_WEB_WEB_PORT\" --strictPort",
		"start": "node --env-file-if-exists=.env dist-server/node.js",
		"db:apply": "node --experimental-strip-types ops/db/ops-web-database.ts apply",
		"db:apply-dining": "node --experimental-strip-types ops/db/ops-web-database.ts apply-dining",
		"db:bootstrap-dining": "node --experimental-strip-types ops/db/bootstrap-dining.ts",
		"db:check": "drizzle-kit check --config drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"test": "vitest run --config vitest.config.mts",
		"test:browser": "pnpm build && playwright test --config browser.config.ts",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1111.0",
		"@axiomhq/js": "2.0.0",
		"campus-contracts": "workspace:*",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@hono/node-server": "^2.1.1",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.29",
		"@tanstack/react-table": "^9.1.2",
		"@tanstack/react-virtual": "^3.14.9",
		"@tldraw/assets": "5.3.1",
		"@tldraw/editor": "5.3.1",
		"@tldraw/tlschema": "5.3.1",
		"clsx": "^2.1.1",
		"cookie": "2.0.1",
		"drizzle-orm": "^0.45.2",
		"hono": "4.13.1",
		"jose": "^6.2.9",
		"lucide-react": "^1.31.0",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tldraw": "5.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/langfuse-identity": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"app-api": "workspace:*",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "12.1.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.21.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"testcontainers": "12.1.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
