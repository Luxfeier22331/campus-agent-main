{
	"name": "ops-web",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist",
		"dist-ops",
		"dist-server"
	],
	"scripts": {
		"build": "bash scripts/build.sh",
		"dev:api": "node --env-file-if-exists=.env.local --experimental-strip-types src/server/node.ts",
		"dev:fixture": "bash scripts/dev-fixture.sh",
		"dev:web": "bash scripts/dev-web.sh",
		"start": "node --env-file-if-exists=.env dist-server/node.js",
		"test:browser": "pnpm build && playwright test --config browser.config.ts",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit",
		"test:node:fast": "vitest run -c vitest.config.mts --project=ops-node-fast",
		"test:node:isolated": "vitest run -c vitest.config.mts --project=ops-node-isolated",
		"test:dom:fast": "vitest run -c vitest.config.mts --project=ops-dom-fast",
		"test:dom:isolated": "vitest run -c vitest.config.mts --project=ops-dom-isolated"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1145.0",
		"@campus-agent/document-ocr": "workspace:*",
		"@campus-agent/internal-portal-client": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@hono/node-server": "^2.1.3",
		"@kubernetes/client-node": "^2.0.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-table": "^9.2.4",
		"@tldraw/assets": "5.5.0",
		"@tldraw/editor": "5.5.0",
		"@tldraw/tlschema": "5.5.0",
		"campus-contracts": "workspace:*",
		"cookie": "2.0.1",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "4.13.12",
		"ingestion-contracts": "workspace:*",
		"jose": "^6.2.12",
		"jsdom": "^30.1.1",
		"lucide-react": "^1.49.0",
		"pg": "^8.23.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"tldraw": "5.5.0",
		"zod": "^4.6.5",
		"@temporalio/client": "1.24.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "12.2.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"app-api": "workspace:*",
		"notice-publisher": "workspace:*",
		"tailwindcss": "^4.3.3",
		"testcontainers": "12.2.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
