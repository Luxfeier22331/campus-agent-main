{
	"name": "ops-web",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"files": [
		"dist",
		"dist-ops",
		"dist-server"
	],
	"scripts": {
		"build": "vite build && vite build --ssr src/server/node.ts --outDir dist-server && vite build --config vite.ops.config.ts",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"dev:api": "node --env-file-if-exists=.env.local --experimental-strip-types src/server/node.ts",
		"dev:fixture": "set -a && . ./.env.local && set +a && exec node --experimental-strip-types test/fixtures/internal-portal-automation-server.ts --port \"$PORT\"",
		"db:bootstrap-transport": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types ops/db/bootstrap-transport.ts",
		"dev:web": "set -a && . ./.env.local && set +a && exec vite --host 127.0.0.1 --port \"$OPS_WEB_WEB_PORT\" --strictPort",
		"start": "node --env-file-if-exists=.env dist-server/node.js",
		"db:bootstrap-dining": "node --experimental-strip-types ops/db/bootstrap-dining.ts",
		"test": "vitest run --config vitest.config.mts",
		"test:browser": "pnpm build && playwright test --config browser.config.ts",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1132.0",
		"@campus-agent/document-ocr": "workspace:*",
		"@campus-agent/internal-portal-client": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"@campus-agent/transport": "workspace:*",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@hono/node-server": "^2.1.1",
		"@kubernetes/client-node": "^2.0.0",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.36",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-virtual": "^3.14.13",
		"@tldraw/assets": "5.4.2",
		"@tldraw/editor": "5.4.2",
		"@tldraw/tlschema": "5.4.2",
		"campus-contracts": "workspace:*",
		"clsx": "^2.1.1",
		"cookie": "2.0.1",
		"drizzle-orm": "1.0.0-rc.4",
		"hono": "4.13.7",
		"jose": "^6.2.12",
		"jsdom": "^30.0.1",
		"lucide-react": "^1.45.0",
		"pg": "^8.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tldraw": "5.4.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@campus-agent/dining": "workspace:*",
		"@campus-agent/ui": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testcontainers/postgresql": "12.1.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.13.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"app-api": "workspace:*",
		"notice-publisher": "workspace:*",
		"tailwindcss": "^4.3.3",
		"testcontainers": "12.1.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
}
