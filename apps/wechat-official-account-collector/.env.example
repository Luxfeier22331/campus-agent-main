# FeedWe authenticated acquisition contract. Keep the real credentials in
# untracked env / secret store.
FEEDWE_EMAIL=
FEEDWE_PASSWORD=
FEEDWE_BASE_URL=https://www.feedwe.top

# App-api control-plane seam. Service token must match
# `apps/app-api/.dev.vars` `APP_API_WECHAT_OFFICIAL_ACCOUNT_COLLECTOR_TOKEN`.
WECHAT_OFFICIAL_ACCOUNT_APP_API_BASE_URL=
WECHAT_OFFICIAL_ACCOUNT_SERVICE_TOKEN=
WECHAT_OFFICIAL_ACCOUNT_TRACE_ID=
WECHAT_OFFICIAL_ACCOUNT_TRIGGER_TYPE=manual

# Existing MinIO-backed source bucket / S3-compatible source-bucket interface.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
OBJECT_STORE_BUCKET_SOURCE=campus-rag-source
