{
	"name": "wechat-official-account-collector",
	"version": "0.1.0",
	"private": true,
	"description": "Collector runtime shell for public WeChat official-account source capture.",
	"type": "module",
	"scripts": {
		"capture": "node --experimental-strip-types src/capture-cli.ts",
		"replay-source-truth": "node --experimental-strip-types src/replay-source-truth-cli.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
