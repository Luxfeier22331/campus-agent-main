		"cheerio": "1.0.0-rc.12",
		"wechat-official-account-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.0"
	}
}
