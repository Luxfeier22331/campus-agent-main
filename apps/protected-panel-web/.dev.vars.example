PANEL_APP_NAME=campus-agent-v2-protected-panel
# Must point to the shared `apps/app-api` runtime, not `apps/execution-control`.
PANEL_RUNTIME_API_BASE_URL=https://app-api.internal
PANEL_PROTECTION_ENVELOPE=cloudflare-access
# Use the real Access team domain for the current environment.
ACCESS_TEAM_DOMAIN=https://team-your-org.cloudflareaccess.com
# Use the real Access application audience for the current environment.
ACCESS_POLICY_AUD=replace-with-panel-access-audience
# Must match `APP_API_INTERNAL_SHARED_SECRET` in `apps/app-api`.
PANEL_APP_API_SHARED_SECRET=replace-with-panel-bridge-secret
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=protected-panel-web@dev-local
