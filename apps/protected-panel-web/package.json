{
  "name": "protected-panel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker runtime shell for the protected panel web surface.",
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.0.1",
    "@sentry/cloudflare": "^10.46.0",
    "jose": "^6.0.10",
    "react": "^19.2.0",
    "react-admin": "^5.14.4",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.3"
  },
  "scripts": {
    "build": "XDG_CONFIG_HOME=./.wrangler-home vite build",
    "dev": "XDG_CONFIG_HOME=./.wrangler-home vite",
    "deploy": "pnpm build && XDG_CONFIG_HOME=./.wrangler-home wrangler deploy --config dist/protected_panel_web/wrangler.json",
    "preview": "pnpm build && XDG_CONFIG_HOME=./.wrangler-home vite preview",
    "test": "XDG_CONFIG_HOME=./.wrangler-home vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.3",
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.8.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.78.0"
  }
}
