{
	"name": "ingestion-control",
	"version": "0.1.0",
	"private": true,
	"description": "Internal ingestion task control plane for campus-agent data plane.",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "node --experimental-strip-types ./src/server.ts",
		"migrate": "tsx ./src/migrate.ts",
		"schedules:sync": "tsx ./src/schedule-sync.ts",
		"start": "node --experimental-strip-types ./src/server.ts",
		"start:api": "node --experimental-strip-types ./src/server.ts",
		"start:temporal-worker": "tsx ./src/temporal-worker.ts",
		"test": "pnpm run test:ingest",
		"test:ingest": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@campus-agent/telemetry-node": "workspace:*",
		"@aws-sdk/client-s3": "^3.1081.0",
		"@temporalio/activity": "^1.20.1",
		"@temporalio/client": "^1.20.1",
		"@temporalio/interceptors-opentelemetry-v2": "1.20.2",
		"@temporalio/worker": "^1.20.1",
		"@temporalio/workflow": "^1.20.1",
		"ingest-core": "workspace:*",
		"ingestion-contracts": "workspace:*",
		"pg": "^8.22.0",
		"tsx": "^4.23.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"@types/pg": "^8.15.6",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
}
