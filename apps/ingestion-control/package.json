{
	"name": "ingestion-control",
	"version": "0.1.0",
	"private": true,
	"description": "Internal portal credential control service for the campus-agent ingestion data plane.",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "esbuild ./src/server.ts ./src/migrate.ts ./src/schema-bootstrap.ts ./src/internal-portal-check.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --external:pg --external:undici",
		"check:artifact": "node ./scripts/check-production-artifact.mjs",
		"credentials:check": "tsx ./src/internal-portal-check.ts",
		"migrate": "tsx ./src/migrate.ts",
		"schema:bootstrap": "tsx ./src/schema-bootstrap.ts",
		"start:api": "node --experimental-strip-types ./src/server.ts",
		"test": "vitest run --exclude 'test/**/*.database.integration.test.ts'",
		"test:database-integration": "vitest run --config vitest.database-integration.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@campus-agent/internal-portal-client": "workspace:*",
		"campus-contracts": "workspace:*",
		"cookie": "^1.1.1",
		"pg": "^8.23.0",
		"undici": "^8.10.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.1.0",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.21.0",
		"esbuild": "^0.28.2",
		"testcontainers": "12.1.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"yaml": "2.9.0"
	},
	"license": "Apache-2.0"
}
