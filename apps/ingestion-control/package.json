{
	"name": "ingestion-control",
	"version": "0.1.0",
	"private": true,
	"description": "Internal ingestion task control plane for campus-agent data plane.",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"dev": "node --experimental-strip-types ./src/server.ts",
		"start": "node --experimental-strip-types ./src/server.ts",
		"start:api": "node --experimental-strip-types ./src/server.ts",
		"start:executor": "node --experimental-strip-types ./src/executor.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.956.0",
		"cheerio": "1.0.0-rc.12",
		"ingestion-contracts": "file:../../packages/ingestion-contracts",
		"official-web-core": "file:../../packages/official-web-core",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"@types/pg": "^8.15.6",
		"typescript": "^5.8.2",
		"vitest": "^4.1.0"
	},
	"license": "Apache-2.0"
}
