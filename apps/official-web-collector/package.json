{
	"name": "official-web-collector",
	"version": "0.1.0",
	"private": true,
	"description": "Collector runtime shell for campus-agent official web collection.",
	"type": "module",
	"scripts": {
		"crawl": "node --experimental-strip-types src/crawl.ts",
		"plan": "node --experimental-strip-types src/plan.ts",
		"plan-source-pack": "node --experimental-strip-types src/source-pack-plan-cli.ts",
		"validate-source-pack": "node --experimental-strip-types src/validate-source-pack.ts",
		"validate": "node --experimental-strip-types src/validate.ts",
		"qc-report": "node --experimental-strip-types src/qc-report.ts",
		"test": "vitest run --fileParallelism=false",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.913.0",
		"crawlee": "^3.16.0",
		"official-web-core": "file:../../packages/official-web-core",
		"playwright": "^1.52.0"
	},
	"devDependencies": {
		"@types/node": "^24.12.0",
		"cheerio": "1.0.0-rc.12",
		"typescript": "^5.8.2",
		"vitest": "^4.1.0"
	}
}
