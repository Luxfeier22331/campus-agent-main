# official-web-collector runtime env

# app-api control-plane seam; leave both empty to run local artifact-only crawl smoke
# For live control-plane smoke, `OFFICIAL_WEB_SERVICE_TOKEN` must match
# `apps/app-api/.dev.vars` `APP_API_OFFICIAL_WEB_COLLECTOR_TOKEN`.
OFFICIAL_WEB_APP_API_BASE_URL=
OFFICIAL_WEB_SERVICE_TOKEN=

# Optional runtime defaults for scheduled Docker entrypoints
OFFICIAL_WEB_RUN_INTENT=
OFFICIAL_WEB_TRIGGER_TYPE=
OFFICIAL_WEB_TRACE_ID=
