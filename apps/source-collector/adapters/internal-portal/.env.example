# source-collector internal-portal adapter runtime env
# Copy to this app's untracked `.env` or inject through the scheduler/deploy
# secret store. Do not put real portal cookies in repo-root templates.

# Portal auth. The file contains only the raw SSO_TGC value.
INTERNAL_PORTAL_SSO_TGC_FILE=
INTERNAL_PORTAL_SSO_COOKIE_DOMAIN=
INTERNAL_PORTAL_AUTH_TIMEOUT_MS=30000

# Portal source and runtime paths.
INTERNAL_PORTAL_RUNTIME_DIR=
INTERNAL_PORTAL_BASE_URL=https://portal.example.edu
INTERNAL_PORTAL_PAGE_URL=https://portal.example.edu/page/11#/
INTERNAL_PORTAL_SOURCE_HOME_URL=https://portal.example.edu
INTERNAL_PORTAL_SITE_ID=synthetic_internal_portal
INTERNAL_PORTAL_NOTICE_TYPES_PATH=
INTERNAL_PORTAL_BYPASS_PROXY=true
INTERNAL_PORTAL_PROXY_SERVER=

# Collection scope and auth-check defaults.
INTERNAL_PORTAL_AUTH_CHECK_NOTICE_TYPE=5
INTERNAL_PORTAL_AUTH_CHECK_PAGE_SIZE=3
INTERNAL_PORTAL_RECONCILE_MAX_PAGES_PER_TYPE=
INTERNAL_PORTAL_REQUEST_MAX_RETRIES=3

# Attachment and media capture controls.

# Existing MinIO-backed source bucket / S3-compatible source-bucket interface.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
OBJECT_STORE_BUCKET_SOURCE=campus-agent-source
