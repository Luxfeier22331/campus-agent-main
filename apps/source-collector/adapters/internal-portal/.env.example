# source-collector internal-portal adapter runtime env
# Copy portal settings to this adapter's untracked `.env`. Do not put real credentials in templates.
# `pnpm dev:init` writes local MinIO settings to the managed `.env.local` beside it.

# Local commands use the raw SSO_TGC value. Kubernetes reads its projected Secret from a file.
INTERNAL_PORTAL_SSO_TGC=
INTERNAL_PORTAL_SSO_TGC_FILE=

# Optional local forward proxy.
INTERNAL_PORTAL_PROXY_SERVER=

# S3-compatible source bucket. These values are needed when not using the managed local environment.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
