# source-collector official-web adapter runtime env

# ingestion-control control-plane seam. `OFFICIAL_WEB_SERVICE_TOKEN` must match
# `INGESTION_CONTROL_OFFICIAL_WEB_COLLECTOR_TOKEN`.
OFFICIAL_WEB_INGESTION_CONTROL_BASE_URL=
OFFICIAL_WEB_SERVICE_TOKEN=

# Optional runtime defaults for scheduled Docker entrypoints
OFFICIAL_WEB_RUN_INTENT=
OFFICIAL_WEB_TRIGGER_TYPE=
OFFICIAL_WEB_TRACE_ID=

# Existing MinIO-backed source bucket / S3-compatible source-bucket interface.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
OBJECT_STORE_BUCKET_SOURCE=campus-agent-source
