{
	"name": "source-collector",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Unified source collector runtime for campus-agent ingestion source adapters.",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"auth:check": "tsx adapters/internal-portal/src/auth-check.ts",
		"notice:backfill": "tsx adapters/internal-portal/src/notice-cli.ts backfill",
		"notice:resources": "tsx adapters/internal-portal/src/notice-resource-cli.ts",
		"notice:status": "tsx adapters/internal-portal/src/notice-cli.ts status",
		"notice:sync": "tsx adapters/internal-portal/src/notice-cli.ts sync",
		"start:temporal-worker": "tsx ./src/temporal-worker.ts",
		"test": "vitest run -c vitest.fast.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1109.0",
		"@campus-agent/internal-portal-client": "workspace:*",
		"@campus-agent/notices": "workspace:*",
		"@temporalio/activity": "^1.22.0",
		"@temporalio/worker": "^1.22.0",
		"content-disposition": "^2.0.1",
		"dotenv": "^17.4.2",
		"ingest-core": "workspace:*",
		"ingestion-contracts": "workspace:*",
		"mime-types": "^3.0.2",
		"tldts": "^7.4.10",
		"tsx": "^4.23.12"
	},
	"devDependencies": {
		"@types/content-disposition": "^0.5.9",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.13.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
}
