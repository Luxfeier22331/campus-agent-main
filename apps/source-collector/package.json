{
	"name": "source-collector",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Unified source collector runtime for campus-agent ingestion source adapters.",
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"auth:check:file-release": "tsx adapters/internal-portal/src/auth-check-file-release.ts",
		"auth:check:notice": "tsx adapters/internal-portal/src/auth-check.ts",
		"auth:refresh": "tsx adapters/internal-portal/src/auth-refresh.ts",
		"auth:save": "tsx adapters/internal-portal/src/auth-save.ts",
		"start:temporal-worker": "tsx ./src/temporal-worker.ts",
		"test": "pnpm run test:ingest",
		"test:fast": "vitest run -c vitest.fast.config.mts",
		"test:ingest": "pnpm run test:fast && pnpm run test:isolated",
		"test:isolated": "vitest run -c vitest.isolated.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1081.0",
		"@temporalio/activity": "^1.20.1",
		"@temporalio/worker": "^1.20.1",
		"@mozilla/readability": "^0.6.0",
		"cheerio": "1.0.0-rc.12",
		"content-disposition": "^2.0.1",
		"crawlee": "^3.17.0",
		"dotenv": "^17.4.2",
		"ingest-core": "workspace:*",
		"ingestion-contracts": "workspace:*",
		"jsdom": "^27.4.0",
		"mime-types": "^3.0.2",
		"playwright": "^1.61.1",
		"tldts": "^7.4.7",
		"tsx": "^4.23.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/content-disposition": "^0.5.9",
		"@types/jsdom": "^28.0.3",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.13.2",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"license": "Apache-2.0"
}
