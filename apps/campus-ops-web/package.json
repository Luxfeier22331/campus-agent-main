{
	"name": "campus-ops-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker runtime shell for the campus operations workspace.",
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"build": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite build && node ../../scripts/check_web_client_bundle_budget.mjs --app apps/campus-ops-web",
		"build:staging": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 CLOUDFLARE_ENV=staging XDG_CONFIG_HOME=./.wrangler-home node ../../scripts/run-worker-staging-build.mjs -- vite build && node ../../scripts/check_web_client_bundle_budget.mjs --app apps/campus-ops-web",
		"dev": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite --host 127.0.0.1 --port 27016 --strictPort",
		"deploy": "pnpm build && pnpm deploy:verify-config && node ../../scripts/run-wrangler-command.mjs deploy --config dist/campus_ops_web/wrangler.json",
		"deploy:preflight:staging": "node ../../scripts/run-worker-staging-preflight.mjs --app apps/campus-ops-web",
		"deploy:verify-config": "node ../../scripts/verify-worker-deploy-config.mjs dist/campus_ops_web/wrangler.json APP_API=app-api",
		"deploy:verify-config:staging": "node ./scripts/verify-staging-config.mjs",
		"deploy:staging": "pnpm deploy:preflight:staging && node ./scripts/deploy-staging.mjs",
		"preview": "pnpm build && WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vite preview",
		"test": "pnpm run test:node",
		"test:node": "vitest run -c vitest.config.mts",
		"test:worker": "WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1 XDG_CONFIG_HOME=./.wrangler-home vitest run -c vitest.worker.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.4",
		"@sentry/cloudflare": "^10.46.0",
		"@tanstack/react-query": "^5.90.5",
		"@tanstack/react-router": "^1.132.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"konva": "^10.0.12",
		"lucide-react": "^1.7.0",
		"maplibre-gl": "^5.14.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.72.0",
		"react-konva": "^19.0.10",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.15.3",
		"@cloudflare/vitest-pool-workers": "^0.13.4",
		"@cloudflare/workers-types": "^4.20260317.1",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"jsdom": "^27.4.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.8.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.0",
		"wrangler": "^4.78.0"
	}
}
