{
  "name": "public-chat-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker runtime shell for the public chat web surface.",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "XDG_CONFIG_HOME=./.wrangler-home vite build",
    "build:staging": "CLOUDFLARE_ENV=staging XDG_CONFIG_HOME=./.wrangler-home vite build",
    "dev": "XDG_CONFIG_HOME=./.wrangler-home vite",
    "dev:live-smoke": "PUBLIC_CHAT_LIVE_SMOKE=1 XDG_CONFIG_HOME=./.wrangler-home vite --host 127.0.0.1 --port 5173 --strictPort",
    "deploy": "pnpm build && pnpm deploy:verify-config && wrangler deploy --config dist/public_chat_web/wrangler.json",
    "deploy:verify-config": "node ../../scripts/verify-worker-deploy-config.mjs dist/public_chat_web/wrangler.json APP_API=app-api",
    "deploy:staging": "pnpm build:staging && pnpm deploy:verify-config:staging && wrangler deploy --config dist/public_chat_web/wrangler.json",
    "deploy:verify-config:staging": "node ../../scripts/verify-worker-deploy-config.mjs dist/public_chat_web/wrangler.json APP_API=app-api-staging",
    "preview": "pnpm build && XDG_CONFIG_HOME=./.wrangler-home vite preview",
    "test": "pnpm run test:worker",
    "test:worker": "XDG_CONFIG_HOME=./.wrangler-home vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.3",
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.118",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@sentry/cloudflare": "^10.46.0",
    "@streamdown/cjk": "1.0.2",
    "@streamdown/code": "1.0.3",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tanstack/react-router": "^1.132.23",
    "ai": "6.0.116",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "diff-match-patch": "^1.0.5",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^11.3.19",
    "jose": "^6.0.10",
    "katex": "0.16.28",
    "lucide-react": "^1.7.0",
    "motion": "12.23.26",
    "nanoid": "^5.1.3",
    "next-themes": "^0.3.0",
    "orderedmap": "^2.1.1",
    "papaparse": "^5.5.3",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "^19.2.0",
    "shiki": "3.21.0",
    "sonner": "^1.5.0",
    "streamdown": "2.3.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.3",
    "usehooks-ts": "3.1.0"
  }
}
