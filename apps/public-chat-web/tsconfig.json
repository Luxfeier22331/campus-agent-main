{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"next/link": ["src/platform/vendor-compat/next/link.tsx"],
			"next/navigation": ["src/platform/vendor-compat/next/navigation.ts"],
			"next/image": ["src/platform/vendor-compat/next/image.tsx"],
			"next-auth/react": ["src/platform/vendor-compat/next-auth/react.tsx"],
			"next-auth": ["src/platform/vendor-compat/next-auth/index.ts"],
			"@streamdown/code": ["src/platform/vendor-compat/streamdown/code.ts"],
			"@/lib/ai/models": ["src/platform/vendor-compat/lib/ai/models.ts"],
			"@/lib/constants": ["src/platform/vendor-compat/lib/constants.ts"],
			"@/app/(chat)/actions": ["src/platform/vendor-compat/app/chat-actions.ts"],
			"@/lib/db/schema": ["src/platform/vendor-compat/lib/db/schema.ts"],
			"@/lib/db/queries": ["src/platform/vendor-compat/lib/db/queries.ts"],
			"@/lib/editor/diff": ["src/platform/vendor-compat/lib/editor/diff.ts"],
			"@/lib/types": ["src/platform/vendor-compat/lib/types.ts"],
			"@/lib/utils": ["src/platform/vendor-compat/lib/utils.ts"],
			"@/components/ai-elements/*": ["vendor/vercel-ai-chatbot/components/ai-elements/*"],
			"@/components/theme-provider": ["vendor/vercel-ai-chatbot/components/theme-provider.tsx"],
			"@/components/ui/*": ["vendor/vercel-ai-chatbot/components/ui/*"],
			"@/hooks/use-active-chat": ["src/platform/vendor-compat/hooks/use-active-chat.ts"],
			"@/hooks/use-chat-visibility": ["src/platform/vendor-compat/hooks/use-chat-visibility.ts"],
			"@/hooks/use-mobile": ["vendor/vercel-ai-chatbot/hooks/use-mobile.ts"],
			"@/hooks/use-scroll-to-bottom": ["vendor/vercel-ai-chatbot/hooks/use-scroll-to-bottom.tsx"],
			"@/components/chat/icons": ["vendor/vercel-ai-chatbot/components/chat/icons.tsx"],
			"@/components/chat/toast": ["vendor/vercel-ai-chatbot/components/chat/toast.tsx"],
			"@/*": ["vendor/vercel-ai-chatbot/*"],
			"@platform/*": ["src/platform/*"]
		},
		"types": ["node", "@cloudflare/workers-types", "vite/client", "vitest/globals"],
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"config/**/*.ts",
		"scripts/**/*.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/**/*.ts",
		"vite.config.ts",
		"vitest.config.mts"
	]
}
