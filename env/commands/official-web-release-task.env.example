# Local official_web release task runner.
# Shared OBJECT_STORE_* runtime config should come from repo root .env / root
# worktree .env.

OFFICIAL_WEB_RELEASE_TASK_DATABASE_URL=
OFFICIAL_WEB_RELEASE_TASK_OPERATOR_DATABASE_URL=
# Local default is http://127.0.0.1:27031 and reuses APP_API_INTERNAL_SHARED_SECRET
# from repo root .env when these callback envs are left unset.
INGESTION_WORKER_APP_API_BASE_URL=
INGESTION_WORKER_APP_API_INTERNAL_SHARED_SECRET=
INGESTION_ON_DEMAND_OFFICIAL_WEB_RELEASE_TASK_WORK_DIR=./var/official-web-release-tasks
