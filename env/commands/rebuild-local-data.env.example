# Optional overrides for `rebuild_local_data`.
# Required shared runtime config still comes from the repo root `.env`.
# `--mode`, `--corpus`, `--collection`, `--raw-version-id`, `--raw-asset-id`,
# and `--source-pdf` should be passed explicitly as CLI args.

DOCUMENT_REGISTRY_DATABASE_URL=
RAW_ASSET_REGISTRY_DATABASE_URL=

# Explicit override only when deviating from repo-tracked collection truth.
INGESTION_SPLIT_MANIFEST_PATH=
HANDBOOK_SOURCE_PROJECTIONS_PATH=

# Replay / indexing behavior.
REBUILD_RESET_QDRANT=false
REBUILD_INDEX_QDRANT=false
REBUILD_PUBLISH_ALIAS=true
QDRANT_UPSERT_BATCH_SIZE=128

# Local output / embedding tuning.
IMPORT_REPORT_DIR=./var/import-reports
INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_DIMENSIONS=
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_HUB_OFFLINE=1
