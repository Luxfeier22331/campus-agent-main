# Local official_web handoff consumer for replay verification.
# Shared OBJECT_STORE_* runtime config should come from repo root .env / root worktree .env.
# Registry database URLs may also come from repo root .env via CAMPUS_SHARED_POSTGRES_URL.

INGESTION_WORKER_OFFICIAL_WEB_HANDOFF_INBOX_DIR=./var/official-web-handoffs
INGESTION_WORKER_OFFICIAL_WEB_HANDOFF_EXECUTION_ROOT_DIR=./var/official-web-handoff-executions
INGESTION_WORKER_OFFICIAL_WEB_PROMOTE_IMPORT=false
INGESTION_WORKER_OFFICIAL_WEB_MINIMUM_PROMOTE_PAGES=2
INGESTION_WORKER_OFFICIAL_WEB_MINIMUM_SEED_COVERAGE_RATIO=0.5
INGESTION_WORKER_OFFICIAL_WEB_MINIMUM_HOST_COVERAGE_RATIO=0.5
OFFICIAL_WEB_RELEASE_TASK_DATABASE_URL=
OFFICIAL_WEB_RELEASE_TASK_OPERATOR_DATABASE_URL=
INGESTION_WORKER_APP_API_BASE_URL=http://127.0.0.1:8787
INGESTION_WORKER_APP_API_INTERNAL_SHARED_SECRET=replace-with-app-api-internal-secret
