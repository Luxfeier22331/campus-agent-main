# Optional overrides for `campus-ingestion-release-registry-scope`.
# Required shared runtime config still comes from the repo root `.env`.
# `--corpus`, `--collection`, and publish/reset flags should be passed explicitly as CLI args.

DOCUMENT_REGISTRY_DATABASE_URL=

# Release/index runtime.
QDRANT_UPSERT_BATCH_SIZE=128
INGESTION_QDRANT_TIMEOUT_SECONDS=

# Object-store + embedding runtime still comes from the shared repo/root env.
INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_DIMENSIONS=
SPARSE_PROVIDER=
SPARSE_MODEL=
SPARSE_TOKENIZER=
SPARSE_LANGUAGE=
