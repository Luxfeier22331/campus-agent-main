# campus-agent provider-config local seed template
#
# These values initialize or update app-api provider-config profiles through the
# app-api seed command. They are not online serving runtime truth and must not be
# copied into K8s ConfigMaps, Worker vars, Docker Compose runtime env, or GitOps
# values as active provider-profile configuration.

# Prompt / chat provider seed.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
RAG_SYNTHESIS_MODEL=

# Current online retrieval embedding baseline is Qwen3-Embedding-4B with 2560
# dimensions. Fill only the key for the default local path.
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560

# Optional local rerank seed input. Leave blank unless the active runtime
# profile enables reranking.
RERANK_BASE_URL=https://ai.gitee.com/v1
RERANK_API_KEY=
RERANK_MODEL=
RERANK_PATH=/rerank

# Public web search provider seed. Provider adoption remains an eval decision;
# this template only seeds the provider-config profile used by the tool.
PUBLIC_WEB_SEARCH_BASE_URL=
PUBLIC_WEB_SEARCH_API_KEY=
PUBLIC_WEB_SEARCH_MODEL=
PUBLIC_WEB_SEARCH_PROVIDER=linux_do
PUBLIC_WEB_SEARCH_TRANSPORT=openai_chat_completions_web_search
