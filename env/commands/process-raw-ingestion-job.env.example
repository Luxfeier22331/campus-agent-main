# Optional overrides for `process_raw_ingestion_job`.
# Shared runtime config such as `OBJECT_STORE_*`, `OCR_BASE_URL`, `OCR_API_KEY`,
# and registry URLs should stay in the repo root `.env`.
# Raw asset identity and collection scope belong to CLI args / typed request.

RAW_INGESTION_ARTIFACT_MODE=normalized
OCR_MODEL=PaddleOCR-VL-1.5
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300
IMPORT_REPORT_DIR=./var/import-reports

# Explicit override only when repo-tracked collection truth is not sufficient.
INGESTION_SPLIT_MANIFEST_PATH=

# Local rebuild / indexing tuning only.
INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_DIMENSIONS=
INGESTION_DEFAULT_CAMPUS_SCOPE=
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_HUB_OFFLINE=1
