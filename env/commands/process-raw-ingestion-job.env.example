# Optional overrides for `process_raw_ingestion_job`.
# Shared runtime config such as `OBJECT_STORE_*`, `OCR_BASE_URL`, `OCR_API_KEY`,
# and registry URLs should stay in the repo root `.env`.
# Raw asset identity and collection scope belong to CLI args / typed request.

RAW_INGESTION_ARTIFACT_MODE=normalized
OCR_MODEL=PaddleOCR-VL-1.5
# Prefer explicit provider pinning instead of relying on URL inference.
# Primary `OCR_*` must stay on a Paddle provider for canonical raw ingestion.
OCR_PROVIDER_MODE=
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300
# Only used by the legacy async-jobs provider path.
OCR_RESULT_READY_GRACE_SECONDS=15

# Optional second provider for source_truth_only conditional routing.
# Current repo truth:
# - typed PDF may route MinerU primary with Paddle fallback
# - generic_image in source_truth_only will dual-run Paddle + MinerU, refine raw asset type,
#   then select canonical provider from that adjudication
# - refined simple_table_image stays Paddle primary
# - refined complex_table_image may promote MinerU primary
# - primary `OCR_PROVIDER_MODE=mineru_api` is still rejected
# - spatial / office assets remain deferred
OCR_MINERU_BASE_URL=
OCR_MINERU_API_KEY=
OCR_MINERU_PROVIDER_MODE=mineru_api
OCR_MINERU_MODEL=vlm
OCR_MINERU_LANGUAGE=ch
OCR_MINERU_ENABLE_FORMULA=true
OCR_MINERU_FORCE_OCR=true
OCR_MINERU_POLL_SECONDS=5
OCR_MINERU_TIMEOUT_SECONDS=300

IMPORT_REPORT_DIR=./var/import-reports

# Explicit override only when repo-tracked collection truth is not sufficient.
INGESTION_SPLIT_MANIFEST_PATH=

# Local rebuild / indexing tuning only.
INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_DIMENSIONS=
INGESTION_DEFAULT_CAMPUS_SCOPE=
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_HUB_OFFLINE=1
