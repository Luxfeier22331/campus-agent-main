# Command-scoped local env for `node scripts/prepare-campus-docs-reader-build.mjs`.
# Copy to `env/commands/campus-docs-reader-build.env` in the root worktree and
# keep real values out of git.

APP_API_OPERATOR_DATABASE_URL=

OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET_DERIVED=campus-agent-derived

# Shared credential mode.
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# Derived-only credential mode. Use this instead of shared credentials when the
# docs reader build should only read the derived bucket.
OBJECT_STORE_DERIVED_ACCESS_KEY=
OBJECT_STORE_DERIVED_SECRET_KEY=
