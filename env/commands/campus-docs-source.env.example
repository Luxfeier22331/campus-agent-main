# Campus Web 文档来源准备、正式构建与来源更新使用的命令级对象存储配置。
# 本地凭据管理器未注入这些值时，复制为 env/commands/campus-docs-source.env。
# 不要提交真实值。

OBJECT_STORE_ENDPOINT=

# 文档合同固定使用共享派生桶 `campus-agent-derived`；这里不配置桶别名。
# 正式构建只读，来源更新还需要写入并回读固定来源键的权限。
OBJECT_STORE_DERIVED_READ_ACCESS_KEY=
OBJECT_STORE_DERIVED_READ_SECRET_KEY=

# 仅来源更新命令使用，不传入正式构建。
OBJECT_STORE_DERIVED_ACCESS_KEY=
OBJECT_STORE_DERIVED_SECRET_KEY=
