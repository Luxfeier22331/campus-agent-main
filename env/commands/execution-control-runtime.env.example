# Optional command-scoped overrides for `infra/local/start-execution-control-runtime.sh`
# and `infra/local/smoke-execution-control-runtime.sh`.
#
# Shared provider/runtime defaults should stay in repo root `.env`.
# Deploy-only secrets should stay in app-local env or deploy secret stores.

# Docker build cache/network tuning.
EXECUTION_CONTROL_DOCKER_GOPROXY=https://goproxy.cn,direct
EXECUTION_CONTROL_DOCKER_GOSUMDB=sum.golang.org
EXECUTION_CONTROL_RUNTIME_COMPOSE_PARALLEL_LIMIT=1

# Runtime bind and auth posture.
EXECUTION_CONTROL_HOST_PORT=18080
EXECUTION_CONTROL_RUNTIME_PROFILE=local
API_AUTH_MODE=trusted-worker
API_WORKER_SHARED_SECRET=
SUPERVISOR_AGENT_WORKER_SHARED_SECRET=

# Prompt/provider runtime (local smoke can use mock-runtime).
AGENT_RUNTIME_PROVIDER=mock-runtime
PROMPT_RUNTIME_PROVIDER=mock-runtime
PROMPT_RUNTIME_TRANSPORT=responses
PROMPT_RUNTIME_MODEL=
SUPERVISOR_PROMPT_MODEL=
AGENT_PROMPT_MODEL=
PROMPT_RUNTIME_API_KEY=
PROMPT_RUNTIME_BASE_URL=
PROMPT_STRICT_STRUCTURED_OUTPUTS=true
SUPERVISOR_AGENTS_SDK_RUNTIME_ENABLED=true

# Transport and bridge budgets.
SUPERVISOR_AGENT_WORKER_THREADS=8
SUPERVISOR_AGENT_WORKER_REQUEST_BODY_LIMIT_BYTES=1048576
SUPERVISOR_AGENT_WORKER_CANCEL_FLAG_TTL_SECONDS=900
EXECUTION_CONTROL_MAX_CONCURRENT_ANSWERS=8
EXECUTION_CONTROL_QUEUE_CAPACITY=24
EXECUTION_CONTROL_QUEUE_TIMEOUT_MS=3000
EXECUTION_CONTROL_REQUEST_TIMEOUT_MS=45000
EXECUTION_CONTROL_REQUEST_BODY_LIMIT_BYTES=1048576
EXECUTION_CONTROL_SHUTDOWN_GRACE_MS=45000
SUPERVISOR_AGENT_WORKER_TIMEOUT_MS=35000
SUPERVISOR_AGENT_WORKER_CANCEL_TIMEOUT_MS=500
EXECUTION_CONTROL_BRIDGE_BREAKER_FAILURE_THRESHOLD=5
EXECUTION_CONTROL_BRIDGE_BREAKER_OPEN_MS=10000
EXECUTION_CONTROL_BRIDGE_RETRY_MAX_ATTEMPTS=2
EXECUTION_CONTROL_BRIDGE_RETRY_BASE_MS=50

# Optional observability and execution audit.
EXECUTION_CONTROL_METRICS_BEARER_TOKEN=
EXECUTION_CONTROL_OTEL_ENABLED=false
EXECUTION_CONTROL_OTEL_EXPORTER_OTLP_ENDPOINT=
EXECUTION_CONTROL_OTEL_METRICS_ENABLED=false
EXECUTION_CONTROL_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
EXECUTION_CONTROL_OTEL_EXPORTER_OTLP_HEADERS=
EXECUTION_CONTROL_OTEL_EXPORT_INTERVAL_MS=15000
EXECUTION_CONTROL_OTEL_SAMPLE_RATIO=1.0
SUPERVISOR_AGENT_WORKER_OTEL_ENABLED=false
SUPERVISOR_AGENT_WORKER_OTEL_EXPORTER_OTLP_HEADERS=
EXECUTION_CONTROL_EXECUTION_AUDIT_ENABLED=false
EXECUTION_CONTROL_EXECUTION_AUDIT_URL=
EXECUTION_CONTROL_EXECUTION_AUDIT_SHARED_SECRET=
EXECUTION_CONTROL_EXECUTION_AUDIT_TIMEOUT_MS=500
EXECUTION_CONTROL_EXECUTION_AUDIT_QUEUE_CAPACITY=128
EXECUTION_CONTROL_EXECUTION_AUDIT_BATCH_SIZE=10
EXECUTION_CONTROL_EXECUTION_AUDIT_SPOOL_DIR=

# Durable worker loop. Keep disabled for local non-durable smoke; set every
# companion field when enabling the durable execution path.
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_ENABLED=false
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_WORKER_ID=
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_LANE=
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_STEP_ID=
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_POLL_INTERVAL_MS=
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_LEASE_TTL_MS=
EXECUTION_CONTROL_DURABLE_WORKER_LOOP_LEASE_HEARTBEAT_INTERVAL_MS=

# Durable recovery loop. This scheduler-owned loop does not execute agent work;
# it only recovers expired leases and timed-out runs.
EXECUTION_CONTROL_DURABLE_RECOVERY_LOOP_ENABLED=false
EXECUTION_CONTROL_DURABLE_RECOVERY_LOOP_INTERVAL_MS=
EXECUTION_CONTROL_DURABLE_RECOVERY_LOOP_MAX_RETRY_ATTEMPTS=

# Structured runtime closed by default; set only when explicitly opening.
EXECUTION_CONTROL_OPEN_CAPABILITIES=
EXECUTION_CONTROL_MULTI_STEP_WORKFLOW_ENABLED=false
EXECUTION_CONTROL_WORKFLOW_RUN_DATABASE_URL=
EXECUTION_CONTROL_WORKFLOW_RUN_AUTO_MIGRATE=false
EXECUTION_CONTROL_INTERNAL_QUERY_SHARED_SECRET=
EXECUTION_CONTROL_STRUCTURED_QUERY_TIMEOUT_MS=1000
CAMPUS_SHARED_POSTGRES_URL=
INTERNAL_NOTICE_READ_MODEL_DATABASE_URL=
INTERNAL_NOTICE_READ_MODEL_TABLE=ingestion_projection.internal_notice_read_model
EXECUTION_CONTROL_NOTICE_BODY_OBJECT_STORE_ENDPOINT=
EXECUTION_CONTROL_NOTICE_BODY_OBJECT_STORE_ACCESS_KEY=
EXECUTION_CONTROL_NOTICE_BODY_OBJECT_STORE_SECRET_KEY=
EXECUTION_CONTROL_NOTICE_BODY_OBJECT_STORE_REGION=us-east-1
EXECUTION_CONTROL_NOTICE_BODY_OBJECT_STORE_BUCKET=

# Smoke artifact output directory.
EXECUTION_CONTROL_RUNTIME_SMOKE_ARTIFACT_DIR=.tmp/execution-control-local-smoke
