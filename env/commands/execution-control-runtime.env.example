# Optional command-scoped values for `infra/local/docker-compose.execution-runtime.yml`.
#
# Online serving resolves active provider bundles from execution-control's
# `execution_config` store.
# Deploy-only secrets should stay in app-local env or deploy secret stores.

# Docker build cache/network tuning.
EXECUTION_CONTROL_DOCKER_GOPROXY=https://goproxy.cn,direct
EXECUTION_CONTROL_DOCKER_GOSUMDB=sum.golang.org
EXECUTION_CONTROL_RUNTIME_COMPOSE_PARALLEL_LIMIT=1

# Runtime bind and auth posture.
EXECUTION_CONTROL_HOST_PORT=18080
EXECUTION_CONTROL_ADMIN_HOST_PORT=18081
DEPLOYMENT_ENVIRONMENT=local
# Required and identical for the combined execution-control runtime and agent-runtime.
DEPLOYMENT_RELEASE=local
APP_API_EXECUTION_SHARED_SECRET=
APP_API_EXECUTION_INPUT_SHARED_SECRET=

# Independent AES-256 keyring used by execution-control for protected workflow input.
# Use an absolute path to a 0600 JSON file with active_key_id and a keys object.
EXECUTION_CONTROL_PROTECTED_PAYLOAD_KEYRING_PATH=/absolute/path/to/protected-payload-keyring.json

# Primary agent runtime bridge.
EXECUTION_CONTROL_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:27062
EXECUTION_AGENT_RUNTIME_SHARED_SECRET=
AGENT_RUNTIME_EXECUTION_CONTROL_BASE_URL=http://execution-control:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4320
OTEL_SERVICE_NAME=agent-runtime

# Provider Config admin and runtime reads.
OPS_WEB_INTERNAL_TOKEN=
EXECUTION_CONTROL_PROVIDER_CONFIG_READER_DATABASE_URL=
EXECUTION_CONTROL_PROVIDER_CONFIG_ADMIN_DATABASE_URL=
EXECUTION_CONTROL_PROVIDER_CONFIG_KEYRING_PATH=/absolute/path/to/provider-config-keyring.json

# Gateway structured tool reads.
EXECUTION_CONTROL_TOOL_READ_DATABASE_URL=

# Smoke artifact output directory.
EXECUTION_CONTROL_RUNTIME_SMOKE_ARTIFACT_DIR=.tmp/execution-control-local-smoke
