# Optional command-scoped overrides for `infra/local/start-execution-control-runtime.sh`
# and `infra/local/smoke-execution-control-runtime.sh`.
#
# Shared provider defaults should stay in repo root `.env`; online answer
# serving reads app-api provider-config active profiles.
# Deploy-only secrets should stay in app-local env or deploy secret stores.

# Docker build cache/network tuning.
EXECUTION_CONTROL_DOCKER_GOPROXY=https://goproxy.cn,direct
EXECUTION_CONTROL_DOCKER_GOSUMDB=sum.golang.org
EXECUTION_CONTROL_RUNTIME_COMPOSE_PARALLEL_LIMIT=1

# Runtime bind and auth posture.
EXECUTION_CONTROL_HOST_PORT=18080
EXECUTION_CONTROL_RUNTIME_PROFILE=local
EXECUTION_CONTROL_RUNTIME_CONFIG_PATH=configs/runtime/execution-control/runtime-profile.local.json
API_AUTH_MODE=trusted-worker
API_WORKER_SHARED_SECRET=

# Primary agent runtime bridge.
EXECUTION_CONTROL_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:27062
EXECUTION_CONTROL_AGENT_RUNTIME_SHARED_SECRET=
EXECUTION_CONTROL_AGENT_RUNTIME_TIMEOUT_MS=30000
AGENT_RUNTIME_HOST_PORT=127.0.0.1:27062
AGENT_RUNTIME_PORT=27062
AGENT_RUNTIME_SHARED_SECRET=
AGENT_RUNTIME_TOOL_REGISTRY_PATH=configs/runtime/tools.v4.json
AGENT_RUNTIME_EXECUTION_CONTROL_BASE_URL=http://execution-control:8000
AGENT_RUNTIME_EXECUTION_CONTROL_SHARED_SECRET=

# Optional observability and execution audit handles.
EXECUTION_CONTROL_METRICS_BEARER_TOKEN=
EXECUTION_CONTROL_OTEL_EXPORTER_OTLP_HEADERS=
EXECUTION_CONTROL_EXECUTION_AUDIT_URL=
EXECUTION_CONTROL_EXECUTION_AUDIT_SHARED_SECRET=

# Structured runtime handles.
EXECUTION_CONTROL_INTERNAL_QUERY_SHARED_SECRET=
CAMPUS_SHARED_POSTGRES_URL=
INTERNAL_NOTICE_READ_MODEL_DATABASE_URL=
INTERNAL_NOTICE_READ_MODEL_TABLE=ingestion_projection.internal_notice_read_model

# Smoke artifact output directory.
EXECUTION_CONTROL_RUNTIME_SMOKE_ARTIFACT_DIR=.tmp/execution-control-local-smoke
