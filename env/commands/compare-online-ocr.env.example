# Optional overrides for `campus-ingestion-compare-online-ocr`.
# Shared runtime config such as `OBJECT_STORE_*`, `RAW_ASSET_REGISTRY_DATABASE_URL`,
# `OCR_BASE_URL`, and `OCR_API_KEY` should stay in the repo root `.env`.
# The command emits `summary.json` and `comparison.json` with per-provider status
# plus adjudication evidence under the chosen output directory.

# MinerU compare lane is sidecar-only for now.
OCR_PROVIDER_MODE=mineru_api
OCR_MODEL=vlm
OCR_LANGUAGE=ch
OCR_ENABLE_FORMULA=true
OCR_FORCE_OCR=true
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300

# Optional when the compare job should fetch a registered raw asset and also
# auto-load its canonical Paddle baseline from the source bucket.
# RAW_ASSET_ID=
# RAW_VERSION_ID=

# Optional explicit override when baseline provider-response.jsonl lives under a
# non-canonical source key.
# BASELINE_PROVIDER_RESPONSE_KEY=
