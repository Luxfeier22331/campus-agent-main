# Command-scoped inputs for publishing or building a Campus Docs release.
# Copy to `env/commands/campus-docs-release.env` when a local secret manager
# does not inject these values. Keep real values out of git.

OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET_DERIVED=campus-agent-derived

# Campus Web release builds use credentials restricted to read access.
OBJECT_STORE_DERIVED_ACCESS_KEY=
OBJECT_STORE_DERIVED_SECRET_KEY=

# docs-publish uses a dedicated identity with create/read access to the release prefix.
DOCS_PUBLISH_OBJECT_STORE_ACCESS_KEY=
DOCS_PUBLISH_OBJECT_STORE_SECRET_KEY=

# Materialization uses the docs_publish PostgreSQL role, never the schema owner or app_api role.
DOCS_PUBLISH_DATABASE_URL=
DOCS_PUBLISH_DATABASE_SSLMODE=verify-full
DOCS_PUBLISH_DATABASE_CA_CERT_PATH=
