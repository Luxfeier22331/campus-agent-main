# Historical/narrow overrides for `migrate_student_handbook_source_faithful`.
# This template is retained for handbook canonical-rename recovery only.
# It is not part of the default operator env surface.
# Required shared runtime config still comes from the repo root `.env`.
# `--raw-version-id`, `--raw-asset-id`, and `--canonical-raw-filename`
# should be passed explicitly as CLI args when possible.

RAW_ASSET_REGISTRY_DATABASE_URL=
REPLAY_SOURCE_PDF=
HANDBOOK_CANONICAL_RAW_FILENAME=学生手册_2018.pdf

# Explicit override only when deviating from repo-tracked collection truth.
INGESTION_SPLIT_MANIFEST_PATH=

# Rebuild toggles delegated to the replay step.
REBUILD_RESET_QDRANT=false
REBUILD_INDEX_QDRANT=false
