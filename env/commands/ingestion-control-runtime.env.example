# Runtime inputs for `apps/ingestion-control`.
#
# Keep production secrets in the deployment secret store. This template is only
# for local command wiring and staging smoke setup.

# Persistent control-plane state.
INGESTION_CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/campus_agent
INGESTION_TASK_REGISTRY_ROOT=configs/ingestion

# HTTP bind for the internal admission/projection API.
INGESTION_CONTROL_HOST=0.0.0.0
INGESTION_CONTROL_PORT=8000

# Internal service bearer tokens. Keep real values in the deployment secret store.
INGESTION_CONTROL_ADMIN_TOKEN=
INGESTION_CONTROL_APP_API_PROJECTION_TOKEN=
INGESTION_CONTROL_OFFICIAL_WEB_COLLECTOR_TOKEN=
INGESTION_CONTROL_OFFICIAL_WEB_EXECUTION_STATUS_TOKEN=
INGESTION_CONTROL_OFFICIAL_WEB_PROJECTION_TOKEN=

# Temporal workflow runtime.
INGESTION_TEMPORAL_ADDRESS=127.0.0.1:7233
INGESTION_TEMPORAL_NAMESPACE=default
INGESTION_TEMPORAL_WORKFLOW_TASK_QUEUE=campus-agent.ingestion.workflow
INGESTION_TEMPORAL_CONTROL_ACTIVITY_TASK_QUEUE=campus-agent.ingestion.activity.control

# S3-compatible source object store for source-bucket ingestion tasks.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET_SOURCE=campus-agent-source
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
