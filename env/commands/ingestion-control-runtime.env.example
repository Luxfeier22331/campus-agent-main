# Runtime inputs for `apps/ingestion-control`.
#
# Keep production secrets in the deployment secret store. This template is only
# for local command wiring.

# Persistent control-plane state.
DEPLOYMENT_ENVIRONMENT=local
INGESTION_CONTROL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/campus_agent
INGESTION_CONTROL_DATABASE_SSLMODE=disable
INGESTION_CONTROL_DATABASE_CA_CERT_PATH=
INGESTION_CONTROL_SCHEMA_DATABASE_URL=postgresql://campus_agent:campus_agent@127.0.0.1:5432/campus_agent
INGESTION_CONTROL_SCHEMA_DATABASE_SSLMODE=disable
INGESTION_CONTROL_SCHEMA_DATABASE_CA_CERT_PATH=

# Internal service bearer token. Keep the real value in the deployment secret store.
OPS_WEB_INTERNAL_TOKEN=
