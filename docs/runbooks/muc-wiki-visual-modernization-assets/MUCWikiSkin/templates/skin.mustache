<div class="mucwiki-shell">
	<header class="mucwiki-topbar">
		<a class="mucwiki-brand" href="{{link-mainpage}}" aria-label="{{msg-sitetitle}}">
			<span class="mucwiki-brand__mark mw-wiki-logo"></span>
			<span class="mucwiki-brand__wordmark">{{msg-sitetitle}}</span>
		</a>

		{{#data-search-box}}
		<form class="mucwiki-search" action="{{form-action}}" role="search">
			<input type="hidden" value="{{page-title}}" name="title">
			{{{html-input}}}
			{{{html-button-search}}}
		</form>
		{{/data-search-box}}

		{{#data-portlets.data-personal}}
		<nav class="mucwiki-usernav" id="{{id}}" aria-labelledby="{{id}}-label">
			<h2 class="mucwiki-visually-hidden" id="{{id}}-label">{{label}}</h2>
			<ul class="mucwiki-usernav__list">{{{html-items}}}</ul>
		</nav>
		{{/data-portlets.data-personal}}
	</header>

	<div class="mucwiki-main-grid">
		<main class="mucwiki-content" id="content">
			<div class="mucwiki-sitenotice">{{{html-site-notice}}}</div>
			<div class="mucwiki-page-toolbar">
				{{#data-portlets.data-namespaces}}
				<nav class="mucwiki-tabs mucwiki-tabs--namespaces" id="{{id}}" aria-labelledby="{{id}}-label">
					<h2 class="mucwiki-visually-hidden" id="{{id}}-label">{{label}}</h2>
					<ul>{{{html-items}}}</ul>
				</nav>
				{{/data-portlets.data-namespaces}}
				{{#data-portlets.data-views}}
				<nav class="mucwiki-tabs mucwiki-tabs--views" id="{{id}}" aria-labelledby="{{id}}-label">
					<h2 class="mucwiki-visually-hidden" id="{{id}}-label">{{label}}</h2>
					<ul>{{{html-items}}}</ul>
				</nav>
				{{/data-portlets.data-views}}
				{{#data-portlets.data-actions}}
				<nav class="mucwiki-tabs mucwiki-tabs--actions" id="{{id}}" aria-labelledby="{{id}}-label">
					<h2 class="mucwiki-visually-hidden" id="{{id}}-label">{{label}}</h2>
					<ul>{{{html-items}}}</ul>
				</nav>
				{{/data-portlets.data-actions}}
			</div>

			<section class="mucwiki-article" aria-labelledby="firstHeading">
				<div class="mucwiki-indicators">
					{{#array-indicators}}
					<div id="{{id}}" class="mw-indicator">{{{html}}}</div>
					{{/array-indicators}}
				</div>
				{{{html-title-heading}}}
				<div id="bodyContent" class="mucwiki-body">
					<div id="siteSub">{{msg-sitetitle}}</div>
					<div id="contentSub" {{{html-user-language-attributes}}}>{{{html-subtitle}}}</div>
					{{#html-undelete-link}}<div id="contentSub2">{{{.}}}</div>{{/html-undelete-link}}
					{{{html-user-message}}}
					{{{html-body-content}}}
					{{{html-categories}}}
				</div>
			</section>

			{{{html-after-content}}}
		</main>
	</div>

	{{#data-footer}}
	<footer class="mucwiki-footer" role="contentinfo" {{{html-user-language-attributes}}}>
		{{#data-info}}{{#array-items}}<span id="{{id}}">{{{html}}}</span>{{/array-items}}{{/data-info}}
		{{#data-places}}{{#array-items}}<span id="{{id}}">{{{html}}}</span>{{/array-items}}{{/data-places}}
		{{#data-icons}}{{#array-items}}<span id="{{id}}" class="mucwiki-footer__icon">{{{html}}}</span>{{/array-items}}{{/data-icons}}
	</footer>
	{{/data-footer}}
</div>
