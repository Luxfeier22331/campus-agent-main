{
  "version": "v1.3",
  "product": "MUC Campus Q&A",
  "positioning": "问答助手为主体验；文档、校园地图、饭堂分布图、反馈作为独立但克制的支撑页面。",
  "navigation": [
    "文档",
    "校园地图",
    "饭堂分布图",
    "反馈"
  ],
  "pages": {
    "/": {
      "name": "首页 / 新会话",
      "layout": "ChatGPT-like shell with history sidebar and centered prompt",
      "content": [
        "历史会话",
        "主输入框",
        "示例问题",
        "低权重边界提示"
      ],
      "excluded": [
        "可查询范围",
        "回答如何生成",
        "服务目录",
        "地图/饭堂详情"
      ]
    },
    "/c/:conversationId": {
      "name": "对话线程",
      "layout": "左侧历史会话 + 中央消息流 + 底部输入框",
      "content": [
        "每段回答底部来源",
        "文档附件卡",
        "校园地图预览卡",
        "饭堂分布图预览卡"
      ],
      "excluded": [
        "右侧本次引用栏",
        "回答详情页",
        "用标注提问"
      ]
    },
    "/docs/...": {
      "name": "文档站",
      "layout": "左侧分类目录 + 中间正文 + 右侧本页目录",
      "content": [
        "文档分类",
        "正文",
        "来源",
        "更新"
      ],
      "excluded": [
        "资料详情单页",
        "相关引用片段",
        "局部反馈",
        "采集时间"
      ]
    },
    "/map": {
      "name": "校园地图",
      "layout": "完整地图画布 + 顶部校区和搜索控件",
      "content": [
        "GeoJSON 地点标注",
        "点击标注 popover"
      ],
      "excluded": [
        "饭堂 SVG",
        "地图/平面图模式切换",
        "右侧详情栏",
        "路线规划",
        "来源说明"
      ]
    },
    "/dining": {
      "name": "饭堂分布图",
      "layout": "顶部校区/饭堂/楼层/搜索 + 完整 SVG + 下方名称与价格列表",
      "content": [
        "SVG 档口布局",
        "名称",
        "价格",
        "位置",
        "点击 SVG 与列表联动"
      ],
      "excluded": [
        "今日菜品",
        "实时营业",
        "右侧详情栏",
        "弹窗作为主要列表入口",
        "本层标注标题"
      ]
    },
    "/feedback": {
      "name": "反馈",
      "layout": "单页表单",
      "content": [
        "问题类型",
        "相关页面",
        "问题描述",
        "联系方式可选"
      ],
      "excluded": [
        "分散在各页面的反馈按钮"
      ]
    }
  },
  "colorPolicy": {
    "identity": "MUC red used for identity and sparse emphasis",
    "interaction": "MUC zaojing blue used for actions and selected navigation",
    "interface": "neutral surfaces, lines, and typography"
  },
  "diningDataBoundary": {
    "svgShows": [
      "档口位置",
      "入口",
      "楼梯",
      "座位区",
      "布局结构"
    ],
    "listShows": [
      "名称",
      "价格",
      "位置"
    ],
    "notShown": [
      "每日菜谱",
      "实时营业",
      "库存",
