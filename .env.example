# campus-agent v2 phase-1 local environment template
# Copy to `.env` and fill in real values.
# 标记说明：
# - 现在可填：按你当前环境，马上能决定或已经具备的值
# - 组件落地后再填：等 Agno / MinIO / API 壳真正接入后再补
# - 可留空：当前阶段可以暂时不填，或保留默认值

# Runtime
# 可留空
CAMPUS_AGENT_APP_NAME=campus-agent-v2
# 可留空
CAMPUS_AGENT_ENV=local
# 可留空
CAMPUS_AGENT_LOG_LEVEL=INFO
# 可留空
CAMPUS_AGENT_HTTP_HOST=0.0.0.0
# 可留空
CAMPUS_AGENT_HTTP_PORT=8080
# 可留空
CAMPUS_AGENT_DEFAULT_CORPORA=student_handbook
# 可留空
CAMPUS_AGENT_CONTRACT_VERSION=v2

# AgentOS / orchestration
# 组件落地后再填
AGNO_API_KEY=
# 可留空
AGNO_BASE_URL=
# 可留空
AGNO_PROJECT_ID=
# 组件落地后再填
AGNO_SUPERVISOR_MODEL=
# 组件落地后再填
AGNO_SPECIALIST_MODEL=

# LLM / embedding provider
# Pick one provider family and fill the matching base URL + API key.
# 推荐 slug 约定：
# - openai: 官方 OpenAI API
# - openai_compatible: 任何兼容 OpenAI 协议的第三方网关
# - cohere: Cohere embeddings
# - voyageai: Voyage embeddings
# - jina: Jina embeddings
# - dashscope: 阿里云百炼 / DashScope
# - ollama: 本地 Ollama
# 可留空
LLM_PROVIDER=openai
# 可留空
LLM_BASE_URL=
# 现在可填
LLM_API_KEY=
# 现在可填
LLM_CHAT_MODEL=
# 可留空
LLM_REASONING_MODEL=
# 可留空
EMBEDDING_PROVIDER=openai
# 可留空
EMBEDDING_BASE_URL=
# 如果与 LLM 供应商复用同一 key，可留空；否则现在可填
EMBEDDING_API_KEY=
# 现在可填；如果第一阶段先复用 chat provider 的 embedding 模型，就先填这个
EMBEDDING_MODEL=

# Retrieval / Qdrant
# 现在可填
QDRANT_URL=http://localhost:6333
# 可留空
QDRANT_API_KEY=
# 可留空
QDRANT_COLLECTION=student_handbook
# 可留空
QDRANT_TIMEOUT_SECONDS=10

# Object storage (local MinIO, S3-compatible)
# 组件落地后再填
OBJECT_STORE_ENDPOINT=http://localhost:9000
# 可留空
OBJECT_STORE_REGION=us-east-1
# 组件落地后再填
OBJECT_STORE_ACCESS_KEY=minioadmin
# 组件落地后再填
OBJECT_STORE_SECRET_KEY=minioadmin
# 可留空
OBJECT_STORE_BUCKET_RAW=campus-rag-raw
# 可留空
OBJECT_STORE_BUCKET_PROCESSED=campus-rag-processed
# 可留空
OBJECT_STORE_SECURE=false

# OCR / parsing service
# `process_raw_ingestion_job` 会使用这组配置
# 在线 OCR 处理会把供应商原始响应保存为 `provider-result.jsonl`，
# 同时把内部统一结果保存为 `structured.jsonl`
OCR_BASE_URL=
# 组件落地后再填
OCR_API_KEY=
# 可留空
OCR_MODEL=PaddleOCR-VL-1.5
# 可留空
OCR_POLL_SECONDS=5
# 可留空
OCR_TIMEOUT_SECONDS=300

# Ingestion / import
# 可留空
INGESTION_CORPUS=student_handbook
# 可留空
INGESTION_PARSER_VERSION=campusrag-import-v1
# 可留空；默认可与 EMBEDDING_MODEL 保持一致
INGESTION_EMBEDDING_MODEL=
# 可留空
INGESTION_CHUNK_SIZE=800
# 可留空
INGESTION_CHUNK_OVERLAP=120
# 可留空；如果你改成 manifest 导入再填
INGESTION_SOURCE_MANIFEST_PATH=
# `import_campusrag_existing_ocr` 必填
CAMPUSRAG_OCR_ROOT=
# `submit_raw_ingestion_job` / `process_raw_ingestion_job` 使用；
# 对 `import_campusrag_existing_ocr` 来说可选，仅用于 raw provenance / raw 上传
CAMPUSRAG_RAW_ROOT=
# 可留空；`submit_raw_ingestion_job` 会把占位 job envelope 写到这里
RAW_INGESTION_JOB_DIR=./var/ingestion-jobs
# 可留空；`process_raw_ingestion_job` 可直接消费这个 job envelope
RAW_INGESTION_JOB_PATH=
# 可留空
IMPORT_REPORT_DIR=./var/import-reports

# Registry
# 当前实现只支持 `file`
# 未来如果把 document registry 迁到 Supabase/Postgres，
# 再把 `DOCUMENT_REGISTRY_BACKEND` 切到 `postgres`
DOCUMENT_REGISTRY_BACKEND=file
# `DOCUMENT_REGISTRY_BACKEND=file` 时使用
DOCUMENT_REGISTRY_PATH=./var/registry/student_handbook.json
# 未来切 Postgres 时再填；当前代码暂未消费
DOCUMENT_REGISTRY_DATABASE_URL=




# API auth / actor mapping
# 可留空
API_AUTH_MODE=bearer
# 组件落地后再填；只有你开始调真实 supervisor-api 才需要
API_BEARER_TOKEN=
# 可留空
DEFAULT_CAMPUS_SCOPE=
# 可留空
DEFAULT_ACTOR_GROUPS=
# 可留空
DEFAULT_ACTOR_ROLES=

# Trace / audit
# 可留空
TRACE_ENABLED=true
# 可留空
TRACE_EXPORTER=console
# 可留空
AUDIT_LOG_PATH=./var/log/audit.log
