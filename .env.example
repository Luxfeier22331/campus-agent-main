# campus-agent v2 repo-root local environment template
#
# Root env owns repo-wide shared database handles and local developer provider
# seed inputs. App runtimes, command overrides, object storage, observability,
# eval ingress, and self-hosted infrastructure handles live in their owning
# templates, runtime profiles, or lifecycle-generated env.
#
# App-local templates:
# - `apps/app-api/.env.example`
# - `apps/app-api/.dev.vars.example`
# - `apps/campus-web/.dev.vars.example`
# - `apps/authenticated-notice-collector/.env.example`
# - `apps/official-web-collector/.env.example`
# - `apps/wechat-official-account-collector/.env.example`
# - `apps/protected-panel-web/.dev.vars.example`
# - `infra/otel/collector.env.example`
#
# Command/runtime templates:
# - `env/commands/*.env.example`
# - `configs/runtime/execution-control/*.json`
# - `configs/ingestion/**/runtime-profile.json`
#
# Self-hosted Qdrant is not root env truth. Local/staging lifecycle projects
# QDRANT_URL, QDRANT_API_KEY, QDRANT_READ_ONLY_API_KEY, and QDRANT_QUERY_API_KEY
# from runtime conventions and generated secrets.

# Runtime posture is IPv4-only persistent backend.
# Use the Supabase session pooler endpoint, not `db.<project-ref>.supabase.co`,
# and do not use the transaction pooler for long-running worker/app traffic.
# URL-encode special characters in the password and keep `?sslmode=require`.
CAMPUS_SHARED_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Operator / migration posture uses the canonical operator DSN. Legacy
# `CAMPUS_SHARED_POSTGRES_MANAGEMENT_URL` is still accepted by some recovery
# scripts as a compatibility alias, but new env files should not introduce it.
CAMPUS_SHARED_POSTGRES_OPERATOR_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Local real-provider seed input. These values are consumed by
# `node apps/app-api/scripts/run-with-local-env.mjs pnpm exec tsx
# ./scripts/seed-local-provider-config.ts`, which writes app-api provider-config
# active profiles. Online serving still consumes app-api active profiles, not
# root env fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
RAG_SYNTHESIS_MODEL=

# Current online retrieval embedding baseline is Gitee Qwen3-Embedding-4B with
# 2560 dimensions. Fill only the key for the default local path.
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560

# Optional local rerank seed input. Leave blank unless the active runtime
# profile enables reranking.
RERANK_BASE_URL=https://ai.gitee.com/v1
RERANK_API_KEY=
RERANK_MODEL=
RERANK_PATH=/rerank
