# campus-agent v2 phase-1 environment template
# Fill only the sections used by the runtime you run.

# Supervisor API
# Required for `supervisor-api`: `AGNO_SUPERVISOR_MODEL`, `AGNO_SPECIALIST_MODEL`
CAMPUS_AGENT_APP_NAME=campus-agent-v2
API_AUTH_MODE=bearer
API_BEARER_TOKEN=
API_WORKER_SHARED_SECRET=
API_WORKER_ACTOR_ID=public-entry-worker
API_DEFAULT_ACTOR_ID=api-user
# In `trusted-worker` mode, actor identity can be projected from the
# worker-forwarded Access JWT payload after origin trust is verified.
API_TRUSTED_JWT_USER_ID_CLAIMS=email,sub
API_TRUSTED_JWT_GROUPS_CLAIMS=
API_TRUSTED_JWT_ROLES_CLAIMS=
API_DEFAULT_ACTOR_GROUPS=
API_DEFAULT_ACTOR_ROLES=
API_DEFAULT_CAMPUS_SCOPE=
AGNO_SUPERVISOR_MODEL=
AGNO_SPECIALIST_MODEL=
AUDIT_LOG_PATH=./var/log/audit.log

# Retrieval / embeddings
# Phase-1 frozen retrieval baseline for `regulations/student_handbook`:
# dense=`Qwen3-Embedding-4B @ 2560`, sparse=`Qdrant native BM25`, fusion=`RRF`
# Required for retrieval + indexing: `QDRANT_URL`, `EMBEDDING_MODEL`, `DOCUMENT_REGISTRY_DATABASE_URL`
# Required sparse baseline knobs for live handbook serving/indexing are listed explicitly below.
EMBEDDING_PROVIDER=gitee
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=100
SPARSE_PROVIDER=qdrant
SPARSE_MODEL=qdrant/bm25
SPARSE_TOKENIZER=multilingual
SPARSE_LANGUAGE=none
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=student_handbook
QDRANT_TIMEOUT_SECONDS=10
INGESTION_QDRANT_TIMEOUT_SECONDS=60
# Use the Supabase session pooler endpoint, not `db.<project-ref>.supabase.co`.
# URL-encode special characters in the password and keep `?sslmode=require`.
DOCUMENT_REGISTRY_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Object storage
# Required for ingestion commands: `OBJECT_STORE_ENDPOINT`, `OBJECT_STORE_ACCESS_KEY`, `OBJECT_STORE_SECRET_KEY`
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET_SOURCE=campus-rag-source
OBJECT_STORE_BUCKET_DERIVED=campus-rag-derived
OBJECT_STORE_SECURE=false

# Existing OCR backfill
# Required for `import_campusrag_existing_ocr`: `CAMPUSRAG_OCR_ROOT`
CAMPUSRAG_OCR_ROOT=
INGESTION_CORPUS=regulations
INGESTION_COLLECTION=student_handbook
INGESTION_SPLIT_MANIFEST_PATH=./configs/ingestion/regulations/student_handbook/split-manifest.v1.json
RAW_ASSET_ID=
RAW_VERSION_ID=
INGESTION_EMBEDDING_MODEL=
INGESTION_EMBEDDING_DIMENSIONS=
INGESTION_DEFAULT_CAMPUS_SCOPE=
IMPORT_REPORT_DIR=./var/import-reports
# Hugging Face tokenizer cache for handbook chunk budgeting.
# Best practice: prefetch once with
# `uv run --all-packages python -m campus_ingestion_core.prefetch_tokenizer`
# then keep runtime/test execution offline with `HF_HUB_OFFLINE=1`.
HF_HOME=
HF_HUB_CACHE=
TRANSFORMERS_CACHE=
HF_HUB_OFFLINE=1

# Raw-first worker
# Required for `process_raw_ingestion_job`: `OCR_BASE_URL`, `OCR_API_KEY`, `RAW_ASSET_ID`, `RAW_VERSION_ID`
# Required for `process_raw_ingestion_job` when `INGESTION_COLLECTION=curriculum_plan`: `INGESTION_SPLIT_MANIFEST_PATH`
# Optional for `process_raw_ingestion_job`: `RAW_INGESTION_ARTIFACT_MODE=normalized|source_truth_only`
RAW_INGESTION_ARTIFACT_MODE=normalized
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=PaddleOCR-VL-1.5
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300
RAW_ASSET_REGISTRY_DATABASE_URL=

# Local rebuild
# Required for `rebuild_local_data`: `REBUILD_IMPORT_MODE`
REBUILD_IMPORT_MODE=
# Optional: `raw_online_ocr` or `provider_response_replay`
REBUILD_RESET_QDRANT=false
REBUILD_INDEX_QDRANT=false
# `student_handbook` rebuild / migration only:
REPLAY_SOURCE_PDF=学生手册_2018.pdf
HANDBOOK_CANONICAL_RAW_FILENAME=学生手册_2018.pdf
HANDBOOK_SOURCE_PROJECTIONS_PATH=./configs/ingestion/regulations/student_handbook/source-projections.v1.json
QDRANT_UPSERT_BATCH_SIZE=128

# Reserved phase-1 placeholders
CAMPUS_AGENT_ENV=local
CAMPUS_AGENT_LOG_LEVEL=INFO
CAMPUS_AGENT_HTTP_HOST=0.0.0.0
CAMPUS_AGENT_HTTP_PORT=8080
CAMPUS_AGENT_DEFAULT_CORPORA=student_handbook
CAMPUS_AGENT_CONTRACT_VERSION=v2
AGNO_API_KEY=
AGNO_BASE_URL=
AGNO_PROJECT_ID=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_REASONING_MODEL=
TRACE_ENABLED=true
TRACE_EXPORTER=console
# Phase-1 `student_handbook` chunking/cleaning is frozen in code:
# target=384, max=512, overlap=64, min=96, safety_margin=16, split_strategy=structure_first
# Do not expose chunk size or overlap as runtime env toggles in phase-1.

# Curriculum-plan split-manifest template
# INGESTION_CORPUS=curriculum
# INGESTION_COLLECTION=curriculum_plan
# INGESTION_SPLIT_MANIFEST_PATH=./configs/ingestion/curriculum/curriculum_plan/split-manifest.v1.json
# RAW_ASSET_ID=asset:curriculum-plan-2022-pdf
# RAW_VERSION_ID=sha256:<object-store-registered-pdf-hash>
