# campus-agent v2 shared environment template
# This file owns repo-root shared runtime config only.
# Worker / web app observability remains app-local by design.
# Keep `SENTRY_*` / `AXIOM_*` in the owning app runtime env or deploy secret store,
# not in this repo-root shared template.
# App-local templates:
# - `apps/app-api/.env.example`
# - `apps/app-api/.dev.vars.example`
# - `apps/public-chat-web/.dev.vars.example`
# - `apps/protected-panel-web/.dev.vars.example`
# Command-scoped overrides:
# - Active operator examples: `env/commands/*.env.example`
# - Narrow historical recovery examples: `env/commands/historical/*.env.example`
#
# Optional local convenience only:
# If you use `uv run --all-packages python -m scripts.sync_worker_observability_env`,
# keep the source values in the root worktree `.env`, not here as shared runtime truth.
# If you use `uv run --all-packages python -m scripts.sync_app_api_local_db_env`,
# keep `CAMPUS_SHARED_POSTGRES_URL` in the root worktree `.env`, not here.
# Example keys:
# SENTRY_DSN_API=
# SENTRY_DSN_CHAT=
# SENTRY_DSN_PANEL=
# SENTRY_API_TOKEN=  # repo-local Sentry API lookup only; do not fan out into Worker runtime env
# AXIOM_ENDPOINT=https://us-east-1.aws.edge.axiom.co
# AXIOM_DATASET=campus-agent-app-api-dev
# AXIOM_TOKEN=

# Supervisor API / shared execution runtime
# Local dev defaults for the Go `apps/supervisor-api` ingress plus the Python
# `apps/supervisor-core-worker` private bridge worker.
# `apps/app-api` calls supervisor with its own app-local `SUPERVISOR_API_SHARED_SECRET`;
# it must match `API_WORKER_SHARED_SECRET` when `API_AUTH_MODE=trusted-worker`.
CAMPUS_AGENT_APP_NAME=campus-agent-v2
CAMPUS_AGENT_HTTP_HOST=0.0.0.0
CAMPUS_AGENT_HTTP_PORT=8000
API_AUTH_MODE=trusted-worker
API_BEARER_TOKEN=
API_WORKER_SHARED_SECRET=replace-with-supervisor-worker-secret
API_DEFAULT_ACTOR_ID=
AGENT_RUNTIME_PROVIDER=
# Local dev examples:
# API_AUTH_MODE=bearer
# API_BEARER_TOKEN=local-dev-token
# API_DEFAULT_ACTOR_ID=local-dev-bearer-user
# In `trusted-worker` mode, final actor/authorization must be supplied
# in the request body `context`; headers only carry caller admission.
API_DEFAULT_ACTOR_ROLES=student
# Prompt runtime model selection:
# - `PROMPT_RUNTIME_MODEL` is the shared default for both roles
# - `SUPERVISOR_PROMPT_MODEL` / `SPECIALIST_PROMPT_MODEL` only override when needed
PROMPT_RUNTIME_MODEL=
SUPERVISOR_PROMPT_MODEL=
SPECIALIST_PROMPT_MODEL=

# Python supervisor-core-worker private bridge runtime.
SUPERVISOR_CORE_WORKER_HOST=127.0.0.1
SUPERVISOR_CORE_WORKER_PORT=18081
SUPERVISOR_CORE_WORKER_THREADS=8
SUPERVISOR_CORE_WORKER_BASE_URL=http://127.0.0.1:18081
SUPERVISOR_CORE_WORKER_SHARED_SECRET=replace-with-supervisor-core-worker-secret
SUPERVISOR_CORE_WORKER_TIMEOUT_MS=35000
SUPERVISOR_CORE_WORKER_CANCEL_TIMEOUT_MS=500
PROMPT_RUNTIME_CONNECT_TIMEOUT_SECONDS=10
PROMPT_RUNTIME_READ_TIMEOUT_SECONDS=30
PROMPT_RUNTIME_WRITE_TIMEOUT_SECONDS=10
PROMPT_RUNTIME_POOL_TIMEOUT_SECONDS=3
PROMPT_RUNTIME_MAX_CONNECTIONS=32
PROMPT_RUNTIME_MAX_KEEPALIVE_CONNECTIONS=16
PROMPT_RUNTIME_KEEPALIVE_EXPIRY_SECONDS=30

# Go supervisor-api admission, request lifecycle, and bridge protection.
# `SUPERVISOR_API_HOST_PORT` is used by the local Docker compose harness only.
SUPERVISOR_API_HOST_PORT=18080
SUPERVISOR_API_MAX_CONCURRENT_ANSWERS=8
SUPERVISOR_API_QUEUE_CAPACITY=24
SUPERVISOR_API_QUEUE_TIMEOUT_MS=3000
SUPERVISOR_API_REQUEST_TIMEOUT_MS=45000
SUPERVISOR_API_REQUEST_BODY_LIMIT_BYTES=1048576
SUPERVISOR_API_SHUTDOWN_GRACE_MS=45000
SUPERVISOR_API_BRIDGE_BREAKER_FAILURE_THRESHOLD=5
SUPERVISOR_API_BRIDGE_BREAKER_OPEN_MS=10000
SUPERVISOR_API_BRIDGE_RETRY_MAX_ATTEMPTS=2
SUPERVISOR_API_BRIDGE_RETRY_BASE_MS=50
SUPERVISOR_API_QUERY_SERVING_SCOPES_PATH=
SUPERVISOR_API_LANE_RAG_MAX_CONCURRENT=6
SUPERVISOR_API_LANE_RAG_QUEUE_CAPACITY=12
SUPERVISOR_API_LANE_RAG_QUEUE_TIMEOUT_MS=3000
SUPERVISOR_API_LANE_NAVIGATION_MAX_CONCURRENT=2
SUPERVISOR_API_LANE_NAVIGATION_QUEUE_CAPACITY=4
SUPERVISOR_API_LANE_NAVIGATION_QUEUE_TIMEOUT_MS=1500
SUPERVISOR_API_LANE_CAMPUS_SERVICES_MAX_CONCURRENT=2
SUPERVISOR_API_LANE_CAMPUS_SERVICES_QUEUE_CAPACITY=4
SUPERVISOR_API_LANE_CAMPUS_SERVICES_QUEUE_TIMEOUT_MS=1500
SUPERVISOR_API_LANE_NOTICE_MAX_CONCURRENT=2
SUPERVISOR_API_LANE_NOTICE_QUEUE_CAPACITY=4
SUPERVISOR_API_LANE_NOTICE_QUEUE_TIMEOUT_MS=1500
SUPERVISOR_API_LANE_DEFAULT_MAX_CONCURRENT=1
SUPERVISOR_API_LANE_DEFAULT_QUEUE_CAPACITY=2
SUPERVISOR_API_LANE_DEFAULT_QUEUE_TIMEOUT_MS=1500
# Comma-separated structured capabilities opened for product serving.
# Keep empty by default; examples: `campus_services`, `notice`, `campus_services,notice`.
# Wildcards such as `*` and `all` are rejected.
SUPERVISOR_API_OPEN_CAPABILITIES=

# Multi-step workflow runtime is closed by default. Opening it requires a
# workflow run store; auto migration is intended for local/dev or explicitly
# approved startup migration only.
SUPERVISOR_API_MULTI_STEP_WORKFLOW_ENABLED=false
SUPERVISOR_API_WORKFLOW_RUN_DATABASE_URL=
SUPERVISOR_API_WORKFLOW_RUN_AUTO_MIGRATE=false

# Supervisor API metrics, telemetry, and execution audit.
SUPERVISOR_API_METRICS_BEARER_TOKEN=
SUPERVISOR_API_OTEL_ENABLED=false
SUPERVISOR_API_OTEL_EXPORTER_OTLP_ENDPOINT=
SUPERVISOR_API_OTEL_EXPORTER_OTLP_HEADERS=
SUPERVISOR_API_OTEL_SERVICE_NAME=campus-supervisor-api
SUPERVISOR_API_OTEL_EXPORT_TIMEOUT_MS=1000
SUPERVISOR_API_OTEL_SAMPLE_RATIO=1
SUPERVISOR_API_OTEL_ALLOWED_ATTRIBUTES_VERSION=supervisor-api-otel-attrs-v1
SUPERVISOR_API_EXECUTION_AUDIT_ENABLED=false
SUPERVISOR_API_EXECUTION_AUDIT_URL=http://127.0.0.1:8787/api/internal/execution/audit-events
SUPERVISOR_API_EXECUTION_AUDIT_SHARED_SECRET=
SUPERVISOR_API_EXECUTION_AUDIT_TIMEOUT_MS=500
SUPERVISOR_API_EXECUTION_AUDIT_QUEUE_CAPACITY=128
SUPERVISOR_API_EXECUTION_AUDIT_BATCH_SIZE=10
SUPERVISOR_API_EXECUTION_AUDIT_FLUSH_MS=1000
SUPERVISOR_API_EXECUTION_AUDIT_RETRY_MAX_ATTEMPTS=3
SUPERVISOR_API_EXECUTION_AUDIT_RETRY_BASE_MS=100
SUPERVISOR_API_EXECUTION_AUDIT_SPOOL_DIR=
SUPERVISOR_API_EXECUTION_AUDIT_SPOOL_MAX_BYTES=10485760

# Supervisor structured query runtime.
# `SUPERVISOR_STRUCTURED_QUERY_BASE_URL` / timeout seconds are consumed by the
# Python worker thin adapters; shared secret / PG read models / timeout ms are consumed
# by the Go internal query routes.
SUPERVISOR_STRUCTURED_QUERY_BASE_URL=http://127.0.0.1:8000
SUPERVISOR_STRUCTURED_QUERY_SHARED_SECRET=replace-with-structured-query-secret
SUPERVISOR_STRUCTURED_QUERY_TRUSTED_TIME_RFC3339=
SUPERVISOR_STRUCTURED_QUERY_TIMEOUT_SECONDS=1
SUPERVISOR_STRUCTURED_QUERY_TIMEOUT_MS=1000

# Optional local Docker build overrides for the supervisor runtime harness.
SUPERVISOR_API_DOCKER_GOPROXY=https://goproxy.cn,direct
SUPERVISOR_API_DOCKER_GOSUMDB=sum.golang.org

# Shared LLM provider
# Shared provider connection info for supervisor/specialist/eval when they use the same vendor.
# Eval model choice stays chain-specific via `EVAL_RAGAS_MODEL` / `EVAL_JUDGE_MODEL`.
LLM_BASE_URL=
LLM_API_KEY=
# Internal notice multimodal processing can inherit PROMPT_RUNTIME_* / LLM_*.
# Set these only when the notice multimodal lane needs a distinct chat endpoint/model.
INTERNAL_NOTICE_MULTIMODAL_BASE_URL=
INTERNAL_NOTICE_MULTIMODAL_API_KEY=
INTERNAL_NOTICE_MULTIMODAL_MODEL=
INTERNAL_NOTICE_MULTIMODAL_MAX_OUTPUT_TOKENS=900

# Retrieval / embeddings
# Current retrieval baseline for `regulations/student_rules`:
# dense=`Qwen3-Embedding-4B @ 2560`, sparse=`Qdrant native BM25`, fusion=`RRF`
# Required for retrieval + indexing: `QDRANT_URL`, `EMBEDDING_MODEL`, `DOCUMENT_REGISTRY_DATABASE_URL`
# Handbook runtime currently retrieves top 8 evidence candidates; final answer rendering keeps at most 3 sources.
# Runtime profiles define the serving alias, collection prefix, and vector bindings.
# Physical Qdrant collections are created per release as `<collection_prefix>__<release_id>`.
# Shared-dev / production should point to managed services; keep these blank until assigned.
EMBEDDING_PROVIDER=gitee
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=100
SPARSE_PROVIDER=qdrant
SPARSE_MODEL=qdrant/bm25
SPARSE_TOKENIZER=multilingual
SPARSE_LANGUAGE=none
# Hybrid retrieval runtime knobs now live in
# `configs/ingestion/<corpus>/<collection>/runtime-profile.json`.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
INGESTION_QDRANT_TIMEOUT_SECONDS=180
QDRANT_UPSERT_BATCH_SIZE=32
# Local dev example:
# QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
# Runtime posture is IPv4-only persistent backend.
# Use the Supabase session pooler endpoint, not `db.<project-ref>.supabase.co`,
# and do not use the transaction pooler for long-running worker/app traffic.
# URL-encode special characters in the password and keep `?sslmode=require`.
CAMPUS_SHARED_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
# Offline operator / migration posture must use a real direct management DSN.
# Do not reuse the session pooler here.
CAMPUS_SHARED_POSTGRES_MANAGEMENT_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Optional ingestion/retrieval override only when the registry should not use the shared repo DB.
DOCUMENT_REGISTRY_DATABASE_URL=

# Object storage
# Required for ingestion commands: `OBJECT_STORE_ENDPOINT`, `OBJECT_STORE_ACCESS_KEY`, `OBJECT_STORE_SECRET_KEY`
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SOURCE_ACCESS_KEY=
OBJECT_STORE_SOURCE_SECRET_KEY=
OBJECT_STORE_DERIVED_ACCESS_KEY=
OBJECT_STORE_DERIVED_SECRET_KEY=
OBJECT_STORE_BUCKET_SOURCE=campus-rag-source
OBJECT_STORE_BUCKET_DERIVED=campus-rag-derived
OBJECT_STORE_SECURE=true
# Either configure shared OBJECT_STORE_ACCESS_KEY/OBJECT_STORE_SECRET_KEY,
# or configure bucket-scoped credential pairs for source and/or derived buckets.
# Source-only collectors may use OBJECT_STORE_SOURCE_* without shared creds.
DOCS_READ_MODEL_MANIFEST_PATH=var/docs-read-model-manifest.json
# Local dev example:
# OBJECT_STORE_ENDPOINT=http://localhost:9000
# OBJECT_STORE_ACCESS_KEY=minioadmin
# OBJECT_STORE_SECRET_KEY=minioadmin
# OBJECT_STORE_SECURE=false

# Legacy Office conversion runtime
LEGACY_OFFICE_CONVERSION_BASE_URL=http://127.0.0.1:8091
LEGACY_OFFICE_CONVERSION_INTERNAL_SHARED_SECRET=
LEGACY_OFFICE_CONVERSION_TIMEOUT_SECONDS=120
LIBREOFFICE_SERVICE_BIND=0.0.0.0:8091
LIBREOFFICE_SERVICE_TASK_TIMEOUT_MS=120000
LIBREOFFICE_SERVICE_QUEUE_TIMEOUT_MS=150000
LIBREOFFICE_SERVICE_MAX_TASKS_PER_PROCESS=200
LIBREOFFICE_SERVICE_WORKDIR=/tmp/legacy-office-conversion

# Raw ingestion / OCR shared runtime
# Scope, source identity, split-manifest overrides, and replay inputs belong to
# CLI args / typed request or `env/commands/*.env.example`, not this root template.
RAW_INGESTION_ARTIFACT_MODE=normalized
OCR_BASE_URL=
OCR_API_KEY=
# Default example keeps Paddle values, but operator runs should pin the actual
# provider needed by the selected lane.
OCR_MODEL=PaddleOCR-VL-1.5
# Explicitly pin the OCR provider mode for operator runs:
# - `paddleocr_async_jobs` / `paddleocr_vl_service` for Paddle-backed lanes
# - `mineru_api` for MinerU-backed lanes such as typed PDF / complex document image
# - do not rely on `OCR_BASE_URL` inference for replay or raw-ingestion operators
OCR_PROVIDER_MODE=
OCR_LANGUAGE=ch
OCR_ENABLE_FORMULA=true
OCR_FORCE_OCR=false
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300
# Only used by the async-jobs client while waiting for resultUrl objects.
OCR_RESULT_READY_GRACE_SECONDS=15
RAW_ASSET_REGISTRY_DATABASE_URL=

# Authenticated notice collector runtime
# Preferred operator auth storage is the explicit three-cookie set below. The
# collector seeds them into `runtime/auth/storageState.json` and preserves them
# across headless bootstrap refresh. `AUTHENTICATED_NOTICE_AUTH_COOKIE_HEADER`
# remains available as a compatibility input when you already have a full
# Cookie header fragment.
AUTHENTICATED_NOTICE_SSO_TGC=
AUTHENTICATED_NOTICE_JSESSIONID=
AUTHENTICATED_NOTICE_NGINX=
AUTHENTICATED_NOTICE_RUNTIME_DIR=
AUTHENTICATED_NOTICE_BASE_URL=https://my.muc.edu.cn
AUTHENTICATED_NOTICE_PAGE_URL=https://my.muc.edu.cn/page/11#/
# Default true keeps muc.edu.cn in NO_PROXY for direct campus portal access.
# Set false only when the local WSL direct DNS/network path is broken and the
# configured proxy is trusted for this authenticated portal session.
AUTHENTICATED_NOTICE_BYPASS_PROXY=true
# Optional explicit portal proxy. When bypass is false, the collector falls back
# to HTTPS_PROXY / HTTP_PROXY / ALL_PROXY if this is empty.
AUTHENTICATED_NOTICE_PROXY_SERVER=
AUTHENTICATED_NOTICE_AUTH_CHECK_NOTICE_TYPE=5
AUTHENTICATED_NOTICE_AUTH_CHECK_PAGE_SIZE=3
AUTHENTICATED_NOTICE_COLLECTION_MODE=incremental
# Optional historical backfill hard cap per enabled notice type. When set with
# AUTHENTICATED_NOTICE_COLLECTION_MODE=backfill, this overrides the per-type
# repo config page budget while the portal-reported last page still stops the run.
AUTHENTICATED_NOTICE_HISTORICAL_BACKFILL_MAX_PAGES_PER_TYPE=
# Optional bounded historical notice refresh input:
# comma-separated notice_id:notice_type[:notice_type_name] entries.
AUTHENTICATED_NOTICE_SELECTED_NOTICES=
# Optional PG ledger used by the collector to skip known terminal attachment
# downloads such as authenticated portal 404/410 responses.
AUTHENTICATED_NOTICE_ATTACHMENT_FETCH_STATUS_DATABASE_URL=
AUTHENTICATED_NOTICE_ATTACHMENT_FETCH_STATUS_DISABLE=false
# Optional PG run ledger used to audit collector input/output artifacts and
# attachment outcome counts for each run.
AUTHENTICATED_NOTICE_COLLECTOR_RUN_LEDGER_DATABASE_URL=
AUTHENTICATED_NOTICE_COLLECTOR_RUN_LEDGER_DISABLE=false
# Optional PG lease used by production collector jobs to prevent concurrent
# writes for the same authenticated source surface.
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_DATABASE_URL=
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_DISABLE=false
AUTHENTICATED_NOTICE_COLLECTOR_LEASE_TTL_SECONDS=3600
# Docker/cron entrypoint mode: auth-check, notice-export, file-release-export.
AUTHENTICATED_NOTICE_COLLECTOR_MODE=auth-check

# WeChat official-account public source channel.
# FeedWe is an acquisition provider only; provider output must be mirrored into
# the existing source bucket before notice consumption.
FEEDWE_API_KEY=
FEEDWE_BASE_URL=https://feedwe.cloud
WECHAT_OFFICIAL_ACCOUNT_APP_API_BASE_URL=
WECHAT_OFFICIAL_ACCOUNT_SERVICE_TOKEN=
WECHAT_OFFICIAL_ACCOUNT_TRACE_ID=
WECHAT_OFFICIAL_ACCOUNT_TRIGGER_TYPE=manual

# Evals / live benchmark runtime
# 共享 provider 真相默认来自 `LLM_*` 与 `EMBEDDING_*`。
# `EVAL_LLM_*` / `EVAL_EMBEDDING_*` 只在 eval 需要独立 provider 或独立预算时使用。
# eval 的模型选择仍由 `EVAL_RAGAS_MODEL` / `EVAL_JUDGE_MODEL` 持有。
# timeout / retry / pacing / keep-alive / connection-pool 这类 benchmark runtime tuning
# 已收口到 repo-tracked live benchmark profile config，不再放在 root `.env`。
# repo-shipped eval CLI 会自动 bootstrap 当前 worktree `.env`；ad-hoc inline Python / REPL 不会。
# 如果要检查当前 worktree 是否真的把这些键暴露给 eval surface，使用：
# `uv run --all-packages python -m scripts.doctor_env evals --json`
# 以下 `APP_API_*` 仅供本地 Python live benchmark runner 连接当前 worktree 的
# `apps/app-api` dev runtime，不是远端部署环境真相。
# `APP_API_INTERNAL_SHARED_SECRET` 应与本地 `apps/app-api/.dev.vars` 中的同名值保持一致。
# `APP_API_BASE_URL` 应指向当前 `pnpm --dir apps/app-api dev` 暴露的本地 URL；
# 本地 wrangler 常见地址例如 `http://127.0.0.1:8787`。
APP_API_BASE_URL=
APP_API_INTERNAL_SHARED_SECRET=
APP_API_EVAL_USER_EMAIL=
APP_API_EVAL_USER_ID=
APP_API_EVAL_USER_NAME=Eval Benchmark
APP_API_EVAL_PRINCIPAL_TYPE=campus_member
# Optional override for the local eval ingress timeout.
# The canonical default now comes from the repo-tracked live benchmark profile.
APP_API_EVAL_HTTP_TIMEOUT_SECONDS=
APP_API_EVAL_TRACE_LINK_TEMPLATE=
APP_API_EVAL_ISSUE_LINK_TEMPLATE=
APP_API_EVAL_ISSUE_FINGERPRINT_TEMPLATE=
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
EVAL_LLM_TRANSPORT=responses
EVAL_RAGAS_MODEL=
EVAL_RAGAS_LLM_TRANSPORT=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_LLM_TRANSPORT=
EVAL_EMBEDDING_BASE_URL=
EVAL_EMBEDDING_API_KEY=
EVAL_EMBEDDING_MODEL=
EVAL_EMBEDDING_DIMENSIONS=
# Optional metric prompt adaptation for non-English evals.
# Current handbook/curriculum live benchmarks are Chinese-first; enable when
# you want Ragas prompt examples translated to the target language.
EVAL_RAGAS_TARGET_LANGUAGE=
RAGAS_REASONING_EFFORT=none
RAGAS_TEXT_VERBOSITY=low
RAGAS_MAX_OUTPUT_TOKENS=256
RAGAS_ADAPT_INSTRUCTION=false

# `student_rules` chunking/cleaning baseline is frozen in code:
# target=384, max=512, overlap=64, min=96, safety_margin=16, split_strategy=structure_first
# Do not expose chunk size or overlap as runtime env toggles in the env template.
