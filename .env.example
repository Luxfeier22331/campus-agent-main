# campus-agent v2 phase-1 environment template
# Fill only the sections used by the runtime you run.

# Supervisor API
# Required for `supervisor-api`: `AGNO_SUPERVISOR_MODEL`, `AGNO_SPECIALIST_MODEL`
CAMPUS_AGENT_APP_NAME=campus-agent-v2
API_AUTH_MODE=bearer
API_BEARER_TOKEN=
API_DEFAULT_ACTOR_GROUPS=
API_DEFAULT_ACTOR_ROLES=
API_DEFAULT_CAMPUS_SCOPE=
AGNO_SUPERVISOR_MODEL=
AGNO_SPECIALIST_MODEL=
AUDIT_LOG_PATH=./var/log/audit.log

# Retrieval / embeddings
# Required for retrieval + indexing: `QDRANT_URL`, `EMBEDDING_MODEL`, `DOCUMENT_REGISTRY_DATABASE_URL`
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=100
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=student_handbook
QDRANT_TIMEOUT_SECONDS=10
# Use the Supabase session pooler endpoint, not `db.<project-ref>.supabase.co`.
# URL-encode special characters in the password and keep `?sslmode=require`.
DOCUMENT_REGISTRY_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Object storage
# Required for ingestion commands: `OBJECT_STORE_ENDPOINT`, `OBJECT_STORE_ACCESS_KEY`, `OBJECT_STORE_SECRET_KEY`
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET_RAW=campus-rag-raw
OBJECT_STORE_BUCKET_PROCESSED=campus-rag-processed
OBJECT_STORE_SECURE=false

# Existing OCR backfill
# Required for `import_campusrag_existing_ocr`: `CAMPUSRAG_OCR_ROOT`
CAMPUSRAG_OCR_ROOT=
CAMPUSRAG_RAW_ROOT=
INGESTION_CORPUS=student_handbook
INGESTION_SPLIT_MANIFEST_PATH=
RAW_INGESTION_SOURCE_PATHS=
INGESTION_EMBEDDING_MODEL=
INGESTION_DEFAULT_CAMPUS_SCOPE=
IMPORT_REPORT_DIR=./var/import-reports

# Raw-first placeholder / worker
# Required for `submit_raw_ingestion_job`: one of `CAMPUSRAG_RAW_ROOT` or `RAW_INGESTION_SOURCE_PATHS`
# Optional for `submit_raw_ingestion_job`: `INGESTION_CORPUS`
# Required for `process_raw_ingestion_job`: `OCR_BASE_URL`, `OCR_API_KEY`, and one of `CAMPUSRAG_RAW_ROOT`, `RAW_INGESTION_JOB_PATH`, or `RAW_INGESTION_SOURCE_PATHS`
# Required for `process_raw_ingestion_job` when `INGESTION_CORPUS=curriculum_plan`: `INGESTION_SPLIT_MANIFEST_PATH`
RAW_INGESTION_JOB_DIR=./var/ingestion-jobs
RAW_INGESTION_JOB_PATH=
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=PaddleOCR-VL-1.5
OCR_POLL_SECONDS=5
OCR_TIMEOUT_SECONDS=300

# Local rebuild
# Required for `rebuild_local_data`: `REBUILD_IMPORT_MODE`
REBUILD_IMPORT_MODE=
# Optional: `existing_ocr` or `raw_online_ocr`
REBUILD_RESET_QDRANT=false

# Reserved phase-1 placeholders
CAMPUS_AGENT_ENV=local
CAMPUS_AGENT_LOG_LEVEL=INFO
CAMPUS_AGENT_HTTP_HOST=0.0.0.0
CAMPUS_AGENT_HTTP_PORT=8080
CAMPUS_AGENT_DEFAULT_CORPORA=student_handbook
CAMPUS_AGENT_CONTRACT_VERSION=v2
AGNO_API_KEY=
AGNO_BASE_URL=
AGNO_PROJECT_ID=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_REASONING_MODEL=
TRACE_ENABLED=true
TRACE_EXPORTER=console
# Phase-1 `student_handbook` chunking/cleaning is frozen in code:
# target=240, max=360, overlap=48, min=40, split_strategy=structure_first
# Do not expose chunk size or overlap as runtime env toggles in phase-1.

# Curriculum-plan split-manifest template
# INGESTION_CORPUS=curriculum_plan
# INGESTION_SPLIT_MANIFEST_PATH=./configs/ingestion/curriculum_plan/split-manifest.v1.json
# RAW_INGESTION_SOURCE_PATHS=/mnt/e/Code/sideProject/campusRag/data/raw/pdfs/curriculum-plan-2022.pdf
