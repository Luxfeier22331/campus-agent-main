# campus-agent v2 repo-root local environment template
#
# Root env owns repo-wide shared database handles only. App runtimes, provider
# seed inputs, command overrides, object storage, observability, eval ingress,
# and self-hosted infrastructure handles live in their owning templates,
# runtime configs, or lifecycle-generated env.
#
# App-local templates:
# - `apps/app-api/.env.example`
# - `apps/app-api/.dev.vars.example`
# - `apps/campus-web/.dev.vars.example`
# - `apps/operator-console-web/.dev.vars.example`
# - `apps/source-collector/adapters/internal-portal/.env.example`
# - `apps/source-collector/adapters/official-web/.env.example`
# - `apps/source-collector/adapters/wechat-official-account/.env.example`
# - `infra/otel/collector.env.example`
#
# Command/runtime templates:
# - `env/commands/*.env.example`
# - `configs/runtime/execution-control/*.json`
# - `configs/ingestion/**/serving-config.json`
#
# Self-hosted Qdrant is not root env truth. Local/staging lifecycle projects
# QDRANT_URL, QDRANT_API_KEY, QDRANT_READ_ONLY_API_KEY, and QDRANT_QUERY_API_KEY
# from runtime conventions and generated secrets.

# Runtime posture is IPv4-only persistent backend.
# Use the Supabase session pooler endpoint, not `db.<project-ref>.supabase.co`,
# and do not use the transaction pooler for long-running worker/app traffic.
# URL-encode special characters in the password and keep `?sslmode=require`.
CAMPUS_SHARED_POSTGRES_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require

# Operator / migration posture uses the canonical operator DSN. Legacy
# `CAMPUS_SHARED_POSTGRES_MANAGEMENT_URL` is still accepted by some recovery
# scripts as a compatibility alias, but new env files should not introduce it.
CAMPUS_SHARED_POSTGRES_OPERATOR_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
